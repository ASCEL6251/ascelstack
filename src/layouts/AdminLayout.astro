---
export const prerender = false;

import Logo from '../components/Logo.astro';
import { getAdminSession } from '../lib/admin-auth';
import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: 'overview' | 'users' | 'quotations' | 'logs' | 'settings';
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title = 'Admin Console · Ascelstack',
  activeNav = 'overview',
  breadcrumbs = [{ label: 'Overview' }],
} = Astro.props;

// 1. Strict Server-Side Authorization Check on every admin page
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Ascelstack Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bacasime+Antique&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <!-- Blueprint background canvas overlay -->
    <div class="dash-bg-canvas" aria-hidden="true"></div>

    <div class="dash-layout">
      <!-- ============================================================== -->
      <!-- LEFT SIDEBAR: MINIMAL ADMIN NAVIGATION -->
      <!-- ============================================================== -->
      <aside class="dash-sidebar" data-sidebar>
        <div class="sidebar-top">
          <a href="/admin" class="sidebar-logo" aria-label="Ascelstack Admin" title="Ascelstack Admin">
            <Logo tone="light" size={26} />
          </a>
          <button class="sidebar-close-btn" data-close-sidebar aria-label="Close sidebar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="sidebar-admin-badge">
          <span class="mono admin-badge-tag">ADMINISTRATOR</span>
          <span class="admin-badge-name" title={session.email}>{session.name || session.email}</span>
        </div>

        <nav class="sidebar-nav" aria-label="Admin Navigation">
          <!-- 1. Overview -->
          <a href="/admin" class:list={['nav-item', { 'is-active': activeNav === 'overview' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" />
              <rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" />
            </svg>
            <span>Overview</span>
          </a>

          <!-- 2. Users -->
          <a href="/admin/users" class:list={['nav-item', { 'is-active': activeNav === 'users' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
            <span>Users</span>
          </a>

          <!-- 3. Quotations -->
          <a href="/admin/quotations" class:list={['nav-item', { 'is-active': activeNav === 'quotations' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /><polyline points="10 9 9 9 8 9" />
            </svg>
            <span>Quotations</span>
          </a>

          <!-- 4. Activity Logs -->
          <a href="/admin/logs" class:list={['nav-item', { 'is-active': activeNav === 'logs' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" /><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" />
            </svg>
            <span>Activity Logs</span>
          </a>

          <!-- 5. Settings -->
          <a href="/admin/settings" class:list={['nav-item', { 'is-active': activeNav === 'settings' }]}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3" />
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
            <span>Settings</span>
          </a>
        </nav>

        <!-- Sidebar footer: site link and logout -->
        <div class="sidebar-footer">
          <a href="/" class="nav-item nav-site-item" title="Ascelstack Main Website">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z" />
            </svg>
            <span>Site</span>
          </a>

          <button class="nav-item nav-logout" type="button" data-action="open-admin-logout-modal" aria-label="Sign out">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" />
              <line x1="21" x2="9" y1="12" y2="12" />
            </svg>
            <span>Logout</span>
          </button>
        </div>
      </aside>

      <!-- Sidebar Backdrop for Mobile/Tablet drawer -->
      <div class="dash-sidebar-backdrop" id="sidebar-backdrop" data-close-sidebar aria-hidden="true"></div>

      <!-- ============================================================== -->
      <!-- MAIN CONTAINER: TOPBAR & CONTENT -->
      <!-- ============================================================== -->
      <div class="dash-main-container">
        <!-- Top App Bar -->
        <header class="dash-topbar">
          <div class="topbar-left">
            <button class="topbar-toggle-btn" data-open-sidebar aria-label="Open sidebar menu" title="Open Menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>
            <div class="dash-breadcrumbs">
              <span class="mono bread-root">Admin</span>
              {breadcrumbs.map((crumb, idx) => (
                <>
                  <span class="bread-sep">/</span>
                  {crumb.href ? (
                    <a href={crumb.href} class="bread-link mono">{crumb.label}</a>
                  ) : (
                    <span class="bread-current">{crumb.label}</span>
                  )}
                </>
              ))}
            </div>
          </div>

          <div class="topbar-right">
            <!-- Real-time DB sync indicator badge -->
            <div class="realtime-status-pill" id="realtime-pill" title="Real-time Database Synchronization Active">
              <span class="live-dot" id="realtime-dot"></span>
              <span class="mono live-label" id="realtime-label">LIVE SYNC</span>
            </div>

            <!-- Admin Profile Indicator -->
            <div class="admin-topbar-profile" title={`Authorized Admin: ${session.email}`}>
              {session.avatarUrl ? (
                <img src={session.avatarUrl} alt={session.name} class="admin-avatar-img" />
              ) : (
                <div class="admin-avatar-placeholder mono">
                  {session.name ? session.name[0].toUpperCase() : 'A'}
                </div>
              )}
              <div class="admin-topbar-details">
                <span class="admin-topbar-name">{session.name || 'Administrator'}</span>
                <span class="mono admin-topbar-email">{session.email}</span>
              </div>
            </div>
          </div>
        </header>

        <!-- Dynamic Page Content Slot -->
        <main class="dash-content admin-content">
          <slot />
        </main>
      </div>
    </div>

    <!-- ADMIN LOGOUT CONFIRMATION MODAL -->
    <div class="modal-backdrop" id="modal-admin-logout" hidden>
      <div class="modal-dialog modal-dialog-sm" role="dialog" aria-modal="true" aria-labelledby="modal-logout-title">
        <div class="modal-header">
          <div>
            <span class="mono eyebrow">Admin Session</span>
            <h3 class="display modal-title" id="modal-logout-title">Sign out of Admin?</h3>
          </div>
          <button type="button" class="modal-close-btn" data-close-modal aria-label="Close dialog">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-desc">
          You are currently signed in as <strong>{session.email}</strong>. Logging out will clear your secure administrator session cookie.
        </p>
        <div class="modal-actions modal-actions-logout">
          <button type="button" class="btn btn-ghost" data-close-modal>Stay signed in</button>
          <button type="button" class="btn btn-danger" id="btn-admin-logout-confirm">Sign out</button>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION HUB -->
    <div class="toast-hub" id="admin-toast-hub" aria-live="polite"></div>

    <style is:global>
      /* Shared Admin Layout Styles */
      .admin-body {
        margin: 0;
        background: var(--paper);
        color: var(--text);
        font-family: var(--font-body);
        min-height: 100vh;
      }
      .dash-bg-canvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image:
          linear-gradient(to right, rgba(29, 45, 61, 0.03) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(29, 45, 61, 0.03) 1px, transparent 1px);
        background-size: 32px 32px;
        z-index: 0;
      }
      .dash-layout {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 100vh;
      }
      .dash-sidebar {
        background: var(--ink-deep);
        color: var(--paper);
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        flex-direction: column;
        padding: 1.5rem 1rem;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      .sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-inline: 0.5rem;
        margin-bottom: 1.25rem;
      }
      .sidebar-close-btn {
        display: none;
        background: none;
        border: 0;
        color: var(--text-on-ink-muted);
        cursor: pointer;
        padding: 4px;
      }
      .sidebar-admin-badge {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-s);
        padding: 0.65rem 0.85rem;
        margin-bottom: 1.5rem;
        display: grid;
        gap: 0.2rem;
      }
      .admin-badge-tag {
        font-size: 0.65rem;
        color: var(--tint);
        letter-spacing: 0.1em;
      }
      .admin-badge-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--paper);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        flex: 1;
      }
      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-s);
        color: var(--text-on-ink-muted);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        border: 0;
        background: transparent;
        cursor: pointer;
        width: 100%;
        text-align: left;
      }
      .nav-item:hover {
        background: rgba(255, 255, 255, 0.06);
        color: var(--paper);
      }
      .nav-item.is-active {
        background: var(--ink-raised);
        color: var(--tint);
        border-left: 3px solid var(--accent);
      }
      .nav-item svg {
        flex-shrink: 0;
      }
      .sidebar-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .nav-logout:hover {
        color: #ef4444;
      }
      .dash-main-container {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .dash-topbar {
        height: 64px;
        background: var(--paper);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-inline: clamp(1rem, 3vw, 2rem);
        position: sticky;
        top: 0;
        z-index: 20;
      }
      .topbar-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .topbar-toggle-btn {
        display: none;
        background: none;
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        padding: 6px;
        color: var(--ink);
        cursor: pointer;
      }
      .dash-breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
      }
      .bread-root {
        color: var(--text-muted);
        font-size: 0.8rem;
        background: var(--paper-sunk);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
      }
      .bread-sep {
        color: var(--text-muted);
      }
      .bread-link {
        color: var(--text-muted);
        text-decoration: none;
      }
      .bread-link:hover {
        color: var(--ink);
        text-decoration: underline;
      }
      .bread-current {
        font-weight: 600;
        color: var(--ink);
      }
      .topbar-right {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .realtime-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.3rem 0.75rem;
        font-size: 0.72rem;
        color: var(--text-muted);
      }
      .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
        animation: pulseLive 2s infinite ease-in-out;
      }
      .live-dot.dot-syncing {
        background: var(--accent);
        box-shadow: 0 0 8px rgba(89, 128, 166, 0.6);
      }
      @keyframes pulseLive {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(0.85); opacity: 0.6; }
      }
      .admin-topbar-profile {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }
      .admin-avatar-img,
      .admin-avatar-placeholder {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--line);
        flex-shrink: 0;
      }
      .admin-avatar-placeholder {
        background: var(--ink);
        color: var(--paper);
        display: grid;
        place-items: center;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .admin-topbar-details {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
      }
      .admin-topbar-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--ink);
      }
      .admin-topbar-email {
        font-size: 0.7rem;
        color: var(--text-muted);
      }
      .dash-content {
        padding: clamp(1.25rem, 3vw, 2.25rem);
        flex: 1;
      }

      /* Responsive rules */
      @media (max-width: 1024px) {
        .dash-layout { grid-template-columns: 1fr; }
        .dash-sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          width: min(280px, 80vw);
          z-index: 50;
          transform: translateX(-100%);
          transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .dash-sidebar.is-open { transform: translateX(0); }
        .sidebar-close-btn, .topbar-toggle-btn { display: inline-flex; }
        .dash-sidebar-backdrop {
          position: fixed;
          inset: 0;
          background: rgba(20, 33, 48, 0.5);
          backdrop-filter: blur(4px);
          z-index: 40;
          display: none;
        }
        .dash-sidebar-backdrop.is-open { display: block; }
        .admin-topbar-details { display: none; }
      }
    </style>

    <script>
      // Sidebar mobile drawer toggles
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openBtn = document.querySelector('[data-open-sidebar]');
      const closeBtns = document.querySelectorAll('[data-close-sidebar]');

      function toggleSidebar(open: boolean) {
        sidebar?.classList.toggle('is-open', open);
        backdrop?.classList.toggle('is-open', open);
      }

      openBtn?.addEventListener('click', () => toggleSidebar(true));
      closeBtns.forEach((btn) => btn.addEventListener('click', () => toggleSidebar(false)));

      // Logout Modal Handling
      const logoutModal = document.getElementById('modal-admin-logout');
      const openLogoutBtn = document.querySelector('[data-action="open-admin-logout-modal"]');
      const closeLogoutBtns = logoutModal?.querySelectorAll('[data-close-modal]');
      const confirmLogoutBtn = document.getElementById('btn-admin-logout-confirm');

      openLogoutBtn?.addEventListener('click', () => {
        if (logoutModal) logoutModal.hidden = false;
      });

      closeLogoutBtns?.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (logoutModal) logoutModal.hidden = true;
        });
      });

      confirmLogoutBtn?.addEventListener('click', async () => {
        try {
          await fetch('/api/admin/auth/logout', { method: 'POST' });
          window.location.href = '/admin/login';
        } catch {
          window.location.href = '/admin/login';
        }
      });

      // Global Toast Notification System for Admin Panel
      (window as any).showAdminToast = (message: string, type: 'success' | 'error' | 'info' = 'success') => {
        const hub = document.getElementById('admin-toast-hub');
        if (!hub) return;
        const toast = document.createElement('div');
        toast.className = `toast-item toast-${type}`;
        toast.innerHTML = `
          <div class="toast-content">
            <span class="toast-icon">
              ${type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ'}
            </span>
            <span>${message}</span>
          </div>
          <button type="button" class="toast-close" aria-label="Close">×</button>
        `;
        toast.querySelector('.toast-close')?.addEventListener('click', () => toast.remove());
        hub.appendChild(toast);
        setTimeout(() => {
          toast.classList.add('is-leaving');
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      };

      // Real-Time Database Synchronization Heartbeat
      let lastKnownHash = '';
      async function checkSync() {
        try {
          const res = await fetch('/api/admin/sync');
          if (res.ok) {
            const data = await res.json();
            if (lastKnownHash && data.versionHash && lastKnownHash !== data.versionHash) {
              // Database was updated! Dispatch custom event for active views to update without full refresh
              window.dispatchEvent(new CustomEvent('asc:db-sync', { detail: data }));
            }
            lastKnownHash = data.versionHash;
          }
        } catch (e) {
          // silently handle transient network blips
        }
      }

      // Poll sync every 6 seconds as a background heartbeat
      setInterval(checkSync, 6000);
      checkSync();
    </script>
  </body>
</html>
