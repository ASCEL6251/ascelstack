  .pj-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2.25rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
    padding: clamp(3rem, 6vw, 5rem) clamp(0.5rem, 3vw, 3rem) 0;
  }
  .pj-feat { display: grid; gap: 0.6rem; align-content: start; }
  .pj-ico { width: 34px; height: 34px; color: var(--accent); margin-bottom: 0.75rem; }
  .pj-ico svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .pj-feat h3 { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; color: var(--ink); }
  .pj-feat p { color: var(--text-muted); font-size: 0.98rem; max-width: 34ch; }

  /* ─── CTA ─── */
  .pj-cta-in { display: grid; justify-items: center; text-align: center; gap: 1.5rem; }
  .pj-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }

  /* ─── Responsive ─── */
  @media (max-width: 960px) {
    .pj-item,
    .pj-item:nth-child(even) { grid-template-columns: 1fr; }
    .pj-item:nth-child(even) .pj-shot { order: 0; }
    .pj-feature-meta { grid-template-columns: 1fr; gap: 1rem; }
    .pj-feature-meta .btn { justify-self: start; }
    .pj-features { grid-template-columns: repeat(2, 1fr); }
    .pj-bento { grid-template-columns: 1fr; }
    .pj-bento { min-height: 0; }
    .pj-globe { min-height: clamp(340px, 70vw, 520px); }
    .pj-globe-canvas { width: min(125cqw, 640px); height: min(125cqw, 640px); right: -25%; top: auto; bottom: -22%; }
  }
  @media (max-width: 600px) {
    .pj-features { grid-template-columns: 1fr; }
    .pj-info { grid-template-columns: 1fr; gap: 0.5rem; }
    .pj-strip { top: 2.5rem; padding-block: 1.75rem; }
    .pj-frame::before,
    .pj-frame::after { display: none; }
    .pj-features { padding-inline: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-strip-track { animation: none; }
  }
</style>

<script>
  import { gsap, reducedMotion, getLenis } from '../scripts/motion';

  function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero || reducedMotion) return;

    const words = hero.querySelectorAll<HTMLElement>('.pj-wi');
    const fades = hero.querySelectorAll<HTMLElement>('[data-hero-fade]');
    const chips = [...hero.querySelectorAll<HTMLElement>('[data-chip]')];
    const canvases = [...hero.querySelectorAll<HTMLCanvasElement>('[data-3d]')];

    // ── Intro: headline rises word by word, then the stack objects arrive.
    const intro = gsap.timeline({ defaults: { ease: 'expo.out' } });
    intro
      .fromTo(words, { y: 0, yPercent: 110 }, { y: 0, yPercent: 0, duration: 1.1, stagger: 0.055 }, 0.05)
      .to('[data-underline]', { scaleX: 1, duration: 0.9, ease: 'power3.inOut' }, 0.7)
      .fromTo(fades, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.1 }, 0.65)
      .fromTo(
        chips,
        { opacity: 0, scale: 0.6, y: 20 },
        {
          opacity: 1,
          scale: 1,
          y: 0,
          duration: 0.9,
          ease: 'back.out(1.8)',
          stagger: { each: 0.07, from: 'random' },
          onComplete: () => chips.forEach((c) => c.classList.add('is-idle')),
        },
        0.5,
      )
      .fromTo(canvases, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.2, stagger: 0.15 }, 0.8);

    // ── Scroll: chips drift away at their own speeds; 3D layers pull apart.
    const scroll = gsap.timeline({
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom 20%', scrub: 0.8 },
    });
    chips.forEach((c) => {
      const speed = Number(c.dataset.speed || 1);
      const left = parseFloat(c.style.getPropertyValue('--x')) < 50;
      scroll.to(
        c,
        { y: -140 * speed, x: (left ? -40 : 40) * speed, opacity: 0, rotate: (left ? -8 : 8) * speed, ease: 'none', duration: 1 },
        0,
      );
    });
    scroll.to(hero.querySelector('.pj-title'), { y: -40, ease: 'none', duration: 1 }, 0);
    scroll.to(canvases, { y: -50, ease: 'none', duration: 1 }, 0);

    // 3D only on wide screens, loaded when needed (three.js is a separate chunk).
    if (!window.matchMedia('(min-width: 1101px)').matches) return;
    const slabsCanvas = hero.querySelector<HTMLCanvasElement>('[data-3d="slabs"]');
    const markCanvas = hero.querySelector<HTMLCanvasElement>('[data-3d="mark"]');

    if (slabsCanvas) {
      import('../scripts/hero-slabs').then(({ createSlabs }) => {
        const slabs = createSlabs(slabsCanvas);
        if (!slabs) return;
        gsap.fromTo(slabs.state, { scale: 0.6 }, { scale: 1, duration: 1.4, ease: 'expo.out', delay: 0.6 });
        scroll.to(slabs.state, { spread: 1, spin: 1, ease: 'none', duration: 1 }, 0);
      });
    }

    if (markCanvas) {
      import('../scripts/stack-scene').then(({ createStack }) => {
        const mark = createStack(markCanvas);
        if (!mark) return;
        mark.state.scale = 0.95;
        // Slow turn so the extrusion depth reads; layers fan apart on scroll.
        gsap.to(mark.group.rotation, { y: Math.PI * 2, duration: 22, ease: 'none', repeat: -1 });
        gsap.from(mark.group.scale, { x: 0.6, y: 0.6, z: 0.6, duration: 1.4, ease: 'expo.out', delay: 0.7 });
        const [top, mid, base] = mark.layers;
        scroll
          .to(top.position, { y: 0.9, z: 0.4, ease: 'none', duration: 1 }, 0)
          .to(mid.position, { z: 0.15, ease: 'none', duration: 1 }, 0)
          .to(base.position, { y: -0.7, z: -0.3, ease: 'none', duration: 1 }, 0);
      });
    }
  }

  initHero();

  function initProjects() {
    if (reducedMotion) return;

    // Featured card tilts back like a laptop lid, then flattens as it scrolls in.
    const feature = document.querySelector<HTMLElement>('[data-feature]');
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (feature && stage) {
      gsap.fromTo(
        feature,
        { rotateX: 32, scale: 0.88, y: 40 },
        {
          rotateX: 0,
          scale: 1,
          y: 0,
          ease: 'none',
          scrollTrigger: { trigger: stage, start: 'top 95%', end: 'top 25%', scrub: 0.6 },
        },
      );
    }

    // Each project screenshot opens from a clipped window and settles its zoom.
    document.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
      const shot = item.querySelector<HTMLElement>('[data-shot]');
      const inner = item.querySelector<HTMLElement>('[data-shot-inner]');
      if (!shot || !inner) return;
      const tl = gsap.timeline({
        scrollTrigger: { trigger: item, start: 'top 90%', end: 'top 35%', scrub: 0.6 },
      });
      tl.fromTo(
        shot,
        { clipPath: 'inset(14% 10% 14% 10% round 28px)', y: 60 },
        { clipPath: 'inset(0% 0% 0% 0% round 16px)', y: 0, ease: 'none' },
        0,
      ).fromTo(inner, { scale: 1.18 }, { scale: 1, ease: 'none' }, 0);
    });
  }

  initProjects();

  // ── Featured card: auto-advances through every project; strip thumbs stay in sync.
  (() => {
    const dataEl = document.getElementById('pj-slides');
    const card = document.querySelector<HTMLAnchorElement>('[data-feature]');
    if (!dataEl || !card) return;
    type Slide = { slug: string; name: string; meta: string; summary: string; url: string | null; host: string };
    const slides: Slide[] = JSON.parse(dataEl.textContent || '[]');
    const imgs = [...card.querySelectorAll<HTMLImageElement>('[data-slide]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-goto]')];
    const bar = card.querySelector<HTMLElement>('[data-f-bar]');
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const urlEl = $('[data-f-url]');
    const catEl = $('[data-f-cat]');
    const nameEl = $('[data-f-name]');
    const sumEl = $('[data-f-sum]');
    const btn = $<HTMLAnchorElement>('[data-f-btn]');
    const btnLabel = $('[data-f-btn-label]');
    const btnArrow = $('[data-f-btn-arrow]');
    const swaps = [...document.querySelectorAll<HTMLElement>('.pj-swap')];
    const thumbs = [...document.querySelectorAll<HTMLAnchorElement>('.pj-thumb')];

    const DURATION = 4.5; // seconds per project
    let index = 0;
    let swapTimer = 0;

    const setLink = (a: HTMLAnchorElement, s: Slide) => {
      a.href = s.url ?? `#${s.slug}`;
      if (s.url) {
        a.target = '_blank';
        a.rel = 'noopener';
      } else {
        a.removeAttribute('target');
        a.removeAttribute('rel');
      }
    };

    function show(i: number) {
      index = (i + slides.length) % slides.length;
      const s = slides[index];
      imgs.forEach((img, n) => img.classList.toggle('is-on', n === index));
      dots.forEach((d, n) => d.setAttribute('aria-selected', String(n === index)));
      thumbs.forEach((t) => {
        const h = t.getAttribute('href');
        t.classList.toggle('is-current', h === (s.url ?? `#${s.slug}`));
      });
      setLink(card, s);
      setLink(btn, s);
      urlEl.style.opacity = '0';
      swaps.forEach((el) => el.classList.add('is-out'));
      clearTimeout(swapTimer);
      swapTimer = window.setTimeout(() => {
        urlEl.textContent = s.host;
        catEl.textContent = s.meta;
        nameEl.textContent = s.name;
        sumEl.textContent = s.summary;
        btnLabel.textContent = s.url ? 'Visit site' : 'View project';
        btnArrow.textContent = s.url ? '↗' : '↓';
        urlEl.style.opacity = '1';
        swaps.forEach((el) => el.classList.remove('is-out'));
      }, 300);
      restartTimer();
    }

    // Progress bar doubles as the timer, so pausing it pauses the rotation.
    let tween: gsap.core.Tween | null = null;
    function restartTimer() {
      tween?.kill();
      if (!bar) return;
      tween = gsap.fromTo(
        bar,
        { scaleX: 0 },
        { scaleX: 1, duration: DURATION, ease: 'none', onComplete: () => show(index + 1) },
      );
      if (paused || !inView) tween.pause();
    }

    let paused = false;
    let inView = true;
    const pause = () => {
      paused = true;
      tween?.pause();
    };
    const resume = () => {
      paused = false;
      if (inView) tween?.resume();
    };

    if (reducedMotion) {
      show(0);
      tween?.kill();
    } else {
      show(0);
      card.addEventListener('mouseenter', pause);
      card.addEventListener('mouseleave', resume);
      card.addEventListener('focusin', pause);
      card.addEventListener('focusout', resume);
      new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        if (inView && !paused) tween?.resume();
        else tween?.pause();
      }).observe(card);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) tween?.pause();
        else if (inView && !paused) tween?.resume();
      });
    }

    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.goto))));

    // Hovering a strip card previews it in the big card.
    thumbs.forEach((t) => {
      t.addEventListener('mouseenter', () => {
        const h = t.getAttribute('href');
        const n = slides.findIndex((s) => (s.url ?? `#${s.slug}`) === h);
        if (n >= 0 && n !== index) show(n);
        pause();
      });
      t.addEventListener('mouseleave', resume);
    });

    // In-page project links in the card and button glide like the strip does.
    [card, btn].forEach((a) =>
      a.addEventListener('click', (e) => {
        const h = a.getAttribute('href');
        if (!h?.startsWith('#')) return;
        const target = document.querySelector<HTMLElement>(h);
        if (!target) return;
        e.preventDefault();
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(target, { offset: -100, duration: 1.4 });
        else target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth' });
      }),
    );
  })();

  // Strip thumbnails that point at a project on this page glide to it.
  document.querySelectorAll<HTMLAnchorElement>('.pj-thumb[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const target = document.querySelector<HTMLElement>(a.getAttribute('href')!);
      if (!target) return;
      e.preventDefault();
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(target, { offset: -100, duration: 1.4 });
      else target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', a.getAttribute('href'));
    });
  });

  // Earth loads only when its card is near the viewport, and pauses off-screen.
  const globeCanvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (globeCanvas && 'IntersectionObserver' in window) {
    let globe: import('../scripts/earth-globe').Globe | null | undefined;
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (entry.isIntersecting) {
          if (globe === undefined) {
            const { createGlobe } = await import('../scripts/earth-globe');
            globe = createGlobe(globeCanvas, { animate: !reducedMotion });
            if (globe) globeCanvas.classList.add('is-live');
          }
          globe?.start();
        } else {
          globe?.stop();
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(globeCanvas);
  }
</script>
