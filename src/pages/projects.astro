---
import Base from '../layouts/Base.astro';
import { projects, featuredProject } from '../data/projects';

const featured = featuredProject;
const rest = projects.filter((p) => p !== featured);
// The big card cycles through every project, featured one first.
const slides = [featured, ...rest];
// Strip behind the featured card: every project, repeated so the loop is seamless.
const strip = [...projects, ...projects];

const host = (url?: string) => (url ? new URL(url).hostname.replace(/^www\./, '') : 'concept.ascelstack.com');
const linkOf = (p: (typeof projects)[number]) => p.url ?? `#${p.slug}`;
const slideData = slides.map((p) => ({
  slug: p.slug,
  name: p.name,
  meta: `${p.category} · ${p.year}`,
  summary: p.summary,
  url: p.url ?? null,
  host: host(p.url),
}));

// Hero headline, split into words so each can rise from its own mask.
const titleBefore = "We've built for some of the".split(' ');
const titleAccent = ['best', 'teams'];
const titleAfter = 'around the world.'.split(' ');

// Tech chips scattered round the headline. x/y are % of the hero; speed drives scroll parallax.
const chips = [
  { label: 'React', x: 6, y: 14, color: '#61dafb', speed: 1.4, bob: 6 },
  { label: 'TypeScript', x: 15, y: 34, color: '#3178c6', speed: 0.8, bob: 7 },
  { label: 'Figma', x: 3, y: 50, color: '#a259ff', speed: 1.1, bob: 5.5 },
  { label: 'Postgres', x: 87, y: 12, color: '#336791', speed: 1.2, bob: 6.5 },
  { label: 'Astro', x: 95, y: 30, color: '#ff5d01', speed: 0.9, bob: 5 },
  { label: 'Node.js', x: 82, y: 42, color: '#5fa04e', speed: 1.5, bob: 7.5 },
  { label: 'Cloudflare', x: 22, y: 8, color: '#f38020', speed: 0.7, bob: 6 },
  { label: 'Next.js', x: 76, y: 6, color: '#1d1f20', speed: 1.3, bob: 5.8 },
];

const features = [
  {
    title: 'Web design and development',
    body: 'We design and build with love, care and attention to detail.',
    icon: 'browser',
  },
  {
    title: 'Mobile responsive',
    body: 'Every page is tested on phones, tablets and wide screens before it ships.',
    icon: 'device',
  },
  {
    title: 'Dark and light mode',
    body: 'Accessible contrast and a look that holds up in both themes.',
    icon: 'theme',
  },
  {
    title: 'Latest tech stack',
    body: 'Modern, typed, fast frameworks — chosen for your problem, not for hype.',
    icon: 'stack',
  },
  {
    title: 'Regular updates',
    body: 'Weekly progress, shared previews and one channel to reach the team.',
    icon: 'chat',
  },
  {
    title: 'Built to keep improving',
    body: 'Clean code and a CMS where it helps, so the next change is cheap.',
    icon: 'future',
  },
];

---

<Base
  title="Our Projects"
  description="Selected websites, apps and platforms designed and built by Ascelstack — from consumer web apps to SaaS dashboards and e-commerce."
>
  <div class="pj">
    <!-- ─────────────── Hero ─────────────── -->
    <section class="pj-hero" data-hero>
      <div class="wrap pj-frame">
        <!-- Stack objects around the headline. Decorative only. -->
        <div class="pj-art" aria-hidden="true">
          {chips.map((c) => (
            <span
              class="pj-chip"
              data-chip
              data-speed={c.speed}
              style={`--x:${c.x}%;--y:${c.y}%;--c:${c.color};--bob:${c.bob}s`}
            >
              <i></i>{c.label}
            </span>
          ))}

          <canvas class="pj-3d pj-3d-left" data-3d="slabs"></canvas>
          <canvas class="pj-3d pj-3d-right" data-3d="mark"></canvas>
        </div>

        <h1 class="pj-title">
          {titleBefore.map((w) => (
            <>
              <span class="pj-w"><span class="pj-wi">{w}</span></span>{' '}
            </>
          ))}
          <span class="pj-accent">
            {titleAccent.map((w, i) => (
              <>
                <span class="pj-w"><span class="pj-wi">{w}</span></span>{i < titleAccent.length - 1 ? ' ' : ''}
              </>
            ))}
            <span class="pj-underline" data-underline></span>
          </span>{' '}
          {titleAfter.map((w) => (
            <>
              <span class="pj-w"><span class="pj-wi">{w}</span></span>{' '}
            </>
          ))}
        </h1>
        <p class="pj-lead" data-hero-fade>
          Websites, products and internal tools — <strong>designed, built and kept running by one team.</strong> Scroll to see the work.
        </p>
        <span class="pj-scroll-cue" data-hero-fade aria-hidden="true"><i></i></span>
      </div>
    </section>

    <!-- ─────────────── Featured showcase ─────────────── -->
    <section class="pj-show" aria-label={`Featured project: ${featured.name}`}>
      <div class="pj-strip">
        <div class="pj-strip-track">
          {strip.map((p, i) => {
            // Second half only exists to make the loop seamless: hide it from AT and tab order.
            const clone = i >= projects.length;
            return (
              <a
                class="pj-thumb"
                href={p.url ?? `#${p.slug}`}
                target={p.url ? '_blank' : undefined}
                rel={p.url ? 'noopener' : undefined}
                aria-label={clone ? undefined : `${p.name} — ${p.category}`}
                aria-hidden={clone ? 'true' : undefined}
                tabindex={clone ? -1 : undefined}
              >
                <img src={p.image} alt="" loading="lazy" width="1440" height="900" />
                <span class="pj-thumb-tag">
                  {p.name} <span aria-hidden="true">{p.url ? '↗' : '↓'}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>

      <div class="pj-stage" data-stage>
        <a
          class="pj-feature"
          data-feature
          href={linkOf(featured)}
          target={featured.url ? '_blank' : undefined}
          rel={featured.url ? 'noopener' : undefined}
        >
          <div class="pj-chrome">
            <span class="pj-dots"><i></i><i></i><i></i></span>
            <span class="pj-url mono" data-f-url>{host(featured.url)}</span>
          </div>
          <div class="pj-screens">
            {slides.map((p, i) => (
              <img
                src={p.image}
                alt={`${p.name} home page`}
                width="1440"
                height="900"
                loading={i === 0 ? 'eager' : 'lazy'}
                class={i === 0 ? 'is-on' : undefined}
                data-slide={i}
              />
            ))}
          </div>
          <div class="pj-progress" aria-hidden="true"><i data-f-bar></i></div>
        </a>
        <div class="pj-pager" role="tablist" aria-label="Featured projects">
          {slides.map((p, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={p.name}
              data-goto={i}
            ></button>
          ))}
        </div>
      </div>

      <div class="wrap pj-feature-meta" data-reveal aria-live="polite">
        <div class="pj-swap" data-f-swap>
          <span class="mono pj-cat" data-f-cat>{featured.category} · {featured.year}</span>
          <h2 class="pj-fname" data-f-name>{featured.name}</h2>
        </div>
        <p class="pj-swap" data-f-sum>{featured.summary}</p>
        <a
          href={linkOf(featured)}
          target={featured.url ? '_blank' : undefined}
          rel={featured.url ? 'noopener' : undefined}
          class="btn"
          data-f-btn
        >
          <span data-f-btn-label>{featured.url ? 'Visit site' : 'View project'}</span>
          <span class="arrow" data-f-btn-arrow>{featured.url ? '↗' : '↓'}</span>
        </a>
      </div>
      <script type="application/json" id="pj-slides" set:html={JSON.stringify(slideData)} />
    </section>

    <!-- ─────────────── Project list ─────────────── -->
    <section class="section pj-list-sec">
      <div class="wrap">
        <div class="pj-list-head">
          <p class="eyebrow" data-reveal>Selected work</p>
          <h2 class="pj-h2" data-reveal>
            Shipped, live and <span class="pj-accent">still growing.</span>
          </h2>
        </div>

        <div class="pj-list">
          {rest.map((p, i) => (
            <article class="pj-item" id={p.slug} data-item>
              <div class="pj-shot" data-shot>
                <div class="pj-shot-inner" data-shot-inner>
                  <img src={p.image} alt={`${p.name} screen`} loading="lazy" width="1440" height="900" />
                </div>
                {p.demo && <span class="pj-badge mono">Concept</span>}
              </div>
              <div class="pj-info">
                <span class="mono pj-idx">{String(i + 2).padStart(2, '0')}</span>
                <div class="pj-info-body">
                  <span class="mono pj-cat" data-reveal>{p.category} · {p.year}</span>
                  <h3 class="pj-iname" data-reveal>{p.name}</h3>
                  <p class="pj-sum" data-reveal>{p.summary}</p>
                  <ul class="pj-chips" data-reveal>
                    {p.services.map((s) => <li>{s}</li>)}
                  </ul>
                  <p class="mono pj-stack" data-reveal>{p.stack.join(' · ')}</p>
                  {p.url && (
                    <a href={p.url} target="_blank" rel="noopener" class="pj-link" data-reveal>
                      Visit site <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        <p class="pj-more mono" data-reveal>More case studies are on the way.</p>
      </div>
    </section>

    <!-- ─────────────── Bento: everything web ─────────────── -->
    <section class="pj-web">
      <div class="wrap pj-frame">
        <div class="pj-bento" data-reveal>
          <div class="pj-bento-copy">
            <h2 class="pj-bento-title">Anything and everything web</h2>
            <p>
              We take care of deployments, hosting, maintenance, revisions, design systems and everything else in
              between.
            </p>
            <div class="pj-trust">
              <strong>One team from first sketch to launch day — and after.</strong>
              <div class="pj-avatars" aria-hidden="true">
                <span>B</span><span>G</span><span>R</span><span>+</span>
              </div>
            </div>
          </div>

          <div class="pj-globe" aria-hidden="true">
            <canvas class="pj-globe-canvas" data-globe></canvas>
          </div>
        </div>

        <div class="pj-features">
          {features.map((f, i) => (
            <div class="pj-feat" data-reveal data-reveal-delay={(i % 3) * 0.08}>
              <span class="pj-ico">
                {f.icon === 'browser' && (
                  <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2.5" /><path d="M3 9h18M6.5 6.6h.01M9 6.6h.01M11.5 6.6h.01" /></svg>
                )}
                {f.icon === 'device' && (
                  <svg viewBox="0 0 24 24"><rect x="3" y="4" width="15" height="11" rx="2" /><path d="M8 19h6M11 15v4M16 4.5l2 2 3.5-4" /></svg>
                )}
                {f.icon === 'theme' && (
                  <svg viewBox="0 0 24 24"><path d="M7 18a4 4 0 0 1-.5-7.97A5.5 5.5 0 0 1 17 9.5a4.25 4.25 0 0 1 .25 8.5Z" /><path d="M5 3v1.5M2 6h1.5M2.9 3.9l1 1" /></svg>
                )}
                {f.icon === 'stack' && (
                  <svg viewBox="0 0 24 24"><rect x="4" y="3" width="6" height="18" rx="2.5" /><rect x="14" y="3" width="6" height="7" rx="2" /><rect x="14" y="14" width="6" height="7" rx="2" /></svg>
                )}
                {f.icon === 'chat' && (
                  <svg viewBox="0 0 24 24"><path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 4v-4H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" /><path d="M8 9h8M8 12.5h5" /></svg>
                )}
                {f.icon === 'future' && (
                  <svg viewBox="0 0 24 24"><path d="M12 20.5 4.6 13.2a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9a4.6 4.6 0 0 1 6.5 6.5Z" /><path d="M9 12.5 12 9l3 3.5" /></svg>
                )}
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─────────────── CTA ─────────────── -->
    <section class="section on-ink pj-cta">
      <div class="wrap pj-cta-in">
        <p class="eyebrow" data-reveal>Your project next</p>
        <h2 class="display h2" data-reveal>Have something worth <em>building?</em></h2>
        <div class="pj-cta-actions" data-reveal>
          <a href="/contact" class="btn">Start a project <span class="arrow">→</span></a>
          <a href="/services" class="btn btn-ghost">Browse services</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .pj {
    --pj-dot: color-mix(in srgb, var(--ink) 28%, transparent);
    --pj-grid: color-mix(in srgb, var(--ink) 5%, transparent);
    --pj-card: #fff;
    --pj-shadow: 0 30px 80px -20px rgba(29, 45, 61, 0.28), 0 8px 24px -8px rgba(29, 45, 61, 0.12);
    overflow-x: clip;
  }

  /* Dotted side rails, like a ruled canvas */
  .pj-frame { position: relative; }
  .pj-frame::before,
  .pj-frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 2px dotted var(--pj-dot);
    pointer-events: none;
  }
  .pj-frame::before { left: calc(var(--gutter) * 0.5); }
  .pj-frame::after { right: calc(var(--gutter) * 0.5); }

  .pj-accent { color: var(--accent); }

  /* ─── Hero ─── */
  .pj-hero { padding-top: calc(var(--nav-h) + clamp(3.5rem, 2rem + 6vw, 7rem)); }
  .pj-hero .pj-frame {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.25rem;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    min-height: clamp(380px, 32vw, 520px);
    align-content: center;
  }
  .pj-hero .pj-frame > :not(.pj-art) { position: relative; z-index: 1; }
  .pj-hero .pj-frame::before,
  .pj-hero .pj-frame::after { display: none; }

  /* Headline words rise out of their own clip box */
  .pj-w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .pj-wi { display: inline-block; will-change: transform; }
  .pj-accent { position: relative; display: inline-block; }
  /* Hero accent: the site's serif italic, in a brand gradient */
  .pj-title .pj-accent {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: -0.01em;
    padding-inline: 0.04em 0.08em;
  }
  .pj-title .pj-accent .pj-wi {
    background: linear-gradient(100deg, var(--accent) 0%, #7fa6cc 45%, var(--ink) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: pj-sheen 6s ease-in-out infinite alternate;
  }
  /* Italic glyphs overhang their box; give the clip mask room so nothing gets cut */
  .pj-title .pj-accent .pj-w { padding-right: 0.08em; margin-right: -0.08em; }
  @keyframes pj-sheen { to { background-position: 100% 0; } }
  .pj-lead strong { color: var(--ink); font-weight: 600; }
  .pj-underline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.055em;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--tint), var(--accent));
    transform-origin: left;
  }

  /* Pre-animation state only when JS + motion are available (no flash, no-JS safe) */
  :global(html.js) .pj-wi { transform: translateY(110%); }
  :global(html.js) .pj-underline { transform: scaleX(0); }
  :global(html.js) [data-hero-fade],
  :global(html.js) .pj-chip,
  :global(html.js) .pj-3d { opacity: 0; }

  .pj-scroll-cue {
    width: 22px;
    height: 34px;
    margin-top: 0.75rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 6px;
  }
  .pj-scroll-cue i {
    width: 3px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    animation: pj-cue 1.8s var(--ease-out) infinite;
  }
  @keyframes pj-cue {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { opacity: 0; }
  }

  /* Decorative layer */
  .pj-art { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .pj-chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem 0.45rem 0.6rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 10px 24px -14px rgba(29, 45, 61, 0.45);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }
  .pj-chip i { width: 9px; height: 9px; border-radius: 3px; background: var(--c); }
  .pj-chip.is-idle { animation: pj-bob var(--bob) ease-in-out infinite; }
  @keyframes pj-bob { 50% { translate: -50% -8px; } }

  /* 3D objects: slabs (Build · Grow · Run) left, the layered mark right */
  .pj-3d {
    position: absolute;
    bottom: -4%;
    width: clamp(180px, 17vw, 260px);
    height: clamp(200px, 19vw, 290px);
    translate: -50% 0;
  }
  .pj-3d-left { left: 10%; }
  .pj-3d-right { left: 89%; }

  @media (max-width: 1100px) {
    .pj-3d { display: none; }
  }
  @media (max-width: 860px) {
    .pj-chip { font-size: 0.7rem; padding: 0.35rem 0.6rem 0.35rem 0.5rem; }
    .pj-chip:nth-child(n + 5) { display: none; }
  }
  @media (max-width: 600px) {
    .pj-art { display: none; }
    .pj-hero .pj-frame { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .pj-wi,
    :global(html.js) .pj-underline { transform: none; }
    .pj-title .pj-accent .pj-wi { animation: none; }
    :global(html.js) [data-hero-fade],
    :global(html.js) .pj-chip,
    :global(html.js) .pj-3d { opacity: 1; }
    .pj-scroll-cue i { animation: none; }
  }
  .pj-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 18ch;
    color: var(--ink);
  }
  .pj-lead {
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  /* ─── Showcase ─── */
  .pj-show {
    position: relative;
    padding-block: clamp(1rem, 4vw, 3rem) clamp(3rem, 6vw, 6rem);
    background-image:
      linear-gradient(var(--pj-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--pj-grid) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
  }
  .pj-strip {
    position: absolute;
    inset-inline: 0;
    top: clamp(4rem, 11vw, 10rem);
    padding-block: 2.25rem;
    border-block: 2px dotted var(--pj-dot);
    overflow: hidden;
  }
  /* Pause the loop while someone is pointing at or tabbing through it. */
  .pj-strip:hover .pj-strip-track,
  .pj-strip:focus-within .pj-strip-track { animation-play-state: paused; }
  .pj-strip-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: pj-marquee 60s linear infinite;
  }
  .pj-thumb {
    position: relative;
    display: block;
    flex: none;
    width: clamp(130px, 12vw, 190px);
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--pj-card);
    box-shadow: 0 8px 22px -12px rgba(29, 45, 61, 0.3);
    border: 1px solid var(--line);
    transform: translateZ(0);
    transition:
      transform 0.55s var(--ease-out),
      box-shadow 0.55s var(--ease-out),
      border-color 0.3s;
  }
  .pj-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.8s var(--ease-out);
  }
  .pj-thumb-tag {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.4rem 0.6rem 0.45rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(to top, rgba(20, 33, 48, 0.85), transparent);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s, transform 0.45s var(--ease-out);
  }
  .pj-thumb:hover,
  .pj-thumb:focus-visible {
    z-index: 2;
    transform: translateY(-8px) scale(1.22);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow: 0 24px 44px -16px rgba(29, 45, 61, 0.5);
  }
  .pj-thumb:hover img,
  .pj-thumb:focus-visible img { transform: scale(1.06); }
  .pj-thumb:hover .pj-thumb-tag,
  .pj-thumb:focus-visible .pj-thumb-tag { opacity: 1; transform: none; }
  .pj-thumb:active { transform: translateY(-4px) scale(1.14); transition-duration: 0.15s; }
  @keyframes pj-marquee { to { transform: translateX(-50%); } }

  .pj-stage {
    position: relative;
    z-index: 1;
    perspective: 1200px;
    width: min(100% - 2 * var(--gutter), 600px);
    margin-inline: auto;
  }
  .pj-feature {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    background: var(--pj-card);
