---
import Base from '../layouts/Base.astro';
import { coreCategories, services } from '../data/catalog';

const lookup = Object.fromEntries(services.map((s) => [s.id, { name: s.name, cat: s.category }]));
const catSlugs = Object.fromEntries(coreCategories.map((c) => [c.name, c.slug]));
---

<Base title="Start a project" description="Tell Ascelstack what you want to build, grow or automate.">
  <section class="contact">
    <div class="wrap contact-grid">
      <div class="contact-side">
        <p class="eyebrow" data-reveal>Start a project</p>
        <h1 class="display h1" data-reveal>Tell us where <em>it hurts.</em></h1>
        <p class="lead" data-reveal>
          A missing website, a team buried in spreadsheets, a licence you haven't filed. Describe it in your own words.
          We reply within one working day.<span class="temp"></span>
        </p>
        <dl class="contact-direct" data-reveal>
          <div><dt class="mono">Email</dt><dd><a href="mailto:hello@ascelstack.com" class="temp">hello@ascelstack.com</a></dd></div>
          <div><dt class="mono">Hours</dt><dd class="temp">Mon–Sat, 10:00–19:00 IST</dd></div>
        </dl>
      </div>

      <form class="form" data-form novalidate>
        <div class="form-picked" data-picked hidden>
          <span class="mono">Enquiring about</span>
          <strong data-picked-name></strong>
          <input type="hidden" name="service" data-picked-input />
          <button type="button" class="picked-clear" data-picked-clear aria-label="Remove selected service">×</button>
        </div>

        <fieldset class="field">
          <legend class="mono">What do you need?</legend>
          <div class="chips">
            {
              coreCategories.map((c) => (
                <label class="chip">
                  <input type="checkbox" name="areas" value={c.slug} />
                  <span>{c.short}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="row">
          <label class="field">
            <span class="mono">Name</span>
            <input name="name" required autocomplete="name" />
          </label>
          <label class="field">
            <span class="mono">Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
        </div>
        <div class="row">
          <label class="field">
            <span class="mono">Phone / WhatsApp <em>optional</em></span>
            <input name="phone" type="tel" autocomplete="tel" />
          </label>
          <label class="field">
            <span class="mono">Business name <em>optional</em></span>
            <input name="company" autocomplete="organization" />
          </label>
        </div>
        <label class="field">
          <span class="mono">Budget</span>
          <select name="budget">
            <option value="">Not sure yet</option>
            <option>Under ₹50,000</option>
            <option>₹50,000 – ₹2,00,000</option>
            <option>₹2,00,000 – ₹10,00,000</option>
            <option>₹10,00,000+</option>
          </select>
        </label>
        <label class="field">
          <span class="mono">Tell us about it</span>
          <textarea name="message" rows="5" required placeholder="What do you do today, and what would you like to stop doing by hand?"></textarea>
        </label>

        <p class="form-error" data-error hidden>Please add your name, a valid email and a short message.</p>
        <button class="btn form-submit" type="submit">Send enquiry <span class="arrow">→</span></button>
        <p class="mono form-fine">Draft site: this form is not connected yet and nothing is sent.</p>

        <div class="form-done" data-done hidden>
          <img src="/brand/mark.svg" alt="" width="56" height="56" />
          <h2 class="display h3">Thanks, we've got it.</h2>
          <p>Expect a reply within one working day.</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ lookup, catSlugs }}>
  window.__ASC = { lookup, catSlugs };
</script>

<script>
  const { lookup, catSlugs } = (window as any).__ASC as {
    lookup: Record<string, { name: string; cat: string }>;
    catSlugs: Record<string, string>;
  };
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const picked = form.querySelector<HTMLElement>('[data-picked]')!;
  const params = new URLSearchParams(location.search);

  const check = (slug: string) => {
    const box = form.querySelector<HTMLInputElement>(`input[name="areas"][value="${CSS.escape(slug)}"]`);
    if (box) box.checked = true;
  };

  const sid = params.get('service');
  if (sid && lookup[sid]) {
    picked.hidden = false;
    picked.querySelector('[data-picked-name]')!.textContent = `${lookup[sid].name} · ${sid}`;
    picked.querySelector<HTMLInputElement>('[data-picked-input]')!.value = sid;
    if (catSlugs[lookup[sid].cat]) check(catSlugs[lookup[sid].cat]);
  }
  const cat = params.get('category');
  if (cat) check(cat);

  picked.querySelector('[data-picked-clear]')!.addEventListener('click', () => {
    picked.hidden = true;
    picked.querySelector<HTMLInputElement>('[data-picked-input]')!.value = '';
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const email = String(data.get('email') ?? '');
    const ok = data.get('name') && /.+@.+\..+/.test(email) && data.get('message');
    form.querySelector<HTMLElement>('[data-error]')!.hidden = !!ok;
    if (!ok) return;
    // TEMP: wire to a backend / email service before launch.
    form.classList.add('is-done');
    form.querySelector<HTMLElement>('[data-done]')!.hidden = false;
  });
</script>

<style>
  .contact {
    padding-top: calc(var(--nav-h) + clamp(3rem, 7vw, 6rem));
    padding-bottom: 8rem;
    background:
      radial-gradient(45% 60% at 0% 0%, rgba(148, 188, 227, 0.3), transparent 70%),
      var(--paper);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .contact-side {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    display: grid;
    gap: 1.5rem;
  }
  .contact-side .h1 { font-size: clamp(2.75rem, 1.5rem + 4vw, 5.5rem); }
  .contact-direct { display: grid; gap: 1rem; margin: 1rem 0 0; }
  .contact-direct div { display: grid; gap: 0.2rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .contact-direct dt { color: var(--text-muted); text-transform: uppercase; }
  .contact-direct dd { margin: 0; font-family: var(--font-display); font-size: 1.35rem; }

  .form {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    box-shadow: 0 40px 80px -50px rgba(29, 45, 61, 0.4);
  }
  .form-picked {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--paper);
  }
  .form-picked .mono { color: var(--tint); text-transform: uppercase; }
  .form-picked strong { font-weight: 500; }
  .picked-clear {
    margin-left: auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line-on-ink);
    background: none;
    color: var(--paper);
    cursor: pointer;
  }
  .field { display: grid; gap: 0.5rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field > .mono,
  .field legend { color: var(--text-muted); text-transform: uppercase; padding: 0; margin-bottom: 0.5rem; }
  .field em { font-style: normal; text-transform: none; opacity: 0.6; }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .field textarea { resize: vertical; }
  .field :is(input, select, textarea):focus {
    outline: 0;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(89, 128, 166, 0.15);
  }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: inline-block;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .chip span:hover { border-color: var(--ink); }
  .chip input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .form-error { color: #9a3b2e; font-size: 0.9rem; }
  .form-submit { justify-self: start; }
  .form-fine { color: var(--text-muted); opacity: 0.8; }

  .form-done {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    text-align: center;
    background: var(--paper-raised);
    border-radius: inherit;
  }
  .form-done p { color: var(--text-muted); }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-side { position: static; }
    .row { grid-template-columns: 1fr; }
  }
</style>
