    <!-- Server data hydration -->
    <script is:inline define:vars={{ initialData }}>
      window.__ASC_DASH__ = initialData;
    </script>

    <!-- Client-side Interactive Script -->
    <script>
      interface SyncData {
        user: any;
        business: any;
        requests: any[];
        quotations: any[];
        activities: any[];
        allServices: any[];
        pricing: any;
        stats: {
          total: number;
          active: number;
          pending: number;
          completed: number;
        };
        role?: string;
      }

      let state: SyncData = (window as any).__ASC_DASH__;

      function escapeHtml(str: any): string {
        if (str === null || str === undefined) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function formatDate(dateStr: any): string {
        if (!dateStr) return '';
        try {
          return new Date(dateStr).toLocaleDateString('en-IN', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
          });
        } catch {
          return String(dateStr);
        }
      }

      function getPriceTag(code: string) {
        const p = state.pricing?.[code];
        if (!p) return null;
        if (p.packages?.length) {
          return { prefix: 'from', amount: '₹' + p.packages[0].price.toLocaleString('en-IN') };
        }
        if (p.small?.price) {
          return {
            prefix: p.small.billing ? 'from' : '',
            amount: '₹' + p.small.price.toLocaleString('en-IN') + (p.small.billing === 'monthly' ? '/mo' : p.small.billing === 'yearly' ? '/yr' : ''),
          };
        }
        return null;
      }

      function renderMetrics(stats: any) {
        if (!stats) return;
        const elTotal = document.querySelector('[data-bind-total]');
        const elActive = document.querySelector('[data-bind-active]');
        const elPending = document.querySelector('[data-bind-pending]');
        const elCompleted = document.querySelector('[data-bind-completed]');
        const badgeTotal = document.querySelector('[data-bind-total-badge]');
        const badgeQuotes = document.querySelector('[data-bind-quotes-badge]');

        if (elTotal) elTotal.textContent = String(stats.total ?? 0);
        if (elActive) elActive.textContent = String(stats.active ?? 0);
        if (elPending) elPending.textContent = String(stats.pending ?? 0);
        if (elCompleted) elCompleted.textContent = String(stats.completed ?? 0);
        if (badgeTotal) badgeTotal.textContent = String(stats.total ?? 0);
        if (badgeQuotes) badgeQuotes.textContent = String(state.quotations?.length ?? 0);
      }

      function renderOverviewRecentRequests(requests: any[]) {
        const wrap = document.getElementById('overview-requests-table-wrap');
        if (!wrap) return;

        if (!requests || requests.length === 0) {
          wrap.innerHTML = `
            <div class="empty-state">
              <div class="empty-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m7.5 4.27 9 5.15"></path>
                  <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                  <path d="m3.3 7 8.7 5 8.7-5"></path>
                  <path d="M12 22V12"></path>
                </svg>
              </div>
              <h3 class="display empty-title">No services requested yet</h3>
              <p class="empty-desc">Build your stack using our interactive Estimation Planner or browse 232 services across Software, Marketing, and Operations.</p>
              <div class="empty-actions">
                <button class="btn btn-primary" data-action="go-planner"><span>Open Estimation Planner</span><span class="arrow">→</span></button>
                <button class="btn btn-ghost" data-action="go-explore">Browse 232 Services</button>
              </div>
            </div>
          `;
          wrap.querySelector('[data-action="go-planner"]')?.addEventListener('click', () => switchTab('planner'));
          wrap.querySelector('[data-action="go-explore"]')?.addEventListener('click', () => switchTab('explore'));
          return;
        }

        const recent5 = requests.slice(0, 5);
        const rowsHtml = recent5.map((req) => {
          const statusText = req.quotation?.quotationStatus || req.status;
          const statusClass = `status-${statusText.toLowerCase().replace(/\\s+/g, '-')}`;
          return `
            <tr>
              <td class="table-service-name">
                <strong>${escapeHtml(req.service.name)}</strong>
                <span class="mono table-code">${escapeHtml(req.service.code)}</span>
              </td>
              <td>
                <span class="layer-tag layer-${escapeHtml(req.service.layer)}">${escapeHtml(req.service.layer)}</span>
              </td>
              <td class="text-muted">${escapeHtml(req.service.discipline)}</td>
              <td>
                <span class="status-tag ${statusClass}">${escapeHtml(statusText)}</span>
              </td>
              <td class="mono text-muted">
                ${formatDate(req.requestedAt)}
              </td>
            </tr>
          `;
        }).join('');

        wrap.innerHTML = `
          <table class="data-table">
            <thead>
              <tr>
                <th>Service</th>
                <th>Layer</th>
                <th>Discipline</th>
                <th>Status</th>
                <th>Requested</th>
              </tr>
            </thead>
            <tbody data-bind-recent-requests>
              ${rowsHtml}
            </tbody>
          </table>
        `;
      }

      function renderOverviewActivities(activities: any[]) {
        const feed = document.getElementById('overview-activity-feed');
        if (!feed) return;

        if (!activities || activities.length === 0) {
          feed.innerHTML = '<p class="empty-subtext">No activity recorded yet.</p>';
          return;
        }

        feed.innerHTML = activities.map((act) => `
          <div class="activity-item">
            <div class="activity-bullet"></div>
            <div class="activity-body">
              <p class="activity-desc">${escapeHtml(act.description)}</p>
              <span class="mono activity-time">
                ${new Date(act.createdAt).toLocaleDateString('en-IN', {
                  month: 'short',
                  day: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })}
              </span>
            </div>
          </div>
        `).join('');
      }

      let pendingCancelId: string | null = null;
      let pendingCancelName: string | null = null;

      function setupCancelModal() {
        const modalCancel = document.getElementById('modal-confirm-cancel') as HTMLElement;
        const btnConfirmCancel = document.getElementById('btn-confirm-cancel-exec') as HTMLButtonElement;
        if (!btnConfirmCancel || btnConfirmCancel.dataset.bound === 'true') return;
        btnConfirmCancel.dataset.bound = 'true';

        btnConfirmCancel.addEventListener('click', async () => {
          if (!pendingCancelId) return;
          btnConfirmCancel.disabled = true;
          const origText = btnConfirmCancel.innerHTML;
          btnConfirmCancel.innerHTML = '<span>Cancelling...</span>';

          try {
            const res = await fetch('/api/customer/service-requests/cancel', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ requestId: pendingCancelId }),
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Failed to cancel request');

            if (modalCancel) {
              modalCancel.setAttribute('hidden', '');
              modalCancel.style.display = 'none';
            }
            showToast(`Cancelled request for ${pendingCancelName}`, 'info');
            syncDashboardData(true);
            try {
              const bc = new BroadcastChannel('asc_customer_sync');
              bc.postMessage({ type: 'REQUEST_CANCELLED', id: pendingCancelId, timestamp: Date.now() });
              bc.close();
            } catch {}
            try {
              localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
            } catch {}
          } catch (err: any) {
            showToast(err.message, 'error');
          } finally {
            btnConfirmCancel.disabled = false;
            btnConfirmCancel.innerHTML = origText;
            pendingCancelId = null;
            pendingCancelName = null;
          }
        });
      }

      function rebindMyServiceActions() {
        setupCancelModal();
        const modalEditReq = document.getElementById('modal-edit-req') as HTMLElement;
        const modalCancel = document.getElementById('modal-confirm-cancel') as HTMLElement;
        const modalCancelTitle = document.getElementById('cancel-modal-title');
        const modalCancelDesc = document.getElementById('cancel-modal-desc');

        document.querySelectorAll('[data-action="edit-req"]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            (document.getElementById('edit-req-id') as HTMLInputElement).value = target.dataset.id || '';
            (document.getElementById('edit-req-text') as HTMLTextAreaElement).value = target.dataset.req || '';
            const titleEl = document.getElementById('edit-req-title');
            if (titleEl) titleEl.textContent = `Update Scope: ${target.dataset.name}`;
            if (modalEditReq) {
              modalEditReq.removeAttribute('hidden');
              modalEditReq.style.display = 'grid';
            }
          });
        });

        document.querySelectorAll('[data-action="cancel-req"]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            pendingCancelId = target.dataset.id || null;
            pendingCancelName = target.dataset.name || 'this request';
            const status = target.dataset.status;

            if (modalCancelTitle) modalCancelTitle.textContent = `Cancel: ${pendingCancelName}`;
            if (modalCancelDesc) {
              modalCancelDesc.textContent = status === 'active'
                ? `Are you sure you want to request cancellation for active service "${pendingCancelName}"? Ongoing execution will be halted.`
                : `Are you sure you want to cancel the request for "${pendingCancelName}"?`;
            }

            if (modalCancel) {
              modalCancel.removeAttribute('hidden');
              modalCancel.style.display = 'grid';
            }
          });
        });
      }

      function renderMyServicesGrid(requests: any[]) {
        const wrap = document.getElementById('my-services-content-wrap');
        if (!wrap) return;

        if (!requests || requests.length === 0) {
          wrap.innerHTML = `
            <div class="empty-state" id="my-services-empty-state">
              <div class="empty-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
              </div>
              <h3 class="display empty-title">Your portfolio is currently empty</h3>
              <p class="empty-desc">Start by using the Project Estimation Planner or exploring 232 services in the catalogue to request your first service.</p>
              <div class="empty-actions">
                <button class="btn btn-primary" data-action="go-planner"><span>Project Estimation Planner</span><span class="arrow">→</span></button>
                <button class="btn btn-ghost" data-action="go-explore">Explore All 232 Services</button>
              </div>
            </div>
          `;
          wrap.querySelector('[data-action="go-planner"]')?.addEventListener('click', () => switchTab('planner'));
          wrap.querySelector('[data-action="go-explore"]')?.addEventListener('click', () => switchTab('explore'));
          return;
        }

        const cardsHtml = requests.map((req) => {
          const isCancelled = req.status === 'cancelled' || req.quotation?.quotationStatus === 'Cancelled';
          const isRejected = req.status === 'rejected' || req.quotation?.quotationStatus === 'Rejected';
          const isCompleted = req.status === 'completed' || req.quotation?.quotationStatus === 'Completed';
          const statusText = isCancelled ? 'Cancelled' : (isRejected ? 'Rejected' : (req.quotation?.quotationStatus || req.status));
          const statusClass = `status-${statusText.toLowerCase().replace(/\\s+/g, '-')}`;
          const price = getPriceTag(req.service.code);
          const quoteSyncHtml = req.quotation ? `
            <div class="my-service-quote-sync">
              <div class="msqs-progress">
                <span class="mono text-xs text-muted">Project Progress: ${req.quotation.projectProgress}%</span>
                <div class="mini-progress-bar">
                  <div class="mini-progress-fill" style="width: ${req.quotation.projectProgress}%;"></div>
                </div>
              </div>
              ${req.quotation.customerNotes ? `
                <div class="cust-notes-callout mono text-xs">
                  <span class="text-accent">Admin Note:</span> ${escapeHtml(req.quotation.customerNotes)}
                </div>
              ` : ''}
            </div>
          ` : '';

          return `
            <article class="my-service-card" data-my-layer="${escapeHtml(req.service.layer)}" data-request-id="${req.id}">
              <div class="card-header-line">
                <span class="layer-tag layer-${escapeHtml(req.service.layer)}">${escapeHtml(req.service.layer)}</span>
                <span class="status-tag ${statusClass}">${escapeHtml(statusText)}</span>
              </div>

              <div class="my-service-info">
                <span class="mono table-code">${escapeHtml(req.service.code)}</span>
                <h3 class="my-service-title">${escapeHtml(req.service.name)}</h3>
                <p class="my-service-desc">${escapeHtml(req.service.description)}</p>
              </div>

              <div class="my-service-meta">
                <div>
                  <span class="meta-k">Discipline</span>
                  <span class="meta-v">${escapeHtml(req.service.discipline)}</span>
                </div>
                ${price ? `
                  <div>
                    <span class="meta-k">Price Tag</span>
                    <span class="meta-v mono">${escapeHtml(price.prefix)} ${escapeHtml(price.amount)}</span>
                  </div>
                ` : ''}
                <div>
                  <span class="meta-k">Requested On</span>
                  <span class="meta-v mono">${formatDate(req.requestedAt)}</span>
                </div>
              </div>

              <div class="my-service-req-box">
                <span class="req-box-title mono">Scope & Requirements</span>
                <p class="req-box-text">${escapeHtml(req.requirements || 'Standard baseline scope agreed upon onboarding.')}</p>
              </div>

              ${quoteSyncHtml}

              <div class="my-service-actions">
                <button
                  class="btn-sm btn-ghost"
                  data-action="edit-req"
                  data-id="${req.id}"
                  data-req="${escapeHtml(req.requirements || '')}"
                  data-name="${escapeHtml(req.service.name)}"
                >
                  ${isCancelled || isRejected ? 'Update Scope &amp; Reopen' : 'Update Scope'}
                </button>
                ${!isCompleted && !isCancelled && !isRejected ? `
                  <button
                    class="btn-sm btn-danger-ghost"
                    data-action="cancel-req"
                    data-id="${req.id}"
                    data-name="${escapeHtml(req.service.name)}"
                    data-status="${req.status}"
                  >
                    Cancel
                  </button>
                ` : ''}
              </div>
            </article>
          `;
        }).join('');

        wrap.innerHTML = `<div class="my-services-grid" id="my-services-grid">${cardsHtml}</div>`;
        rebindMyServiceActions();
      }

      function renderCustomerQuotesGrid(quotations: any[]) {
        const wrap = document.getElementById('customer-quotes-content-wrap');
        if (!wrap) return;

        if (!quotations || quotations.length === 0) {
          wrap.innerHTML = `
            <div class="empty-state" id="customer-quotes-empty-state">
              <div class="empty-icon">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              </div>
              <h3 class="display empty-title">No quotations prepared yet</h3>
              <p class="empty-desc">Configure your project stack using the Project Estimation Planner to generate an official quotation.</p>
              <button class="btn btn-primary" data-action="go-planner"><span>Open Estimation Planner</span><span class="arrow">→</span></button>
            </div>
          `;
          wrap.querySelector('[data-action="go-planner"]')?.addEventListener('click', () => switchTab('planner'));
          return;
        }

        const cardsHtml = quotations.map((q) => {
          const qStatusClass = `status-${q.quotationStatus.toLowerCase().replace(/\\s+/g, '-')}`;
          const pStatusClass = `payment-${q.paymentStatus.toLowerCase().replace(/\\s+/g, '-')}`;
          const amount = parseFloat(String(q.finalQuotationAmount || q.initialEstimatedCost || 0)).toLocaleString();

          return `
            <div class="cust-quote-card" data-quote-id="${q.id}">
              <div class="cust-qc-top">
                <div>
                  <span class="mono text-xs text-muted">${escapeHtml(q.quotationNumber)}</span>
                  <h3 class="cust-qc-title">${escapeHtml(q.projectTitle)}</h3>
                </div>
                <div class="cust-qc-tags">
                  <span class="status-tag ${qStatusClass}">${escapeHtml(q.quotationStatus)}</span>
                  <span class="payment-pill ${pStatusClass}">${escapeHtml(q.paymentStatus)}</span>
                </div>
              </div>

              ${q.projectDescription ? `<p class="cust-qc-desc">${escapeHtml(q.projectDescription)}</p>` : ''}

              <div class="cust-qc-progress-block">
                <div class="cust-qc-progress-head">
                  <span class="mono text-xs text-muted">Project Execution Progress</span>
                  <strong class="mono text-sm">${q.projectProgress}%</strong>
                </div>
                <div class="live-progress-bar">
                  <div class="live-progress-fill" style="width: ${q.projectProgress}%;"></div>
                </div>
              </div>

              ${q.customerNotes ? `
                <div class="cust-qc-notes-box">
                  <div class="cust-notes-head">
