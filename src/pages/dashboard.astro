                        const isRejected = req.status === 'rejected' || req.quotation?.quotationStatus === 'Rejected';
                        const isCompleted = req.status === 'completed' || req.quotation?.quotationStatus === 'Completed';
                        const displayStatus = isCancelled ? 'Cancelled' : (isRejected ? 'Rejected' : (req.quotation?.quotationStatus || req.status));
                        const statusClass = `status-${displayStatus.toLowerCase().replace(/\s+/g, '-')}`;

                        return (
                          <>
                            <div class="card-header-line">
                              <span class={`layer-tag layer-${req.service.layer}`}>{req.service.layer}</span>
                              <span class={`status-tag ${statusClass}`}>{displayStatus}</span>
