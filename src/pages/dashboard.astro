              ` : ''}

              <div class="cust-qc-footer">
                <div>
                  <span class="mono text-xs text-muted">Agreed Investment:</span>
                  <div class="mono cust-qc-amount">${escapeHtml(q.currency)} ${amount}</div>
                </div>
                <span class="mono text-xs text-muted">Last Updated: ${formatDate(q.updatedAt)}</span>
              </div>

              <div class="cust-qc-actions">
                <button
                  class="btn-sm btn-ghost"
                  data-action="edit-req"
                  data-id="${q.id}"
                  data-req="${escapeHtml(q.requirements || '')}"
                  data-name="${escapeHtml(q.projectTitle)}"
                >
                  ${['Rejected', 'Cancelled'].includes(q.quotationStatus) ? 'Update Scope &amp; Reopen' : 'Update Scope'}
                </button>
                ${!['Completed', 'Cancelled', 'Rejected'].includes(q.quotationStatus) ? `
                  <button
                    class="btn-sm btn-danger-ghost"
                    data-action="cancel-req"
                    data-id="${q.id}"
                    data-name="${escapeHtml(q.projectTitle)}"
