          <div class="modal-actions">
            <button class="btn btn-ghost" type="button" data-close-modal>Cancel</button>
            <button class="btn btn-primary" type="submit" id="btn-submit-request">
              <span>Submit Request</span>
              <span class="arrow">→</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL 2: UPDATE REQUIREMENTS -->
    <div class="modal-backdrop" id="modal-edit-req" hidden>
      <div class="modal-dialog">
        <div class="modal-header">
          <div>
            <span class="eyebrow">Service Requirements</span>
            <h3 class="display modal-title" id="edit-req-title">Update Requirements</h3>
          </div>
          <button class="modal-close-btn" data-close-modal aria-label="Close modal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <form id="form-edit-req">
          <input type="hidden" name="requestId" id="edit-req-id" />

          <label class="field">
            <span class="mono">Project Scope & Requirements</span>
            <textarea name="requirements" id="edit-req-text" rows="5" required></textarea>
          </label>

          <div class="modal-actions">
            <button class="btn btn-ghost" type="button" data-close-modal>Close</button>
            <button class="btn btn-primary" type="submit" id="btn-save-req">
              <span>Save Requirements</span>
              <span class="arrow">→</span>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL 2B: CONFIRM CANCELLATION -->
    <div class="modal-backdrop" id="modal-confirm-cancel" hidden>
      <div class="modal-dialog modal-dialog-sm">
        <div class="modal-header">
          <div>
            <span class="eyebrow" style="color: #ef4444;">Confirmation</span>
            <h3 class="display modal-title" id="cancel-modal-title">Cancel Request</h3>
          </div>
          <button class="modal-close-btn" data-close-modal aria-label="Close modal">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <p class="modal-desc" id="cancel-modal-desc" style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; margin: 0;">
          Are you sure you want to cancel this request? This will halt any active scope preparation.
        </p>
        <div class="modal-actions">
          <button class="btn btn-ghost" type="button" data-close-modal>Keep Request</button>
          <button class="btn btn-danger" type="button" id="btn-confirm-cancel-exec" style="background: #dc2626; color: #ffffff; border: 1px solid #b91c1c;">
            <span>Yes, Cancel It</span>
          </button>
        </div>
