                  <button class="tab-pill" data-layer-filter="grow">Grow</button>
                  <button class="tab-pill" data-layer-filter="run">Run</button>

                  <span class="mono filter-label filter-label-sep">DISCIPLINE:</span>
                  <select id="explore-discipline-filter" class="discipline-select">
                    <option value="all">All Disciplines (8)</option>
                    <option value="Technology & Software Development">Software & Web</option>
                    <option value="AI, Automation & Emerging Technologies">AI & Automation</option>
                    <option value="Digital Marketing & Online Growth">Marketing & SEO</option>
                    <option value="Branding, Graphics & Creative Studio">Brand & Creative</option>
                    <option value="E-commerce & Marketplace Management">E-commerce</option>
                    <option value="Business Management & Digital Operations">Operations</option>
                    <option value="Restaurant, Cafe & Food Business Solutions">Restaurants</option>
                    <option value="Business Registration, Licensing & Compliance">Compliance & GST</option>
                  </select>
                </div>
              </div>

              <!-- Services Cards Grid -->
              <div class="explore-grid" id="explore-cards-grid">
                {allServices.map((svc) => {
                  const isRequested = customerRequests.some((r) => r.serviceId === svc.id);
                  const p = svc.code ? getPricing(svc.code) : undefined;
                  const price = p ? cardPrice(p) : null;
                  const typeLabel = p ? { package: '5 packages', fixed: 'Fixed price', starting: 'Starting price' }[p.type] : '';
                  return (
                    <article
                      class="explore-card"
                      data-id={svc.id}
                      data-layer={svc.layer}
                      data-discipline={svc.discipline}
                      data-search={`${svc.name.toLowerCase()} ${svc.discipline.toLowerCase()} ${(svc.code || '').toLowerCase()} ${svc.description.toLowerCase()}`}
                    >
                      <div class="explore-card-top">
                        <span class={`layer-tag layer-${svc.layer}`}>{svc.layer}</span>
                        <span class="mono explore-code">{svc.code}</span>
                        <span class="card-badge-soft">{svc.availabilityStatus === 'live' ? 'Live' : 'Coming Soon'}</span>
                      </div>

                      <h3 class="display explore-card-name">{svc.name}</h3>
                      <p class="explore-card-desc">{svc.description}</p>
                      <span class="mono explore-discipline-tag">{svc.discipline}</span>

                      {price && (
                        <div class="explore-card-price">
                          <span class="mono explore-price-type">{typeLabel}</span>
                          <span class="explore-price-row">
                            {price.prefix && <span class="explore-price-from">{price.prefix}</span>}
                            <strong class="explore-price-amt">{price.amount}</strong>
                            <span class="explore-price-unit">{price.unit}</span>
                          </span>
                          {p?.market && <span class="explore-market" title="India market rate, 2026">Market: {p.market}</span>}
                        </div>
                      )}

                      <div class="explore-card-footer">
                        {isRequested ? (
                          <div class="already-added-badge mono">Active in Pipeline</div>
                        ) : (
                          <button
                            class="btn btn-sm btn-primary-pill"
                            data-action="open-add-service-modal"
                            data-id={svc.id}
                            data-name={svc.name}
                            data-code={svc.code}
                            data-layer={svc.layer}
                            data-desc={svc.description}
                          >
                            Request Service →
                          </button>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>

              <!-- No Results Message -->
              <div class="empty-state" id="explore-no-results" hidden>
                <div class="empty-icon">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                </div>
                <h3 class="display empty-title">No services match your filters</h3>
                <p class="empty-desc">Try resetting your search query or choosing another discipline.</p>
              </div>
            </div>
          </section>



