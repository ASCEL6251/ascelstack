                            {q.paymentStatus}
                          </span>
                        </div>
                      </div>

                      {q.projectDescription && (
                        <p class="cust-qc-desc">{q.projectDescription}</p>
                      )}

                      <!-- Project Progress Section -->
                      <div class="cust-qc-progress-block">
                        <div class="cust-qc-progress-head">
                          <span class="mono text-xs text-muted">Project Execution Progress</span>
                          <strong class="mono text-sm">{q.projectProgress}%</strong>
                        </div>
                        <div class="live-progress-bar">
                          <div class="live-progress-fill" style={`width: ${q.projectProgress}%;`}></div>
                        </div>
                      </div>

                      <!-- Customer Notes / Updates from Administration -->
                      {q.customerNotes && (
                        <div class="cust-qc-notes-box">
                          <div class="cust-notes-head">
                            <span class="mono text-xs text-accent">TEAM UPDATE NOTE</span>
                            <span class="mono text-xs text-muted">
                              {new Date(q.updatedAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' })}
                            </span>
                          </div>
                          <p class="cust-notes-text">{q.customerNotes}</p>
                        </div>
                      )}

                      <!-- Financial details strip -->
                      <div class="cust-qc-footer">
                        <div>
                          <span class="mono text-xs text-muted">Agreed Investment:</span>
                          <div class="mono cust-qc-amount">
                            {q.currency} {parseFloat(String(q.finalQuotationAmount || q.initialEstimatedCost)).toLocaleString()}
                          </div>
                        </div>
                        <span class="mono text-xs text-muted">
                          Last Updated: {new Date(q.updatedAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
                        </span>
                      </div>

                      <!-- Quotation Actions (Scope & Cancellation) -->
                      <div class="cust-qc-actions">
                        <button
                          class="btn-sm btn-ghost"
                          data-action="edit-req"
                          data-id={q.id}
                          data-req={q.requirements || ''}
                          data-name={q.projectTitle}
                        >
                          {['Rejected', 'Cancelled'].includes(q.quotationStatus) ? 'Update Scope & Reopen' : 'Update Scope'}
                        </button>
                        {!['Completed', 'Cancelled', 'Rejected'].includes(q.quotationStatus) && (
                          <button
                            class="btn-sm btn-danger-ghost"
                            data-action="cancel-req"
                            data-id={q.id}
                            data-name={q.projectTitle}
                            data-status={q.quotationStatus}
                          >
                            Cancel Quotation
                          </button>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
              </div>
            </div>
          </section>

          <!-- ============================================================== -->
          <!-- VIEW: CLIENT AGREEMENTS -->
          <!-- ============================================================== -->
