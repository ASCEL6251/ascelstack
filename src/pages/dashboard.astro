                  <p class="empty-desc">
                    When your project scope and budget are approved, your dedicated team will prepare a formal Professional Service Agreement for digital execution.
                  </p>
                  <button class="btn btn-primary" data-action="go-planner">
                    <span>Open Estimation Planner</span>
                    <span class="arrow">→</span>
                  </button>
                </div>
              ) : (
                <div class="customer-quotes-grid">
                  {customerAgreements.map((agr) => {
                    const clientSigned = Boolean(agr.clientSignedAt);
                    const providerSigned = Boolean(agr.providerSignedAt);
                    return (
                      <div class="cust-quote-card">
                        <div class="cust-qc-top">
                          <div>
                            <span class="mono cust-qc-num">{agr.agreementNumber}</span>
                            <h3 class="display cust-qc-title">{agr.projectName}</h3>
                          </div>
                          <span class={`status-tag status-${agr.status}`}>
                            {agr.status === 'signed' ? 'Executed' : agr.status}
                          </span>
                        </div>

                        <div style="margin: 0.75rem 0; font-size: 0.82rem; color: #64748b; display: flex; gap: 0.75rem;">
                          <span>{providerSigned ? '✓ Ascelstack Signed' : '○ Pending Ascelstack'}</span>
                          <span>·</span>
                          <span>{clientSigned ? '✓ You Signed' : '○ Signature Required'}</span>
                        </div>

                        <div class="cust-qc-footer">
                          <div>
                            <span class="mono text-xs text-muted">Contract Value:</span>
                            <div class="mono cust-qc-amount">
                              {agr.currency} {parseFloat(String(agr.totalAmount)).toLocaleString()}
                            </div>
                          </div>
                          <span class="mono text-xs text-muted">
                            Created: {new Date(agr.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
                          </span>
                        </div>

                        <div class="cust-qc-actions">
                          <a
                            href={`/agreements/${agr.secureToken}`}
                            class="btn-sm btn-primary"
                            style="text-align: center; justify-content: center; text-decoration: none;"
                          >
                            {clientSigned ? 'View Agreement' : 'Review & Sign →'}
                          </a>
                          <a
                            href={`/agreements/${agr.secureToken}/print`}
                            target="_blank"
                            rel="noreferrer"
                            class="btn-sm btn-ghost"
                            style="text-align: center; justify-content: center; text-decoration: none;"
                          >
                            Download PDF
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </section>

          <!-- ============================================================== -->
          <!-- VIEW 4: EXPLORE SERVICES -->
          <!-- ============================================================== -->
          <section class="dash-view" id="view-explore" data-view="explore">
            <div class="card-panel">
              <div class="panel-header-flex">
                <div>
                  <span class="eyebrow">Catalogue Browser</span>
                  <h2 class="display h3">Explore Ascelstack Services</h2>
                  <p class="panel-subtitle">232 production services ready to attach to your business contract</p>
