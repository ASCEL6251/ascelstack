---
export const prerender = false;

import { UserButton, SignOutButton } from '@clerk/astro/components';
import Logo from '../components/Logo.astro';
import { getAuthenticatedUser } from '../lib/auth';
import { db, services, serviceRequests, businesses, activityLogs, quotations, agreements } from '../db';
import { eq, desc, asc, or } from 'drizzle-orm';
import { getPricing, cardPrice, formatINR } from '../lib/pricing';
import rawPricing from '../data/pricing.json';
import '../styles/global.css';

// 1. Server-side authentication check
const auth = Astro.locals.auth();
if (!auth.isAuthenticated || !auth.userId) {
  return Astro.redirect('/login');
}

// 2. Fetch or sync authenticated customer from Neon PostgreSQL
const authData = await getAuthenticatedUser(Astro);
if (!authData) {
  return Astro.redirect('/login');
}

const { user, business } = authData;

// 3. Fetch customer's service requests with service, business & live quotation details from Neon
const customerRequests = await db
  .select({
    id: serviceRequests.id,
    businessId: serviceRequests.businessId,
    userId: serviceRequests.userId,
    serviceId: serviceRequests.serviceId,
    quotationId: serviceRequests.quotationId,
    requirements: serviceRequests.requirements,
    status: serviceRequests.status,
    requestedAt: serviceRequests.requestedAt,
    updatedAt: serviceRequests.updatedAt,
    service: {
      id: services.id,
      code: services.code,
      name: services.name,
      slug: services.slug,
      description: services.description,
      layer: services.layer,
      discipline: services.discipline,
      availabilityStatus: services.availabilityStatus,
    },
    business: {
      id: businesses.id,
      businessName: businesses.businessName,
    },
    quotation: {
      id: quotations.id,
      quotationNumber: quotations.quotationNumber,
      quotationStatus: quotations.quotationStatus,
      paymentStatus: quotations.paymentStatus,
      projectProgress: quotations.projectProgress,
      finalQuotationAmount: quotations.finalQuotationAmount,
      currency: quotations.currency,
      customerNotes: quotations.customerNotes,
      updatedAt: quotations.updatedAt,
    },
  })
  .from(serviceRequests)
  .innerJoin(services, eq(serviceRequests.serviceId, services.id))
  .innerJoin(businesses, eq(serviceRequests.businessId, businesses.id))
  .leftJoin(quotations, eq(serviceRequests.quotationId, quotations.id))
  .where(eq(serviceRequests.userId, user.id))
  .orderBy(desc(serviceRequests.requestedAt));

// 3b. Fetch all quotations directly for customer
const customerQuotations = await db
  .select({
    id: quotations.id,
    quotationNumber: quotations.quotationNumber,
    projectTitle: quotations.projectTitle,
    projectDescription: quotations.projectDescription,
    requirements: quotations.requirements,
    quotationStatus: quotations.quotationStatus,
    paymentStatus: quotations.paymentStatus,
    paymentVerified: quotations.paymentVerified,
    projectProgress: quotations.projectProgress,
    currency: quotations.currency,
    initialEstimatedCost: quotations.initialEstimatedCost,
    finalQuotationAmount: quotations.finalQuotationAmount,
    customerNotes: quotations.customerNotes,
    createdAt: quotations.createdAt,
    updatedAt: quotations.updatedAt,
  })
  .from(quotations)
  .where(eq(quotations.userId, user.id))
  .orderBy(desc(quotations.createdAt));

// 3c. Fetch all client agreements for customer
const customerAgreements = await db
  .select({
    id: agreements.id,
    agreementNumber: agreements.agreementNumber,
    secureToken: agreements.secureToken,
    title: agreements.title,
    projectName: agreements.projectName,
    status: agreements.status,
    version: agreements.version,
    isImmutable: agreements.isImmutable,
    currency: agreements.currency,
    totalAmount: agreements.totalAmount,
    advanceAmount: agreements.advanceAmount,
    advancePercentage: agreements.advancePercentage,
    clientSignedAt: agreements.clientSignedAt,
    providerSignedAt: agreements.providerSignedAt,
    signedAt: agreements.signedAt,
    createdAt: agreements.createdAt,
  })
  .from(agreements)
  .where(
    or(
      eq(agreements.userId, user.id),
      eq(agreements.clientEmail, user.email),
      business ? eq(agreements.businessId, business.id) : undefined
    )
  )
  .orderBy(desc(agreements.createdAt));

// 4. Fetch all catalog services for exploration and the estimation planner
const allServices = await db
  .select()
  .from(services)
  .orderBy(asc(services.code), asc(services.name));

// 5. Fetch recent activity logs from Neon
const recentActivities = await db
  .select()
  .from(activityLogs)
  .where(eq(activityLogs.userId, user.id))
  .orderBy(desc(activityLogs.createdAt))
  .limit(10);

// Calculate initial statistics taking into account both direct service requests and linked quotation states
const isActive = (r: any) =>
  r.status === 'active' ||
  (r.quotation && (
    ['Approved', 'Processing', 'Estimation in Progress', 'Quotation Prepared', 'Quotation Sent', 'Awaiting Customer Approval'].includes(r.quotation.quotationStatus) ||
    ['Payment Completed', 'Partially Paid'].includes(r.quotation.paymentStatus) ||
    (r.quotation.projectProgress > 0 && r.quotation.projectProgress < 100)
  ));

const isCompleted = (r: any) =>
  r.status === 'completed' ||
  (r.quotation && (r.quotation.quotationStatus === 'Completed' || r.quotation.projectProgress === 100));

const isPending = (r: any) =>
  !isCompleted(r) && !isActive(r) && r.status !== 'cancelled';

const activeServicesCount = customerRequests.filter(isActive).length;
const pendingServicesCount = customerRequests.filter(isPending).length;
const completedServicesCount = customerRequests.filter(isCompleted).length;
const totalServicesCount = customerRequests.length;

// Pre-fill initial business data if user hasn't created one
const defaultBusinessName = business?.businessName || `${user.fullName || 'My'} Business`;
const defaultBusinessEmail = business?.email || user.email;

// Pass safe initial state to client for instant hydration without extra initial requests
const initialData = {
  user,
  role: authData.role,
  business: business || {
    id: '',
    businessName: defaultBusinessName,
    email: defaultBusinessEmail,
    businessType: '',
    industry: '',
    phone: '',
    website: '',
    address: '',
    city: '',
    state: '',
    country: 'India',
    gstin: '',
    description: '',
  },
  requests: customerRequests,
  quotations: customerQuotations,
  agreements: customerAgreements,
  activities: recentActivities,
  allServices,
  pricing: rawPricing,
  stats: {
    total: totalServicesCount,
    active: activeServicesCount,
    pending: pendingServicesCount,
    completed: completedServicesCount,
  },
};
---

