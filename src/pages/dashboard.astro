      }
      .phase-title {
        font-family: var(--font-display);
        font-size: 1.4rem;
        margin: 0;
      }
      .phase-desc {
        color: var(--text-muted);
        font-size: 0.88rem;
      }
      .phase-status {
        font-size: 0.75rem;
        color: var(--ink);
        background: var(--paper-sunk);
        padding: 0.35rem 0.65rem;
        border-radius: 6px;
        width: fit-content;
      }

      .support-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
      }
      .support-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: grid;
        gap: 0.35rem;
      }
      .support-card h4 {
        margin: 0;
        font-size: 1.15rem;
        color: var(--ink);
      }
      .support-card p {
        color: var(--text-muted);
        font-size: 0.85rem;
      }
      .support-notice {
        background: radial-gradient(40% 120% at 90% 0%, rgba(148, 188, 227, 0.25), transparent 70%), var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.25rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      /* ------------------------------------------------------------- Modals */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(20, 33, 48, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: grid;
        place-items: center;
        z-index: 99;
        padding: 1.5rem;
      }
      .modal-dialog {
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        max-width: 540px;
        width: 100%;
        padding: clamp(1.5rem, 4vw, 2.25rem);
        box-shadow: 0 30px 60px -25px rgba(20, 33, 48, 0.4);
        display: grid;
        gap: 1.25rem;
        animation: modalScale 0.25s ease;
      }
      @keyframes modalScale {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }
      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }
      .modal-title {
        font-size: 1.6rem;
        margin-top: 0.25rem;
      }
      .modal-code {
        color: var(--text-muted);
        font-size: 0.75rem;
      }
      .modal-close-btn {
        background: none;
        border: 0;
        font-size: 1.25rem;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
      }
      .modal-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
      }
      .modal-info-callout {
        background: var(--paper-sunk);
        border-left: 3px solid var(--accent);
        padding: 0.85rem 1rem;
        border-radius: 0 var(--radius-s) var(--radius-s) 0;
        font-size: 0.82rem;
      }
      .modal-info-callout .mono {
        color: var(--accent);
        display: block;
        margin-bottom: 0.2rem;
      }
      .modal-info-callout p {
        margin: 0;
        color: var(--text);
      }
      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 0.5rem;
      }

      /* ------------------------------------------------------------- Toast Hub */
      .toast-hub {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        pointer-events: none;
      }
      .toast-item {
        pointer-events: auto;
        background: var(--ink);
        color: var(--paper);
        border-radius: 8px;
        padding: 0.75rem 1.15rem;
        font-size: 0.88rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 16px 36px -16px rgba(0, 0, 0, 0.4);
        border-left: 4px solid var(--accent);
        animation: toastEnter 0.3s ease;
      }
      .toast-item.toast-error { border-left-color: #ef4444; }
      .toast-item.toast-info { border-left-color: var(--tint); }
      .toast-content { display: flex; align-items: center; gap: 0.5rem; }
      .toast-close { background: none; border: 0; color: rgba(255, 255, 255, 0.6); cursor: pointer; padding: 2px; }
      @keyframes toastEnter {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }
      .toast-item.is-leaving { opacity: 0; transform: translateY(12px); transition: all 0.3s; }

      /* ------------------------------------------------------------- Responsive */
      @media (max-width: 1024px) {
        .overview-columns { grid-template-columns: 1fr; }
        .dash-welcome-card { flex-direction: column; align-items: flex-start; }
        .welcome-actions { width: 100%; flex-direction: row; }
      }

      @media (max-width: 820px) {
        .dash-layout { grid-template-columns: 1fr; }
        .dash-sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          width: 280px;
          transform: translateX(-100%);
          transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
        }
        .dash-sidebar.is-open {
          transform: none;
        }
        .sidebar-close-btn { display: block; }
        .topbar-toggle-btn { display: block; }
        .form-row, .form-row-3, .support-grid { grid-template-columns: 1fr; }
        .welcome-actions { flex-direction: column; }
      }
    </style>
  </body>
</html>
