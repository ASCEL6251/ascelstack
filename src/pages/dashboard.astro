          <div class="modal-price-box" id="modal-svc-price-box" hidden>
            <span class="mono text-xs text-muted" id="modal-svc-price-type">PRICING</span>
            <div class="modal-price-row">
              <strong class="modal-price-val" id="modal-svc-price-val">₹0</strong>
              <span class="modal-price-unit" id="modal-svc-price-unit"></span>
            </div>
          </div>

          <label class="field">
            <span class="mono">Associate with Business</span>
            <input type="text" value={defaultBusinessName} disabled class="input-disabled" />
          </label>

