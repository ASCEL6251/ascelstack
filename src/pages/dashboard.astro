          `;
        }).join('');

        wrap.innerHTML = `<div class="customer-quotes-grid" id="customer-quotes-grid">${cardsHtml}</div>`;
        rebindMyServiceActions();
      }

      let isSyncing = false;
      async function syncDashboardData(silent = false) {
        if (isSyncing) return;
        isSyncing = true;

        const syncDot = document.getElementById('sync-dot');
        const syncLabel = document.getElementById('sync-status-label');
        if (syncDot) {
          syncDot.classList.remove('live-pulse');
          syncDot.classList.add('is-syncing');
        }
        if (syncLabel) syncLabel.textContent = 'Syncing...';

        try {
          const res = await fetch(`/api/customer/sync?_t=${Date.now()}`);
          if (!res.ok) throw new Error('Sync failed with status ' + res.status);
          const data = await res.json();

          if (data && data.success) {
            state.requests = data.requests || [];
            state.quotations = data.quotations || [];
            state.activities = data.activities || [];
            state.stats = data.stats || state.stats;
            if (data.business) state.business = data.business;
            if (data.role) state.role = data.role;

            renderMetrics(state.stats);
            renderOverviewRecentRequests(state.requests);
            renderOverviewActivities(state.activities);
            renderMyServicesGrid(state.requests);
            renderCustomerQuotesGrid(state.quotations);

            if (syncDot) {
              syncDot.classList.remove('is-syncing');
              syncDot.classList.add('live-pulse');
            }
            if (syncLabel) syncLabel.textContent = 'Cloud Synced';
            const statusBtn = document.getElementById('cloud-sync-status');
            if (statusBtn) statusBtn.title = `Last synchronized with cloud: ${new Date().toLocaleTimeString()}`;

            if (!silent) {
              showToast('Project & service portfolio synchronized in real time', 'success');
            }
          }
        } catch (err) {
          console.warn('Real-time sync error:', err);
          if (syncDot) syncDot.classList.remove('is-syncing');
          if (syncLabel) syncLabel.textContent = 'Sync Pending';
        } finally {
          isSyncing = false;
        }
      }

      // Real-time cross-tab and cloud event listeners
      try {
        const adminBc = new BroadcastChannel('asc_admin_sync');
        adminBc.onmessage = () => syncDashboardData(true);
      } catch (e) {}

      try {
        const custBc = new BroadcastChannel('asc_customer_sync');
        custBc.onmessage = () => syncDashboardData(true);
      } catch (e) {}

      window.addEventListener('storage', (e) => {
        if (e.key === 'asc_admin_sync_tick' || e.key === 'asc_customer_sync_tick') {
          syncDashboardData(true);
        }
      });

      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) syncDashboardData(true);
      });
      window.addEventListener('focus', () => syncDashboardData(true));
      window.addEventListener('pageshow', () => syncDashboardData(true));

      setInterval(() => {
        if (!document.hidden) {
          syncDashboardData(true);
        }
      }, 8000);

      document.getElementById('cloud-sync-status')?.addEventListener('click', () => {
        syncDashboardData(false);
      });

      // Toast Notification Helper (clean SVGs, no emojis)
      function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
        const hub = document.getElementById('toast-hub');
        if (!hub) return;

        const iconSvg =
          type === 'success'
            ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`
            : type === 'error'
              ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`
              : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;

        const toast = document.createElement('div');
        toast.className = `toast-item toast-${type}`;
        toast.innerHTML = `
          <div class="toast-content">
            <span class="toast-icon">${iconSvg}</span>
            <span>${message}</span>
          </div>
          <button class="toast-close" type="button" aria-label="Close">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        `;

        toast.querySelector('.toast-close')?.addEventListener('click', () => toast.remove());
        hub.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('is-leaving');
          setTimeout(() => toast.remove(), 300);
        }, 4500);
      }

      // Sidebar Tab Navigation
      const navItems = document.querySelectorAll<HTMLButtonElement>('.sidebar-nav .nav-item');
      const views = document.querySelectorAll<HTMLElement>('.dash-view');
      const currentViewLabel = document.querySelector<HTMLElement>('[data-bind-current-view]');
      const sidebarEl = document.querySelector('[data-sidebar]');
      const backdropEl = document.getElementById('sidebar-backdrop');
      const plannerMobileDock = document.getElementById('planner-mobile-dock');

      function openSidebar() {
        sidebarEl?.classList.add('is-open');
        backdropEl?.classList.add('is-visible');
        document.body.classList.add('sidebar-locked');
      }

      function closeSidebar() {
        sidebarEl?.classList.remove('is-open');
        backdropEl?.classList.remove('is-visible');
        document.body.classList.remove('sidebar-locked');
      }

      function switchTab(targetTab: string) {
        navItems.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.tab === targetTab));
        views.forEach((view) => view.classList.toggle('is-active', view.dataset.view === targetTab));

        if (currentViewLabel) {
          const activeBtn = Array.from(navItems).find((b) => b.dataset.tab === targetTab);
          const rawText = activeBtn?.querySelector('span')?.textContent || 'Overview';
          currentViewLabel.textContent = rawText;
        }

        history.replaceState(null, '', `#${targetTab}`);
        window.scrollTo({ top: 0, behavior: 'smooth' });

        // Close sidebar on mobile after navigating
        closeSidebar();

        // Toggle mobile planner floating dock
        if (plannerMobileDock) {
          if (targetTab === 'planner') {
            plannerMobileDock.classList.add('is-active');
          } else {
            plannerMobileDock.classList.remove('is-active');
          }
        }
      }

      navItems.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tab = btn.dataset.tab;
          if (tab) switchTab(tab);
        });
      });

      // Quick action button listeners
      document.querySelectorAll('[data-action="go-planner"]').forEach((b) => b.addEventListener('click', () => switchTab('planner')));
      document.querySelectorAll('[data-action="go-explore"]').forEach((b) => b.addEventListener('click', () => switchTab('explore')));
      document.querySelectorAll('[data-action="go-business"]').forEach((b) => b.addEventListener('click', () => switchTab('business')));
      document.querySelectorAll('[data-action="go-my-services"]').forEach((b) => b.addEventListener('click', () => switchTab('my-services')));

      // Initialize from URL hash
      const hash = location.hash.replace('#', '');
      if (hash && document.querySelector(`[data-view="${hash}"]`)) {
        switchTab(hash);
      } else {
        const defaultView = document.querySelector('.dash-view.is-active');
        if (defaultView?.getAttribute('data-view') === 'planner') {
          plannerMobileDock?.classList.add('is-active');
        }
      }

      // Mobile sidebar toggle listeners & backdrop handling
      const openSidebarBtn = document.querySelector('[data-open-sidebar]');
      openSidebarBtn?.addEventListener('click', openSidebar);
      document.querySelectorAll('[data-close-sidebar]').forEach((btn) => {
        btn.addEventListener('click', closeSidebar);
      });

      // Close sidebar with Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sidebarEl?.classList.contains('is-open')) {
          closeSidebar();
        }
      });

      // Mobile Planner Dock "Review & Submit" smooth scroll
      document.getElementById('pmd-scroll-summary')?.addEventListener('click', () => {
        const summaryCard = document.getElementById('planner-estimate-summary');
        if (summaryCard) {
          summaryCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      // ----------------------------------------------------------------------
      // LOGOUT MODAL & FUNCTIONALITY (Stay / Logout options)
      // ----------------------------------------------------------------------
      const modalConfirmLogout = document.getElementById('modal-confirm-logout') as HTMLElement;
      const btnLogoutProceed = document.getElementById('btn-logout-proceed') as HTMLButtonElement;
      const btnLogoutStay = document.getElementById('btn-logout-stay') as HTMLButtonElement;

      // Open logout confirmation dialog when clicking the bottom-left Logout button
      document.querySelectorAll('[data-action="open-logout-modal"]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (modalConfirmLogout) {
            modalConfirmLogout.hidden = false;
            btnLogoutStay?.focus();
          }
        });
      });

      // Option 1: Stay (cancel and close modal)
      btnLogoutStay?.addEventListener('click', () => {
        if (modalConfirmLogout) {
          modalConfirmLogout.hidden = true;
        }
      });

      // Close modal on backdrop click
      modalConfirmLogout?.addEventListener('click', (e) => {
        if (e.target === modalConfirmLogout) {
          modalConfirmLogout.hidden = true;
        }
      });

      // Option 2: Logout (cleanly sign out of Clerk & redirect to /login)
      btnLogoutProceed?.addEventListener('click', async () => {
        btnLogoutProceed.disabled = true;
        btnLogoutProceed.innerHTML = '<span>Signing out...</span>';

        // Set safety timer to force redirect if network hangs
        const forceTimer = setTimeout(() => {
          try {
            document.cookie = '__session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
            document.cookie = '__client_uat=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
          } catch {}
          window.location.href = '/login';
        }, 1200);

        try {
          // 1. Trigger Clerk's native button handler if available
          const nativeTrigger = document.getElementById('native-clerk-signout-trigger') as HTMLButtonElement | null;
          if (nativeTrigger) {
            nativeTrigger.click();
          }

          // 2. Programmatically invoke window.Clerk.signOut
          const clerk = (window as any).Clerk;
          if (clerk && typeof clerk.signOut === 'function') {
            await clerk.signOut({ redirectUrl: '/login' });
          }
        } catch (err) {
          console.warn('Clerk signOut error, initiating fallback redirect:', err);
        }

        clearTimeout(forceTimer);

        // 3. Clear session cookies & redirect
        try {
          document.cookie = '__session=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
          document.cookie = '__client_uat=; Path=/; Expires=Thu, 01 Jan 1970 00:00:01 GMT;';
        } catch {}

        window.location.href = '/login';
      });

      // ----------------------------------------------------------------------
      // PROJECT ESTIMATION PLANNER ENGINE
      // ----------------------------------------------------------------------
      const DISCIPLINE_BASE_RATES: Record<string, { inr: number; hours: number; weeks: number }> = {
        'Technology & Software Development': { inr: 60000, hours: 65, weeks: 3.5 },
        'AI, Automation & Emerging Technologies': { inr: 70000, hours: 75, weeks: 3.5 },
        'Digital Marketing & Online Growth': { inr: 40000, hours: 40, weeks: 2.0 },
        'Branding, Graphics & Creative Studio': { inr: 38000, hours: 40, weeks: 2.0 },
        'E-commerce & Marketplace Management': { inr: 48000, hours: 50, weeks: 2.5 },
        'Business Management & Digital Operations': { inr: 45000, hours: 45, weeks: 2.5 },
        'Restaurant, Cafe & Food Business Solutions': { inr: 38000, hours: 40, weeks: 2.0 },
        'Business Registration, Licensing & Compliance': { inr: 22000, hours: 20, weeks: 1.5 },
        'IT Infrastructure & Technical Support': { inr: 35000, hours: 35, weeks: 2.0 },
      };

      const USD_EXCHANGE_RATE = 85;
      let plannerCurrency: 'INR' | 'USD' = 'INR';
      let selectedServiceIds = new Set<string>();

      function getServiceBaseMetrics(svc: any) {
        const code = svc.code || '';
        const p = state.pricing?.[code];
        let cost = p?.small?.price ?? p?.mid?.price ?? (p?.packages?.[0]?.price ?? null);
        if (cost === null || cost <= 0) {
          const disciplineRate = DISCIPLINE_BASE_RATES[svc.discipline] || { inr: 15000, hours: 20, weeks: 1.5 };
          cost = disciplineRate.inr;
        }

        let hours = Math.max(2, Math.round(cost / 800));
        let weeks = cost < 3000 ? 0.5 : cost < 15000 ? 1 : cost < 50000 ? 2 : cost < 150000 ? 4 : 8;

        if (p?.packages?.[0]?.delivery) {
          const d = p.packages[0].delivery.toLowerCase();
          if (d.includes('day')) {
            const days = parseInt(d) || 3;
            weeks = Math.max(0.5, Math.round((days / 7) * 10) / 10);
            hours = Math.max(4, Math.round(days * 4));
          } else if (d.includes('week')) {
            weeks = parseInt(d) || 2;
            hours = Math.max(15, weeks * 15);
          }
        }

        return { cost, hours, weeks };
      }

      function formatMoney(amountInr: number) {
        if (plannerCurrency === 'USD') {
          const usd = Math.round(amountInr / USD_EXCHANGE_RATE);
          return `$${usd.toLocaleString('en-US')}`;
        }
        return `₹${Math.round(amountInr).toLocaleString('en-IN')}`;
      }

      function recalculateEstimate() {
        const selectedServices = state.allServices.filter((s) => selectedServiceIds.has(s.id));
        const count = selectedServices.length;

        const counterEl = document.getElementById('planner-selected-count');
        if (counterEl) counterEl.textContent = `${count} selected`;

        const tierInput = document.querySelector<HTMLInputElement>('input[name="project-tier"]:checked');
        const tier = tierInput?.value || 'starter';
        let tierMultiplier = 1.0;
        if (tier === 'growth') tierMultiplier = 1.5;
        if (tier === 'enterprise') tierMultiplier = 2.2;

        const urgencySelect = document.getElementById('planner-urgency') as HTMLSelectElement;
        const urgency = urgencySelect?.value || 'standard';
        let urgencyCostMult = 1.0;
        let urgencyTimeMult = 1.0;
        if (urgency === 'sprint') {
          urgencyCostMult = 1.2;
          urgencyTimeMult = 0.7;
        } else if (urgency === 'phased') {
          urgencyCostMult = 0.95;
          urgencyTimeMult = 1.3;
        }

        const supportSelect = document.getElementById('planner-support') as HTMLSelectElement;
        const support = supportSelect?.value || 'none';
        let supportAddonInr = 0;
        if (support === 'hypercare') supportAddonInr = 35000;
        if (support === 'retainer') supportAddonInr = 75000;

        let rawCost = 0;
        let totalHours = 0;
        let maxWeeks = 0;
        let buildCost = 0;
        let growCost = 0;
        let runCost = 0;

        selectedServices.forEach((svc) => {
          const { cost, hours, weeks } = getServiceBaseMetrics(svc);
          const scaledCost = cost * tierMultiplier * urgencyCostMult;
          rawCost += scaledCost;
          totalHours += hours * (tierMultiplier > 1 ? tierMultiplier * 0.85 : 1);
          if (weeks > maxWeeks) maxWeeks = weeks;

          if (svc.layer === 'build') buildCost += scaledCost;
          else if (svc.layer === 'grow') growCost += scaledCost;
          else if (svc.layer === 'run') runCost += scaledCost;
        });

        // Stack Synergy Savings
        let synergyDiscount = 0;
        const distinctLayers = new Set(selectedServices.map((s) => s.layer)).size;
        if (count >= 5) {
          synergyDiscount = rawCost * 0.15;
        } else if (count >= 3 || distinctLayers >= 2) {
          synergyDiscount = rawCost * 0.10;
        }

        const finalTotalInr = Math.max(0, rawCost - synergyDiscount + supportAddonInr);

        let totalWeeks = 0;
        if (count > 0) {
          totalWeeks = Math.max(2, Math.round((maxWeeks + Math.sqrt(count) * 1.4) * urgencyTimeMult));
        }

        // Update UI
        const priceEl = document.getElementById('est-total-price');
        if (priceEl) priceEl.textContent = formatMoney(finalTotalInr);

        // Update mobile floating dock
        const pmdCount = document.getElementById('pmd-count');
        const pmdPrice = document.getElementById('pmd-price');
        if (pmdCount) pmdCount.textContent = `${count} ${count === 1 ? 'service' : 'services'} selected`;
        if (pmdPrice) pmdPrice.textContent = formatMoney(finalTotalInr);

        const durationEl = document.getElementById('est-duration');
        if (durationEl) durationEl.textContent = count > 0 ? `${totalWeeks}–${totalWeeks + 2} Wks` : '0 Weeks';

        const hoursEl = document.getElementById('est-hours');
        if (hoursEl) hoursEl.textContent = count > 0 ? `${Math.round(totalHours)} Hrs` : '0 Hrs';

        const svcCountEl = document.getElementById('est-service-count');
        if (svcCountEl) svcCountEl.textContent = `${count} Stacked`;

        // Synergy Banner
        const synergyBanner = document.getElementById('est-synergy-banner');
        const synergyAmountEl = document.getElementById('est-synergy-amount');
        if (synergyBanner && synergyAmountEl) {
          if (synergyDiscount > 0) {
            synergyBanner.hidden = false;
            synergyAmountEl.textContent = `-${formatMoney(synergyDiscount)}`;
          } else {
            synergyBanner.hidden = true;
          }
        }

        // Layer Allocation Bar
        const totalLayerCost = buildCost + growCost + runCost || 1;
        const pctBuild = count > 0 ? Math.round((buildCost / totalLayerCost) * 100) : 33;
        const pctGrow = count > 0 ? Math.round((growCost / totalLayerCost) * 100) : 33;
        const pctRun = count > 0 ? 100 - pctBuild - pctGrow : 34;

        const barBuild = document.getElementById('bar-build');
        const barGrow = document.getElementById('bar-grow');
        const barRun = document.getElementById('bar-run');
        if (barBuild) barBuild.style.width = `${pctBuild}%`;
        if (barGrow) barGrow.style.width = `${pctGrow}%`;
        if (barRun) barRun.style.width = `${pctRun}%`;

        const pctBuildEl = document.getElementById('pct-build');
        const pctGrowEl = document.getElementById('pct-grow');
        const pctRunEl = document.getElementById('pct-run');
        if (pctBuildEl) pctBuildEl.textContent = `${pctBuild}%`;
        if (pctGrowEl) pctGrowEl.textContent = `${pctGrow}%`;
        if (pctRunEl) pctRunEl.textContent = `${pctRun}%`;

        // Milestones
        const m1 = document.getElementById('ms-time-1');
        const m2 = document.getElementById('ms-time-2');
        const m3 = document.getElementById('ms-time-3');
        const m4 = document.getElementById('ms-time-4');
        if (count > 0 && totalWeeks > 0) {
          const w1 = Math.max(1, Math.round(totalWeeks * 0.25));
          const w2 = Math.max(w1 + 1, Math.round(totalWeeks * 0.6));
          const w3 = Math.max(w2 + 1, Math.round(totalWeeks * 0.85));
          const w4 = totalWeeks;
          if (m1) m1.textContent = `Weeks 1–${w1}`;
          if (m2) m2.textContent = `Weeks ${w1}–${w2}`;
          if (m3) m3.textContent = `Weeks ${w2}–${w3}`;
          if (m4) m4.textContent = `Weeks ${w3}–${w4}`;
        } else {
          if (m1) m1.textContent = 'Weeks 1–2';
          if (m2) m2.textContent = 'Weeks 2–4';
          if (m3) m3.textContent = 'Weeks 4–5';
          if (m4) m4.textContent = 'Weeks 5–6';
        }

        // Update basket count indicator
        const basketCountEl = document.getElementById('est-basket-count');
        if (basketCountEl) basketCountEl.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;

        // Render basket list
        const basketList = document.getElementById('est-basket-items');
        if (basketList) {
          if (count === 0) {
            basketList.innerHTML = `<li class="basket-empty-msg text-muted">No services selected. Pick services from the catalog list to model your project.</li>`;
          } else {
            basketList.innerHTML = selectedServices
              .map((svc) => {
                const { cost } = getServiceBaseMetrics(svc);
                const scaledCost = cost * tierMultiplier * urgencyCostMult;
                return `
                  <li class="basket-item">
                    <div class="basket-item-info">
                      <span class="basket-layer-pill layer-${svc.layer}">${svc.layer}</span>
                      <span class="basket-item-name" title="${svc.name}">${svc.name}</span>
                    </div>
                    <div class="basket-item-right">
                      <span class="mono basket-item-price">${formatMoney(scaledCost)}</span>
                      <button type="button" class="basket-remove-btn" data-remove-id="${svc.id}" title="Remove ${svc.name} from scope" aria-label="Remove">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <line x1="18" y1="6" x2="6" y2="18"></line>
                          <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                      </button>
                    </div>
                  </li>
                `;
              })
              .join('');

            basketList.querySelectorAll<HTMLButtonElement>('[data-remove-id]').forEach((btn) => {
              btn.addEventListener('click', () => {
                const id = btn.dataset.removeId;
                if (id) {
                  selectedServiceIds.delete(id);
                  const checkbox = document.querySelector<HTMLInputElement>(`.planner-svc-checkbox[value="${id}"]`);
                  if (checkbox) {
                    checkbox.checked = false;
                    checkbox.closest('.svc-select-item')?.classList.remove('is-selected');
                  }
                  recalculateEstimate();
                }
              });
            });
          }
        }

        const submitBtn = document.getElementById('btn-submit-estimate') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = count === 0;
        }
      }

      // Update base prices in planner list
      function updatePlannerBasePriceLabels() {
        document.querySelectorAll<HTMLElement>('.svc-select-item').forEach((item) => {
          const code = item.dataset.svcCode || '';
          const name = item.dataset.svcName || '';
          const { cost } = getServiceBaseMetrics({ code, name });
          const priceSpan = item.querySelector<HTMLElement>('[data-base-price]');
          const p = state.pricing?.[code];
          const isStarting = p?.type === 'starting' || p?.type === 'package';
          const prefix = isStarting ? 'From ' : '';
          if (priceSpan) {
            if (p && (p.small?.price !== null || p.mid?.price !== null || p.packages?.[0]?.price !== null)) {
              priceSpan.textContent = `${prefix}${formatMoney(cost)}`;
            } else {
              priceSpan.textContent = 'On quote';
            }
          }
        });
      }

      // Initial populate
      updatePlannerBasePriceLabels();

      // Checkbox changes
      const serviceCheckboxes = document.querySelectorAll<HTMLInputElement>('.planner-svc-checkbox');
      serviceCheckboxes.forEach((checkbox) => {
        checkbox.addEventListener('change', () => {
          const id = checkbox.value;
          const card = checkbox.closest('.svc-select-item');
          if (checkbox.checked) {
            selectedServiceIds.add(id);
            card?.classList.add('is-selected');
          } else {
            selectedServiceIds.delete(id);
            card?.classList.remove('is-selected');
          }
          recalculateEstimate();
        });
      });

      // Tier Radio
      document.querySelectorAll<HTMLInputElement>('input[name="project-tier"]').forEach((radio) => {
        radio.addEventListener('change', () => {
          document.querySelectorAll('.tier-card').forEach((tc) => tc.classList.remove('is-checked'));
          radio.closest('.tier-card')?.classList.add('is-checked');
          recalculateEstimate();
        });
      });

      document.getElementById('planner-urgency')?.addEventListener('change', recalculateEstimate);
      document.getElementById('planner-support')?.addEventListener('change', recalculateEstimate);

      // Currency Switcher
      document.querySelectorAll<HTMLButtonElement>('.curr-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.curr-pill').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          plannerCurrency = (btn.dataset.curr as 'INR' | 'USD') || 'INR';

          updatePlannerBasePriceLabels();
          recalculateEstimate();
        });
      });

      // Preset Stacks
      function applyPreset(presetKey: string) {
        selectedServiceIds.clear();
        serviceCheckboxes.forEach((cb) => {
          cb.checked = false;
          cb.closest('.svc-select-item')?.classList.remove('is-selected');
        });

        let targetKeywords: string[] = [];
        let targetTier = 'starter';

        if (presetKey === 'mvp') {
          targetKeywords = ['website development', 'brand identity', 'business registration'];
          targetTier = 'starter';
        } else if (presetKey === 'ai-ops') {
          targetKeywords = ['web application', 'ai', 'automation', 'crm'];
          targetTier = 'growth';
        } else if (presetKey === 'ecommerce') {
          targetKeywords = ['e-commerce', 'marketplace', 'seo'];
          targetTier = 'growth';
        } else if (presetKey === 'enterprise') {
          targetKeywords = ['saas', 'mobile app', 'cloud', 'operations'];
          targetTier = 'enterprise';
        }

        targetKeywords.forEach((kw) => {
          const match = state.allServices.find((s) => s.name.toLowerCase().includes(kw));
          if (match) {
            selectedServiceIds.add(match.id);
            const cb = document.querySelector<HTMLInputElement>(`.planner-svc-checkbox[value="${match.id}"]`);
            if (cb) {
              cb.checked = true;
              cb.closest('.svc-select-item')?.classList.add('is-selected');
            }
          }
        });

        const tierRadio = document.querySelector<HTMLInputElement>(`input[name="project-tier"][value="${targetTier}"]`);
        if (tierRadio) {
          tierRadio.checked = true;
          document.querySelectorAll('.tier-card').forEach((tc) => tc.classList.remove('is-checked'));
          tierRadio.closest('.tier-card')?.classList.add('is-checked');
        }

        recalculateEstimate();
        showToast(`Loaded ${presetKey.toUpperCase()} preset template`, 'info');
      }

      document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const preset = btn.dataset.preset;
          if (preset) applyPreset(preset);
        });
      });

      // Matrix Search Filter
      const matrixSearch = document.getElementById('planner-service-search') as HTMLInputElement;
      const matrixLayerPills = document.querySelectorAll<HTMLButtonElement>('.mlp-btn');
      let currentMatrixLayer = 'all';

      function filterPlannerMatrix() {
        const query = matrixSearch?.value.trim().toLowerCase() || '';
        document.querySelectorAll<HTMLElement>('.svc-select-item').forEach((item) => {
          const layer = item.dataset.svcLayer;
          const searchData = item.dataset.search || '';
          const matchesLayer = currentMatrixLayer === 'all' || layer === currentMatrixLayer;
          const matchesQuery = !query || searchData.includes(query);
          item.hidden = !(matchesLayer && matchesQuery);
        });
      }

      matrixSearch?.addEventListener('input', filterPlannerMatrix);
      matrixLayerPills.forEach((btn) => {
        btn.addEventListener('click', () => {
          matrixLayerPills.forEach((b) => b.classList.remove('is-on'));
          btn.classList.add('is-on');
          currentMatrixLayer = btn.dataset.layerFilter || 'all';
          filterPlannerMatrix();
        });
      });

      // Reset
      document.getElementById('btn-reset-planner')?.addEventListener('click', () => {
        selectedServiceIds.clear();
        serviceCheckboxes.forEach((cb) => {
          cb.checked = false;
          cb.closest('.svc-select-item')?.classList.remove('is-selected');
        });
        recalculateEstimate();
        showToast('Planner reset to empty state', 'info');
      });

      // Submit as Project Requests Custom Modal Flow
      const btnSubmitEstimate = document.getElementById('btn-submit-estimate') as HTMLButtonElement;
      const modalSubmitStack = document.getElementById('modal-confirm-submit-stack') as HTMLElement;
      const btnConfirmSubmitPipeline = document.getElementById('btn-confirm-submit-pipeline') as HTMLButtonElement;
      const modalSubmitProjName = document.getElementById('modal-submit-proj-name') as HTMLInputElement;
      const modalSubmitCount = document.getElementById('modal-submit-count') as HTMLElement;
      const modalSubmitPrice = document.getElementById('modal-submit-price') as HTMLElement;
      const modalSubmitTimeline = document.getElementById('modal-submit-timeline') as HTMLElement;
      const modalSubmitHours = document.getElementById('modal-submit-hours') as HTMLElement;
      const modalSubmitServicesCount = document.getElementById('modal-submit-services-count') as HTMLElement;
      const modalSubmitServicesList = document.getElementById('modal-submit-services-list') as HTMLElement;

      // When clicking "Submit as Project Requests" on the planner sticky board
      btnSubmitEstimate?.addEventListener('click', () => {
        const selectedServices = state.allServices.filter((s) => selectedServiceIds.has(s.id));
        if (selectedServices.length === 0) {
          showToast('Please select at least 1 service to submit a project scope.', 'warn');
          return;
        }

        const projectName = (document.getElementById('planner-project-name') as HTMLInputElement)?.value.trim() || 'Ascelstack Custom Growth Stack';
        if (modalSubmitProjName) modalSubmitProjName.value = projectName;

        if (modalSubmitCount) modalSubmitCount.textContent = `${selectedServices.length}`;
        if (modalSubmitPrice) modalSubmitPrice.textContent = document.getElementById('est-total-price')?.textContent || '₹0';
        if (modalSubmitTimeline) modalSubmitTimeline.textContent = document.getElementById('est-duration')?.textContent || 'Weeks 1–4';
        if (modalSubmitHours) modalSubmitHours.textContent = document.getElementById('est-hours')?.textContent || '0 hrs';
        if (modalSubmitServicesCount) modalSubmitServicesCount.textContent = `${selectedServices.length} ${selectedServices.length === 1 ? 'service' : 'services'}`;

        const tierInput = document.querySelector<HTMLInputElement>('input[name="project-tier"]:checked');
        const tier = tierInput?.value || 'starter';
        let tierMultiplier = 1.0;
        if (tier === 'growth') tierMultiplier = 1.5;
        if (tier === 'enterprise') tierMultiplier = 2.2;

        const urgencySelect = document.getElementById('planner-urgency') as HTMLSelectElement;
        let urgencyCostMult = 1.0;
        if (urgencySelect?.value === 'sprint') urgencyCostMult = 1.2;
        if (urgencySelect?.value === 'phased') urgencyCostMult = 0.95;

        // Render services in the modal scope list
        if (modalSubmitServicesList) {
          modalSubmitServicesList.innerHTML = selectedServices
            .map((svc) => {
              const { cost } = getServiceBaseMetrics(svc);
              const scaledCost = cost * tierMultiplier * urgencyCostMult;
              return `
                <li class="submit-svc-item">
                  <div class="submit-svc-left">
                    <span class="basket-layer-pill layer-${svc.layer}">${svc.layer}</span>
                    <span class="mono submit-svc-code">${svc.code}</span>
                    <strong class="submit-svc-name" title="${svc.name}">${svc.name}</strong>
                  </div>
                  <span class="mono submit-svc-price">${formatMoney(scaledCost)}</span>
                </li>
              `;
            })
            .join('');
        }

        if (modalSubmitStack) {
          modalSubmitStack.hidden = false;
        }
      });

      // Confirm button inside modal
      btnConfirmSubmitPipeline?.addEventListener('click', async () => {
        const selectedServices = state.allServices.filter((s) => selectedServiceIds.has(s.id));
        if (selectedServices.length === 0) return;

        const projectName = modalSubmitProjName?.value.trim() || 'Ascelstack Custom Growth Stack';
        const tierInput = document.querySelector<HTMLInputElement>('input[name="project-tier"]:checked');
        const tier = tierInput?.value || 'starter';
        const urgency = (document.getElementById('planner-urgency') as HTMLSelectElement)?.value || 'standard';

        btnConfirmSubmitPipeline.disabled = true;
        btnConfirmSubmitPipeline.innerHTML = '<span>Submitting...</span>';

        let successCount = 0;
        let duplicateCount = 0;

        for (const svc of selectedServices) {
          try {
            const requirements = `[Project Estimation Planner: ${projectName}] Scale: ${tier.toUpperCase()}, Urgency: ${urgency.toUpperCase()}. Configured via Client Portal Planner.`;
            const res = await fetch('/api/customer/service-requests', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ serviceId: svc.id, requirements }),
            });

            if (res.ok) {
              successCount++;
            } else if (res.status === 409) {
              duplicateCount++;
            }
          } catch (e) {
            console.error('Failed to submit service:', svc.name, e);
          }
        }

        btnConfirmSubmitPipeline.disabled = false;
        btnConfirmSubmitPipeline.innerHTML = '<span>Submit</span><span class="arrow">→</span>';

        if (modalSubmitStack) {
          modalSubmitStack.hidden = true;
        }

        if (successCount > 0) {
          showToast(`Successfully registered ${successCount} service requests!`, 'success');
          syncDashboardData(true);
          try {
            const bc = new BroadcastChannel('asc_customer_sync');
            bc.postMessage({ type: 'SERVICES_REGISTERED', count: successCount, timestamp: Date.now() });
            bc.close();
          } catch {}
          try {
            localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
          } catch {}
          switchTab('my-services');
        } else if (duplicateCount > 0) {
          showToast('Selected services are already active or pending in your pipeline.', 'info');
        } else {
          showToast('Failed to submit requests. Please try again.', 'error');
        }
      });

      // SOW Export Modal
      const modalSow = document.getElementById('modal-sow-export') as HTMLElement;
      document.getElementById('btn-export-sow')?.addEventListener('click', () => {
        const selectedServices = state.allServices.filter((s) => selectedServiceIds.has(s.id));
        if (selectedServices.length === 0) {
          showToast('Select at least one service before exporting an estimate.', 'info');
          return;
        }

        const projectName = (document.getElementById('planner-project-name') as HTMLInputElement)?.value.trim() || 'Ascelstack Project';
        const totalPrice = document.getElementById('est-total-price')?.textContent || '₹0';
        const duration = document.getElementById('est-duration')?.textContent || '0 Weeks';
        const hours = document.getElementById('est-hours')?.textContent || '0 Hours';

        document.getElementById('sow-proj-name')!.textContent = projectName;
        document.getElementById('sow-proj-cost')!.textContent = totalPrice;
        document.getElementById('sow-proj-timeline')!.textContent = duration;
        document.getElementById('sow-proj-hours')!.textContent = hours;
        document.getElementById('sow-doc-ref')!.textContent = `EST-${Date.now().toString().slice(-6)}`;
        document.getElementById('sow-doc-date')!.textContent = new Date().toLocaleDateString('en-IN', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        });

        const rowsContainer = document.getElementById('sow-services-rows');
        if (rowsContainer) {
          rowsContainer.innerHTML = selectedServices
            .map((svc) => {
              const { cost } = getServiceBaseMetrics(svc);
              return `
                <tr>
                  <td class="mono">${svc.code || 'ASC-0000'}</td>
                  <td><strong>${svc.name}</strong></td>
                  <td><span class="layer-tag layer-${svc.layer}">${svc.layer}</span></td>
                  <td class="text-muted">${svc.discipline}</td>
                  <td class="mono">${formatMoney(cost)}</td>
                </tr>
              `;
            })
            .join('');
        }

        if (modalSow) modalSow.hidden = false;
      });

      document.getElementById('btn-print-sow')?.addEventListener('click', () => {
        window.print();
      });

      // Default preset
      applyPreset('mvp');

      // ----------------------------------------------------------------------
      // EXPLORE CATALOG SEARCH & MODAL
      // ----------------------------------------------------------------------
      const exploreSearch = document.getElementById('explore-search-input') as HTMLInputElement;
      const exploreCards = document.querySelectorAll<HTMLElement>('.explore-card');
      const exploreLayerFilters = document.querySelectorAll<HTMLButtonElement>('[data-layer-filter]');
      const exploreDiscipline = document.getElementById('explore-discipline-filter') as HTMLSelectElement;
      const exploreNoResults = document.getElementById('explore-no-results');

      let curExpLayer = 'all';
      let curExpDisc = 'all';

      function filterExplore() {
        const query = exploreSearch?.value.trim().toLowerCase() || '';
        let count = 0;
        exploreCards.forEach((card) => {
          const matchLayer = curExpLayer === 'all' || card.dataset.layer === curExpLayer;
          const matchDisc = curExpDisc === 'all' || card.dataset.discipline === curExpDisc;
          const matchQuery = !query || (card.dataset.search?.includes(query) ?? false);
          const ok = matchLayer && matchDisc && matchQuery;
          card.hidden = !ok;
          if (ok) count++;
        });
        if (exploreNoResults) exploreNoResults.hidden = count > 0;
      }

      exploreSearch?.addEventListener('input', filterExplore);
      exploreLayerFilters.forEach((btn) => {
        btn.addEventListener('click', () => {
          exploreLayerFilters.forEach((b) => b.classList.remove('is-on'));
          btn.classList.add('is-on');
          curExpLayer = btn.dataset.layerFilter || 'all';
          filterExplore();
        });
      });
      exploreDiscipline?.addEventListener('change', () => {
        curExpDisc = exploreDiscipline.value;
        filterExplore();
      });

      // Modals close helper
      function closeAnyModal(m: HTMLElement) {
        m.setAttribute('hidden', '');
        m.style.display = 'none';
      }
      function closeAllActiveModals() {
        document.querySelectorAll<HTMLElement>('.modal-backdrop').forEach((m) => closeAnyModal(m));
      }

      document.querySelectorAll('[data-close-modal]').forEach((btn) => {
        btn.addEventListener('click', closeAllActiveModals);
      });

      // Close modal on backdrop click
      document.querySelectorAll<HTMLElement>('.modal-backdrop').forEach((backdrop) => {
        backdrop.addEventListener('click', (e) => {
          if (e.target === backdrop) {
            closeAnyModal(backdrop);
          }
        });
      });

      // Close open modals on Escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeAllActiveModals();
        }
      });

      // Add Service
      const modalAddService = document.getElementById('modal-add-service') as HTMLElement;
      const formAddService = document.getElementById('form-add-service') as HTMLFormElement;

      document.querySelectorAll('[data-action="open-add-service-modal"]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const code = target.dataset.code || '';
          (document.getElementById('modal-svc-id') as HTMLInputElement).value = target.dataset.id || '';
          document.getElementById('modal-svc-name')!.textContent = target.dataset.name || '';
          document.getElementById('modal-svc-code')!.textContent = code;
          document.getElementById('modal-svc-layer')!.textContent = `${target.dataset.layer?.toUpperCase()} LAYER`;
          document.getElementById('modal-svc-desc')!.textContent = target.dataset.desc || '';

          const priceBox = document.getElementById('modal-svc-price-box');
          const p = state.pricing?.[code];
          if (p && priceBox) {
            const isPkg = p.type === 'package';
            const cost = p.small?.price ?? p.mid?.price ?? (p.packages?.[0]?.price ?? null);
            const amt = cost !== null ? formatMoney(cost) : 'On quote';
            const prefix = (p.type === 'starting' || isPkg) && cost !== null ? 'From ' : '';
            const unit = isPkg ? 'one-time (5 packages available)' : (p.small?.unit || 'one-time');
            const typeLabel = isPkg ? '5 PACKAGES AVAILABLE' : p.type === 'fixed' ? 'FIXED PRICE' : 'STARTING PRICE';

            document.getElementById('modal-svc-price-type')!.textContent = typeLabel;
            document.getElementById('modal-svc-price-val')!.textContent = `${prefix}${amt}`;
            document.getElementById('modal-svc-price-unit')!.textContent = `· ${unit}`;
            priceBox.hidden = false;
          } else if (priceBox) {
            priceBox.hidden = true;
          }

          if (modalAddService) modalAddService.hidden = false;
        });
      });

      formAddService?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('btn-submit-request') as HTMLButtonElement;
        submitBtn.disabled = true;
        submitBtn.textContent = 'Saving...';

        const formData = new FormData(formAddService);
        const serviceId = formData.get('serviceId') as string;
        const requirements = formData.get('requirements') as string;

        try {
          const res = await fetch('/api/customer/service-requests', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ serviceId, requirements }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to submit request');

          modalAddService.hidden = true;
          formAddService.reset();
          showToast(`Request registered for ${data.request?.service?.name}! Status: Pending.`, 'success');
          syncDashboardData(true);
          try {
            const bc = new BroadcastChannel('asc_customer_sync');
            bc.postMessage({ type: 'SERVICE_ADDED', timestamp: Date.now() });
            bc.close();
          } catch {}
          try {
            localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
          } catch {}
          switchTab('my-services');
        } catch (err: any) {
          showToast(err.message, 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Submit Request</span><span class="arrow">→</span>';
        }
      });

      // Initialize My Services & Quotation actions
      rebindMyServiceActions();

      // Edit Requirements Form
      const modalEditReq = document.getElementById('modal-edit-req') as HTMLElement;
      const formEditReq = document.getElementById('form-edit-req') as HTMLFormElement;

      formEditReq?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('btn-save-req') as HTMLButtonElement;
        submitBtn.disabled = true;

        const formData = new FormData(formEditReq);
        const requestId = formData.get('requestId') as string;
        const requirements = formData.get('requirements') as string;

        try {
          const res = await fetch('/api/customer/service-requests', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ requestId, requirements }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to update requirements');

          if (modalEditReq) {
            modalEditReq.setAttribute('hidden', '');
            modalEditReq.style.display = 'none';
          }
          showToast('Requirements saved in database', 'success');
          syncDashboardData(true);
          try {
            const bc = new BroadcastChannel('asc_customer_sync');
            bc.postMessage({ type: 'SCOPE_UPDATED', requestId, timestamp: Date.now() });
            bc.close();
          } catch {}
          try {
            localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
          } catch {}
        } catch (err: any) {
          showToast(err.message, 'error');
        } finally {
          submitBtn.disabled = false;
        }
      });

      // Business Form
      const formBusiness = document.getElementById('business-form') as HTMLFormElement;
      formBusiness?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('btn-save-biz') as HTMLButtonElement;
        const statusSpan = document.getElementById('biz-save-status');

        saveBtn.disabled = true;
        if (statusSpan) statusSpan.textContent = 'Saving...';

        const formData = new FormData(formBusiness);
        const payload: Record<string, any> = {};
        formData.forEach((val, key) => {
          payload[key] = typeof val === 'string' ? val.trim() : val;
        });
        if (!payload.id) delete payload.id;

        try {
          const res = await fetch('/api/customer/business', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to update business profile');

          if (data.business?.id) {
            (formBusiness.querySelector('input[name="id"]') as HTMLInputElement).value = data.business.id;
          }

          showToast('Business profile updated successfully', 'success');
          if (statusSpan) statusSpan.textContent = 'Saved';
        } catch (err: any) {
          showToast(err.message, 'error');
          if (statusSpan) statusSpan.textContent = 'Error';
        } finally {
          saveBtn.disabled = false;
        }
      });

      // Profile Form
      const formProfile = document.getElementById('profile-form') as HTMLFormElement;
      formProfile?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('btn-save-profile') as HTMLButtonElement;
        const statusSpan = document.getElementById('profile-save-status');

        saveBtn.disabled = true;
        if (statusSpan) statusSpan.textContent = 'Saving...';

        const formData = new FormData(formProfile);
        const fullName = formData.get('fullName') as string;

        try {
          const res = await fetch('/api/customer/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fullName }),
          });

          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to update profile');

          showToast('Profile name updated successfully', 'success');
          if (statusSpan) statusSpan.textContent = 'Saved';
        } catch (err: any) {
          showToast(err.message, 'error');
          if (statusSpan) statusSpan.textContent = 'Error';
        } finally {
          saveBtn.disabled = false;
        }
      });

      // My Services layer filters
      const myTabs = document.querySelectorAll<HTMLButtonElement>('[data-my-filter]');
      const myCards = document.querySelectorAll<HTMLElement>('.my-service-card');
      myTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          myTabs.forEach((t) => t.classList.remove('is-on'));
          tab.classList.add('is-on');
          const filter = tab.dataset.myFilter;
          myCards.forEach((card) => {
            card.hidden = !(filter === 'all' || card.dataset.myLayer === filter);
          });
        });
      });
    </script>

    <!-- STYLESHEET WITH NO EMOJIS, SLEEK SIDEBAR, AND CONFIRMATION MODALS -->
    <style is:global>
      .dash-body {
        margin: 0;
        background: var(--paper);
        color: var(--text);
        font-family: var(--font-body);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      /* Blueprint background overlay */
      .dash-bg-canvas {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(65% 55% at 75% 15%, rgba(148, 188, 227, 0.32), transparent 70%),
          radial-gradient(45% 45% at 20% 85%, rgba(89, 128, 166, 0.14), transparent 70%),
          var(--paper);
        background-image:
          radial-gradient(65% 55% at 75% 15%, rgba(148, 188, 227, 0.32), transparent 70%),
          radial-gradient(45% 45% at 20% 85%, rgba(89, 128, 166, 0.14), transparent 70%),
          linear-gradient(var(--line) 1px, transparent 1px),
          linear-gradient(90deg, var(--line) 1px, transparent 1px);
        background-size: auto, auto, 64px 64px, 64px 64px;
        opacity: 0.85;
      }

      /* ------------------------------------------------------------- Layout */
      .dash-layout {
        display: grid;
        grid-template-columns: 260px 1fr;
        min-height: 100vh;
        position: relative;
        z-index: 1;
      }

      /* ------------------------------------------------------------- Left Side Sidebar */
      .dash-sidebar {
        background: var(--ink);
        color: var(--text-on-ink);
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--line-on-ink);
        padding: 1.5rem 1.25rem;
        position: sticky;
        top: 0;
        height: 100vh;
        z-index: 40;
        box-shadow: 4px 0 24px -12px rgba(20, 33, 48, 0.3);
      }

      .sidebar-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line-on-ink);
      }
      .sidebar-logo {
        display: inline-flex;
        align-items: center;
      }
      .sidebar-close-btn {
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--line-on-ink);
        border-radius: var(--radius-s);
        color: var(--text-on-ink);
        cursor: pointer;
        padding: 6px;
        transition: background 0.2s, color 0.2s;
      }
      .sidebar-close-btn:hover {
        background: rgba(255, 255, 255, 0.16);
      }

      /* Sidebar Backdrop for mobile/tablet */
      .dash-sidebar-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(10, 18, 28, 0.65);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 45;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      .dash-sidebar-backdrop.is-visible {
        opacity: 1;
        pointer-events: auto;
      }
      body.sidebar-locked {
        overflow: hidden;
      }

      .sidebar-biz-badge {
        padding: 1rem 0;
        display: grid;
        gap: 0.2rem;
        border-bottom: 1px solid var(--line-on-ink);
      }
      .sidebar-biz-tag {
        font-size: 0.65rem;
        letter-spacing: 0.12em;
        color: var(--tint);
      }
      .sidebar-biz-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--paper);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding-top: 1.5rem;
        flex: 1;
        overflow-y: auto;
      }
      .sidebar-nav::-webkit-scrollbar { width: 4px; }
      .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 4px; }

      .nav-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        padding: 0.7rem 0.95rem;
        border-radius: var(--radius-s);
        background: transparent;
        border: 0;
        color: var(--text-on-ink-muted);
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        text-align: left;
        transition: all 0.2s ease;
      }
      .nav-item:hover {
        background: rgba(242, 242, 243, 0.08);
        color: var(--text-on-ink);
      }
      .nav-item.is-active {
        background: rgba(148, 188, 227, 0.18);
        color: var(--tint);
        font-weight: 600;
      }
      .nav-item-highlight {
        color: #94bce3;
      }
      .nav-item svg { flex: none; }

      .pill-chip-new {
        font-size: 0.58rem;
        letter-spacing: 0.08em;
        font-family: var(--font-mono);
        text-transform: uppercase;
        background: var(--accent);
        color: var(--paper);
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        margin-left: auto;
        font-weight: 700;
      }

      .badge-pill {
        margin-left: auto;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        background: rgba(242, 242, 243, 0.15);
        font-size: 0.72rem;
        font-family: var(--font-body);
        font-weight: 700;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        color: var(--text-on-ink);
      }
      .badge-accent {
        background: var(--accent);
        color: var(--paper);
      }

      .sidebar-admin-section {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px dashed rgba(255, 255, 255, 0.15);
        display: grid;
        gap: 0.35rem;
      }
      .sidebar-admin-tag {
        font-size: 0.58rem;
        letter-spacing: 0.1em;
        color: #94bce3;
        padding-left: 0.85rem;
        text-transform: uppercase;
        font-weight: 700;
      }
      .nav-admin-item {
        text-decoration: none;
        color: #e0f2fe;
        background: rgba(14, 165, 233, 0.12);
        border: 1px solid rgba(14, 165, 233, 0.25);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-s);
        font-size: 0.88rem;
        font-weight: 600;
        transition: all 0.15s ease;
      }
      .nav-admin-item:hover {
        background: rgba(14, 165, 233, 0.24);
        color: #ffffff;
        border-color: rgba(14, 165, 233, 0.45);
      }
      .pill-chip-admin {
        font-size: 0.58rem;
        letter-spacing: 0.08em;
        font-family: var(--font-mono);
        text-transform: uppercase;
        background: #0284c7;
        color: #ffffff;
        padding: 0.1rem 0.45rem;
        border-radius: 999px;
        margin-left: auto;
        font-weight: 700;
      }

      .sidebar-footer {
        padding-top: 1rem;
        border-top: 1px solid var(--line-on-ink);
        display: grid;
        gap: 0.35rem;
        margin-top: auto;
      }
      .nav-site-item {
        text-decoration: none;
        color: var(--text-on-ink);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-s);
        font-size: 0.88rem;
        font-weight: 500;
        transition: background 0.15s, color 0.15s;
      }
      .nav-site-item:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }
      .nav-site-item svg {
        flex-shrink: 0;
        opacity: 0.85;
      }
      .nav-logout { color: #f87171; }
      .nav-logout:hover {
        background: rgba(248, 113, 113, 0.15);
        color: #fca5a5;
      }

      /* ------------------------------------------------------------- Main Container & Topbar */
      .dash-main-container {
        display: flex;
        flex-direction: column;
        min-width: 0;
        position: relative;
        z-index: 1;
      }

      .dash-topbar {
        height: 64px;
        background: var(--paper-raised);
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-inline: clamp(1.25rem, 3vw, 2.5rem);
        position: sticky;
        top: 0;
        z-index: 30;
        box-shadow: 0 1px 3px rgba(29, 45, 61, 0.04);
      }

      .topbar-left {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-width: 0;
      }
      .topbar-toggle-btn {
        display: none;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        cursor: pointer;
        color: var(--ink);
        padding: 0;
        flex-shrink: 0;
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
      }
      .topbar-toggle-btn:hover {
        background: var(--paper-sunk);
        border-color: rgba(20, 33, 48, 0.25);
      }
      .topbar-toggle-btn:active {
        transform: scale(0.96);
      }
      .topbar-page-name {
        margin: 0;
        font-family: var(--font-body);
        font-size: clamp(1.15rem, 2.5vw, 1.35rem);
        font-weight: 700;
        color: var(--ink);
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2;
      }
      .dash-breadcrumbs {
        display: none;
      }

      .cust-qc-actions {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding-top: 0.85rem;
        border-top: 1px dashed var(--line);
        margin-top: 0.85rem;
        flex-wrap: wrap;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }
      .btn-text-link {
        font-size: 0.78rem;
        color: var(--text-muted);
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        transition: all 0.2s ease;
      }
      .btn-text-link:hover {
        color: var(--ink);
        background: var(--paper-sunk);
      }
      .topbar-icon-btn {
        position: relative;
        background: none;
        border: 0;
        cursor: pointer;
        color: var(--text-muted);
        display: grid;
        place-items: center;
        padding: 6px;
        border-radius: 50%;
        transition: background 0.2s, color 0.2s;
      }
      .topbar-icon-btn:hover {
        background: var(--paper-sunk);
        color: var(--ink);
      }
      .notif-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        min-width: 14px;
        height: 14px;
        background: var(--accent);
        color: white;
        font-size: 0.62rem;
        border-radius: 999px;
        display: grid;
        place-items: center;
        padding: 0 3px;
        font-family: var(--font-mono);
      }
      .clerk-user-slot { display: flex; align-items: center; }

      .cloud-sync-status {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.72rem;
        color: var(--text-muted);
        background: rgba(29, 45, 61, 0.05);
        border: 1px solid rgba(29, 45, 61, 0.12);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .cloud-sync-status:hover {
        background: rgba(29, 45, 61, 0.09);
        color: var(--ink);
      }
      .sync-indicator-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #10b981;
        display: inline-block;
      }
      .sync-indicator-dot.live-pulse {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        animation: pulseSyncDot 2s infinite;
      }
      .sync-indicator-dot.is-syncing {
        background: var(--accent);
        box-shadow: 0 0 0 0 rgba(89, 128, 166, 0.7);
        animation: pulseSyncDot 0.6s infinite;
      }
      @keyframes pulseSyncDot {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }
      .admin-quick-switch-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: var(--ink);
        color: var(--paper);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        text-decoration: none;
        transition: all 0.2s ease;
      }
      .admin-quick-switch-btn:hover {
        background: var(--accent);
        color: #ffffff;
      }

      /* ------------------------------------------------------------- Content Area */
      .dash-content {
        padding: clamp(1.25rem, 3vw, 2.5rem);
        flex: 1;
      }
      .dash-view {
        display: none;
        animation: fadeIn 0.3s ease;
      }
      .dash-view.is-active { display: block; }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: none; }
      }

      /* ------------------------------------------------------------- Welcome Card */
      .dash-welcome-card {
        background: radial-gradient(45% 120% at 85% 0%, rgba(148, 188, 227, 0.35), transparent 70%), var(--paper-raised);
        border: 1px solid rgba(29, 45, 61, 0.12);
        border-radius: var(--radius-l);
        padding: clamp(1.75rem, 3vw, 2.5rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.85) inset, 0 18px 36px -18px rgba(29, 45, 61, 0.12);
      }
      .welcome-title {
        font-size: clamp(2rem, 1.4rem + 1.4vw, 2.9rem);
        margin-block: 0.35rem 0.55rem;
      }
      .welcome-desc {
        color: var(--text-muted);
        max-width: 58ch;
        font-size: 0.96rem;
        line-height: 1.55;
      }
      .welcome-actions {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        flex: none;
      }

      /* ------------------------------------------------------------- 4 Metrics Grid */
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
      }
      .metric-card {
        background: var(--paper-raised);
        border: 1px solid rgba(29, 45, 61, 0.12);
        border-radius: var(--radius);
        padding: 1.35rem 1.5rem;
        display: grid;
        gap: 0.35rem;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 12px 24px -14px rgba(29, 45, 61, 0.1);
        transition: transform 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
      }
      .metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 18px 36px -16px rgba(29, 45, 61, 0.16);
      }
      .metric-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .metric-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.08em;
      }
      .metric-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--tint);
      }
      .dot-accent { background: var(--accent); }
      .dot-warn { background: #d97706; }
      .dot-success { background: #16a34a; }

      .metric-value {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: clamp(2.4rem, 1.8rem + 1.5vw, 3.25rem);
        line-height: 1;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        color: var(--ink);
      }
      .metric-hint { font-size: 0.8rem; color: var(--text-muted); }
      .text-accent { color: var(--accent); }
      .text-warn { color: #d97706; }
      .text-success { color: #16a34a; }

      /* ------------------------------------------------------------- Planner Callout */
      .planner-teaser-card {
        background: radial-gradient(40% 120% at 90% 20%, rgba(89, 128, 166, 0.25), transparent 70%), var(--ink);
        color: var(--text-on-ink);
        border-radius: var(--radius-l);
        padding: clamp(1.75rem, 3vw, 2.5rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 20px 40px -20px rgba(20, 33, 48, 0.4);
      }
      .planner-teaser-card .eyebrow { color: var(--tint); }
      .planner-teaser-card .eyebrow::before { background: currentColor; }
      .planner-teaser-card .display em { color: var(--tint); }
      .planner-teaser-card .lead { color: var(--text-on-ink-muted); }
      .planner-teaser-card .btn-primary { background: var(--paper); color: var(--ink); }
      .planner-teaser-card .btn-primary:hover { background: var(--tint); color: var(--ink-deep); }

      /* ------------------------------------------------------------- Panels & Tables */
      .overview-columns {
        display: grid;
        grid-template-columns: 2fr 1.15fr;
        gap: 1.5rem;
      }
      .card-panel {
        background: var(--paper-raised);
        border: 1px solid rgba(29, 45, 61, 0.12);
        border-radius: var(--radius-l);
        padding: clamp(1.5rem, 3vw, 2.25rem);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 18px 36px -18px rgba(29, 45, 61, 0.1);
      }
      .max-form-panel { max-width: 860px; }
      .panel-header {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
      }
      .panel-header-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.75rem;
      }
      .panel-title { color: var(--ink); }
      .panel-subtitle {
        color: var(--text-muted);
        font-size: 0.88rem;
        margin-top: 0.25rem;
      }
      .text-link {
        background: none;
        border: 0;
        color: var(--accent);
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
      }
      .text-link:hover { text-decoration: underline; }

      .requests-table-wrap { overflow-x: auto; }
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }
      .data-table th {
        text-align: left;
        padding: 0.75rem 0.85rem;
        border-bottom: 1px solid var(--line);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .data-table td {
        padding: 0.95rem 0.85rem;
        border-bottom: 1px solid rgba(29, 45, 61, 0.06);
        vertical-align: middle;
      }
      .table-service-name { display: grid; gap: 0.15rem; }
      .table-code { font-size: 0.72rem; color: var(--text-muted); }

      /* ------------------------------------------------------------- Tags */
      .layer-tag {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .layer-build { background: rgba(148, 188, 227, 0.4); color: #142130; }
      .layer-grow { background: rgba(89, 128, 166, 0.3); color: #142130; }
      .layer-run { background: rgba(29, 45, 61, 0.15); color: #142130; }

      .status-tag {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .status-pending { background: #fef3c7; color: #92400e; }
      .status-reviewing { background: #dbeafe; color: #1e40af; }
      .status-approved { background: #dcfce7; color: #15803d; }
      .status-active { background: var(--ink); color: var(--paper); }
      .status-completed { background: #f3f4f6; color: #374151; }
      .status-cancelled { background: #fee2e2; color: #991b1b; }

      /* ------------------------------------------------------------- Activity Feed */
      .activity-feed {
        display: grid;
        gap: 1.15rem;
        position: relative;
      }
      .activity-item {
        display: flex;
        gap: 0.85rem;
        align-items: flex-start;
      }
      .activity-bullet {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        margin-top: 0.4rem;
        flex: none;
      }
      .activity-body { display: grid; gap: 0.15rem; }
      .activity-desc { font-size: 0.88rem; line-height: 1.4; }
      .activity-time { font-size: 0.72rem; color: var(--text-muted); }

      /* ------------------------------------------------------------- Empty State */
      .empty-state {
        padding: 3rem 1.5rem;
        text-align: center;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 0.75rem;
      }
      .empty-icon {
        color: var(--accent);
        margin-bottom: 0.25rem;
      }
      .empty-title { font-size: 1.6rem; color: var(--ink); }
      .empty-desc { color: var(--text-muted); font-size: 0.95rem; max-width: 46ch; }
      .empty-actions { display: flex; gap: 0.75rem; margin-top: 0.5rem; }

      /* ============================================================== */
      /* STYLES: PROJECT ESTIMATION PLANNER */
      /* ============================================================== */
      .planner-hero-card {
        background: radial-gradient(40% 120% at 85% 0%, rgba(148, 188, 227, 0.35), transparent 70%), var(--paper-raised);
        border: 1px solid rgba(29, 45, 61, 0.12);
        border-radius: var(--radius-l);
        padding: clamp(2rem, 4vw, 3rem);
        margin-bottom: 2rem;
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.85) inset, 0 20px 40px -20px rgba(29, 45, 61, 0.12);
      }
      .preset-stacks-box {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
      }
      .preset-title {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.12em;
        display: block;
        margin-bottom: 0.75rem;
      }
      .preset-buttons-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 0.75rem;
      }
      .preset-btn {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
        text-align: left;
        cursor: pointer;
        display: grid;
        gap: 0.15rem;
        transition: all 0.2s var(--ease-out);
      }
      .preset-btn:hover {
        background: var(--paper-raised);
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -10px rgba(29, 45, 61, 0.15);
      }
      .preset-tag {
        font-family: var(--font-body);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        color: var(--accent);
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        margin-bottom: 0.1rem;
      }
      .preset-name { font-size: 0.92rem; font-weight: 700; color: var(--ink); }
      .preset-sub { font-size: 0.75rem; color: var(--text-muted); }

      .planner-workspace-grid {
        display: grid;
        grid-template-columns: 1.7fr 1.3fr;
        gap: 2rem;
        align-items: flex-start;
      }
      .planner-left-pane { display: grid; gap: 2rem; }
      .planner-params-form { display: grid; gap: 1.25rem; }

      .currency-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--paper);
        padding: 0.25rem;
        border-radius: 999px;
        border: 1px solid var(--line);
      }
      .curr-pill {
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        border: 0;
        background: transparent;
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        cursor: pointer;
        color: var(--text-muted);
        transition: all 0.2s;
      }
      .curr-pill.is-active {
        background: var(--ink);
        color: var(--paper);
      }

      .tier-options-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 0.75rem;
      }
      .tier-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1rem;
        cursor: pointer;
        transition: all 0.2s;
        position: relative;
        display: block;
      }
      .tier-card input { position: absolute; opacity: 0; pointer-events: none; }
      .tier-card.is-checked {
        border-color: var(--accent);
        background: radial-gradient(60% 120% at 90% 0%, rgba(148, 188, 227, 0.25), transparent 70%), var(--paper-raised);
        box-shadow: 0 0 0 2px var(--accent);
      }
      .tier-badge {
        font-family: var(--font-body);
        font-size: 0.68rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        background: var(--paper-sunk);
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        color: var(--ink);
        display: inline-block;
        margin-bottom: 0.4rem;
        letter-spacing: 0.02em;
      }
      .tier-title {
        display: block;
        font-size: 1rem;
        color: var(--ink);
        margin-bottom: 0.25rem;
      }
      .tier-desc { font-size: 0.78rem; color: var(--text-muted); line-height: 1.35; display: block; }

      .matrix-filter-bar { display: grid; gap: 0.85rem; margin-bottom: 1.25rem; }
      .matrix-search {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.65rem 1.15rem;
      }
      .matrix-search input {
        border: 0;
        background: transparent;
        outline: 0;
        flex: 1;
        font-size: 0.88rem;
      }
      .matrix-layer-pills { display: flex; gap: 0.35rem; flex-wrap: wrap; }
      .mlp-btn {
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--paper);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .mlp-btn.is-on {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
      }
      .mlp-build.is-on { background: #38bdf8; color: #082f49; border-color: #38bdf8; }
      .mlp-grow.is-on { background: var(--accent); color: white; border-color: var(--accent); }
      .mlp-run.is-on { background: var(--ink-deep); color: white; border-color: var(--ink-deep); }
      .selected-counter { font-size: 0.75rem; color: var(--accent); font-weight: 600; }

      .planner-services-list {
        display: grid;
        gap: 0.65rem;
        max-height: 480px;
        overflow-y: auto;
        padding-right: 0.5rem;
      }
      .svc-select-item {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.9rem 1.15rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .svc-select-item:hover { background: var(--paper-raised); border-color: rgba(29, 45, 61, 0.25); }
      .svc-select-item.is-selected {
        border-color: var(--accent);
        background: radial-gradient(40% 120% at 95% 0%, rgba(148, 188, 227, 0.25), transparent 70%), var(--paper-raised);
        box-shadow: 0 0 0 1.5px var(--accent);
      }
      .planner-svc-checkbox {
        margin-top: 0.35rem;
        width: 17px;
        height: 17px;
        accent-color: var(--accent);
        cursor: pointer;
      }
      .svc-select-body { flex: 1; }
      .svc-select-top {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
      }
      .svc-select-code { font-size: 0.68rem; color: var(--text-muted); }
      .svc-select-disc { font-size: 0.75rem; color: var(--text-muted); }
      .svc-select-base-price {
        margin-left: auto;
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .svc-select-title { font-size: 0.98rem; color: var(--ink); display: block; }
      .svc-select-desc { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.15rem; line-height: 1.4; }

      /* Sticky Estimate Card */
      .sticky-estimate-card {
        background: var(--paper-raised);
        border: 1px solid rgba(29, 45, 61, 0.14);
        border-radius: var(--radius-l);
        padding: clamp(1.5rem, 3vw, 2.25rem);
        box-shadow: 0 1px 0 rgba(255, 255, 255, 0.8) inset, 0 24px 48px -24px rgba(29, 45, 61, 0.2);
        position: sticky;
        top: 5rem;
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
      }
      .sticky-estimate-card::-webkit-scrollbar {
        width: 5px;
      }
      .sticky-estimate-card::-webkit-scrollbar-thumb {
        background: rgba(20, 33, 48, 0.15);
        border-radius: 999px;
      }

      /* Mobile Planner Dock (hidden on desktop) */
      .planner-mobile-dock {
        display: none;
      }
      .est-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
      }
      .est-badge {
        font-size: 0.65rem;
        background: rgba(16, 185, 129, 0.12);
        color: #10b981;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-weight: 600;
      }
      .est-price-block {
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .est-price-label { font-size: 0.75rem; color: var(--text-muted); letter-spacing: 0.1em; }
      .est-price-value {
        font-family: var(--font-body);
        font-weight: 800;
        font-size: clamp(2.4rem, 1.8rem + 1.8vw, 3.5rem);
        color: var(--ink);
        line-height: 1.05;
        margin-top: 0.25rem;
        letter-spacing: -0.03em;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        white-space: nowrap;
        word-break: normal;
      }
      .est-synergy-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(16, 185, 129, 0.12);
        color: #15803d;
        border-radius: 999px;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 0.65rem;
      }
      .est-synergy-pill .mono {
        font-family: var(--font-body);
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
      }

      .est-metrics-row {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
      }
      .est-metric { display: grid; gap: 0.2rem; }
      .est-m-label { font-size: 0.65rem; color: var(--text-muted); letter-spacing: 0.08em; }
      .est-m-val {
        font-family: var(--font-body);
        font-size: clamp(1.05rem, 0.95rem + 0.3vw, 1.25rem);
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        color: var(--ink);
        letter-spacing: -0.015em;
        line-height: 1.15;
      }

      .est-breakdown-box { margin-bottom: 1.5rem; }
      .est-subhead {
        font-size: 0.7rem;
        color: var(--text-muted);
        letter-spacing: 0.1em;
        display: block;
        margin-bottom: 0.65rem;
      }
      .est-progress-bar {
        height: 10px;
        border-radius: 999px;
        background: var(--paper-sunk);
        display: flex;
        overflow: hidden;
        margin-bottom: 0.5rem;
      }
      .epb-segment { height: 100%; transition: width 0.3s ease; }
      .epb-build { background: var(--tint); }
      .epb-grow { background: var(--accent); }
      .epb-run { background: var(--ink); }
      .est-legend {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: var(--text-muted);
      }
      .est-legend strong {
        font-family: var(--font-body);
        font-weight: 800;
        color: var(--ink);
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
      }
      .leg-item { display: inline-flex; align-items: center; gap: 0.35rem; }
      .leg-dot { width: 7px; height: 7px; border-radius: 50%; }
      .leg-build { background: var(--tint); }
      .leg-grow { background: var(--accent); }
      .leg-run { background: var(--ink); }

      .est-milestones-box { margin-bottom: 1.5rem; }
      .milestone-timeline {
        display: grid;
        gap: 0.75rem;
        position: relative;
        padding-left: 0.5rem;
      }
      .ms-node { display: flex; gap: 0.75rem; align-items: center; }
      .ms-dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--paper-sunk);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        flex: none;
      }
      .ms-body { display: grid; gap: 0.1rem; font-size: 0.85rem; }
      .ms-body .mono {
        font-family: var(--font-body);
        font-size: 0.74rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
      }

      .est-basket-box {
        margin-bottom: 1.5rem;
        background: var(--paper-sunk);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
      }
      .est-basket-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.5rem;
      }
      .est-basket-header .est-subhead {
        margin-bottom: 0;
      }
      .est-basket-list {
        display: grid;
        gap: 0.5rem;
        max-height: 220px;
        overflow-y: auto;
        padding-right: 0.25rem;
        margin: 0;
        padding-left: 0;
        list-style: none;
      }
      .est-basket-list::-webkit-scrollbar {
        width: 4px;
      }
      .est-basket-list::-webkit-scrollbar-thumb {
        background: rgba(20, 33, 48, 0.15);
        border-radius: 4px;
      }
      .basket-empty-msg {
        font-size: 0.82rem;
        color: var(--text-muted);
        list-style: none;
        padding: 0.5rem 0;
        line-height: 1.45;
      }
      .basket-item {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.55rem 0.75rem;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 1px 3px rgba(20, 33, 48, 0.03);
      }
      .basket-item:hover {
        border-color: var(--line-strong);
        box-shadow: 0 3px 8px -2px rgba(20, 33, 48, 0.08);
      }
      .basket-item-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        flex: 1;
      }
      .basket-layer-pill {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.15rem 0.45rem;
        border-radius: 999px;
        flex: none;
      }
      .basket-layer-pill.layer-build {
        background: rgba(148, 188, 227, 0.25);
        color: #142130;
        border: 1px solid rgba(148, 188, 227, 0.55);
      }
      .basket-layer-pill.layer-grow {
        background: rgba(16, 185, 129, 0.12);
        color: #065f46;
        border: 1px solid rgba(16, 185, 129, 0.35);
      }
      .basket-layer-pill.layer-run {
        background: rgba(245, 158, 11, 0.12);
        color: #92400e;
        border: 1px solid rgba(245, 158, 11, 0.35);
      }
      .basket-item-name {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .basket-item-right {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex: none;
      }
      .basket-item-price {
        font-family: var(--font-body);
        font-size: 0.82rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .basket-remove-btn {
        width: 22px;
        height: 22px;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--paper);
        color: var(--text-muted);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        padding: 0;
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .basket-remove-btn:hover {
        background: rgba(239, 68, 68, 0.1);
        border-color: rgba(239, 68, 68, 0.4);
        color: #ef4444;
        transform: scale(1.12);
      }
      .basket-remove-btn:active {
        transform: scale(0.92);
      }

      /* Submit Scope Modal Styles */
      .modal-dialog-submit {
        max-width: 620px;
        width: 100%;
      }
      .submit-summary-box {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        display: grid;
        gap: 0.85rem;
      }
      .submit-summary-top {
        display: grid;
        gap: 0.35rem;
      }
      .submit-summary-label {
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }
      .submit-proj-name-input {
        width: 100%;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        padding: 0.55rem 0.85rem;
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--ink);
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .submit-proj-name-input:focus {
        border-color: var(--accent);
        outline: none;
        box-shadow: 0 0 0 3px rgba(148, 188, 227, 0.25);
      }
      .submit-metrics-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.65rem;
        padding-top: 0.85rem;
        border-top: 1px dashed var(--line);
      }
      .submit-metric-cell {
        display: grid;
        gap: 0.2rem;
      }
      .submit-metric-cell .cell-label {
        font-size: 0.62rem;
        letter-spacing: 0.08em;
        color: var(--text-muted);
      }
      .submit-metric-cell .cell-val {
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .submit-scope-section {
        display: grid;
        gap: 0.5rem;
      }
      .submit-scope-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .submit-services-list {
        list-style: none;
        padding: 0;
        margin: 0;
        max-height: 180px;
        overflow-y: auto;
        display: grid;
        gap: 0.45rem;
        padding-right: 0.25rem;
      }
      .submit-services-list::-webkit-scrollbar {
        width: 4px;
      }
      .submit-services-list::-webkit-scrollbar-thumb {
        background: rgba(20, 33, 48, 0.15);
        border-radius: 4px;
      }
      .submit-svc-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
      }
      .submit-svc-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        flex: 1;
      }
      .submit-svc-code {
        font-size: 0.72rem;
        color: var(--text-muted);
        flex: none;
      }
      .submit-svc-name {
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .submit-svc-price {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ink);
        flex: none;
      }
      .modal-actions-submit {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 0.5rem;
      }

      .est-actions { display: grid; gap: 0.75rem; }
      .btn-block { width: 100%; justify-content: center; }
      .est-sub-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem; }

      /* ------------------------------------------------------------- Forms */
      .business-form { display: grid; gap: 1.25rem; }
      .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
      .field { display: grid; gap: 0.45rem; }
      .field .mono {
        color: var(--text-muted);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .field em { font-style: normal; opacity: 0.65; }
      .field input,
      .field select,
      .field textarea {
        width: 100%;
        padding: 0.75rem 0.95rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        font-size: 0.92rem;
        transition: border-color 0.25s, box-shadow 0.25s;
      }
      .field :is(input, select, textarea):focus {
        outline: 0;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(89, 128, 166, 0.15);
      }
      .input-disabled {
        opacity: 0.7;
        background: var(--paper-sunk) !important;
        cursor: not-allowed;
      }
      .form-footer {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding-top: 0.75rem;
      }
      .save-status { font-size: 0.85rem; color: #16a34a; }

      /* ------------------------------------------------------------- My Services */
      .my-services-filter-bar {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.75rem;
        overflow-x: auto;
      }
      .my-services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.25rem;
      }
      .my-service-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        transition: transform 0.25s, box-shadow 0.25s;
      }
      .my-service-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 32px -16px rgba(29, 45, 61, 0.16);
      }
      .card-header-line { display: flex; justify-content: space-between; align-items: center; }
      .my-service-title {
        font-family: var(--font-display);
        font-size: 1.45rem;
        margin: 0.15rem 0 0.35rem 0;
        color: var(--ink);
      }
      .my-service-desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.45; }
      .my-service-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        padding-block: 0.75rem;
        border-block: 1px solid rgba(29, 45, 61, 0.08);
      }
      .meta-k { display: block; font-size: 0.68rem; color: var(--text-muted); }
      .meta-v { font-size: 0.85rem; font-weight: 600; color: var(--ink); }
      .my-service-req-box {
        background: var(--paper-raised);
        border: 1px dashed var(--line);
        border-radius: 6px;
        padding: 0.65rem 0.85rem;
        font-size: 0.82rem;
      }
      .req-box-title {
        font-size: 0.68rem;
        color: var(--text-muted);
        display: block;
        margin-bottom: 0.2rem;
      }
      .req-box-text { color: var(--text); margin: 0; }
      .my-service-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: auto;
        padding-top: 0.5rem;
      }
      .btn-sm {
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        border-radius: 999px;
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s;
      }
      .btn-danger-ghost {
        background: transparent;
        border: 1px solid rgba(220, 38, 38, 0.2);
        color: #dc2626;
      }
      .btn-danger-ghost:hover { background: #fee2e2; border-color: #dc2626; }

      /* ------------------------------------------------------------- Customer Quotations */
      .customer-quotes-grid {
        display: grid;
        gap: 1.25rem;
      }
      .cust-quote-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: grid;
        gap: 1rem;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .cust-quote-card:hover {
        box-shadow: 0 12px 28px -12px rgba(29, 45, 61, 0.15);
      }
      .cust-qc-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .cust-qc-title {
        font-family: var(--font-display);
        font-size: 1.45rem;
        color: var(--ink);
        margin: 0.2rem 0 0;
      }
      .cust-qc-tags {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
      }
      .cust-qc-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0;
      }
      .cust-qc-progress-block {
        display: grid;
        gap: 0.35rem;
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        padding: 0.75rem 1rem;
      }
      .cust-qc-progress-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .cust-qc-notes-box {
        background: rgba(89, 128, 166, 0.08);
        border-left: 3px solid var(--accent);
        border-radius: 0 var(--radius-s) var(--radius-s) 0;
        padding: 0.85rem 1rem;
        display: grid;
        gap: 0.35rem;
      }
      .cust-notes-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .cust-notes-text {
        font-size: 0.88rem;
        color: var(--text);
        margin: 0;
        line-height: 1.45;
      }
      .cust-qc-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px dashed var(--line);
        padding-top: 0.85rem;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .cust-qc-amount {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--ink);
      }
      .my-service-quote-sync {
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
        padding: 0.65rem 0.85rem;
        display: grid;
        gap: 0.35rem;
      }
      .msqs-progress {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .cust-notes-callout {
        border-top: 1px dashed var(--line);
        padding-top: 0.35rem;
        color: var(--text);
      }

      /* ------------------------------------------------------------- Explore Services */
      .explore-toolbar { display: grid; gap: 1rem; margin-bottom: 2rem; }
      .search-box {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.75rem 1.25rem;
      }
      .search-box input {
        border: 0;
        outline: 0;
        background: none;
        flex: 1;
        font-size: 0.95rem;
      }
      .filter-pills-row { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
      .filter-label { font-size: 0.72rem; }
      .filter-label-sep { margin-left: 1rem; }
      .tab-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.95rem;
        border-radius: 999px;
        background: var(--paper);
        border: 1px solid var(--line);
        color: var(--text-muted);
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }
      .tab-pill.is-on {
        background: var(--ink);
        color: var(--paper);
        border-color: var(--ink);
      }
      .discipline-select {
        padding: 0.45rem 0.95rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--paper);
        font-size: 0.85rem;
        cursor: pointer;
      }
      .explore-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
      }
      .explore-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        transition: transform 0.25s, box-shadow 0.25s;
      }
      .explore-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 32px -16px rgba(29, 45, 61, 0.2);
      }
      .explore-card-top { display: flex; align-items: center; gap: 0.5rem; }
      .explore-code { font-size: 0.72rem; color: var(--text-muted); }
      .card-badge-soft {
        margin-left: auto;
        font-size: 0.68rem;
        background: var(--paper-sunk);
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        color: var(--text-muted);
      }
      .explore-card-name { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
      .explore-card-desc { font-size: 0.85rem; color: var(--text-muted); line-height: 1.45; }
      .explore-discipline-tag { font-size: 0.72rem; color: var(--accent); }
      .explore-card-price {
        display: grid;
        gap: 0.15rem;
        margin-top: 0.25rem;
        padding-top: 0.65rem;
        border-top: 1px dashed var(--line);
      }
      .explore-price-type {
        color: var(--text-muted);
        text-transform: uppercase;
        font-size: 0.65rem;
      }
      .explore-price-row {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.35rem;
      }
      .explore-price-from {
        font-size: 0.78rem;
        color: var(--text-muted);
      }
      .explore-price-amt {
        font-family: var(--font-body);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--ink);
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
      }
      .explore-price-unit {
        font-size: 0.75rem;
        color: var(--text-muted);
      }
      .explore-market {
        font-size: 0.72rem;
        color: var(--text-muted);
        opacity: 0.85;
        line-height: 1.35;
      }

      .modal-price-box {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 0.75rem 1rem;
        background: var(--paper-sunk);
        border: 1px solid var(--line);
        border-radius: var(--radius-s);
      }
      .modal-price-row {
        display: flex;
        align-items: baseline;
        gap: 0.4rem;
      }
      .modal-price-val {
        font-family: var(--font-body);
        font-size: 1.35rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        letter-spacing: -0.02em;
        color: var(--ink);
      }
      .modal-price-unit {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .explore-card-footer { margin-top: auto; padding-top: 0.75rem; }
      .btn-primary-pill {
        background: var(--ink);
        color: var(--paper);
        border: 0;
        font-weight: 600;
        width: 100%;
        text-align: center;
      }
      .btn-primary-pill:hover { background: var(--accent); }
      .already-added-badge {
        background: var(--paper-sunk);
        border: 1px solid var(--line);
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        text-align: center;
        font-size: 0.75rem;
        color: var(--accent);
        font-weight: 600;
      }

      /* ------------------------------------------------------------- Support */
      .support-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
      }
      .support-card {
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: grid;
        gap: 0.35rem;
      }
      .support-card h4 { margin: 0; font-size: 1.15rem; color: var(--ink); }
      .support-card p { color: var(--text-muted); font-size: 0.88rem; line-height: 1.45; }
      .support-notice {
        background: radial-gradient(40% 120% at 90% 0%, rgba(148, 188, 227, 0.25), transparent 70%), var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1.25rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      /* ------------------------------------------------------------- Modals */
      .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(20, 33, 48, 0.65);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        display: grid;
        place-items: center;
        z-index: 99;
        padding: 1.5rem;
      }
      .modal-backdrop[hidden] {
        display: none !important;
      }
      .modal-dialog {
        background: var(--paper-raised);
        border: 1px solid var(--line);
        border-radius: var(--radius-l);
        max-width: 560px;
        width: 100%;
        padding: clamp(1.5rem, 4vw, 2.25rem);
        box-shadow: 0 30px 60px -25px rgba(20, 33, 48, 0.4);
        display: grid;
        gap: 1.25rem;
        animation: modalScale 0.25s ease;
      }
      .modal-dialog-sm { max-width: 440px; }
      .modal-dialog-wide { max-width: 780px; }
      @keyframes modalScale {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
      }
      .modal-header { display: flex; justify-content: space-between; align-items: flex-start; }
      .modal-title { font-size: 1.6rem; margin-top: 0.25rem; }
      .modal-code { color: var(--text-muted); font-size: 0.75rem; }
      .modal-close-btn {
        background: none;
        border: 0;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
        display: grid;
        place-items: center;
      }
      .modal-desc { color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; }
      .modal-info-callout {
        background: var(--paper-sunk);
        border-left: 3px solid var(--accent);
        padding: 0.85rem 1rem;
        border-radius: 0 var(--radius-s) var(--radius-s) 0;
        font-size: 0.82rem;
      }
      .modal-info-callout .mono { color: var(--accent); display: block; margin-bottom: 0.2rem; }
      .modal-info-callout p { margin: 0; color: var(--text); }
      .modal-actions { display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 0.5rem; }
      .modal-actions-logout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        width: 100%;
      }
      .btn-danger {
        background: #dc2626;
        color: #ffffff;
        border: 1px solid #dc2626;
      }
      .btn-danger:hover {
        background: #b91c1c;
        border-color: #b91c1c;
      }

      /* SOW Document Print */
      .sow-document {
        background: white;
        color: #1d1f20;
        padding: 1.75rem;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        display: grid;
        gap: 1.25rem;
      }
      .sow-doc-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid #1d2d3d;
        padding-bottom: 1rem;
      }
      .sow-brand-title {
        font-size: 1.2rem;
        font-family: var(--font-display);
        letter-spacing: -0.01em;
      }
      .sow-summary-box {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
      }
      .sow-stat-col { display: grid; gap: 0.25rem; }
      .sow-stat-col strong {
        font-family: var(--font-body);
        font-size: 1.15rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums lining-nums;
        font-feature-settings: 'tnum' 1, 'lnum' 1;
        letter-spacing: -0.02em;
      }
      .sow-services-table-wrap { overflow-x: auto; }

      /* ------------------------------------------------------------- Toast Hub */
      .toast-hub {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        pointer-events: none;
      }
      .toast-item {
        pointer-events: auto;
        background: var(--ink);
        color: var(--paper);
        border-radius: 8px;
        padding: 0.75rem 1.15rem;
        font-size: 0.88rem;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        box-shadow: 0 16px 36px -16px rgba(0, 0, 0, 0.4);
        border-left: 4px solid var(--accent);
        animation: toastEnter 0.3s ease;
      }
      .toast-item.toast-error { border-left-color: #ef4444; }
      .toast-item.toast-info { border-left-color: var(--tint); }
      .toast-content { display: flex; align-items: center; gap: 0.6rem; }
      .toast-icon { display: flex; align-items: center; }
      .toast-close { background: none; border: 0; color: rgba(255, 255, 255, 0.6); cursor: pointer; padding: 2px; display: grid; place-items: center; }
      @keyframes toastEnter {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
      }
      .toast-item.is-leaving { opacity: 0; transform: translateY(12px); transition: all 0.3s; }

      /* ------------------------------------------------------------- Responsive */
      /* Tablet & Smaller Laptops (<= 1024px) */
      @media (max-width: 1024px) {
        .dash-layout {
          grid-template-columns: 1fr;
        }
        .dash-sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          width: min(300px, 84vw);
          height: 100vh;
          height: 100dvh;
          transform: translateX(-100%);
          transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
          z-index: 50;
          box-shadow: 4px 0 32px rgba(0, 0, 0, 0.35);
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }
        .dash-sidebar.is-open {
          transform: translateX(0);
        }
        .sidebar-close-btn {
          display: inline-flex;
        }
        .topbar-toggle-btn {
          display: inline-flex;
        }
        .overview-columns {
          grid-template-columns: 1fr;
        }
        .dash-welcome-card,
        .planner-teaser-card {
          flex-direction: column;
          align-items: flex-start;
        }
        .welcome-actions {
          width: 100%;
          flex-direction: row;
        }
        /* Tablet Planner: balanced 2-column workspace since sidebar is in off-canvas drawer */
        .planner-workspace-grid {
          grid-template-columns: 1.15fr 0.85fr;
          gap: 1.5rem;
        }
        .preset-buttons-row {
          grid-template-columns: repeat(2, 1fr);
        }
        .tier-options-grid {
          grid-template-columns: repeat(3, 1fr);
        }
        .sticky-estimate-card {
          position: sticky;
          top: 5rem;
          padding: 1.5rem 1.25rem;
        }
        .est-price-value {
          font-size: clamp(2.2rem, 3.5vw, 2.75rem);
        }
      }

      /* Mobile & Compact Tablets (<= 768px) */
      @media (max-width: 768px) {
        .form-row, .form-row-3, .support-grid, .sow-summary-box {
          grid-template-columns: 1fr;
        }
        .welcome-actions {
          flex-direction: column;
        }

        /* Planner Mobile Optimization */
        .planner-workspace-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
        .planner-hero-card {
          padding: 1.25rem 1rem;
          margin-bottom: 1.25rem;
        }
        .preset-buttons-row {
          display: flex;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scroll-snap-type: x mandatory;
          gap: 0.65rem;
          padding-bottom: 0.5rem;
          margin-inline: -0.25rem;
          padding-inline: 0.25rem;
        }
        .preset-btn {
          min-width: 200px;
          flex: 0 0 auto;
          scroll-snap-align: start;
        }
        .tier-options-grid {
          grid-template-columns: 1fr;
          gap: 0.65rem;
        }
        .tier-card {
          padding: 0.85rem;
        }
        .matrix-filter-bar {
          gap: 0.65rem;
        }
        .matrix-layer-pills {
          gap: 0.35rem;
        }
        .mlp-btn {
          padding: 0.35rem 0.65rem;
          font-size: 0.74rem;
        }
        .planner-services-list {
          max-height: 400px;
          padding-right: 0.25rem;
        }
        .svc-select-item {
          padding: 0.75rem 0.85rem;
          gap: 0.65rem;
        }
        .svc-select-top {
          flex-wrap: wrap;
          gap: 0.35rem 0.5rem;
        }
        .svc-select-base-price {
          margin-left: 0;
          font-size: 0.75rem;
        }
        .sticky-estimate-card {
          position: static;
          max-height: none;
          overflow-y: visible;
          padding: 1.25rem 1rem;
        }
        .est-price-value {
          font-size: clamp(2.2rem, 8vw, 3rem);
        }
        .est-metrics-row {
          padding: 0.65rem 0.75rem;
          gap: 0.5rem;
        }
        .est-m-label {
          font-size: 0.6rem;
        }
        .est-m-val {
          font-size: 1rem;
        }
        .est-actions {
          padding-bottom: 4rem; /* room for mobile floating dock */
        }

        /* Mobile Live Estimation Floating Dock */
        .planner-mobile-dock {
          display: flex;
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          background: rgba(255, 255, 255, 0.95);
          backdrop-filter: blur(16px);
          -webkit-backdrop-filter: blur(16px);
          border-top: 1px solid var(--line);
          padding: 0.65rem 1rem max(0.65rem, env(safe-area-inset-bottom));
          align-items: center;
          justify-content: space-between;
          gap: 0.75rem;
          z-index: 35;
          box-shadow: 0 -4px 24px rgba(20, 33, 48, 0.12);
          transform: translateY(120%);
          transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .planner-mobile-dock.is-active {
          transform: translateY(0);
        }
        .pmd-info {
          display: grid;
          gap: 0.1rem;
        }
        .pmd-count {
          font-size: 0.7rem;
          color: var(--text-muted);
          letter-spacing: 0.05em;
        }
        .pmd-price {
          font-family: var(--font-body);
          font-size: 1.25rem;
          font-weight: 800;
          color: var(--ink);
          line-height: 1.1;
          letter-spacing: -0.02em;
          font-variant-numeric: tabular-nums lining-nums;
          font-feature-settings: 'tnum' 1, 'lnum' 1;
        }
        .pmd-btn {
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
          padding: 0.55rem 0.95rem;
          font-size: 0.82rem;
          white-space: nowrap;
        }
      }

      /* Compact Phone Screens (<= 480px) */
      @media (max-width: 480px) {
        .dash-topbar {
          padding-inline: 0.85rem;
          height: 58px;
        }
        .topbar-left {
          gap: 0.65rem;
        }
        .topbar-page-name {
          font-size: 1.05rem;
        }
        .est-price-value {
          font-size: clamp(1.85rem, 6.5vw, 2.3rem);
        }
        .est-sub-actions {
          grid-template-columns: 1fr;
        }
        .panel-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }
        .currency-switch {
          align-self: flex-start;
        }
        .modal-backdrop {
          padding: 0.75rem;
        }
        .modal-dialog {
          padding: 1.25rem 1rem;
        }
        .modal-title {
          font-size: 1.35rem;
        }
      }

      @media print {
        body * { visibility: hidden; }
        #modal-sow-export, #modal-sow-export * { visibility: visible; }
        #modal-sow-export {
          position: absolute;
          inset: 0;
          background: white;
          padding: 0;
        }
        .modal-dialog {
          box-shadow: none;
          border: 0;
          padding: 0;
          max-width: 100%;
        }
        .modal-actions, .modal-close-btn { display: none !important; }
      }
    </style>
  </body>
</html>
