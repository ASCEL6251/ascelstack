---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { counts } from '../data/catalog';

const stats = [
  { value: `${counts.core}`, label: 'Live services', sub: 'Across 8 core disciplines today' },
  { value: '3', label: 'Connected layers', sub: 'Build, Grow, Run on one foundation' },
  { value: '24h', label: 'Architecture response', sub: 'Direct review by a systems architect' },
  { value: '1', label: 'Single partner', sub: 'Zero vendor finger-pointing' },
];

const layers = [
  {
    tag: 'Build',
    color: '#94BCE3',
    num: '01',
    headline: 'Digital foundations that do not break under scale.',
    desc: 'Custom web platforms, mobile apps, enterprise APIs, internal portals, and bespoke AI agents. Built cleanly from day one with modern architectures, type safety, and zero bloat.',
    disciplines: ['Software & Web Development', 'AI & Automation Engineering', 'IT & Cloud Infrastructure', 'Corporate Tech Solutions'],
  },
  {
    tag: 'Grow',
    color: '#5980A6',
    num: '02',
    headline: 'Repeatable acquisition, high-converting brand identity.',
    desc: 'Getting found, chosen, and paid. Data-backed performance marketing, multi-channel marketplace acceleration (Amazon, Flipkart, Swiggy, Zomato), organic SEO, and distinctive visual design.',
    disciplines: ['Digital & Performance Marketing', 'Brand Strategy & Creative', 'E-commerce & Marketplace Expansion', 'Education & Sales Training'],
  },
  {
    tag: 'Run',
    color: '#1D2D3D',
    num: '03',
    headline: 'Daily operations and compliance moving on autopilot.',
    desc: 'The unglamorous machinery that keeps businesses alive: CRM pipelines, ERP integration, inventory sync, kitchen display systems, payroll, and 75+ statutory compliance and licensing filings.',
    disciplines: ['Business Operations & ERP', 'Restaurant & Food Systems', 'Registrations, GST & Legal Compliance', 'HR & Team Recruitment'],
  },
];

const principles = [
  {
    num: '01',
    title: 'Connected by default',
    desc: 'Every tool, script, and database we deploy speaks to the rest of the business. A GST registration feeds the payment gateway; the store inventory triggers production workflows; ad campaigns feed CRM pipelines automatically.',
  },
  {
    num: '02',
    title: 'No vanity deliverables',
    desc: 'We do not sell 100-page slide decks or unmaintainable prototypes. We measure software in uptime and response time, marketing in qualified revenue, and compliance in clean, penalty-free audits.',
  },
  {
    num: '03',
    title: 'Humans at the helm, AI at the engine',
    desc: 'We build autonomous AI agents to eliminate repetitive data entry, file parsing, and customer triage. But every sensitive step—statutory filings, financial transactions, and refunds—is locked behind human sign-off.',
  },
  {
    num: '04',
    title: 'Skin in the game',
    desc: 'Clear scope, flat pricing, milestone-driven billing, and weekly sprint demos. When you work with Ascelstack, you work with an owner-minded partner whose incentives align with your bottom line.',
  },
];

const comparison = [
  {
    aspect: 'Point of Contact',
    patchwork: '5–8 different agencies, freelancers, and accountants who blame each other when systems fail.',
    ascelstack: 'One unified team and dedicated lead architect accountable for your entire operational stack.',
  },
  {
    aspect: 'Data & Systems',
    patchwork: 'Disconnected silos. Orders in Shopify, leads in WhatsApp, receipts in Excel, taxes filed late.',
    ascelstack: 'A single shared data layer. Real-time synchronisation across inventory, billing, CRM, and accounts.',
  },
  {
    aspect: 'Automation',
    patchwork: 'Manual copy-pasting between browser tabs, lost emails, and staff drowning in repetitive chores.',
    ascelstack: 'Autonomous workflows and AI agents handling order triage, document parsing, and invoice reconciliation.',
  },
  {
    aspect: 'Cost Structure',
    patchwork: 'Compounding retainers, surprise hourly overages, hidden markups, and duplicative tool subscriptions.',
    ascelstack: 'Transparent pricing, predictable monthly retainers, and modular services that scale as you grow.',
  },
];

interface Contributor {
  login: string;
  name: string;
  role: string;
  bio: string;
  avatar_url: string;
  html_url: string;
  contributions: number;
}

const knownTeamMeta: Record<string, { name: string; role: string; bio: string }> = {
  Sujoymoulick: {
    name: 'Sujoy Moulick',
    role: 'Founder & Lead Architect',
    bio: 'Full-stack systems architecture, blockchain engineering, and core infrastructure.',
  },
  arnabbasak01: {
    name: 'Arnab Basak',
    role: 'Full-Stack & Systems Engineer',
    bio: 'Database synchronization, admin portal engineering, and cloud workflows.',
  },
  Souvik444411: {
    name: 'Souvik Chowdhury',
    role: 'AI & Software Engineer',
    bio: 'B.Tech CSE AIML specialist, prompt pipelines, and intelligent automations.',
  },
  ASCEL6251: {
    name: 'ASCELSTACK Core',
    role: 'Platform & Organization',
    bio: 'Official central maintainer, release management, and repository core.',
  },
};

const defaultContributors: Contributor[] = [
  {
    login: 'Sujoymoulick',
    name: 'Sujoy Moulick',
    role: 'Founder & Lead Architect',
    bio: 'Full-stack systems architecture, blockchain engineering, and core infrastructure.',
    avatar_url: 'https://avatars.githubusercontent.com/u/177207941?v=4',
    html_url: 'https://github.com/Sujoymoulick',
    contributions: 20,
  },
  {
    login: 'arnabbasak01',
    name: 'Arnab Basak',
    role: 'Full-Stack & Systems Engineer',
    bio: 'Database synchronization, admin portal engineering, and cloud workflows.',
    avatar_url: 'https://avatars.githubusercontent.com/u/177306006?v=4',
    html_url: 'https://github.com/arnabbasak01',
    contributions: 13,
  },
  {
    login: 'Souvik444411',
    name: 'Souvik Chowdhury',
    role: 'AI & Software Engineer',
    bio: 'B.Tech CSE AIML specialist, prompt pipelines, and intelligent automations.',
    avatar_url: 'https://avatars.githubusercontent.com/u/141899070?v=4',
    html_url: 'https://github.com/Souvik444411',
    contributions: 1,
  },
  {
    login: 'ASCEL6251',
    name: 'ASCELSTACK Core',
    role: 'Platform & Organization',
    bio: 'Official central maintainer, release management, and repository core.',
    avatar_url: 'https://avatars.githubusercontent.com/u/354181175?v=4',
    html_url: 'https://github.com/ASCEL6251',
    contributions: 1,
  },
];

let teamMembers: Contributor[] = [...defaultContributors];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 3000);

  const res = await fetch('https://api.github.com/repos/ASCEL6251/ascelstack/contributors?per_page=100', {
    headers: {
      'User-Agent': 'Ascelstack-Team-Directory',
      Accept: 'application/vnd.github.v3+json',
    },
    signal: controller.signal,
  });
  clearTimeout(timeoutId);

  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data) && data.length > 0) {
      // Exclude Claude, bots, and CI accounts
      const filtered = data.filter((c: any) => {
        const login = (c.login || '').toLowerCase();
        return (
          !login.includes('claude') &&
          !login.includes('anthropic') &&
          !login.includes('actions-user') &&
          !login.includes('[bot]')
        );
      });

      if (filtered.length > 0) {
        teamMembers = filtered.map((c: any) => {
          const meta = knownTeamMeta[c.login] || {
            name: c.login,
            role: 'Core Contributor',
            bio: 'Active contributor to the Ascelstack repository ecosystem.',
          };
          return {
            login: c.login,
            name: meta.name,
            role: meta.role,
            bio: meta.bio,
            avatar_url: c.avatar_url || `https://github.com/${c.login}.png`,
            html_url: c.html_url || `https://github.com/${c.login}`,
            contributions: typeof c.contributions === 'number' ? c.contributions : 1,
          };
        });
      }
    }
  }
} catch {
  // Graceful fallback to verified repository contributors if network or rate-limited
  teamMembers = defaultContributors;
}
---

<Base
  title="About Us"
  description="Ascelstack replaces the agency patchwork with one connected stack. Software, marketing, operations, AI automation, and compliance under one roof."
>
  <!-- Hero -->
  <section class="about-hero">
    <div class="wrap">
      <div class="hero-content">
        <p class="eyebrow" data-reveal>About Ascelstack</p>
        <h1 class="display h1 hero-title" data-reveal>
          The antidote to <br /><em>vendor chaos.</em>
        </h1>
        <p class="lead hero-lead" data-reveal>
          Most growing businesses do not stall for lack of ambition. They get buried under the weight of
          five mismatched agencies, ten freelancers, and thirty unintegrated tools.
          Ascelstack is the single partner that unifies the whole stack.
        </p>

        <div class="hero-actions" data-reveal>
          <a href="/contact" class="btn">
            Start a project <span class="arrow">→</span>
          </a>
          <a href="/services" class="btn btn-ghost">
            Explore 232 services
          </a>
        </div>
      </div>

      <!-- Quick stats banner -->
      <div class="stats-grid" data-reveal>
        {
          stats.map((s) => (
            <div class="stat-card">
              <span class="display stat-val">{s.value}</span>
              <strong class="stat-label">{s.label}</strong>
              <span class="mono stat-sub">{s.sub}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The Origin Story & Problem Statement -->
  <section class="section story-section">
    <div class="wrap">
      <div class="story-grid">
        <div class="story-side">
          <p class="eyebrow" data-reveal>The Problem</p>
          <h2 class="display h2 story-h2" data-reveal>
            The <em>fragmentation tax</em> is killing business velocity.
          </h2>
        </div>

        <div class="story-body" data-reveal>
          <p class="story-p">
            Ask any founder or operating partner how their business runs behind the curtain.
            You will hear the same story: a web agency that built a site without checking the inventory API;
            a marketing firm spending ad dollars on leads that drop into an unmonitored inbox; a chartered
            accountant pleading for GST invoices stored across three WhatsApp groups; and custom software
            that broke the moment the freelancer stopped replying.
          </p>
          <p class="story-p">
            The business owner becomes the glue—spending late nights reconciling spreadsheets, copying customer
            addresses between portals, and coordinating vendors who do not know each other.
          </p>
          <blockquote class="story-quote">
            “We did not start Ascelstack to be another agency. We started it to build what we wished existed:
            a single engineering and operations house capable of designing the brand, writing the software,
            accelerating the revenue, and automating the operations.”
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- The Three Layers Deep-Dive -->
  <section class="section on-ink layers-section">
    <div class="wrap">
      <div class="layers-head">
        <div>
          <p class="eyebrow" data-reveal>The Framework</p>
          <h2 class="display h2" data-reveal>Three layers. <em>One continuous stack.</em></h2>
        </div>
        <p class="lead" data-reveal>
          Every business requires three fundamental engines to thrive. Our Layered A emblem is built
          from the exact same three components.
        </p>
      </div>

      <div class="layers-cards">
        {
          layers.map((l) => (
            <div class="layer-card" data-reveal>
              <div class="layer-top">
                <span class="mono layer-num">{l.num}</span>
                <span class="layer-pill" style={`--tag-color: ${l.color}`}>{l.tag}</span>
              </div>
              <h3 class="display layer-title">{l.headline}</h3>
              <p class="layer-desc">{l.desc}</p>
              <div class="layer-disciplines">
                <span class="mono layer-subhead">Core Disciplines</span>
                <ul>
                  {l.disciplines.map((d) => (
                    <li>
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" />
                        <path d="M5.5 8L7 9.5L10.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      <span>{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Patchwork vs Stack Comparison -->
  <section class="section compare-section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>The Difference</p>
        <h2 class="display h2" data-reveal>The agency circus vs. <em>The Ascelstack model.</em></h2>
        <p class="lead" data-reveal>
          Compare the typical status quo against an engineered stack built for compound efficiency.
        </p>
      </div>

      <div class="compare-table-wrap" data-reveal>
        <table class="compare-table">
          <thead>
            <tr>
              <th class="mono th-aspect">Dimension</th>
              <th class="th-patchwork">
                <span class="tag-status is-bad">The Vendor Patchwork</span>
              </th>
              <th class="th-ascelstack">
                <span class="tag-status is-good">The Ascelstack Stack</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((c) => (
                <tr>
                  <td class="mono td-aspect">{c.aspect}</td>
                  <td class="td-patchwork">{c.patchwork}</td>
                  <td class="td-ascelstack">
                    <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{c.ascelstack}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Operating Principles -->
  <section class="section principles-section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Our Code of Craft</p>
        <h2 class="display h2" data-reveal>Principles we <em>never negotiate.</em></h2>
        <p class="lead" data-reveal>
          These four rules dictate how we design architecture, deploy code, and run client relationships.
        </p>
      </div>

      <div class="principles-grid">
        {
          principles.map((p) => (
            <div class="principle-card" data-reveal>
              <span class="mono principle-num">{p.num}</span>
              <h3 class="display principle-title">{p.title}</h3>
              <p class="principle-desc">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cross-Functional Pods -->
  <section class="section on-ink pods-section">
    <div class="wrap">
      <div class="pods-intro">
        <div class="pods-text">
          <p class="eyebrow" data-reveal>How We Deliver</p>
          <h2 class="display h2" data-reveal>Cross-functional <em>delivery pods.</em></h2>
          <p class="lead" data-reveal>
            Instead of siloing departments into isolated rooms, every Ascelstack engagement is run
            by a multi-disciplinary pod tailored to your industry.
          </p>
        </div>
        <div class="pods-badge" data-reveal>
          <Logo tone="light" size={48} />
          <span class="mono pods-tag">In-House Pod Model</span>
        </div>
      </div>

      <div class="pods-grid">
        <div class="pod-card" data-reveal>
          <div class="pod-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </div>
          <h3 class="display pod-name">Software & Cloud Pod</h3>
          <p class="pod-desc">Full-stack software engineers, cloud architects, and database specialists who write production TypeScript, Go, and SQL designed to scale without technical debt.</p>
        </div>

        <div class="pod-card" data-reveal>
          <div class="pod-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h3 class="display pod-name">Growth & Commerce Pod</h3>
          <p class="pod-desc">Performance marketers, copywriters, and marketplace managers with deep expertise in CAC optimization, Amazon/Flipkart algorithms, and DTC funnels.</p>
        </div>

        <div class="pod-card" data-reveal>
          <div class="pod-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <h3 class="display pod-name">Compliance & Legal Pod</h3>
          <p class="pod-desc">Chartered accountants, company secretaries, and corporate legal associates who handle GST filings, MCA incorporation, trademark protection, and FSSAI licensing.</p>
        </div>

        <div class="pod-card" data-reveal>
          <div class="pod-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </div>
          <h3 class="display pod-name">AI & Automation Pod</h3>
          <p class="pod-desc">Workflow engineers and prompt architects who build durable background workers, automated reconciliation pipelines, and intelligent WhatsApp bots with human checkpoints.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Our Team -->
  <section class="section team-section" id="team">
    <div class="wrap">
      <div class="team-head">
        <div class="team-head-text">
          <p class="eyebrow" data-reveal>The Builders</p>
          <h2 class="display h2 team-title" data-reveal>Meet Our <em>Team.</em></h2>
        </div>
        <p class="lead team-lead" data-reveal>
          The architects, core engineers, and open-source contributors actively building, scaling,
          and maintaining the Ascelstack platform.
        </p>
      </div>

      <div class="team-grid">
        {
          teamMembers.map((member, index) => (
            <div class="team-card" data-reveal data-reveal-delay={(index * 0.08).toFixed(2)}>
              <div class="team-card-inner">
                <div class="team-card-top">
                  <div class="team-avatar-container">
                    <div class="team-avatar-glow" aria-hidden="true" />
                    <img
                      src={member.avatar_url}
                      alt={`Avatar of ${member.name} (@${member.login})`}
                      class="team-avatar-img"
                      width="88"
                      height="88"
                      loading="lazy"
                      decoding="async"
                    />
                    <a
                      href={member.html_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="team-gh-badge"
                      title="GitHub Profile"
                      aria-label={`${member.name} on GitHub`}
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                      </svg>
                    </a>
                  </div>

                  <span class="mono team-role-tag">{member.role}</span>
                </div>

                <div class="team-card-content">
                  <div class="team-name-group">
                    <h3 class="display team-member-name">{member.name}</h3>
                    <a
                      href={member.html_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="team-gh-link mono"
                      title={`Visit ${member.login} on GitHub`}
                    >
                      <span>@{member.login}</span>
                      <svg class="team-link-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </a>
                  </div>

                  <p class="team-member-bio">{member.bio}</p>
                </div>

                <div class="team-card-footer">
                  <div class="team-commits-count mono">
                    <span class="team-commit-dot" aria-hidden="true"></span>
                    <span>{member.contributions} {member.contributions === 1 ? 'commit' : 'commits'}</span>
                  </div>

                  <a
                    href={member.html_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="team-view-btn mono"
                  >
                    <span>View Profile</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section about-cta">
    <div class="wrap cta-wrap" data-reveal>
      <p class="eyebrow">Ready for clarity?</p>
      <h2 class="display h1 cta-h1">
        Replace the vendor circus with <em>one unified stack.</em>
      </h2>
      <p class="lead cta-lead">
        Tell us what you are building, running, or automating. We will review your current systems
        and send back a clear architectural blueprint within one working day.
      </p>
      <div class="cta-btns">
        <a href="/contact" class="btn">
          Start a project <span class="arrow">→</span>
        </a>
        <a href="/services" class="btn btn-ghost">
          Browse our catalogue
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- Hero */
  .about-hero {
    padding-top: calc(var(--nav-h) + clamp(3.5rem, 7vw, 6.5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background:
      radial-gradient(65% 50% at 50% 0%, rgba(148, 188, 227, 0.28), transparent 75%),
      var(--paper);
  }
