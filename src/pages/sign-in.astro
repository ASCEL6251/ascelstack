---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/auth/AuthShell.astro';
---

<Base title="Sign in" description="Sign in to Ascelstack to view and submit your project estimates.">
  <AuthShell eyebrow="Sign in" title="Welcome <em>back.</em>" lead="Sign in to submit your estimate and track the quotes our team sends back.">
    <form data-signin novalidate>
      <label class="ff">
        <span class="mono">Email</span>
        <input name="email" type="email" required autocomplete="email" />
      </label>
      <label class="ff">
        <span class="mono">Password</span>
        <input name="password" type="password" required autocomplete="current-password" />
      </label>
      <p class="form-err" data-err hidden></p>
      <button class="btn" type="submit">Sign in <span class="arrow">→</span></button>
      <p class="auth-alt">New to Ascelstack? <a href="/sign-up" data-keep-redirect>Create an account</a></p>
    </form>
  </AuthShell>
</Base>

<script>
  import { signIn, getUser, safeRedirect } from '../lib/auth';

  const params = new URLSearchParams(location.search);
  const next = safeRedirect(params.get('redirect'));
  if (getUser()) location.replace(next);
  document.querySelectorAll<HTMLAnchorElement>('[data-keep-redirect]').forEach((a) => params.get('redirect') && (a.search = `?redirect=${encodeURIComponent(next)}`));

  const form = document.querySelector<HTMLFormElement>('[data-signin]')!;
  const err = form.querySelector<HTMLElement>('[data-err]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const email = String(d.get('email') ?? '').trim();
    const fail = (m: string) => ((err.textContent = m), (err.hidden = false));
    if (!email) return fail('Enter your email.');
    if (!String(d.get('password') ?? '')) return fail('Enter your password.');
    try {
      signIn(email); // mock: password not checked
      location.href = next;
    } catch (x) {
      fail((x as Error).message);
    }
  });
</script>
