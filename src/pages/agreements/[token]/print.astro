---
import GoogleTag from '../../../components/GoogleTag.astro';
export const prerender = false;

import AgreementDocument from '../../../components/agreement/AgreementDocument.astro';
import { loadAgreementByToken } from '../../../lib/agreement-load';

const { token } = Astro.params;
if (!token) return Astro.redirect('/agreements');

const data = await loadAgreementByToken(token);
if (!data) return Astro.redirect('/404');

const { agreement: a, clientSig, providerSig } = data;
const executed = Boolean(clientSig && providerSig);
const autoDownload = Astro.url.searchParams.has('download');

// Becomes the default file name in the browser's "Save as PDF" dialog.
const slug = (s: string) => s.replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
const fileName = `${a.agreementNumber}_${slug(a.clientCompany || a.clientName)}_${executed ? 'Signed' : 'Draft'}`;

// Running header/footer on every printed page. CSS strings need quotes escaped.
const esc = (s: string) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
const pageCss = `
@page {
  size: A4;
  margin: 20mm 18mm 22mm;
  @top-left { content: "${esc(a.providerName)}"; font: 500 7.5pt 'Inter Tight', sans-serif; color: #8a96a3; }
  @top-right { content: "${esc(a.agreementNumber)} · v${a.version}"; font: 500 7.5pt 'JetBrains Mono', monospace; color: #8a96a3; }
  @bottom-left { content: "${executed ? 'Executed copy' : 'Copy for review, not yet fully signed'}"; font: 500 7.5pt 'Inter Tight', sans-serif; color: #8a96a3; }
  @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 500 7.5pt 'Inter Tight', sans-serif; color: #8a96a3; }
}
@page :first {
  @top-left { content: none; }
  @top-right { content: none; }
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{fileName}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bacasime+Antique&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Mr+Dafoe&display=swap"
      rel="stylesheet"
    />
    <style is:inline set:html={pageCss}></style>
  </head>
  <body data-auto={autoDownload ? '1' : undefined}>
    <div class="bar">
      <a class="bar-back" href={`/agreements/${a.secureToken}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
        Back to agreement
      </a>
      <div class="bar-mid">
        <span class="mono">{a.agreementNumber}</span>
        <span class:list={['pill', { ok: executed }]}>{executed ? 'Fully signed' : 'Not yet fully signed'}</span>
      </div>
      <button type="button" class="bar-btn" id="save-pdf">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
        Save as PDF
      </button>
    </div>
    <p class="tip">In the print dialog choose <strong>Save as PDF</strong> as the destination. A4, margins default.</p>

    <main class="sheet">
      <AgreementDocument data={data} />
    </main>

    <style>
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: #e6eaee;
        font-family: 'Inter Tight', system-ui, sans-serif;
        color: #1d2d3d;
        -webkit-font-smoothing: antialiased;
      }
      .mono { font-family: 'JetBrains Mono', monospace; }
      .bar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px clamp(12px, 3vw, 28px);
        background: #1d2d3d;
        color: #fff;
      }
      .bar svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .bar-back { display: inline-flex; align-items: center; gap: 6px; color: #c9d6e3; text-decoration: none; font-size: 0.88rem; }
      .bar-back:hover { color: #fff; }
      .bar-mid { display: flex; align-items: center; gap: 10px; font-size: 0.85rem; }
      .bar-mid .mono { color: #94bce3; font-weight: 600; }
      .pill { padding: 3px 10px; border-radius: 99px; background: rgba(255, 255, 255, 0.12); font-size: 0.76rem; font-weight: 600; }
      .pill.ok { background: rgba(52, 199, 123, 0.2); color: #8ef0bb; }
      .bar-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 38px;
        padding: 0 16px;
        border: 0;
        border-radius: 9px;
        background: #fff;
        color: #1d2d3d;
        font: 600 0.88rem 'Inter Tight', sans-serif;
        cursor: pointer;
      }
      .bar-btn:hover { background: #dfe9f4; }
      .tip { text-align: center; font-size: 0.8rem; color: #66737f; margin: 14px 16px 0; }
      .sheet { max-width: 210mm; margin: 14px auto 48px; }

      @media (max-width: 640px) {
        .bar-mid { display: none; }
        .sheet { margin-top: 10px; }
      }
      @media print {
        body { background: #fff; }
        .bar, .tip { display: none !important; }
        .sheet { max-width: none; margin: 0; }
      }
    </style>

    <script is:inline>
      (function () {
        var btn = document.getElementById('save-pdf');
        function go() {
          // Wait for web fonts so the PDF never falls back to system fonts.
          (document.fonts ? document.fonts.ready : Promise.resolve()).then(function () {
            window.print();
          });
        }
        btn && btn.addEventListener('click', go);
        if (document.body.dataset.auto) {
          window.addEventListener('load', function () { setTimeout(go, 250); });
        }
      })();
    </script>
  </body>
</html>
