---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import AgreementDocument from '../../components/agreement/AgreementDocument.astro';
import { db, agreements, agreementAuditLogs } from '../../db';
import { eq } from 'drizzle-orm';
import { loadAgreementByToken } from '../../lib/agreement-load';
import { money, longDate, STATUS_LABEL } from '../../lib/agreement-document';

const { token } = Astro.params;
if (!token) return Astro.redirect('/agreements');

const data = await loadAgreementByToken(token);
if (!data) return Astro.redirect('/404');

const { agreement: a, clauses, clientSig, providerSig } = data;

// First open by the client moves the agreement from "sent" to "viewed".
if (a.status === 'sent') {
  const now = new Date();
  await db.update(agreements).set({ status: 'viewed', viewedAt: now, updatedAt: now }).where(eq(agreements.id, a.id));
  a.status = 'viewed';
  a.viewedAt = now;
  await db.insert(agreementAuditLogs).values({
    agreementId: a.id,
    action: 'viewed',
    performedBy: a.clientEmail,
    role: 'client',
    description: `Agreement ${a.agreementNumber} was opened by the client (${a.clientEmail})`,
    ipAddress: Astro.clientAddress || null,
  });
}

const closed = ['cancelled', 'rejected', 'expired'].includes(a.status);
const canSign = !clientSig && !closed;
const pdfUrl = `/agreements/${a.secureToken}/print`;
const currency = a.currency || 'INR';

const steps = [
  { label: 'Issued', at: a.sentAt ?? a.createdAt, done: true },
  { label: 'Opened', at: a.viewedAt ?? clientSig?.signedAt, done: Boolean(a.viewedAt || clientSig) },
  { label: 'You signed', at: clientSig?.signedAt, done: Boolean(clientSig) },
  { label: 'Countersigned', at: providerSig?.signedAt, done: Boolean(providerSig) },
];

const statusTone =
  a.status === 'signed' ? 'ok' : closed ? 'bad' : clientSig ? 'wait' : 'action';
const statusText = clientSig && !providerSig ? 'Awaiting countersignature' : STATUS_LABEL[a.status] ?? a.status;
---

<Base
  title={`${a.projectName} · Agreement ${a.agreementNumber}`}
  description={`Professional Service Agreement ${a.agreementNumber} between ${a.providerName} and ${a.clientCompany || a.clientName}.`}
>
  <link href="https://fonts.googleapis.com/css2?family=Mr+Dafoe&display=swap" rel="stylesheet" />
  <meta name="robots" content="noindex, nofollow" />

  <div class="ag" data-token={a.secureToken}>
    <!-- Header -->
    <header class="ag-head wrap">
      <div class="ag-head-text">
        <p class="ag-ref">
          <span class="mono">{a.agreementNumber}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>Version {a.version}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{longDate(a.createdAt)}</span>
        </p>
        <h1 class="ag-title">{a.projectName}</h1>
        <p class="ag-sub">
          Service agreement from <strong>{a.providerName}</strong> for <strong>{a.clientCompany || a.clientName}</strong> · {money(a.totalAmount, currency)}
        </p>
      </div>
      <div class="ag-head-actions">
        <span class:list={['ag-status', `is-${statusTone}`]}>
          <span class="ag-status-dot" aria-hidden="true"></span>{statusText}
        </span>
        <div class="ag-btns">
          <a class="ag-btn ghost" href={`${pdfUrl}?download=1`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
            Download PDF
          </a>
          {canSign && (
            <a class="ag-btn solid" href="#sign">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16M6.5 16.5 17 6a2.1 2.1 0 0 1 3 3L9.5 19.5 5 21l1.5-4.5Z" /></svg>
              Review and sign
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Progress -->
    <div class="wrap">
      <ol class="ag-steps" aria-label="Signing progress">
        {steps.map((s, i) => (
          <li class:list={['ag-step', { done: s.done, now: !s.done && (i === 0 || steps[i - 1].done) && !closed }]}>
            <span class="ag-step-dot" aria-hidden="true">
              {s.done ? (
                <svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
              ) : (
                <span>{i + 1}</span>
              )}
            </span>
            <span class="ag-step-text">
              <strong>{s.label}</strong>
              <small>{s.done && s.at ? longDate(s.at) : 'Pending'}</small>
            </span>
          </li>
        ))}
      </ol>
    </div>

    <div class="ag-layout wrap">
      <!-- Contents -->
      <aside class="ag-side" aria-label="Agreement contents">
        <div class="ag-side-inner">
          <p class="ag-side-label">Contents</p>
          <nav class="ag-toc" data-toc>
            <a href="#doc-parties">Parties</a>
            <a href="#doc-summary">Key commercial terms</a>
            <a href="#doc-schedule">Schedule A · Scope and payments</a>
            <details class="ag-toc-terms">
              <summary><a href="#doc-terms">Terms and conditions</a><span class="mono">{clauses.length}</span></summary>
              <div class="ag-toc-clauses">
                {clauses.map((c) => <a href={`#clause-${c.sectionNumber}`}><span class="mono">{c.sectionNumber}</span>{c.title}</a>)}
              </div>
            </details>
            <a href="#doc-signatures">Execution</a>
            <a href="#doc-certificate">Certificate</a>
          </nav>

          <div class="ag-side-card">
            <p class="ag-side-label">Contract value</p>
            <p class="ag-side-amount">{money(a.totalAmount, currency)}</p>
            <p class="ag-side-note">{money(a.advanceAmount, currency)} advance ({a.advancePercentage}%) on signing</p>
            {a.timeline && <p class="ag-side-note">{a.timeline}</p>}
          </div>

          <p class="ag-side-help">
            Questions about a clause? Write to <a href={`mailto:${a.providerEmail}`}>{a.providerEmail}</a> before you sign.
          </p>
        </div>
      </aside>

      <div class="ag-main">
        <div class="ag-paper" data-reveal>
          <AgreementDocument data={data} />
        </div>

        {canSign && (
          <section class="ag-sign" id="sign" aria-labelledby="sign-title">
            <div class="ag-sign-head">
              <p class="ag-kicker">Final step</p>
              <h2 id="sign-title">Sign this agreement</h2>
              <p>
                Check your details, add your signature and confirm. We record the time, your IP address and the signature
                on the agreement’s execution certificate.
              </p>
            </div>

            <form class="ag-form" id="sign-form" novalidate>
              <fieldset class="ag-fs">
                <legend><span class="ag-fs-no">1</span>Your details</legend>
                <div class="ag-grid">
                  <label class="ag-field">
                    <span>Full legal name</span>
                    <input id="f-name" name="signerName" autocomplete="name" required value={a.clientName} />
                  </label>
                  <label class="ag-field">
                    <span>Email</span>
                    <input id="f-email" name="signerEmail" type="email" autocomplete="email" required value={a.clientEmail} />
                  </label>
                  <label class="ag-field ag-span">
                    <span>Designation <em>(the role that lets you sign for {a.clientCompany || 'your business'})</em></span>
                    <input id="f-title" name="signerTitle" autocomplete="organization-title" placeholder="e.g. Founder, Director, Proprietor" />
                  </label>
                </div>
              </fieldset>

              <fieldset class="ag-fs">
                <legend><span class="ag-fs-no">2</span>Signature</legend>
                <div class="ag-tabs" role="tablist">
                  <button type="button" role="tab" class="ag-tab is-on" data-mode="typed" aria-selected="true">Type</button>
                  <button type="button" role="tab" class="ag-tab" data-mode="drawn" aria-selected="false">Draw</button>
                </div>

                <div class="ag-pad" data-pane="typed">
                  <input id="f-typed" class="ag-typed" value={a.clientName} aria-label="Type your signature" autocomplete="off" />
                  <span class="ag-pad-line" aria-hidden="true"></span>
                </div>
                <div class="ag-pad" data-pane="drawn" hidden>
                  <canvas id="f-canvas" class="ag-canvas" aria-label="Draw your signature"></canvas>
                  <span class="ag-pad-line" aria-hidden="true"></span>
                  <span class="ag-pad-hint" id="f-hint">Sign here with your mouse, trackpad or finger</span>
                  <button type="button" class="ag-clear" id="f-clear">Clear</button>
                </div>
              </fieldset>

              <fieldset class="ag-fs">
                <legend><span class="ag-fs-no">3</span>Confirm</legend>
                <label class="ag-check">
                  <input type="checkbox" id="f-consent" />
                  <span>
                    I have read all {clauses.length} clauses and Schedule A, I agree to them, and I am authorised to sign for
                    {' '}<strong>{a.clientCompany || a.clientName}</strong>. I agree that this electronic signature is as binding as
                    a handwritten one (Section 10A, Information Technology Act, 2000).
                  </span>
                </label>
              </fieldset>

              <p class="ag-error" id="f-error" role="alert" hidden></p>

              <div class="ag-submit-row">
                <p class="ag-fine">Electronic signature, not an Aadhaar eSign or DSC.</p>
                <button type="submit" class="ag-btn solid lg" id="f-submit">
                  <span class="ag-btn-label">Sign agreement</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
                </button>
              </div>
            </form>
          </section>
        )}

        {clientSig && (
          <section class="ag-done">
            <span class="ag-done-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
            </span>
            <div>
              <h2>{providerSig ? 'Agreement fully signed' : 'Thanks, you have signed'}</h2>
              <p>
                {providerSig
                  ? `Both parties signed. The agreement took effect on ${longDate(a.signedAt ?? clientSig.signedAt)} and is now locked.`
                  : `You signed on ${longDate(clientSig.signedAt)}. ${a.providerName} will countersign shortly and you will get the final copy.`}
              </p>
            </div>
            <a class="ag-btn solid" href={`${pdfUrl}?download=1`} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
              Download signed PDF
            </a>
          </section>
        )}

        {closed && (
          <section class="ag-done is-closed">
            <div>
              <h2>This agreement is {STATUS_LABEL[a.status]?.toLowerCase()}</h2>
              <p>It can no longer be signed. Contact {a.providerEmail} if you think this is a mistake.</p>
            </div>
          </section>
        )}
      </div>
    </div>

    {canSign && (
      <div class="ag-mbar">
        <a class="ag-btn ghost" href={`${pdfUrl}?download=1`} target="_blank" rel="noopener" aria-label="Download PDF">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
          PDF
        </a>
        <a class="ag-btn solid" href="#sign">Review and sign</a>
      </div>
    )}
  </div>
</Base>

<style>
  .ag {
    --ag-ink: #1d2d3d;
    --ag-accent: #5980a6;
    --ag-tint: #94bce3;
    --ag-muted: #66737f;
    --ag-rule: #dde3e9;
    background:
      radial-gradient(1200px 420px at 50% -120px, rgba(148, 188, 227, 0.28), transparent 70%),
      #eef1f4;
    padding: calc(var(--nav-h, 72px) + 28px) 0 96px;
    color: var(--ag-ink);
  }
  .wrap { max-width: 1180px; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }

  /* Header */
  .ag-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .ag-head-text { min-width: 0; flex: 1 1 520px; }
  .ag-ref { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 10px; font-size: 0.82rem; color: var(--ag-muted); }
  .ag-ref .mono { color: var(--ag-accent); font-weight: 600; }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.6; }
  .ag-title {
    margin: 0;
    font-family: 'Bacasime Antique', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: 24ch;
  }
  .ag-sub { margin: 10px 0 0; color: var(--ag-muted); font-size: 0.98rem; }
  .ag-sub strong { color: var(--ag-ink); font-weight: 600; }
  .ag-head-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
  .ag-btns { display: flex; gap: 10px; flex-wrap: wrap; }

  .ag-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 5px 12px 5px 10px;
    border-radius: 99px;
    background: #fff;
    border: 1px solid var(--ag-rule);
  }
  .ag-status-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .ag-status.is-ok { color: #11683f; }
  .ag-status.is-wait { color: #7a4f00; }
  .ag-status.is-action { color: #1f5d99; }
  .ag-status.is-action .ag-status-dot { animation: pulse 1.8s ease-out infinite; }
  .ag-status.is-bad { color: #a12a2a; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(31, 93, 153, 0.45); }
    100% { box-shadow: 0 0 0 8px rgba(31, 93, 153, 0); }
  }

  .ag-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 18px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    border: 1px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }
  .ag-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ag-btn:active { transform: translateY(1px); }
  .ag-btn.solid { background: var(--ag-ink); color: #fff; box-shadow: 0 8px 20px -10px rgba(29, 45, 61, 0.7); }
  .ag-btn.solid:hover { background: #2a3f55; }
  .ag-btn.ghost { background: #fff; color: var(--ag-ink); border-color: var(--ag-rule); }
  .ag-btn.ghost:hover { border-color: var(--ag-accent); }
  .ag-btn.lg { height: 50px; padding: 0 26px; font-size: 1rem; }
  .ag-btn[disabled] { opacity: 0.6; cursor: progress; }

  /* Steps */
  .ag-steps {
    list-style: none;
    margin: 28px 0 0;
    padding: 14px 18px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    background: #fff;
    border: 1px solid var(--ag-rule);
    border-radius: 14px;
  }
  .ag-step { display: flex; align-items: center; gap: 10px; position: relative; min-width: 0; }
  .ag-step:not(:last-child)::after {
    content: '';
    flex: 1;
    height: 2px;
    margin: 0 6px 0 4px;
    background: var(--ag-rule);
    border-radius: 2px;
  }
  .ag-step.done:not(:last-child)::after { background: var(--ag-accent); }
  .ag-step-dot {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ag-muted);
    border: 1.5px solid var(--ag-rule);
    background: #fff;
  }
  .ag-step-dot svg { width: 15px; height: 15px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .ag-step.done .ag-step-dot { background: var(--ag-accent); border-color: var(--ag-accent); }
  .ag-step.now .ag-step-dot { border-color: var(--ag-ink); color: var(--ag-ink); box-shadow: 0 0 0 4px rgba(148, 188, 227, 0.35); }
  .ag-step-text { display: grid; line-height: 1.2; min-width: 0; }
  .ag-step-text strong { font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ag-step-text small { font-size: 0.74rem; color: var(--ag-muted); white-space: nowrap; }

  /* Layout */
  .ag-layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 32px; margin-top: 28px; align-items: start; }
  .ag-side { position: sticky; top: calc(var(--nav-h, 72px) + 20px); }
  .ag-side-inner { display: grid; gap: 18px; max-height: calc(100vh - var(--nav-h, 72px) - 40px); overflow: auto; padding-right: 4px; }
  .ag-side-label { margin: 0 0 8px; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ag-muted); font-weight: 600; }
  .ag-toc { display: grid; gap: 2px; }
  .ag-toc a, .ag-toc summary {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 0.88rem;
    color: #3a4a5a;
    text-decoration: none;
    border-left: 2px solid transparent;
  }
  .ag-toc a:hover { background: rgba(255, 255, 255, 0.8); color: var(--ag-ink); }
  .ag-toc a.is-active { background: #fff; color: var(--ag-ink); border-left-color: var(--ag-accent); font-weight: 600; }
  .ag-toc-terms summary { cursor: pointer; list-style: none; justify-content: space-between; padding: 0; }
  .ag-toc-terms summary::-webkit-details-marker { display: none; }
  .ag-toc-terms summary a { flex: 1; }
  .ag-toc-terms summary .mono { font-size: 0.7rem; color: var(--ag-muted); padding-right: 10px; }
  .ag-toc-clauses { display: grid; padding: 2px 0 6px 10px; }
  .ag-toc-clauses a { font-size: 0.8rem; padding: 4px 10px; line-height: 1.35; }
  .ag-toc-clauses .mono { font-size: 0.7rem; color: var(--ag-accent); min-width: 1.5em; }

  .ag-side-card { background: var(--ag-ink); color: #fff; border-radius: 14px; padding: 16px 18px; }
  .ag-side-card .ag-side-label { color: var(--ag-tint); }
  .ag-side-amount { margin: 0; font-family: 'Bacasime Antique', Georgia, serif; font-size: 1.8rem; line-height: 1.1; }
  .ag-side-note { margin: 6px 0 0; font-size: 0.8rem; color: rgba(255, 255, 255, 0.72); }
  .ag-side-help { margin: 0; font-size: 0.8rem; color: var(--ag-muted); line-height: 1.5; }
  .ag-side-help a { color: var(--ag-accent); word-break: break-all; }

  .ag-main { min-width: 0; display: grid; gap: 28px; }

  /* Sign panel */
  .ag-sign {
    background: #fff;
    border-radius: 18px;
    border: 1px solid var(--ag-rule);
    box-shadow: 0 24px 60px -30px rgba(29, 45, 61, 0.35);
    overflow: hidden;
    scroll-margin-top: calc(var(--nav-h, 72px) + 20px);
  }
  .ag-sign-head {
    padding: 28px clamp(20px, 4vw, 40px) 24px;
    background: linear-gradient(120deg, var(--ag-ink), #2c4661);
    color: #fff;
  }
  .ag-kicker { margin: 0 0 6px; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ag-tint); font-weight: 600; }
  .ag-sign-head h2 { margin: 0; font-family: 'Bacasime Antique', Georgia, serif; font-weight: 400; font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .ag-sign-head p { margin: 8px 0 0; max-width: 60ch; color: rgba(255, 255, 255, 0.78); font-size: 0.94rem; }

  .ag-form { padding: 8px clamp(20px, 4vw, 40px) 28px; }
  .ag-fs { border: 0; margin: 0; padding: 22px 0 6px; border-bottom: 1px solid var(--ag-rule); }
  .ag-fs:last-of-type { border-bottom: 0; }
  .ag-fs legend { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 0.98rem; padding: 0; margin-bottom: 14px; float: left; width: 100%; }
  .ag-fs legend + * { clear: both; }
  .ag-fs-no {
    width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center;
    background: rgba(148, 188, 227, 0.3); color: var(--ag-ink);
    font-size: 0.78rem; font-weight: 700;
  }
  .ag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; clear: both; }
  .ag-span { grid-column: 1 / -1; }
  .ag-field { display: grid; gap: 6px; }
  .ag-field > span { font-size: 0.82rem; font-weight: 600; color: #3a4a5a; }
  .ag-field em { font-style: normal; font-weight: 400; color: var(--ag-muted); }
  .ag-field input {
    height: 46px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid #cfd7df;
    background: #fbfcfd;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ag-ink);
    transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
  }
  .ag-field input:focus { outline: none; border-color: var(--ag-accent); background: #fff; box-shadow: 0 0 0 4px rgba(148, 188, 227, 0.35); }
  .ag-field input[aria-invalid='true'] { border-color: #c2410c; }

  .ag-tabs { display: inline-flex; padding: 4px; gap: 4px; background: #eef1f4; border-radius: 10px; margin-bottom: 12px; clear: both; }
  .ag-tab { border: 0; background: transparent; padding: 7px 18px; border-radius: 7px; font: inherit; font-size: 0.86rem; font-weight: 600; color: var(--ag-muted); cursor: pointer; }
  .ag-tab.is-on { background: #fff; color: var(--ag-ink); box-shadow: 0 1px 3px rgba(29, 45, 61, 0.15); }

  .ag-pad {
    position: relative;
    height: 170px;
    border-radius: 14px;
    border: 1px dashed #c3cdd7;
    background: linear-gradient(#fbfcfd, #f4f7fa);
    overflow: hidden;
  }
  .ag-pad[hidden] { display: none; }
  .ag-pad-line { position: absolute; left: 28px; right: 28px; bottom: 44px; height: 1px; background: #9fb0c0; pointer-events: none; }
  .ag-pad-line::before { content: '×'; position: absolute; left: -16px; bottom: 2px; color: #9fb0c0; font-size: 14px; }
  .ag-typed {
    position: absolute;
    inset: 0 28px 46px;
    width: calc(100% - 56px);
    border: 0;
    background: transparent;
    font-family: 'Mr Dafoe', 'Brush Script MT', cursive;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    color: #13233a;
    padding: 0;
    padding-top: 40px;
  }
  .ag-typed:focus { outline: none; }
  .ag-canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; max-width: none; touch-action: none; cursor: crosshair; }
  .ag-pad-hint { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-80%); text-align: center; color: #9fb0c0; font-size: 0.86rem; pointer-events: none; }
  .ag-clear {
    position: absolute; right: 10px; top: 10px;
    border: 1px solid var(--ag-rule); background: #fff; border-radius: 7px;
    padding: 4px 10px; font: inherit; font-size: 0.78rem; color: var(--ag-muted); cursor: pointer;
  }

  .ag-check { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; font-size: 0.9rem; line-height: 1.55; color: #3a4a5a; clear: both; }
  .ag-check input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--ag-ink); flex: none; }

  .ag-error { margin: 16px 0 0; padding: 10px 14px; border-radius: 10px; background: #fdecea; color: #9b2c2c; font-size: 0.88rem; }
  .ag-submit-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 22px; flex-wrap: wrap; }
  .ag-fine { margin: 0; font-size: 0.78rem; color: var(--ag-muted); }

  /* Done */
  .ag-done {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 18px;
    align-items: center;
    background: #fff;
    border: 1px solid #c9e7d6;
    border-radius: 18px;
    padding: 22px 26px;
  }
  .ag-done.is-closed { border-color: #f1cccc; grid-template-columns: 1fr; }
  .ag-done-icon { width: 46px; height: 46px; border-radius: 50%; background: #1f9d5c; display: grid; place-items: center; }
  .ag-done-icon svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .ag-done h2 { margin: 0; font-size: 1.15rem; }
  .ag-done p { margin: 4px 0 0; color: var(--ag-muted); font-size: 0.92rem; }

  .ag-mbar { display: none; }

  @media (max-width: 1023px) {
    .ag-layout { grid-template-columns: 1fr; }
    .ag-side { display: none; }
  }
  @media (max-width: 720px) {
    .ag { padding-bottom: 120px; }
    .ag-head-actions { align-items: flex-start; width: 100%; }
    .ag-steps { grid-template-columns: 1fr 1fr; row-gap: 14px; }
    .ag-step::after { display: none; }
    .ag-layout { margin-top: 20px; padding: 0; }
    .ag-paper { margin: 0 -1px; }
    .ag-sign { border-radius: 0; border-inline: 0; }
    .ag-grid { grid-template-columns: 1fr; }
    .ag-submit-row .ag-btn { width: 100%; }
    .ag-done { grid-template-columns: 1fr; margin: 0 16px; }
    .ag-mbar {
      display: flex;
      gap: 10px;
      position: fixed;
      left: 12px; right: 12px; bottom: max(12px, env(safe-area-inset-bottom));
      z-index: 40;
      padding: 8px;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      border: 1px solid var(--ag-rule);
      border-radius: 14px;
      box-shadow: 0 12px 30px -12px rgba(29, 45, 61, 0.4);
    }
    .ag-mbar .solid { flex: 1; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.ag');
  const token = root?.dataset.token;

  /* Contents: highlight the section in view. */
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const byId = new Map(links.map((l) => [l.hash.slice(1), l]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((l) => l.classList.remove('is-active'));
          byId.get(e.target.id)?.classList.add('is-active');
          if (e.target.id.startsWith('clause-')) byId.get('doc-terms')?.classList.add('is-active');
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }

  /* Signing form */
  const form = document.getElementById('sign-form') as HTMLFormElement | null;
  if (form && token) {
    let mode: 'typed' | 'drawn' = 'typed';
    const tabs = [...form.querySelectorAll<HTMLButtonElement>('.ag-tab')];
    const panes = [...form.querySelectorAll<HTMLElement>('[data-pane]')];
    const canvas = document.getElementById('f-canvas') as HTMLCanvasElement;
    const hint = document.getElementById('f-hint')!;
    const errorBox = document.getElementById('f-error')!;
    const submit = document.getElementById('f-submit') as HTMLButtonElement;
    const ctx = canvas.getContext('2d')!;
    let drawn = false;

    const sizeCanvas = () => {
      const r = canvas.getBoundingClientRect();
      if (!r.width) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const snapshot = drawn ? canvas.toDataURL() : null;
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.strokeStyle = '#13233a';
      if (snapshot) {
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0, r.width, r.height);
        img.src = snapshot;
      }
    };

    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        mode = t.dataset.mode as typeof mode;
        tabs.forEach((x) => {
          x.classList.toggle('is-on', x === t);
          x.setAttribute('aria-selected', String(x === t));
        });
        panes.forEach((p) => (p.hidden = p.dataset.pane !== mode));
        if (mode === 'drawn') requestAnimationFrame(sizeCanvas);
      }),
    );

    // Pressure-ish stroke: faster movement draws a thinner line, like ink.
    let last: { x: number; y: number; t: number } | null = null;
    let width = 2.4;
    const pos = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top, t: performance.now() };
    };
    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      last = pos(e);
      if (!drawn) {
        drawn = true;
        hint.hidden = true;
      }
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!last) return;
      const p = pos(e);
      const dist = Math.hypot(p.x - last.x, p.y - last.y);
      const speed = dist / Math.max(p.t - last.t, 1);
      width = width * 0.7 + Math.max(1.1, Math.min(3.2, 3.4 - speed * 1.4)) * 0.3;
      ctx.lineWidth = width;
      ctx.beginPath();
      ctx.moveTo(last.x, last.y);
      ctx.lineTo(p.x, p.y);
      ctx.stroke();
      last = p;
    });
    const end = () => (last = null);
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    document.getElementById('f-clear')?.addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawn = false;
      hint.hidden = false;
    });
    window.addEventListener('resize', () => mode === 'drawn' && sizeCanvas());

    /** Export the drawing cropped to the ink, so it sits neatly on the signature line. */
    const exportSignature = () => {
      const { width: w, height: h } = canvas;
      const px = ctx.getImageData(0, 0, w, h).data;
      let x0 = w, y0 = h, x1 = 0, y1 = 0;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          if (px[(y * w + x) * 4 + 3] > 10) {
            if (x < x0) x0 = x;
            if (x > x1) x1 = x;
            if (y < y0) y0 = y;
            if (y > y1) y1 = y;
          }
        }
      }
      if (x1 <= x0 || y1 <= y0) return null;
      const padding = 12;
      const out = document.createElement('canvas');
      out.width = x1 - x0 + padding * 2;
      out.height = y1 - y0 + padding * 2;
      out.getContext('2d')!.drawImage(canvas, x0 - padding, y0 - padding, out.width, out.height, 0, 0, out.width, out.height);
      return out.toDataURL('image/png');
    };

    const fail = (msg: string, field?: HTMLElement | null) => {
      errorBox.textContent = msg;
      errorBox.hidden = false;
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        field.focus();
      }
    };
    form.addEventListener('input', (e) => {
      (e.target as HTMLElement).removeAttribute('aria-invalid');
      errorBox.hidden = true;
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      const name = form.querySelector<HTMLInputElement>('#f-name')!;
      const email = form.querySelector<HTMLInputElement>('#f-email')!;
      const title = form.querySelector<HTMLInputElement>('#f-title')!;
      const typed = form.querySelector<HTMLInputElement>('#f-typed')!;
      const consent = form.querySelector<HTMLInputElement>('#f-consent')!;

      if (name.value.trim().length < 2) return fail('Enter your full legal name.', name);
      if (!/^\S+@\S+\.\S+$/.test(email.value.trim())) return fail('Enter a valid email address.', email);

      let signatureData: string | null = null;
      if (mode === 'typed') {
        signatureData = typed.value.trim();
        if (signatureData.length < 2) return fail('Type your signature.', typed);
      } else {
        signatureData = drawn ? exportSignature() : null;
        if (!signatureData) return fail('Draw your signature in the box.');
      }
      if (!consent.checked) return fail('Tick the box to confirm you agree to the terms.', consent);

      submit.disabled = true;
      submit.querySelector('.ag-btn-label')!.textContent = 'Signing…';
      try {
        const res = await fetch(`/api/agreements/${token}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            signerName: name.value.trim(),
            signerEmail: email.value.trim(),
            signerTitle: title.value.trim() || 'Authorised signatory',
            signatureType: mode,
            signatureData,
            consentChecked: true,
          }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.error || 'Could not record your signature.');
        submit.querySelector('.ag-btn-label')!.textContent = 'Signed';
        location.hash = '';
        location.reload();
      } catch (err) {
        fail((err as Error).message);
        submit.disabled = false;
        submit.querySelector('.ag-btn-label')!.textContent = 'Sign agreement';
      }
    });
  }
</script>
