---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { categories, counts, sharedServiceNames } from '../../data/catalog';
import { db, servicePricing } from '../../db';
import { dbRowToPricing, staticPricing, type Pricing } from '../../lib/pricing';

let livePricingMap: Record<string, Pricing> = { ...staticPricing };
try {
  const rows = await db.select().from(servicePricing);
  for (const row of rows) {
    if (row.serviceCode) {
      livePricingMap[row.serviceCode] = dbRowToPricing(row);
    }
  }
} catch (err) {
  console.warn('Neon query error in /services, fallback to static:', err);
}

const liveCoreCount = Object.values(livePricingMap).filter((p) => p.status === 'open').length;
const liveSoonCount = Object.values(livePricingMap).filter((p) => p.status === 'soon').length;
---

<Base title="Services" description={`The full Ascelstack catalogue: ${counts.services} services across ${counts.categories} disciplines.`}>
  <section class="cat-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Service catalogue</p>
      <h1 class="display h1" data-reveal>Everything <em>on the stack.</em></h1>
      <div class="cat-stats" data-reveal>
        <div><span class="display" id="hero-live-count">{liveCoreCount || counts.core}</span><span class="mono">Live services</span></div>
        <div><span class="display" id="hero-soon-count">{liveSoonCount || counts.future}</span><span class="mono">Coming soon</span></div>
        <div><span class="display">{counts.categories}</span><span class="mono">Disciplines</span></div>
      </div>
    </div>
  </section>

  <div class="cat-tools" data-tools>
    <div class="wrap cat-tools-inner">
      <label class="cat-search">
        <span class="sr">Search services</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" placeholder="Search 232 services — try “GST” or “chatbot”" data-search-input autocomplete="off" />
        <span class="mono cat-count" data-count aria-live="polite"></span>
      </label>
      <nav class="cat-tabs" aria-label="Filter by discipline" data-lenis-prevent>
        <button class="tab is-on" data-filter="all">All</button>
        {categories.map((c) => <button class="tab" data-filter={c.slug}>{c.short}</button>)}
      </nav>
    </div>
  </div>

  <div class="wrap cat-body">
    {
      categories.map((c) => (
        <section class="cat-group" id={c.slug} data-group={c.slug}>
          <header class="cat-group-head">
            <div>
              <p class="mono cat-group-meta">
                {c.priority === 'future' ? 'Coming soon' : `${c.layer} layer`} · {c.services.length} services
              </p>
              <h2 class="display h3">{c.name}</h2>
            </div>
            <a href={`/services/${c.slug}`} class="cat-group-link">
              Overview <span class="arrow">→</span>
            </a>
          </header>

          {c.subgroups.map((g) => (
            <div class="cat-sub" data-sub>
              {g.name && <h3 class="mono cat-sub-name">{g.name}</h3>}
              <div class="cat-cards">
                {g.services.map((s) => (
                  <ServiceCard service={s} layer={c.layer} shared={sharedServiceNames.has(s.name)} />
                ))}
              </div>
            </div>
          ))}

          {c.services[0]?.notes && <p class="cat-note">Note: {c.services[0].notes}</p>}
        </section>
      ))
    }

    <p class="cat-empty" data-empty hidden>
      No services match that search. <a href="/contact">Tell us what you need</a> and we'll scope it.
    </p>
  </div>
</Base>

<style>
  .cat-hero {
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5.5rem));
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    background:
      radial-gradient(50% 80% at 85% 0%, rgba(148, 188, 227, 0.35), transparent 70%),
      var(--paper);
  }
  .cat-hero .wrap { display: grid; gap: 1.5rem; }
  .cat-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3.5vw, 3.5rem);
    margin-top: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .cat-stats div { display: grid; gap: 0.25rem; min-width: 0; }
  .cat-stats .display {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  .cat-stats .mono { color: var(--text-muted); text-transform: uppercase; font-size: clamp(0.68rem, 0.62rem + 0.2vw, 0.75rem); letter-spacing: 0.08em; }

  @media (max-width: 560px) {
    .cat-stats {
      grid-template-columns: repeat(auto-fit, minmax(95px, 1fr));
      gap: 1rem 1.25rem;
    }
  }

  .cat-tools {
    position: sticky;
    top: 0;
    z-index: 25;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-block: 1px solid var(--line);
    transition: top 0.4s var(--ease-out);
  }
  :global(body:has(.nav:not(.is-hidden))) .cat-tools { top: var(--nav-h); }
  .cat-tools-inner { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; padding-block: 0.75rem; }
  .cat-search {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1.1rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .cat-search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(89, 128, 166, 0.15);
  }
  .cat-search svg { flex: none; color: var(--accent); }
  .cat-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text);
    font-size: 1rem;
  }
  .cat-search input::placeholder {
    color: var(--text-muted);
    opacity: 0.75;
    text-overflow: ellipsis;
  }
  @media (max-width: 480px) {
    .cat-search { padding: 0.6rem 0.9rem; gap: 0.5rem; }
    .cat-search input { font-size: 0.95rem; }
  }
  .cat-count {
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--paper-sunk);
    color: var(--ink);
    font-weight: 500;
  }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .cat-tabs {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block: 2px 4px;
    mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
  }
  .cat-tabs::-webkit-scrollbar { display: none; }
  .tab {
    flex: none;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    scroll-snap-align: start;
    touch-action: manipulation;
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  .tab:hover { border-color: var(--ink); }
  .tab.is-on { background: var(--ink); color: var(--paper); border-color: var(--ink); font-weight: 600; }

  .cat-body {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(4rem, 8vw, 8rem);
    display: grid;
    gap: clamp(3.5rem, 7vw, 5.5rem);
  }
  .cat-group {
    scroll-margin-top: calc(var(--nav-h) + 120px);
  }
  @media (max-width: 860px) {
    .cat-group { scroll-margin-top: calc(var(--nav-h) + 100px); }
  }

  .cat-group-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .cat-group-head h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.4rem);
  }
  .cat-group-meta { color: var(--accent); text-transform: uppercase; margin-bottom: 0.4rem; font-size: 0.75rem; letter-spacing: 0.08em; }
  .cat-group-link {
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    color: var(--ink);
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .cat-group-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .cat-group-link .arrow { display: inline-block; transition: transform 0.4s var(--ease-out); }
  .cat-group-link:hover .arrow { transform: translateX(4px); }

  .cat-sub + .cat-sub { margin-top: 2.25rem; }
  .cat-sub-name { color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.9rem; font-size: 0.78rem; letter-spacing: 0.08em; }
  .cat-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1rem;
  }
  @media (max-width: 580px) {
    .cat-cards {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }

  .cat-note {
    margin-top: 1.5rem;
    padding: 0.85rem 1.15rem;
    border-left: 2px solid var(--accent);
    background: var(--paper-sunk);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
  }
  .cat-empty { text-align: center; color: var(--text-muted); padding: 3rem 1rem; font-size: 1.1rem; }
  .cat-empty a { color: var(--accent); border-bottom: 1px solid currentColor; font-weight: 600; }
</style>

<script>
  import '../../scripts/realtime-pricing';

  const input = document.querySelector<HTMLInputElement>('[data-search-input]')!;
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const toolsEl = document.querySelector<HTMLElement>('[data-tools]');
  let filter = 'all';

  function apply() {
    const q = input.value.trim().toLowerCase();
    let total = 0;
    groups.forEach((g) => {
      const inCat = filter === 'all' || g.dataset.group === filter;
      let shown = 0;
      g.querySelectorAll<HTMLElement>('[data-sub]').forEach((sub) => {
        let subShown = 0;
        sub.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
          const ok = inCat && (!q || card.dataset.search!.includes(q));
          card.hidden = !ok;
          if (ok) subShown++;
        });
        sub.hidden = subShown === 0;
        shown += subShown;
      });
      g.hidden = shown === 0;
      total += shown;
    });
    countEl.textContent = `${total} shown`;
    empty.hidden = total > 0;
    window.dispatchEvent(new Event('resize')); // let ScrollTrigger recalc
  }

  // Listen for real-time pricing updates to adjust stats and search
  window.addEventListener('ascel:pricing-update', (e: any) => {
    apply();
    // Update live hero counters
    const allCards = document.querySelectorAll<HTMLElement>('article[data-card]');
    let openCount = 0;
    let soonCount = 0;
    allCards.forEach((c) => {
      if (c.classList.contains('card--future')) soonCount++;
      else openCount++;
    });
    const liveEl = document.getElementById('hero-live-count');
    const soonEl = document.getElementById('hero-soon-count');
    if (liveEl) liveEl.textContent = String(openCount);
    if (soonEl) soonEl.textContent = String(soonCount);
  });

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      filter = t.dataset.filter!;
      tabs.forEach((x) => x.classList.toggle('is-on', x === t));
      history.replaceState(null, '', filter === 'all' ? location.pathname : `#${filter}`);
      apply();

      const navEl = document.querySelector<HTMLElement>('.nav');
      const navH = navEl && !navEl.classList.contains('is-hidden') ? navEl.offsetHeight : 0;
      const toolsH = toolsEl ? toolsEl.offsetHeight : 80;
      const targetEl = filter === 'all' ? document.querySelector<HTMLElement>('.cat-body') : document.getElementById(filter);
      if (targetEl) {
        const top = targetEl.getBoundingClientRect().top + window.scrollY - (toolsH + navH + 16);
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      }
    }),
  );
  input.addEventListener('input', apply);

  const hash = location.hash.slice(1);
  const start = tabs.find((t) => t.dataset.filter === hash);
  if (start) {
    filter = hash;
    tabs.forEach((x) => x.classList.toggle('is-on', x === start));
  }
  apply();
</script>
