---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../lib/admin-auth';
import { db, users, quotations, quotationHistory, activityLogs } from '../../db';
import { sql, desc, eq, inArray, gte } from 'drizzle-orm';

// Strict Server-Side Session Check before running queries
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}

// 1. Database Queries for Real Statistics with Safe Fallbacks
let totalUsers = 0;
let newUsers = 0;
let totalQuotations = 0;
let pendingQuotations = 0;
let approvedQuotations = 0;
let completedQuotations = 0;
let paidQuotations = 0;
let partiallyPaidQuotations = 0;
let newInquiriesCount = 0;
let totalRevenue = 0;
let pipelineValue = 0;
let recentQuotations: any[] = [];
let recentHistory: any[] = [];

try {
  const usersCountResult = await db
    .select({ totalUsers: sql<number>`count(*)::int` })
    .from(users);
  totalUsers = usersCountResult[0]?.totalUsers || 0;

  const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
  const newUsersResult = await db
    .select({ newUsers: sql<number>`count(*)::int` })
    .from(users)
    .where(gte(users.createdAt, thirtyDaysAgo));
  newUsers = newUsersResult[0]?.newUsers || 0;

  const totalQuotationsResult = await db
    .select({ totalQuotations: sql<number>`count(*)::int` })
    .from(quotations);
  totalQuotations = totalQuotationsResult[0]?.totalQuotations || 0;

  const pendingResult = await db
    .select({ pendingQuotations: sql<number>`count(*)::int` })
    .from(quotations)
    .where(
      inArray(quotations.quotationStatus, [
        'New Inquiry',
        'Under Review',
        'Processing',
        'Estimation in Progress',
        'Quotation Prepared',
        'Awaiting Customer Approval',
      ])
    );
  pendingQuotations = pendingResult[0]?.pendingQuotations || 0;

  const approvedResult = await db
    .select({ approvedQuotations: sql<number>`count(*)::int` })
    .from(quotations)
    .where(eq(quotations.quotationStatus, 'Approved'));
  approvedQuotations = approvedResult[0]?.approvedQuotations || 0;

  const completedResult = await db
    .select({ completedQuotations: sql<number>`count(*)::int` })
    .from(quotations)
    .where(eq(quotations.quotationStatus, 'Completed'));
  completedQuotations = completedResult[0]?.completedQuotations || 0;

  const paidResult = await db
    .select({ paidQuotations: sql<number>`count(*)::int` })
    .from(quotations)
    .where(eq(quotations.paymentStatus, 'Payment Completed'));
  paidQuotations = paidResult[0]?.paidQuotations || 0;

  const partiallyPaidResult = await db
    .select({ partiallyPaidQuotations: sql<number>`count(*)::int` })
    .from(quotations)
    .where(eq(quotations.paymentStatus, 'Partially Paid'));
  partiallyPaidQuotations = partiallyPaidResult[0]?.partiallyPaidQuotations || 0;

  const newInqResult = await db
    .select({ newInquiriesCount: sql<number>`count(*)::int` })
    .from(quotations)
    .where(eq(quotations.quotationStatus, 'New Inquiry'));
  newInquiriesCount = newInqResult[0]?.newInquiriesCount || 0;

  const revenueResult = await db
    .select({
      totalRevenue: sql<number>`COALESCE(SUM(CASE WHEN ${quotations.paymentStatus} = 'Payment Completed' THEN ${quotations.finalQuotationAmount}::numeric ELSE 0 END), 0)::float`,
      pipelineValue: sql<number>`COALESCE(SUM(COALESCE(${quotations.finalQuotationAmount}::numeric, ${quotations.initialEstimatedCost}::numeric, 0)), 0)::float`,
    })
    .from(quotations);
  totalRevenue = revenueResult[0]?.totalRevenue || 0;
  pipelineValue = revenueResult[0]?.pipelineValue || 0;

  // 2. Fetch Recent Real Quotations & Inquiries from Neon DB
  // Ordered by latest update/creation so any status or payment update jumps to the top in real time!
  recentQuotations = await db
    .select({
      id: quotations.id,
      quotationNumber: quotations.quotationNumber,
      projectTitle: quotations.projectTitle,
      quotationStatus: quotations.quotationStatus,
      paymentStatus: quotations.paymentStatus,
      projectProgress: quotations.projectProgress,
      finalQuotationAmount: quotations.finalQuotationAmount,
      currency: quotations.currency,
      createdAt: quotations.createdAt,
      updatedAt: quotations.updatedAt,
      customer: {
        id: users.id,
        fullName: users.fullName,
        email: users.email,
      },
    })
    .from(quotations)
    .innerJoin(users, eq(quotations.userId, users.id))
    .orderBy(desc(sql`COALESCE(${quotations.updatedAt}, ${quotations.createdAt})`))
    .limit(8);

  // 3. Fetch Recent Change History from Neon DB
  recentHistory = await db
    .select({
      id: quotationHistory.id,
      quotationId: quotationHistory.quotationId,
      fieldChanged: quotationHistory.fieldChanged,
      previousValue: quotationHistory.previousValue,
      newValue: quotationHistory.newValue,
      description: quotationHistory.description,
      adminEmail: quotationHistory.adminEmail,
      createdAt: quotationHistory.createdAt,
      quotationNumber: quotations.quotationNumber,
    })
    .from(quotationHistory)
    .leftJoin(quotations, eq(quotationHistory.quotationId, quotations.id))
    .orderBy(desc(quotationHistory.createdAt))
    .limit(6);
} catch (dbErr) {
  console.warn('Non-fatal error loading admin dashboard metrics:', dbErr);
}

// Donut math for Big Circular Chart
// Radius = 75, Circumference = 2 * PI * 75 = 471.24
const CIRCUMFERENCE = 471.24;
const totalQuotesCount = Math.max(1, totalQuotations);

// Fractions of circle
const paidLen = (paidQuotations / totalQuotesCount) * CIRCUMFERENCE;
const approvedLen = (approvedQuotations / totalQuotesCount) * CIRCUMFERENCE;
const pendingLen = (pendingQuotations / totalQuotesCount) * CIRCUMFERENCE;
const otherLen = Math.max(0, CIRCUMFERENCE - (paidLen + approvedLen + pendingLen));

// Offsets
const paidOffset = 0;
const approvedOffset = -(paidLen);
const pendingOffset = -(paidLen + approvedLen);
const otherOffset = -(paidLen + approvedLen + pendingLen);

const healthRatePct = totalQuotations > 0 ? Math.round(((approvedQuotations + completedQuotations + paidQuotations) / (totalQuotations * 2 || 1)) * 100) : 0;
const paidPct = totalQuotations > 0 ? Math.round((paidQuotations / totalQuotations) * 100) : 0;
const pendingPct = totalQuotations > 0 ? Math.round((pendingQuotations / totalQuotations) * 100) : 0;
const approvedPct = totalQuotations > 0 ? Math.round((approvedQuotations / totalQuotations) * 100) : 0;
---

<AdminLayout title="Overview" activeNav="overview" breadcrumbs={[{ label: 'Overview' }]} session={session}>
  <!-- Dashboard Hero Welcome Card -->
  <div class="dash-welcome-card">
    <div class="welcome-copy">
      <div class="welcome-tag-row">
        <span class="eyebrow">Enterprise Control Plane</span>
        <div class="live-pulse-badge" title="Live Auto-Sync with Neon Database & Clerk">
          <span class="buzzblink-dot"></span>
          <span class="mono text-xs">REAL-TIME AUTO-SYNC</span>
        </div>
      </div>
      <h1 class="display welcome-title">Ascelstack <em>Overview</em></h1>
      <p class="welcome-desc">
        Real-time pipeline monitoring, live quotation tracking, customer activity audit, and project progress oversight directly synchronized with your Neon database.
      </p>
    </div>
    <div class="welcome-actions">
      <a href="/admin/quotations" class="btn btn-primary">
        <span>Manage Quotations</span>
        <span class="arrow">→</span>
      </a>
      <a href="/admin/users" class="btn btn-ghost">
        <span>Registered Users</span>
        <span class="arrow">→</span>
      </a>
      <a href="/admin/logs" class="btn btn-ghost">
        <span>Activity Trail</span>
      </a>
    </div>
  </div>

  <!-- 4 Compact Statistic Cards with Circular Indicators -->
  <div class="metrics-grid">
    <!-- Card 1: Total Registered Users -->
    <div class="metric-card metric-card--total">
      <div class="metric-top-row">
        <div class="metric-meta">
          <span class="mono metric-label">REGISTERED USERS</span>
          <span class="metric-dot"></span>
        </div>
        <div class="circ-indicator" title="Total unique accounts">
          <svg viewBox="0 0 36 36" class="circ-svg">
            <path class="circ-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
            <path class="circ-fill circ-blue" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
          </svg>
          <span class="mono circ-val">100%</span>
        </div>
      </div>
      <div class="metric-value" id="stat-total-users">{totalUsers}</div>
      <span class="metric-hint">Deduplicated & Synced</span>
    </div>

    <!-- Card 2: Total Quotations -->
    <div class="metric-card metric-card--completed">
      <div class="metric-top-row">
        <div class="metric-meta">
          <span class="mono metric-label">TOTAL PIPELINES</span>
          <span class="metric-dot dot-accent"></span>
        </div>
        <div class="circ-indicator" title="Total project scopes">
          <svg viewBox="0 0 36 36" class="circ-svg">
            <path class="circ-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
            <path class="circ-fill circ-accent" stroke-dasharray="100, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
          </svg>
          <span class="mono circ-val">{totalQuotations}</span>
        </div>
      </div>
      <div class="metric-value text-accent" id="stat-total-quotations">{totalQuotations}</div>
      <span class="metric-hint">Client project scopes</span>
    </div>

    <!-- Card 3: Fully Paid & Verified Revenue -->
    <div class="metric-card metric-card--paid">
      <div class="metric-top-row">
        <div class="metric-meta">
          <span class="mono metric-label">FULLY PAID & APPROVED</span>
          <span class="metric-dot dot-success"></span>
        </div>
        <div class="circ-indicator" title={`${paidPct}% of quotations fully paid`}>
          <svg viewBox="0 0 36 36" class="circ-svg">
            <path class="circ-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
            <path class="circ-fill circ-green" id="circ-fill-paid" stroke-dasharray={`${paidPct}, 100`} d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
          </svg>
          <span class="mono circ-val" id="circ-val-paid">{paidPct}%</span>
        </div>
      </div>
      <div class="metric-value text-success" id="stat-paid-quotations">{paidQuotations}</div>
      <span class="metric-hint" id="stat-revenue-hint">₹{totalRevenue.toLocaleString()} Verified</span>
    </div>

    <!-- Card 4: Pending Review / Action -->
    <div class="metric-card metric-card--pending">
      <div class="metric-top-row">
        <div class="metric-meta">
          <span class="mono metric-label">PENDING REVIEW</span>
          <span class="metric-dot dot-warn"></span>
        </div>
        <div class="circ-indicator" title={`${pendingPct}% of quotations awaiting review or pricing`}>
          <svg viewBox="0 0 36 36" class="circ-svg">
            <path class="circ-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
            <path class="circ-fill circ-warn" id="circ-fill-pending" stroke-dasharray={`${pendingPct}, 100`} d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
          </svg>
          <span class="mono circ-val" id="circ-val-pending">{pendingPct}%</span>
        </div>
      </div>
      <div class="metric-value text-warn" id="stat-pending-quotations">{pendingQuotations}</div>
      <span class="metric-hint">Awaiting quote prep</span>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- BIG CIRCULAR VISUAL RADAR: Live Status & Fulfillment Ring -->
  <!-- ============================================================== -->
  <div class="card-panel radar-panel">
    <div class="panel-header radar-header">
      <div>
        <div class="radar-tag-row">
          <span class="eyebrow">Visual Telemetry</span>
          <div class="buzzblink-badge">
            <span class="buzzblink-dot"></span>
            <span class="mono text-xs">BUZZBLINK TELEMETRY</span>
          </div>
        </div>
        <h2 class="display h3 panel-title">Pipeline & Fulfillment Radar</h2>
        <p class="panel-subtitle">
          Instant high-contrast circular visualization of current project stages, payments, and approvals across all customer services
        </p>
      </div>

      <div class="radar-quick-stats mono">
        <span class="radar-stat-chip">
          <span class="chip-dot chip-dot-paid"></span> Paid: <strong id="chip-paid-count">{paidQuotations}</strong>
        </span>
        <span class="radar-stat-chip">
          <span class="chip-dot chip-dot-approved"></span> Approved: <strong id="chip-approved-count">{approvedQuotations}</strong>
        </span>
        <span class="radar-stat-chip">
          <span class="chip-dot chip-dot-pending"></span> Pending: <strong id="chip-pending-count">{pendingQuotations}</strong>
        </span>
      </div>
    </div>

    <div class="radar-layout">
      <!-- The Big Circular Ring Visualization -->
      <div class="radar-circle-wrap">
        <div class="radar-circle-container">
          <svg viewBox="0 0 200 200" class="radar-svg" id="radar-svg-elem">
            <!-- Background track -->
            <circle cx="100" cy="100" r="75" class="radar-track-bg" />

            <!-- Segment 1: Fully Paid (Emerald Green) -->
            <circle
              cx="100"
              cy="100"
              r="75"
              class="radar-segment segment-paid"
              id="seg-paid"
              stroke-dasharray={`${paidLen} ${CIRCUMFERENCE}`}
              stroke-dashoffset={paidOffset}
            />

            <!-- Segment 2: Approved Workflows (Cyan/Teal) -->
            <circle
              cx="100"
              cy="100"
              r="75"
              class="radar-segment segment-approved"
              id="seg-approved"
              stroke-dasharray={`${approvedLen} ${CIRCUMFERENCE}`}
              stroke-dashoffset={approvedOffset}
            />

            <!-- Segment 3: In Review / Pending (Amber) -->
            <circle
              cx="100"
              cy="100"
              r="75"
              class="radar-segment segment-pending"
              id="seg-pending"
              stroke-dasharray={`${pendingLen} ${CIRCUMFERENCE}`}
              stroke-dashoffset={pendingOffset}
            />

            <!-- Segment 4: Other / New Inquiries (Indigo) -->
            <circle
              cx="100"
              cy="100"
              r="75"
              class="radar-segment segment-other"
              id="seg-other"
              stroke-dasharray={`${otherLen} ${CIRCUMFERENCE}`}
              stroke-dashoffset={otherOffset}
            />
          </svg>

          <!-- Center Information with Buzzblink Pulse -->
          <div class="radar-center-content">
            <div class="center-pulse-wrap">
              <span class="buzzblink-dot-large"></span>
            </div>
            <strong class="radar-center-pct" id="radar-center-pct">{paidPct}%</strong>
            <span class="radar-center-label">PAID / COMPLETE</span>
            <span class="radar-center-sub" id="radar-center-sub">₹{totalRevenue.toLocaleString()}</span>
          </div>
        </div>
      </div>

      <!-- Radar Legend & Metric Breakdown Cards -->
      <div class="radar-legend-grid">
        <!-- Legend Item 1: Fully Paid -->
        <div class="radar-card card-paid">
          <div class="radar-card-top">
            <span class="radar-badge-dot dot-emerald"></span>
            <span class="mono radar-card-cat">PAYMENT COMPLETED</span>
          </div>
          <div class="radar-card-body">
            <span class="radar-card-num" id="radar-num-paid">{paidQuotations}</span>
            <div class="radar-card-details">
              <strong class="radar-card-val text-success">₹{totalRevenue.toLocaleString()}</strong>
              <span class="mono text-xs text-muted">{paidPct}% of total orders</span>
            </div>
          </div>
          <div class="radar-progress-mini">
            <div class="progress-bar-fill fill-emerald" id="bar-paid" style={`width: ${paidPct}%;`}></div>
          </div>
        </div>

        <!-- Legend Item 2: Approved Workflows -->
        <div class="radar-card card-approved">
          <div class="radar-card-top">
            <span class="radar-badge-dot dot-cyan"></span>
            <span class="mono radar-card-cat">APPROVED WORKFLOWS</span>
          </div>
          <div class="radar-card-body">
            <span class="radar-card-num" id="radar-num-approved">{approvedQuotations}</span>
            <div class="radar-card-details">
              <strong class="radar-card-val text-accent">Active Delivery</strong>
              <span class="mono text-xs text-muted">{approvedPct}% approved scopes</span>
            </div>
          </div>
          <div class="radar-progress-mini">
            <div class="progress-bar-fill fill-cyan" id="bar-approved" style={`width: ${approvedPct}%;`}></div>
          </div>
        </div>

        <!-- Legend Item 3: Under Review / Estimation -->
        <div class="radar-card card-pending">
          <div class="radar-card-top">
            <span class="radar-badge-dot dot-amber"></span>
            <span class="mono radar-card-cat">UNDER REVIEW</span>
          </div>
          <div class="radar-card-body">
            <span class="radar-card-num" id="radar-num-pending">{pendingQuotations}</span>
            <div class="radar-card-details">
              <strong class="radar-card-val text-warn">Awaiting Preparation</strong>
              <span class="mono text-xs text-muted">{pendingPct}% requiring action</span>
            </div>
          </div>
          <div class="radar-progress-mini">
            <div class="progress-bar-fill fill-amber" id="bar-pending" style={`width: ${pendingPct}%;`}></div>
          </div>
        </div>

        <!-- Legend Item 4: New Customer Inquiries -->
        <div class="radar-card card-inquiries">
          <div class="radar-card-top">
            <span class="radar-badge-dot dot-indigo"></span>
            <span class="mono radar-card-cat">NEW INQUIRIES</span>
          </div>
          <div class="radar-card-body">
            <span class="radar-card-num" id="radar-num-inquiries">{newInquiriesCount}</span>
            <div class="radar-card-details">
              <strong class="radar-card-val">Client Inbound</strong>
              <span class="mono text-xs text-muted">Awaiting initial triage</span>
            </div>
          </div>
          <div class="radar-progress-mini">
            <div class="progress-bar-fill fill-indigo" id="bar-inquiries" style={`width: ${Math.round((newInquiriesCount / totalQuotesCount) * 100)}%;`}></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Two Column Content Grid -->
  <div class="overview-columns">
    <!-- Left Column: Recent Customer Inquiries & Quotations -->
    <div class="card-panel">
      <div class="panel-header">
        <div>
          <h2 class="panel-title display h3">Recent Quotations & Inquiries</h2>
          <p class="panel-subtitle">Latest customer requirements and status updates</p>
        </div>
        <a href="/admin/quotations" class="text-link mono">View All ({totalQuotations}) →</a>
      </div>

      <div class="requests-table-wrap">
        <table class="data-table" id="recent-quotes-table">
          <thead>
            <tr>
              <th>Quotation Ref & Title</th>
              <th>Customer</th>
              <th>Quotation Status</th>
              <th>Payment Status</th>
              <th>Progress</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="recent-quotes-tbody">
            {recentQuotations.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No quotations recorded yet.</td>
              </tr>
            ) : (
              recentQuotations.map((q) => (
                <tr class="table-row-hover">
                  <td>
                    <strong class="table-proj-title">{q.projectTitle}</strong>
                    <span class="mono table-code">{q.quotationNumber}</span>
                  </td>
                  <td>
                    <div class="cust-cell">
                      <a href={`/admin/users/${q.customer.id}`} class="cust-name-link" title="Open customer account">
                        {q.customer.fullName || 'Ascelstack Customer'}
                      </a>
                      <span class="mono cust-email">{q.customer.email}</span>
                    </div>
                  </td>
                  <td>
                    <span class={`status-tag status-${q.quotationStatus.toLowerCase().replace(/\s+/g, '-')}`}>
                      {q.quotationStatus}
                    </span>
                  </td>
                  <td>
                    <span class={`payment-pill payment-${q.paymentStatus.toLowerCase().replace(/\s+/g, '-')}`}>
                      {q.paymentStatus}
                    </span>
                  </td>
                  <td>
                    <div class="progress-cell">
                      <div class="mini-progress-bar">
                        <div class="mini-progress-fill" style={`width: ${q.projectProgress}%;`}></div>
                      </div>
                      <span class="mono text-xs">{q.projectProgress}%</span>
                    </div>
                  </td>
                  <td>
                    <a href={`/admin/quotations/${q.id}`} class="btn-table-action" title="Open Quotation">
                      Manage →
                    </a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Right Column: Recent Activity Logs -->
    <div class="card-panel">
      <div class="panel-header">
        <div>
          <h2 class="panel-title display h3">Recent Activity Trail</h2>
          <p class="panel-subtitle">Audit log of quotation updates & administrative actions</p>
        </div>
        <a href="/admin/logs" class="text-link mono">Full Log →</a>
      </div>

      <div class="activity-feed" id="recent-activity-feed">
        {recentHistory.length === 0 ? (
          <p class="empty-subtext">No historical updates recorded yet. Modifications made to quotations will appear here.</p>
        ) : (
          recentHistory.map((act) => (
            <div class="activity-item">
              <div class="activity-bullet"></div>
              <div class="activity-body">
                <div class="activity-header">
                  {act.quotationNumber && (
                    <span class="mono activity-ref-pill">{act.quotationNumber}</span>
                  )}
                  <span class="mono activity-admin-email">{act.adminEmail}</span>
                </div>
                <p class="activity-desc">{act.description}</p>
                <span class="mono activity-time">
                  {new Date(act.createdAt).toLocaleDateString('en-IN', {
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                  })}
                </span>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>

  <style>
    .welcome-tag-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.4rem;
      flex-wrap: wrap;
    }
    .live-pulse-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #065f46;
      font-weight: 600;
    }

    /* Buzzblink Animation: Pulsing radar effect */
    .buzzblink-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      animation: buzzblink 2s infinite cubic-bezier(0.66, 0, 0, 1);
    }
    .buzzblink-dot-large {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #10b981;
      display: inline-block;
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.8);
      animation: buzzblink 1.8s infinite cubic-bezier(0.66, 0, 0, 1);
    }

    @keyframes buzzblink {
      0% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
      }
      70% {
        transform: scale(1);
        box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
      }
      100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
      }
    }

    .metric-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }
    .circ-indicator {
      width: 34px;
      height: 34px;
      position: relative;
      display: grid;
      place-items: center;
    }
    .circ-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .circ-bg {
      fill: none;
      stroke: var(--paper-sunk);
      stroke-width: 3.8;
    }
    .circ-fill {
      fill: none;
      stroke-width: 3.8;
      stroke-linecap: round;
      transition: stroke-dasharray 0.6s ease;
    }
    .circ-blue { stroke: var(--ink); }
    .circ-accent { stroke: var(--accent); }
    .circ-green { stroke: #10b981; }
    .circ-warn { stroke: #f59e0b; }
    .circ-val {
      position: absolute;
      font-size: 0.58rem;
      font-weight: 700;
      color: var(--ink);
    }

    /* Radar Section Styling */
    .radar-panel {
      margin-bottom: 2rem;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-l);
      box-shadow: 0 12px 36px -16px rgba(20, 33, 48, 0.08);
      padding: clamp(1.25rem, 3vw, 2rem);
    }
    .radar-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .radar-tag-row {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      margin-bottom: 0.25rem;
    }
    .buzzblink-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: rgba(14, 165, 233, 0.1);
      color: #0369a1;
      padding: 0.15rem 0.5rem;
