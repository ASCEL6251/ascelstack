      border-radius: 50%;
    }
    .chip-dot-paid { background: #10b981; }
    .chip-dot-approved { background: #06b6d4; }
    .chip-dot-pending { background: #f59e0b; }

    /* Radar Main Layout */
    .radar-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 2rem;
      align-items: center;
    }
    .radar-circle-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .radar-circle-container {
      width: 220px;
      height: 220px;
      position: relative;
      display: grid;
      place-items: center;
    }
    .radar-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .radar-track-bg {
      fill: none;
      stroke: var(--paper-sunk);
      stroke-width: 14;
    }
    .radar-segment {
      fill: none;
      stroke-width: 14;
      stroke-linecap: round;
      transition: stroke-dasharray 0.75s cubic-bezier(0.4, 0, 0.2, 1), stroke-dashoffset 0.75s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .segment-paid { stroke: #10b981; }
    .segment-approved { stroke: #06b6d4; }
    .segment-pending { stroke: #f59e0b; }
    .segment-other { stroke: #6366f1; }

    .radar-center-content {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      pointer-events: none;
    }
    .center-pulse-wrap {
      margin-bottom: 0.2rem;
    }
    .radar-center-pct {
      font-size: 1.85rem;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--ink);
      line-height: 1;
    }
    .radar-center-label {
      font-size: 0.65rem;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      margin-top: 0.2rem;
    }
    .radar-center-sub {
      font-size: 0.75rem;
      font-family: var(--font-mono);
      font-weight: 600;
      color: #10b981;
    }

    /* Radar Legend Breakdown Cards */
    .radar-legend-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
    }
    .radar-card {
      background: var(--paper-sunk);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1rem 1.15rem;
      display: grid;
      gap: 0.6rem;
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    .radar-card:hover {
      transform: translateY(-2px);
      border-color: rgba(89, 128, 166, 0.35);
      box-shadow: 0 6px 18px -8px rgba(29, 45, 61, 0.12);
    }
    .radar-card-top {
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }
    .radar-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }
    .dot-emerald { background: #10b981; }
    .dot-cyan { background: #06b6d4; }
    .dot-amber { background: #f59e0b; }
    .dot-indigo { background: #6366f1; }
    .radar-card-cat {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--text-muted);
      letter-spacing: 0.04em;
    }
    .radar-card-body {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .radar-card-num {
      font-size: 1.65rem;
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--ink);
      line-height: 1;
    }
    .radar-card-details {
      display: grid;
      text-align: right;
      gap: 0.1rem;
    }
    .radar-card-val {
      font-size: 0.88rem;
    }
    .radar-progress-mini {
      height: 4px;
      background: rgba(29, 45, 61, 0.08);
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.6s ease;
    }
    .fill-emerald { background: #10b981; }
    .fill-cyan { background: #06b6d4; }
    .fill-amber { background: #f59e0b; }
    .fill-indigo { background: #6366f1; }

    /* Tables & Common */
    .table-proj-title {
      display: block;
      color: var(--ink);
      font-size: 0.92rem;
    }
    .table-code {
      display: block;
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .cust-cell {
      display: grid;
      gap: 0.1rem;
    }
    .cust-name-link {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--ink);
      text-decoration: none;
    }
    .cust-name-link:hover {
      color: var(--accent);
      text-decoration: underline;
    }
    .cust-email {
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .progress-cell {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .mini-progress-bar {
      width: 48px;
      height: 6px;
      background: var(--paper-sunk);
      border-radius: 999px;
      overflow: hidden;
    }
    .mini-progress-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 999px;
      transition: width 0.5s ease;
    }
    .btn-table-action {
      display: inline-flex;
      align-items: center;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent);
      padding: 0.3rem 0.65rem;
      border-radius: 999px;
      background: var(--paper-sunk);
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-table-action:hover {
      background: var(--ink);
      color: var(--paper);
    }
    .activity-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.2rem;
      flex-wrap: wrap;
    }
    .activity-ref-pill {
      font-size: 0.65rem;
      background: var(--paper-sunk);
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      color: var(--accent);
    }
    .activity-admin-email {
      font-size: 0.68rem;
      color: var(--text-muted);
    }
    .payment-pill {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: var(--font-mono);
      background: var(--paper-sunk);
      color: var(--text-muted);
    }
    .payment-payment-completed {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }
    .payment-payment-pending {
      background: #fffbeb;
      color: #92400e;
      border: 1px solid #fde68a;
    }
    .payment-partially-paid {
      background: #f0fdfa;
      color: #0f766e;
      border: 1px solid #99f6e4;
    }
    .payment-not-required {
      background: var(--paper-sunk);
      color: var(--text-muted);
    }

    /* Mobile & Tablet Responsiveness for Overview */
    @media (max-width: 900px) {
      .radar-layout {
        grid-template-columns: 1fr;
        justify-items: center;
      }
      .radar-legend-grid {
        width: 100%;
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .welcome-tag-row {
        flex-direction: column;
        align-items: flex-start;
      }
      .radar-header {
        flex-direction: column;
      }
      .radar-quick-stats {
        width: 100%;
      }
      .radar-legend-grid {
        grid-template-columns: 1fr;
      }
      .overview-columns {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <!-- ============================================================== -->
  <!-- REAL-TIME SYNC ENGINE: BroadcastChannel, SSE & Auto-Update -->
  <!-- ============================================================== -->
  <script>
    const CIRCUMFERENCE = 471.24;
    let isUpdating = false;

    async function refreshOverview(silent = false) {
      if (isUpdating) return;
      isUpdating = true;

      try {
        const res = await fetch('/api/admin/stats', {
          headers: { 'Cache-Control': 'no-cache' },
          cache: 'no-store',
        });

        if (!res.ok) {
          isUpdating = false;
          return;
        }

        const data = await res.json();
        const s = data.stats;

        // 1. Update Top Metric Cards
        const totalUsersEl = document.getElementById('stat-total-users');
        const totalQuotesEl = document.getElementById('stat-total-quotations');
        const paidQuotesEl = document.getElementById('stat-paid-quotations');
        const pendingQuotesEl = document.getElementById('stat-pending-quotations');
        const revenueHintEl = document.getElementById('stat-revenue-hint');

        if (totalUsersEl) totalUsersEl.textContent = String(s.totalUsers);
        if (totalQuotesEl) totalQuotesEl.textContent = String(s.totalQuotations);
        if (paidQuotesEl) paidQuotesEl.textContent = String(s.paidQuotations || 0);
        if (pendingQuotesEl) pendingQuotesEl.textContent = String(s.pendingQuotations);
        if (revenueHintEl) revenueHintEl.textContent = `₹${(s.totalRevenue || 0).toLocaleString()} Verified`;

        // Circular indicators in top cards
        const circFillPaid = document.getElementById('circ-fill-paid');
        const circValPaid = document.getElementById('circ-val-paid');
        const circFillPending = document.getElementById('circ-fill-pending');
        const circValPending = document.getElementById('circ-val-pending');

        const totalQ = Math.max(1, s.totalQuotations);
        const paidPct = Math.round(((s.paidQuotations || 0) / totalQ) * 100);
        const pendingPct = Math.round((s.pendingQuotations / totalQ) * 100);
        const approvedPct = Math.round(((s.approvedQuotations || 0) / totalQ) * 100);
        const newInqCount = s.newInquiriesCount || 0;

        if (circFillPaid) circFillPaid.setAttribute('stroke-dasharray', `${paidPct}, 100`);
        if (circValPaid) circValPaid.textContent = `${paidPct}%`;
        if (circFillPending) circFillPending.setAttribute('stroke-dasharray', `${pendingPct}, 100`);
        if (circValPending) circValPending.textContent = `${pendingPct}%`;

        // 2. Update Big Radar SVG Donut Arcs & Calculations
        const paidLen = ((s.paidQuotations || 0) / totalQ) * CIRCUMFERENCE;
        const approvedLen = ((s.approvedQuotations || 0) / totalQ) * CIRCUMFERENCE;
        const pendingLen = (s.pendingQuotations / totalQ) * CIRCUMFERENCE;
        const otherLen = Math.max(0, CIRCUMFERENCE - (paidLen + approvedLen + pendingLen));

        const paidOffset = 0;
        const approvedOffset = -paidLen;
        const pendingOffset = -(paidLen + approvedLen);
        const otherOffset = -(paidLen + approvedLen + pendingLen);

        const segPaid = document.getElementById('seg-paid');
        const segApproved = document.getElementById('seg-approved');
        const segPending = document.getElementById('seg-pending');
        const segOther = document.getElementById('seg-other');

        if (segPaid) {
          segPaid.setAttribute('stroke-dasharray', `${paidLen} ${CIRCUMFERENCE}`);
          segPaid.setAttribute('stroke-dashoffset', String(paidOffset));
        }
        if (segApproved) {
          segApproved.setAttribute('stroke-dasharray', `${approvedLen} ${CIRCUMFERENCE}`);
          segApproved.setAttribute('stroke-dashoffset', String(approvedOffset));
        }
        if (segPending) {
          segPending.setAttribute('stroke-dasharray', `${pendingLen} ${CIRCUMFERENCE}`);
          segPending.setAttribute('stroke-dashoffset', String(pendingOffset));
        }
        if (segOther) {
          segOther.setAttribute('stroke-dasharray', `${otherLen} ${CIRCUMFERENCE}`);
          segOther.setAttribute('stroke-dashoffset', String(otherOffset));
        }

        // Radar center
        const radarPctEl = document.getElementById('radar-center-pct');
        const radarSubEl = document.getElementById('radar-center-sub');
        if (radarPctEl) radarPctEl.textContent = `${paidPct}%`;
        if (radarSubEl) radarSubEl.textContent = `₹${(s.totalRevenue || 0).toLocaleString()}`;

        // Radar Chips & Legend
        const chipPaid = document.getElementById('chip-paid-count');
        const chipApproved = document.getElementById('chip-approved-count');
        const chipPending = document.getElementById('chip-pending-count');
        if (chipPaid) chipPaid.textContent = String(s.paidQuotations || 0);
        if (chipApproved) chipApproved.textContent = String(s.approvedQuotations || 0);
        if (chipPending) chipPending.textContent = String(s.pendingQuotations);

        const numPaid = document.getElementById('radar-num-paid');
        const numApproved = document.getElementById('radar-num-approved');
        const numPending = document.getElementById('radar-num-pending');
        const numInquiries = document.getElementById('radar-num-inquiries');
        if (numPaid) numPaid.textContent = String(s.paidQuotations || 0);
        if (numApproved) numApproved.textContent = String(s.approvedQuotations || 0);
        if (numPending) numPending.textContent = String(s.pendingQuotations);
        if (numInquiries) numInquiries.textContent = String(newInqCount);

        const barPaid = document.getElementById('bar-paid');
        const barApproved = document.getElementById('bar-approved');
        const barPending = document.getElementById('bar-pending');
        const barInquiries = document.getElementById('bar-inquiries');
        if (barPaid) barPaid.style.width = `${paidPct}%`;
        if (barApproved) barApproved.style.width = `${approvedPct}%`;
        if (barPending) barPending.style.width = `${pendingPct}%`;
        if (barInquiries) barInquiries.style.width = `${Math.round((newInqCount / totalQ) * 100)}%`;

        // 3. Update Recent Quotations Table (Live Reactive Row Rendering)
        if (Array.isArray(data.recentQuotations)) {
          const tbody = document.getElementById('recent-quotes-tbody');
          if (tbody) {
            tbody.innerHTML = data.recentQuotations.map((q: any) => `
              <tr class="table-row-hover">
                <td>
                  <strong class="table-proj-title">${escapeHtml(q.projectTitle)}</strong>
                  <span class="mono table-code">${escapeHtml(q.quotationNumber)}</span>
                </td>
                <td>
                  <div class="cust-cell">
                    <a href="/admin/users/${q.customer.id}" class="cust-name-link" title="Open customer account">
                      ${escapeHtml(q.customer.fullName || 'Ascelstack Customer')}
                    </a>
                    <span class="mono cust-email">${escapeHtml(q.customer.email)}</span>
                  </div>
                </td>
                <td>
                  <span class="status-tag status-${q.quotationStatus.toLowerCase().replace(/\\s+/g, '-')}">
                    ${escapeHtml(q.quotationStatus)}
                  </span>
                </td>
                <td>
                  <span class="payment-pill payment-${q.paymentStatus.toLowerCase().replace(/\\s+/g, '-')}">
                    ${escapeHtml(q.paymentStatus)}
                  </span>
                </td>
                <td>
                  <div class="progress-cell">
                    <div class="mini-progress-bar">
                      <div class="mini-progress-fill" style="width: ${q.projectProgress}%;"></div>
                    </div>
                    <span class="mono text-xs">${q.projectProgress}%</span>
                  </div>
                </td>
                <td>
                  <a href="/admin/quotations/${q.id}" class="btn-table-action" title="Open Quotation">
                    Manage →
                  </a>
                </td>
              </tr>
            `).join('');
          }
        }

        if (!silent) {
          (window as any).showAdminToast?.('Dashboard synchronized with latest database changes', 'info');
        }
      } catch (err) {
        // silent
      } finally {
        isUpdating = false;
      }
    }

    function escapeHtml(str: string) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // 1. Cross-tab BroadcastChannel listener
    try {
      const bc = new BroadcastChannel('asc_admin_sync');
      bc.onmessage = (event) => {
        refreshOverview(false);
      };
    } catch (e) {}

    // 2. Storage event for cross-tab sync
    window.addEventListener('storage', (e) => {
      if (e.key === 'asc_admin_sync_tick') {
        refreshOverview(false);
      }
    });

    // 3. Heartbeat event dispatched by AdminLayout
    window.addEventListener('asc:db-sync', () => {
      refreshOverview(true);
    });

    // 4. Back / Forward cache navigation: instantly sync fresh data
    window.addEventListener('pageshow', (e) => {
      refreshOverview(true);
    });

    // 5. Visibility change: when admin switches back to this tab, refresh
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        refreshOverview(true);
      }
    });
  </script>
</AdminLayout>
