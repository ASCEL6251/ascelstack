<script>
  // Client-side interactions for Service Pricing Admin
  const pricingData = JSON.parse(document.getElementById('initial-pricing-data')!.textContent!);
  const servicesData = JSON.parse(document.getElementById('initial-services-data')!.textContent!);
  const servicesMap = new Map(servicesData.map((s: any) => [s.code, s]));

  // BroadcastChannel for cross-tab instant real-time synchronization
  const pricingChannel = typeof BroadcastChannel !== 'undefined' ? new BroadcastChannel('ascel_pricing') : null;

  // DOM Elements
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchCount = document.getElementById('search-count') as HTMLElement;
  const statusFilter = document.getElementById('status-filter') as HTMLElement;
  const layerFilter = document.getElementById('layer-filter') as HTMLSelectElement;
  const disciplineFilter = document.getElementById('discipline-filter') as HTMLSelectElement;
  const typeFilter = document.getElementById('type-filter') as HTMLSelectElement;
  const resetFiltersBtn = document.getElementById('reset-filters-btn') as HTMLButtonElement;
  const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
  const tableRows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.service-row'));
  const emptyState = document.getElementById('pricing-empty') as HTMLElement;

  // Stats Counters
  const liveCountEl = document.getElementById('stat-live-count');
  const soonCountEl = document.getElementById('stat-soon-count');

  // Drawer Elements
  const drawer = document.getElementById('pricing-drawer') as HTMLElement;
  const drawerBackdrop = document.getElementById('drawer-backdrop') as HTMLElement;
  const drawerCloseBtn = document.getElementById('drawer-close-btn') as HTMLButtonElement;
  const drawerCancelBtn = document.getElementById('drawer-cancel-btn') as HTMLButtonElement;
  const pricingForm = document.getElementById('pricing-form') as HTMLFormElement;
  const saveBtn = document.getElementById('save-pricing-btn') as HTMLButtonElement;
  const saveSpinner = document.getElementById('save-spinner') as HTMLElement;
  const saveBtnText = document.getElementById('save-btn-text') as HTMLElement;

  // Drawer Content Elements
  const drawerCodeEl = document.getElementById('drawer-code') as HTMLElement;
  const drawerDisciplineEl = document.getElementById('drawer-discipline') as HTMLElement;
  const drawerNameEl = document.getElementById('drawer-name') as HTMLElement;
  const drawerDescEl = document.getElementById('drawer-desc') as HTMLElement;

  // Preview Elements
  const previewCard = document.getElementById('preview-card') as HTMLElement;
  const previewId = document.getElementById('preview-id') as HTMLElement;
  const previewBadge = document.getElementById('preview-badge') as HTMLElement;
  const previewName = document.getElementById('preview-name') as HTMLElement;
  const previewDesc = document.getElementById('preview-desc') as HTMLElement;
  const previewTypeLabel = document.getElementById('preview-type-label') as HTMLElement;
  const previewPrefix = document.getElementById('preview-prefix') as HTMLElement;
  const previewAmt = document.getElementById('preview-amt') as HTMLElement;
  const previewUnit = document.getElementById('preview-unit') as HTMLElement;
  const previewMarket = document.getElementById('preview-market') as HTMLElement;
  const previewBtn = document.getElementById('preview-btn') as HTMLElement;

  // Toast
  const toast = document.getElementById('admin-toast') as HTMLElement;
  const toastMessage = document.getElementById('toast-message') as HTMLElement;
  let toastTimer = 0;

  function showToast(msg: string) {
    toastMessage.textContent = msg;
    toast.classList.add('is-show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('is-show'), 3500);
  }

  // Filter State
  let currentSearch = '';
  let currentStatus = 'all';
  let currentLayer = 'all';
  let currentDiscipline = 'all';
  let currentType = 'all';

  function applyFilters() {
    let visibleCount = 0;
    const query = currentSearch.toLowerCase().trim();

    for (const row of tableRows) {
      const code = row.dataset.code || '';
      const status = row.dataset.status || '';
      const layer = row.dataset.layer || '';
      const discipline = row.dataset.discipline || '';
      const type = row.dataset.type || '';
      const searchHaystack = row.dataset.search || '';

      const matchSearch = !query || searchHaystack.includes(query) || code.toLowerCase().includes(query);
      const matchStatus = currentStatus === 'all' || status === currentStatus;
      const matchLayer = currentLayer === 'all' || layer === currentLayer;
      const matchDiscipline = currentDiscipline === 'all' || discipline === currentDiscipline;
      const matchType = currentType === 'all' || type === currentType;

      const isMatch = matchSearch && matchStatus && matchLayer && matchDiscipline && matchType;
      row.hidden = !isMatch;
      if (isMatch) visibleCount++;
    }

    searchCount.textContent = `${visibleCount} of ${tableRows.length} services`;
    emptyState.hidden = visibleCount > 0;
  }

  // Event Listeners for Filters
  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value;
    applyFilters();
  });

  statusFilter?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.seg-btn');
    if (!btn) return;
    statusFilter.querySelectorAll('.seg-btn').forEach((b) => b.classList.remove('is-active'));
    btn.classList.add('is-active');
    currentStatus = btn.dataset.val || 'all';
    applyFilters();
  });

  layerFilter?.addEventListener('change', () => {
    currentLayer = layerFilter.value;
    applyFilters();
  });

  disciplineFilter?.addEventListener('change', () => {
    currentDiscipline = disciplineFilter.value;
    applyFilters();
  });

  typeFilter?.addEventListener('change', () => {
    currentType = typeFilter.value;
    applyFilters();
  });

  function resetAllFilters() {
    currentSearch = '';
    currentStatus = 'all';
    currentLayer = 'all';
    currentDiscipline = 'all';
    currentType = 'all';
    if (searchInput) searchInput.value = '';
    if (layerFilter) layerFilter.value = 'all';
    if (disciplineFilter) disciplineFilter.value = 'all';
    if (typeFilter) typeFilter.value = 'all';
    statusFilter?.querySelectorAll('.seg-btn').forEach((b) => {
      b.classList.toggle('is-active', (b as HTMLElement).dataset.val === 'all');
    });
    document.querySelectorAll('.stat-box').forEach((b) => b.classList.remove('is-active-stat'));
    document.querySelector('.stat-box[data-stat-filter="all"]')?.classList.add('is-active-stat');
    applyFilters();
  }

  resetFiltersBtn?.addEventListener('click', resetAllFilters);
  clearSearchBtn?.addEventListener('click', resetAllFilters);

  // Stat Boxes Quick Filter click
  document.querySelectorAll<HTMLElement>('.stat-box').forEach((box) => {
    box.addEventListener('click', () => {
      document.querySelectorAll('.stat-box').forEach((b) => b.classList.remove('is-active-stat'));
      box.classList.add('is-active-stat');
      const val = box.dataset.statFilter;
      if (val === 'open' || val === 'soon') {
        currentStatus = val;
        currentType = 'all';
        statusFilter?.querySelectorAll('.seg-btn').forEach((b) => {
          b.classList.toggle('is-active', (b as HTMLElement).dataset.val === val);
        });
      } else if (val === 'package' || val === 'fixed') {
        currentType = val;
        currentStatus = 'all';
        if (typeFilter) typeFilter.value = val;
      } else {
        resetAllFilters();
        return;
      }
      applyFilters();
    });
  });

  // Quick 1-Click Status Toggle on Table Row
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action="toggle-status"]');
    if (!btn) return;
    e.preventDefault();

    const code = btn.dataset.code;
    const targetStatus = btn.dataset.targetStatus;
    if (!code) return;

    btn.disabled = true;
    const oldText = btn.textContent;
    btn.textContent = 'Updating...';

    try {
      const res = await fetch('/api/admin/pricing/toggle-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ serviceCode: code, status: targetStatus }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to toggle status');

      // Update local cache
      if (pricingData[code]) {
        pricingData[code].status = data.status;
      }

      // Update row in table
      const row = document.querySelector<HTMLTableRowElement>(`.service-row[data-code="${code}"]`);
      if (row) {
        row.dataset.status = data.status;
        row.classList.toggle('is-soon', data.status !== 'open');
        const badge = row.querySelector('[data-status-label]');
        if (badge) {
          badge.className = `status-badge ${data.status === 'open' ? 'badge-live' : 'badge-soon'}`;
          badge.innerHTML = `<span class="status-circle"></span> ${data.status === 'open' ? 'LIVE' : 'COMING SOON'}`;
        }
        btn.dataset.targetStatus = data.status === 'open' ? 'soon' : 'open';
        btn.textContent = data.status === 'open' ? 'Set Coming Soon' : '⚡ Unplug (Go Live)';
      }

      // Re-calculate stats
      updateHeaderCounts();
      showToast(data.message || `${code} status updated!`);

      // Broadcast to other tabs & main website
      pricingChannel?.postMessage({
        type: 'pricing_updated',
        code,
        pricing: data.pricing || pricingData[code],
        timestamp: Date.now(),
      });
    } catch (err: any) {
      alert(`Error toggling status: ${err.message}`);
      btn.textContent = oldText;
    } finally {
      btn.disabled = false;
    }
  });

  function updateHeaderCounts() {
    let live = 0;
    let soon = 0;
    for (const row of tableRows) {
      if (row.dataset.status === 'open') live++;
      else soon++;
    }
    if (liveCountEl) liveCountEl.textContent = String(live);
    if (soonCountEl) soonCountEl.textContent = String(soon);
  }

  // Slide-over Drawer Open & Populate
  document.addEventListener('click', (e) => {
    const editBtn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action="edit-pricing"]');
    if (!editBtn) return;
    const code = editBtn.dataset.code;
    if (!code) return;
    openEditor(code);
  });

  function closeEditor() {
    drawer.classList.remove('is-open');
    drawerBackdrop.hidden = true;
    drawer.setAttribute('aria-hidden', 'true');
  }

  drawerCloseBtn?.addEventListener('click', closeEditor);
  drawerCancelBtn?.addEventListener('click', closeEditor);
  drawerBackdrop?.addEventListener('click', closeEditor);

  // Packages list manager
  let currentPackages: any[] = [];

  function renderPackagesList() {
    const list = document.getElementById('packages-list')!;
    if (!currentPackages.length) {
      list.innerHTML = `<p class="mono text-muted text-xs">No individual packages configured. Defaults to standard tiers.</p>`;
      return;
    }
    list.innerHTML = currentPackages
      .map((pkg, i) => `
        <div class="pkg-item-card" data-idx="${i}">
          <div class="pkg-item-header">
            <strong class="mono text-xs">Tier #${i + 1}: ${pkg.name || pkg.key}</strong>
            <button type="button" class="pkg-del-btn" data-del-pkg="${i}">Remove</button>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label>Package Name</label>
              <input type="text" class="pkg-input-name" data-idx="${i}" value="${pkg.name || ''}" placeholder="e.g. Starter" />
            </div>
            <div class="form-group">
              <label>Price (₹ INR, null = on quote)</label>
              <input type="number" class="pkg-input-price" data-idx="${i}" value="${pkg.price !== null && pkg.price !== undefined ? pkg.price : ''}" placeholder="Leave empty for quote" />
            </div>
          </div>
          <div class="form-row-2">
            <div class="form-group">
              <label>Delivery Timeline</label>
              <input type="text" class="pkg-input-delivery" data-idx="${i}" value="${pkg.delivery || ''}" placeholder="e.g. 3 days" />
            </div>
            <div class="form-group">
              <label>Unique Key</label>
              <input type="text" class="pkg-input-key" data-idx="${i}" value="${pkg.key || ''}" placeholder="e.g. starter" />
            </div>
          </div>
          <div class="form-group">
            <label>What's Included</label>
            <input type="text" class="pkg-input-includes" data-idx="${i}" value="${pkg.includes || ''}" placeholder="Features included..." />
          </div>
        </div>
      `)
      .join('');

    list.querySelectorAll<HTMLButtonElement>('[data-del-pkg]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.delPkg || '0', 10);
        currentPackages.splice(idx, 1);
        renderPackagesList();
        updatePreview();
      });
    });

    list.querySelectorAll<HTMLInputElement>('.pkg-input-name, .pkg-input-price, .pkg-input-delivery, .pkg-input-key, .pkg-input-includes').forEach((inp) => {
      inp.addEventListener('input', () => {
        const idx = parseInt(inp.dataset.idx || '0', 10);
        if (!currentPackages[idx]) return;
        if (inp.classList.contains('pkg-input-name')) currentPackages[idx].name = inp.value;
        if (inp.classList.contains('pkg-input-price')) {
          const val = inp.value.trim();
          currentPackages[idx].price = val === '' ? null : Number(val);
        }
        if (inp.classList.contains('pkg-input-delivery')) currentPackages[idx].delivery = inp.value;
        if (inp.classList.contains('pkg-input-key')) currentPackages[idx].key = inp.value;
        if (inp.classList.contains('pkg-input-includes')) currentPackages[idx].includes = inp.value;
        updatePreview();
      });
    });
  }

  document.getElementById('add-pkg-btn')?.addEventListener('click', () => {
    currentPackages.push({
      key: `tier-${currentPackages.length + 1}`,
      name: `Custom Tier ${currentPackages.length + 1}`,
      price: 9999,
      includes: 'Package scope and deliverables',
      delivery: '5 days',
      notes: '',
    });
    renderPackagesList();
    updatePreview();
  });

  function openEditor(code: string) {
    const s = servicesMap.get(code);
    const p = pricingData[code] || {
      id: code,
      status: 'open',
      type: 'starting',
      small: { price: 2999, text: '', unit: 'one-time', detail: '' },
      mid: { price: 29999, text: '', unit: 'one-time', detail: '' },
      billing: 'Project',
      market: '',
      notes: '',
      packages: [],
    };

    // Header Info
    drawerCodeEl.textContent = code;
    drawerDisciplineEl.textContent = s?.discipline || 'General';
    drawerNameEl.textContent = s?.name || code;
    drawerDescEl.textContent = s?.description || '';

    // Form fields
    (document.getElementById('form-code') as HTMLInputElement).value = code;

    // Status Radio
    const openRadio = document.getElementById('status-open-radio') as HTMLInputElement;
    const soonRadio = document.getElementById('status-soon-radio') as HTMLInputElement;
    if (p.status === 'open') openRadio.checked = true;
    else soonRadio.checked = true;

    // Type Radio
    const pkgRadio = document.getElementById('type-package') as HTMLInputElement;
    const fixedRadio = document.getElementById('type-fixed') as HTMLInputElement;
    const startRadio = document.getElementById('type-starting') as HTMLInputElement;
    if (p.type === 'package') pkgRadio.checked = true;
    else if (p.type === 'fixed') fixedRadio.checked = true;
    else startRadio.checked = true;

    // Small tier
    (document.getElementById('smallPrice') as HTMLInputElement).value = p.small?.price !== null && p.small?.price !== undefined ? String(p.small.price) : '';
    (document.getElementById('smallUnit') as HTMLInputElement).value = p.small?.unit || '';
    (document.getElementById('smallDetail') as HTMLInputElement).value = p.small?.detail || '';
    (document.getElementById('smallText') as HTMLInputElement).value = p.small?.text || '';

    // Mid tier
    (document.getElementById('midPrice') as HTMLInputElement).value = p.mid?.price !== null && p.mid?.price !== undefined ? String(p.mid.price) : '';
    (document.getElementById('midUnit') as HTMLInputElement).value = p.mid?.unit || '';
    (document.getElementById('midDetail') as HTMLInputElement).value = p.mid?.detail || '';
    (document.getElementById('midText') as HTMLInputElement).value = p.mid?.text || '';

    // Packages
    currentPackages = Array.isArray(p.packages) ? JSON.parse(JSON.stringify(p.packages)) : [];
    renderPackagesList();

    // Billing & Notes
    (document.getElementById('billing') as HTMLInputElement).value = p.billing || '';
    (document.getElementById('market') as HTMLInputElement).value = p.market || '';
    (document.getElementById('notes') as HTMLTextAreaElement).value = p.notes || '';

    updatePreview();

    drawer.classList.add('is-open');
    drawerBackdrop.hidden = false;
    drawer.setAttribute('aria-hidden', 'false');
  }

  // Real-time Preview Update inside Drawer
  function updatePreview() {
    const code = (document.getElementById('form-code') as HTMLInputElement).value;
    const s = servicesMap.get(code);
    const isOpen = (document.getElementById('status-open-radio') as HTMLInputElement).checked;
    const type = (document.querySelector('input[name="type"]:checked') as HTMLInputElement)?.value || 'starting';

    const smallPriceVal = (document.getElementById('smallPrice') as HTMLInputElement).value.trim();
    const smallUnitVal = (document.getElementById('smallUnit') as HTMLInputElement).value.trim();
    const smallTextVal = (document.getElementById('smallText') as HTMLInputElement).value.trim();
    const marketVal = (document.getElementById('market') as HTMLInputElement).value.trim();

    previewId.textContent = code;
    previewName.textContent = s?.name || code;
    previewDesc.textContent = s?.description || '';

    previewCard.classList.toggle('is-soon-preview', !isOpen);
    previewBadge.hidden = isOpen;

    previewTypeLabel.textContent = type === 'package' ? '5 packages' : type === 'fixed' ? 'Fixed price' : 'Starting price';
    previewPrefix.textContent = type === 'fixed' ? '' : 'From';

    if (type === 'package' && currentPackages.length > 0) {
      const minPkgPrice = currentPackages.find((k) => k.price !== null)?.price;
      previewAmt.textContent = minPkgPrice !== undefined ? `₹${minPkgPrice.toLocaleString('en-IN')}` : 'On quote';
      previewUnit.textContent = 'one-time';
      previewBtn.textContent = isOpen ? 'Choose package +' : 'Register interest →';
    } else if (smallPriceVal !== '') {
      previewAmt.textContent = `₹${Number(smallPriceVal).toLocaleString('en-IN')}`;
      previewUnit.textContent = smallUnitVal || 'one-time';
      previewBtn.textContent = isOpen ? 'Add to estimate +' : 'Register interest →';
    } else {
      previewAmt.textContent = smallTextVal || 'On quote';
      previewUnit.textContent = smallUnitVal || '';
      previewBtn.textContent = isOpen ? 'Add to estimate +' : 'Register interest →';
    }

    previewMarket.textContent = marketVal ? `Market: ${marketVal}` : '';
    previewMarket.hidden = !marketVal;
  }

  // Connect input listeners to live preview
  pricingForm?.querySelectorAll('input, textarea, select').forEach((el) => {
    el.addEventListener('input', updatePreview);
    el.addEventListener('change', updatePreview);
  });

  // Submit Drawer Form to Neon Database
  pricingForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('form-code') as HTMLInputElement).value;
    if (!code) return;

    saveBtn.disabled = true;
    saveSpinner.hidden = false;
    saveBtnText.textContent = 'Saving to Neon DB...';

    const status = (document.querySelector('input[name="status"]:checked') as HTMLInputElement).value;
    const type = (document.querySelector('input[name="type"]:checked') as HTMLInputElement).value;
    const smallPrice = (document.getElementById('smallPrice') as HTMLInputElement).value;
    const smallUnit = (document.getElementById('smallUnit') as HTMLInputElement).value;
    const smallDetail = (document.getElementById('smallDetail') as HTMLInputElement).value;
    const smallText = (document.getElementById('smallText') as HTMLInputElement).value;

    const midPrice = (document.getElementById('midPrice') as HTMLInputElement).value;
    const midUnit = (document.getElementById('midUnit') as HTMLInputElement).value;
    const midDetail = (document.getElementById('midDetail') as HTMLInputElement).value;
    const midText = (document.getElementById('midText') as HTMLInputElement).value;

    const billing = (document.getElementById('billing') as HTMLInputElement).value;
    const market = (document.getElementById('market') as HTMLInputElement).value;
    const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;

    const payload = {
      serviceCode: code,
      status,
      type,
      smallPrice: smallPrice === '' ? null : Number(smallPrice),
      smallUnit,
      smallDetail,
      smallText,
      midPrice: midPrice === '' ? null : Number(midPrice),
      midUnit,
      midDetail,
      midText,
      billing,
      market,
      notes,
      packages: currentPackages,
    };

    try {
      const res = await fetch('/api/admin/pricing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to update pricing');

      // Update local memory
      pricingData[code] = data.pricing;

      // Update table row
      const row = document.querySelector<HTMLTableRowElement>(`.service-row[data-code="${code}"]`);
      if (row) {
        row.dataset.status = status;
        row.dataset.type = type;
        row.classList.toggle('is-soon', status !== 'open');

        // Status badge & button
        const badge = row.querySelector('[data-status-label]');
        if (badge) {
          badge.className = `status-badge ${status === 'open' ? 'badge-live' : 'badge-soon'}`;
          badge.innerHTML = `<span class="status-circle"></span> ${status === 'open' ? 'LIVE' : 'COMING SOON'}`;
        }
        const toggleBtn = row.querySelector<HTMLButtonElement>('[data-action="toggle-status"]');
        if (toggleBtn) {
          toggleBtn.dataset.targetStatus = status === 'open' ? 'soon' : 'open';
          toggleBtn.textContent = status === 'open' ? 'Set Coming Soon' : '⚡ Unplug (Go Live)';
        }

        // Model tag
        const typePill = row.querySelector('.type-pill');
        if (typePill) {
          typePill.className = `type-pill type-${type}`;
          typePill.textContent = type === 'package' ? '5 Packages' : type === 'fixed' ? 'Fixed' : 'Starting';
        }

        // Small Price
        const smallPriceEl = row.querySelector('.col-small .price-val');
        if (smallPriceEl) {
          smallPriceEl.textContent = payload.smallPrice !== null ? `₹${payload.smallPrice.toLocaleString('en-IN')}` : (smallText || 'On quote');
        }
        const smallUnitEl = row.querySelector('.col-small .unit-val');
        if (smallUnitEl) smallUnitEl.textContent = smallUnit;

        // Mid Price
        const midPriceEl = row.querySelector('.col-mid .price-val');
        if (midPriceEl) {
          midPriceEl.textContent = payload.midPrice !== null ? `₹${payload.midPrice.toLocaleString('en-IN')}` : (midText || 'On quote');
        }
        const midUnitEl = row.querySelector('.col-mid .unit-val');
        if (midUnitEl) midUnitEl.textContent = midUnit;

        // Market
        const marketEl = row.querySelector('.market-val');
        if (marketEl) marketEl.textContent = market || '—';
      }

      updateHeaderCounts();
      closeEditor();
      showToast(`Saved ${code} pricing to Neon database! Live site updated.`);

      // Broadcast update across tabs
      pricingChannel?.postMessage({
        type: 'pricing_updated',
        code,
        pricing: data.pricing,
        timestamp: Date.now(),
      });
    } catch (err: any) {
      alert(`Error saving pricing: ${err.message}`);
    } finally {
      saveBtn.disabled = false;
      saveSpinner.hidden = true;
      saveBtnText.textContent = 'Save Changes to Neon DB';
    }
  });

  // Listen for real-time updates from other admin sessions via SSE
  try {
    const sse = new EventSource('/api/pricing/stream');
    sse.addEventListener('update', (e) => {
      try {
        const payload = JSON.parse(e.data);
        if (payload?.code && payload?.pricing) {
          pricingData[payload.code] = payload.pricing;
          // Softly reflect in table if present
          const row = document.querySelector<HTMLTableRowElement>(`.service-row[data-code="${payload.code}"]`);
          if (row && payload.pricing.status) {
            row.dataset.status = payload.pricing.status;
            row.classList.toggle('is-soon', payload.pricing.status !== 'open');
            const badge = row.querySelector('[data-status-label]');
            if (badge) {
              badge.className = `status-badge ${payload.pricing.status === 'open' ? 'badge-live' : 'badge-soon'}`;
              badge.innerHTML = `<span class="status-circle"></span> ${payload.pricing.status === 'open' ? 'LIVE' : 'COMING SOON'}`;
            }
          }
        }
      } catch {}
    });
  } catch {}
</script>
