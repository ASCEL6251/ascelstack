---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../lib/admin-auth';
import { db, services, servicePricing } from '../../db';
import { dbRowToPricing, staticPricing, type Pricing, formatINR, cardPrice } from '../../lib/pricing';
import { asc } from 'drizzle-orm';

// 1. Strict Server-Side Session Check
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}

// 2. Fetch all services and live pricing records from Neon PostgreSQL
let allServices: any[] = [];
let pricingMap: Record<string, Pricing> = { ...staticPricing };

try {
  allServices = await db
    .select({
      id: services.id,
      code: services.code,
      name: services.name,
      slug: services.slug,
      description: services.description,
      layer: services.layer,
      discipline: services.discipline,
      availabilityStatus: services.availabilityStatus,
    })
    .from(services)
    .orderBy(asc(services.code));

  const pricingRows = await db.select().from(servicePricing);
  for (const row of pricingRows) {
    if (row.serviceCode) {
      pricingMap[row.serviceCode] = dbRowToPricing(row);
    }
  }
} catch (err) {
  console.warn('Neon query in admin/pricing, using static fallback:', err);
}

// Ensure all 233 services exist in list
const serviceItems = allServices.map((svc) => {
  const code = svc.code || '';
  const p = pricingMap[code] || staticPricing[code] || {
    id: code,
    status: svc.availabilityStatus === 'live' ? 'open' : 'soon',
    type: 'starting',
    small: { price: null, text: 'On quote', unit: 'one-time', detail: '' },
    mid: { price: null, text: 'On quote', unit: 'one-time', detail: '' },
    billing: 'Project',
    market: '',
    notes: '',
  };
  return {
    ...svc,
    pricing: p,
    cardPricing: cardPrice(p),
  };
});

const totalCount = serviceItems.length;
const liveCount = serviceItems.filter((s) => s.pricing.status === 'open').length;
const soonCount = serviceItems.filter((s) => s.pricing.status === 'soon').length;
const packageCount = serviceItems.filter((s) => s.pricing.type === 'package').length;
const fixedCount = serviceItems.filter((s) => s.pricing.type === 'fixed').length;
const startingCount = serviceItems.filter((s) => s.pricing.type === 'starting').length;

// Collect unique disciplines for filtering
const disciplines = Array.from(new Set(serviceItems.map((s) => s.discipline))).sort();
---

<AdminLayout
  title="Service Pricing & Coming Soon Controls"
  activeNav="pricing"
  breadcrumbs={[{ label: 'Service Pricing' }]}
  session={session}
>
  <!-- Page Header -->
  <div class="pricing-admin-header">
    <div>
      <div class="header-tags">
        <span class="eyebrow">Database Catalog Controls</span>
        <span class="live-sync-pill">
          <span class="live-dot"></span> Neon Real-Time Sync
        </span>
      </div>
      <h1 class="display h2">Service Pricing & Availability</h1>
      <p class="header-subtitle">
        Directly modify pricing, tiers, and unplug "Coming Soon" across all {totalCount} catalogue services with instant real-time synchronization to the main website.
      </p>
    </div>

    <div class="header-actions">
      <a href="/services" target="_blank" rel="noopener noreferrer" class="btn btn-outline" title="Open Main Website Service Catalogue in new tab">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        <span>View Live Site</span>
      </a>
    </div>
  </div>

  <!-- Metric Statistics Ribbon -->
  <div class="pricing-stats-grid">
    <div class="stat-box is-active-stat" data-stat-filter="all">
      <span class="mono stat-label">Total Services</span>
      <strong class="stat-number">{totalCount}</strong>
      <span class="stat-desc">Complete catalog</span>
    </div>

    <div class="stat-box stat-live" data-stat-filter="open">
      <span class="mono stat-label">Live / Open</span>
      <strong class="stat-number text-success" id="stat-live-count">{liveCount}</strong>
      <span class="stat-desc">Live on main site</span>
    </div>

    <div class="stat-box stat-soon" data-stat-filter="soon">
      <span class="mono stat-label">Coming Soon</span>
      <strong class="stat-number text-amber" id="stat-soon-count">{soonCount}</strong>
      <span class="stat-desc">Click to unplug status</span>
    </div>

    <div class="stat-box" data-stat-filter="package">
      <span class="mono stat-label">Package Services</span>
      <strong class="stat-number text-accent">{packageCount}</strong>
      <span class="stat-desc">Multi-tier (5 packages)</span>
    </div>

    <div class="stat-box" data-stat-filter="fixed">
      <span class="mono stat-label">Fixed & Starting</span>
      <strong class="stat-number">{fixedCount + startingCount}</strong>
      <span class="stat-desc">{fixedCount} fixed · {startingCount} starting</span>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="pricing-toolbar card-panel">
    <div class="toolbar-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon">
        <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search 233 services by code (ASC-0001), name, or keyword..."
        autocomplete="off"
      />
      <span class="mono search-count" id="search-count">{totalCount} services</span>
    </div>

    <div class="toolbar-filters">
      <!-- Status Filter Tabs -->
      <div class="filter-group">
        <span class="filter-label mono">Status:</span>
        <div class="segmented-control" id="status-filter">
          <button type="button" class="seg-btn is-active" data-val="all">All</button>
          <button type="button" class="seg-btn" data-val="open">Live Only</button>
          <button type="button" class="seg-btn" data-val="soon">Coming Soon</button>
        </div>
      </div>

      <!-- Layer Filter -->
      <div class="filter-group">
        <span class="filter-label mono">Layer:</span>
        <select id="layer-filter" class="filter-select">
          <option value="all">All Layers</option>
          <option value="build">Build</option>
          <option value="grow">Grow</option>
          <option value="run">Run</option>
        </select>
      </div>

      <!-- Discipline Filter -->
      <div class="filter-group">
        <span class="filter-label mono">Discipline:</span>
        <select id="discipline-filter" class="filter-select">
          <option value="all">All Disciplines ({disciplines.length})</option>
          {disciplines.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>

      <!-- Type Filter -->
      <div class="filter-group">
        <span class="filter-label mono">Type:</span>
        <select id="type-filter" class="filter-select">
          <option value="all">All Types</option>
          <option value="package">Package (5 options)</option>
          <option value="fixed">Fixed Price</option>
          <option value="starting">Starting Price</option>
        </select>
      </div>

      <button type="button" id="reset-filters-btn" class="btn btn-ghost btn-sm" title="Reset all filters">
        Reset
      </button>
    </div>
  </div>

  <!-- Services Table Container -->
  <div class="card-panel table-panel">
    <div class="table-wrapper">
      <table class="pricing-table" id="pricing-table">
        <thead>
          <tr>
            <th class="col-code mono">Code</th>
            <th class="col-name">Service & Discipline</th>
            <th class="col-status">Status / Unplug</th>
            <th class="col-type mono">Model</th>
            <th class="col-small">Small Business Price</th>
            <th class="col-mid">Mid-Size Price</th>
            <th class="col-market">Market Benchmark</th>
            <th class="col-actions text-right">Action</th>
          </tr>
        </thead>
        <tbody id="pricing-tbody">
          {serviceItems.map((s) => {
            const isOpen = s.pricing.status === 'open';
            const price = s.cardPricing;
            const searchHaystack = `${s.code} ${s.name} ${s.discipline} ${s.description} ${s.pricing.type} ${s.pricing.billing || ''}`.toLowerCase();
            return (
              <tr
                class:list={['service-row', { 'is-soon': !isOpen }]}
                data-code={s.code}
                data-status={s.pricing.status}
                data-layer={s.layer}
                data-discipline={s.discipline}
                data-type={s.pricing.type}
                data-search={searchHaystack}
              >
                <!-- Code -->
                <td class="col-code">
                  <div class="code-wrapper">
                    <span class="mono code-tag">{s.code}</span>
                    <span class:list={['layer-tag-sm', `layer-${s.layer}`]}>{s.layer}</span>
                  </div>
                </td>

                <!-- Name & Description -->
                <td class="col-name">
                  <div class="service-meta-box">
                    <strong class="service-name">{s.name}</strong>
                    <span class="service-desc">{s.description}</span>
                    <span class="mono discipline-badge">{s.discipline}</span>
                  </div>
                </td>

                <!-- Status & 1-Click Unplug Toggle -->
                <td class="col-status">
                  <div class="status-action-cell">
                    <span class:list={['status-badge', isOpen ? 'badge-live' : 'badge-soon']} data-status-label>
                      <span class="status-circle"></span>
                      {isOpen ? 'LIVE' : 'COMING SOON'}
                    </span>
                    <button
                      type="button"
                      class="btn-toggle-status"
                      data-action="toggle-status"
                      data-code={s.code}
                      data-target-status={isOpen ? 'soon' : 'open'}
                      title={isOpen ? 'Change to Coming Soon' : 'Unplug Coming Soon and publish live pricing'}
                    >
                      {isOpen ? 'Set Coming Soon' : '⚡ Unplug (Go Live)'}
                    </button>
                  </div>
                </td>

                <!-- Pricing Model -->
                <td class="col-type mono">
                  <span class:list={['type-pill', `type-${s.pricing.type}`]}>
                    {s.pricing.type === 'package' ? '5 Packages' : s.pricing.type === 'fixed' ? 'Fixed' : 'Starting'}
                  </span>
                  {s.pricing.billing && <span class="billing-hint">{s.pricing.billing}</span>}
                </td>

                <!-- Small Biz Price -->
                <td class="col-small">
                  <div class="price-val-box">
                    <strong class="price-val">
                      {s.pricing.small.price !== null ? formatINR(s.pricing.small.price) : (s.pricing.small.text || 'On quote')}
                    </strong>
                    {s.pricing.small.unit && <span class="unit-val mono">{s.pricing.small.unit}</span>}
                  </div>
                </td>

                <!-- Mid-Size Price -->
                <td class="col-mid">
                  <div class="price-val-box">
                    <strong class="price-val">
                      {s.pricing.mid.price !== null ? formatINR(s.pricing.mid.price) : (s.pricing.mid.text || 'On quote')}
                    </strong>
                    {s.pricing.mid.unit && <span class="unit-val mono">{s.pricing.mid.unit}</span>}
                  </div>
                </td>

                <!-- Market Benchmark -->
                <td class="col-market">
                  <span class="market-val" title={s.pricing.market || 'No market rate noted'}>
                    {s.pricing.market || '—'}
                  </span>
                </td>

                <!-- Actions -->
                <td class="col-actions text-right">
                  <div class="actions-group">
                    <button
                      type="button"
                      class="btn btn-sm btn-outline btn-edit"
                      data-action="edit-pricing"
                      data-code={s.code}
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                      </svg>
                      <span>Edit</span>
                    </button>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>

      <!-- Empty State -->
      <div class="pricing-empty" id="pricing-empty" hidden>
        <p class="mono text-muted">No services match the current search or filters.</p>
        <button type="button" class="btn btn-sm btn-outline" id="clear-search-btn">Clear Search & Filters</button>
      </div>
    </div>
  </div>

  <!-- Slide-Over Full Pricing Editor Drawer -->
  <div class="pricing-drawer-backdrop" id="drawer-backdrop" hidden></div>
  <aside class="pricing-drawer" id="pricing-drawer" aria-hidden="true">
    <div class="drawer-header">
      <div>
        <div class="header-tags">
          <span class="mono code-pill" id="drawer-code">ASC-0001</span>
          <span class="mono discipline-badge" id="drawer-discipline">Discipline</span>
        </div>
        <h2 class="display h3" id="drawer-name">Service Name</h2>
        <p class="drawer-desc" id="drawer-desc">Service description</p>
      </div>
      <button type="button" class="drawer-close" id="drawer-close-btn" aria-label="Close drawer">×</button>
    </div>

    <!-- Live Card Preview Card -->
    <div class="drawer-preview-section">
      <span class="mono preview-label">Live Site Preview</span>
      <div class="preview-card" id="preview-card">
        <div class="preview-top">
          <span class="mono preview-id" id="preview-id">ASC-0001</span>
          <span class="preview-badge" id="preview-badge" hidden>Coming soon</span>
        </div>
        <h3 class="preview-name" id="preview-name">Service Name</h3>
        <p class="preview-desc" id="preview-desc">Service description</p>
        <div class="preview-price-box" id="preview-price-box">
          <span class="mono preview-type-label" id="preview-type-label">5 packages</span>
          <div class="preview-price-row">
            <span class="preview-prefix" id="preview-prefix">From</span>
            <strong class="preview-amt" id="preview-amt">₹2,999</strong>
            <span class="preview-unit" id="preview-unit">one-time</span>
          </div>
          <span class="preview-market" id="preview-market">Market: ₹10,000–₹80,000</span>
        </div>
        <div class="preview-cta-row">
          <span class="preview-btn" id="preview-btn">Choose package +</span>
        </div>
      </div>
    </div>

    <!-- Drawer Form -->
    <form class="drawer-form" id="pricing-form">
      <input type="hidden" id="form-code" name="serviceCode" />

      <!-- Section 1: Availability Status & Unplug Coming Soon -->
      <div class="form-section">
        <h3 class="form-section-title">Availability & "Coming Soon" Setting</h3>
        <p class="form-section-desc">
          Toggle between Live (prices active on website) and Coming Soon.
        </p>
        <div class="status-radio-grid">
          <label class="status-radio-card" id="status-card-open">
            <input type="radio" name="status" value="open" id="status-open-radio" />
            <div class="radio-card-content">
              <div class="radio-title-row">
                <span class="status-circle-green"></span>
                <strong>Live & Active (Unplugged)</strong>
              </div>
              <p>Prices displayed on main site. Users can choose packages or add to estimate immediately.</p>
            </div>
          </label>

          <label class="status-radio-card" id="status-card-soon">
            <input type="radio" name="status" value="soon" id="status-soon-radio" />
            <div class="radio-card-content">
              <div class="radio-title-row">
                <span class="status-circle-amber"></span>
                <strong>Coming Soon</strong>
              </div>
              <p>Displays "Coming soon" dashed card. Users register interest instead of adding to cart.</p>
            </div>
          </label>
        </div>
      </div>

      <!-- Section 2: Pricing Type Model -->
      <div class="form-section">
        <h3 class="form-section-title">Pricing Model</h3>
        <div class="form-grid-3">
          <label class="model-radio-card">
            <input type="radio" name="type" value="package" id="type-package" />
            <span><strong>Package</strong><small>5 defined tiers (Starter, Basic, etc.)</small></span>
          </label>
          <label class="model-radio-card">
            <input type="radio" name="type" value="fixed" id="type-fixed" />
            <span><strong>Fixed Price</strong><small>Flat project or item rate</small></span>
          </label>
          <label class="model-radio-card">
            <input type="radio" name="type" value="starting" id="type-starting" />
            <span><strong>Starting Price</strong><small>"From ₹..." scope-based rate</small></span>
          </label>
        </div>
      </div>

      <!-- Section 3: Small Business Tier -->
      <div class="form-section">
        <h3 class="form-section-title">Small Business Pricing Tier</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label for="smallPrice">Price (₹ INR, excl. GST)</label>
            <div class="input-currency">
              <span class="currency-prefix">₹</span>
              <input type="number" id="smallPrice" name="smallPrice" min="0" step="1" placeholder="e.g. 2999" />
            </div>
            <span class="field-hint">Leave blank if custom/on-quote.</span>
          </div>

          <div class="form-group">
            <label for="smallUnit">Billing Unit / Frequency</label>
            <input type="text" id="smallUnit" name="smallUnit" placeholder="e.g. one-time, per month, per SKU" />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="smallDetail">Price Details / Tier Summary</label>
            <input type="text" id="smallDetail" name="smallDetail" placeholder="e.g. 5 packages from ₹2,999" />
          </div>

          <div class="form-group">
            <label for="smallText">Non-numeric Text (when price is on quote / %)</label>
            <input type="text" id="smallText" name="smallText" placeholder="e.g. 15% of campaign budget, On quote" />
          </div>
        </div>
      </div>

      <!-- Section 4: Mid-Size Business Tier -->
      <div class="form-section">
        <h3 class="form-section-title">Mid-Size Business Pricing Tier</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label for="midPrice">Price (₹ INR, excl. GST)</label>
            <div class="input-currency">
              <span class="currency-prefix">₹</span>
              <input type="number" id="midPrice" name="midPrice" min="0" step="1" placeholder="e.g. 29999" />
            </div>
            <span class="field-hint">Leave blank if custom/on-quote.</span>
          </div>

          <div class="form-group">
            <label for="midUnit">Billing Unit / Frequency</label>
            <input type="text" id="midUnit" name="midUnit" placeholder="e.g. one-time, per month, per SKU" />
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="midDetail">Price Details / Tier Summary</label>
            <input type="text" id="midDetail" name="midDetail" placeholder="e.g. Premium package ₹29,999" />
          </div>

          <div class="form-group">
            <label for="midText">Non-numeric Text</label>
            <input type="text" id="midText" name="midText" placeholder="e.g. Custom quote" />
          </div>
        </div>
      </div>

      <!-- Section 5: Package Tiers Manager -->
      <div class="form-section" id="packages-section">
        <div class="section-head-with-action">
          <div>
            <h3 class="form-section-title">Package Tiers (Cart Picker)</h3>
            <p class="form-section-desc">Manage specific options shown in the package selection popup.</p>
          </div>
          <button type="button" class="btn btn-sm btn-outline" id="add-pkg-btn">+ Add Package</button>
        </div>

        <div class="packages-list" id="packages-list">
          <!-- Dynamically populated package items -->
        </div>
      </div>

      <!-- Section 6: Market Benchmark & Billing Notes -->
      <div class="form-section">
        <h3 class="form-section-title">Market Benchmark & Fine Print</h3>
        <div class="form-row-2">
          <div class="form-group">
            <label for="billing">Billing Model</label>
            <input type="text" id="billing" name="billing" placeholder="e.g. One-time project, Monthly retainer" />
          </div>

          <div class="form-group">
            <label for="market">India Market Rate Benchmark (2026)</label>
            <input type="text" id="market" name="market" placeholder="e.g. ₹10,000–₹80,000 (freelancer)" />
          </div>
        </div>

        <div class="form-group">
          <label for="notes">Customer-Facing Notes & Extra Costs</label>
          <textarea id="notes" name="notes" rows="2" placeholder="e.g. Domain + hosting ₹3,000–₹8,000/yr extra. All prices excl. 18% GST."></textarea>
        </div>
      </div>

      <!-- Drawer Footer Actions -->
      <div class="drawer-footer">
        <button type="button" class="btn btn-ghost" id="drawer-cancel-btn">Cancel</button>
        <button type="submit" class="btn btn-primary" id="save-pricing-btn">
          <span class="btn-spinner" id="save-spinner" hidden></span>
          <span id="save-btn-text">Save Changes to Neon DB</span>
        </button>
      </div>
    </form>
  </aside>

  <!-- Toast Notification Container -->
  <div class="admin-toast" id="admin-toast" role="status" aria-live="polite">
    <span class="toast-dot"></span>
    <span class="toast-message" id="toast-message">Pricing updated successfully!</span>
  </div>

  <!-- Store client-side initial services pricing cache for instant editor interactions -->
  <script id="initial-pricing-data" type="application/json" set:html={JSON.stringify(pricingMap)}></script>
  <script id="initial-services-data" type="application/json" set:html={JSON.stringify(serviceItems.map((s) => ({
    code: s.code,
    name: s.name,
    discipline: s.discipline,
    description: s.description,
    layer: s.layer,
  })))}></script>
</AdminLayout>

<style>
  .pricing-admin-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .header-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .live-sync-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.25);
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }
  .header-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 720px;
    line-height: 1.5;
    margin-top: 0.35rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Metric Statistics Ribbon */
  .pricing-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .stat-box {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .stat-box:hover {
    border-color: rgba(148, 188, 227, 0.4);
