---
import GoogleTag from '../../components/GoogleTag.astro';
export const prerender = false;

import { SignIn, SignOutButton } from '@clerk/astro/components';
import Logo from '../../components/Logo.astro';
import { getAdminSession, isAuthorizedAdminEmail, getClerkAdminUser } from '../../lib/admin-auth';
import '../../styles/global.css';

// 1. If already authenticated as an authorized administrator, redirect directly to /admin
const session = await getAdminSession(Astro);
if (session) {
  return Astro.redirect('/admin');
}

// 2. Check if user is signed in to Clerk with an UNauthorized email
const clerkUser = await getClerkAdminUser(Astro);
let unauthorizedEmail: string | null = null;
if (clerkUser) {
  const isAllowed = isAuthorizedAdminEmail(clerkUser.email, Astro);
  if (isAllowed) {
    return Astro.redirect('/admin');
  } else {
    unauthorizedEmail = clerkUser.email;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <GoogleTag />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administrator Sign In · Ascelstack</title>
    <meta name="description" content="Secure administrative access for Ascelstack management." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bacasime+Antique&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-login-body">
    <div class="admin-login-layout">
      <!-- Left Brand Panel -->
      <aside class="admin-login-brand on-ink">
        <div class="brand-inner">
          <a href="/" class="brand-logo" aria-label="Ascelstack Home">
            <Logo tone="light" size={32} />
          </a>

          <div class="brand-hero">
            <span class="eyebrow">Enterprise Control</span>
            <h1 class="display brand-title">Administration<br /><em>Console</em></h1>
            <p class="brand-desc">
              Manage client relationships, review project quotation requests, configure detailed scopes, verify payments, and monitor execution milestones in real time.
            </p>

            <div class="admin-features-list">
              <div class="feat-item">
                <span class="feat-dot"></span>
                <span><strong>Quotation & Estimation Engine</strong> · Pricing & SOW control</span>
              </div>
              <div class="feat-item">
                <span class="feat-dot"></span>
                <span><strong>Independent Status Tracking</strong> · Quotes, Payments & Progress</span>
              </div>
              <div class="feat-item">
                <span class="feat-dot"></span>
                <span><strong>Cloudflare Access Control</strong> · Allowlist via <code>ADMIN_EMAILS</code></span>
              </div>
            </div>
          </div>

          <footer class="brand-footer mono">
            <span>© 2026 Ascelstack</span>
            <a href="/" target="_blank">ascelstack.com</a>
          </footer>
        </div>
      </aside>

      <!-- Right Sign In Panel -->
      <main class="admin-login-main">
        <div class="login-card-wrap">
          <div class="login-card-header">
            <span class="mono admin-badge-pill">RESTRICTED ACCESS</span>
            <h2 class="display login-title">Administrator Login</h2>
            <p class="login-subtitle">
              Sign in with your authorized credentials. Access is restricted to accounts registered in the Cloudflare <code>ADMIN_EMAILS</code> allowlist.
            </p>
          </div>

          <!-- IF user is signed in to Clerk with an unauthorized account, ONLY show the Access Restricted card and Sign Out button (prevents client redirect loop) -->
          {unauthorizedEmail && (
            <div class="alert-box alert-error" id="unauthorized-alert">
              <div class="alert-icon">✕</div>
              <div class="alert-body">
                <strong id="alert-error-title">Access Restricted</strong>
                <p id="alert-error-desc">
                  The signed-in account <code>{unauthorizedEmail}</code> is not on the administrator allowlist.
                  Please sign in with an email configured in the Cloudflare <code>ADMIN_EMAILS</code> environment variable.
                </p>
                <div class="alert-switch-wrap">
                  <SignOutButton redirectUrl="/admin/login">
                    <button type="button" class="btn-switch-account mono">
                      Sign Out &amp; Switch Account &rarr;
                    </button>
                  </SignOutButton>
                </div>
              </div>
            </div>
          )}

          <!-- Primary Clerk Sign-In Widget (rendered ONLY when not signed in) -->
          {!unauthorizedEmail && (
            <div class="clerk-admin-container">
              <SignIn
                routing="hash"
                forceRedirectUrl="/admin"
                signUpUrl=""
                appearance={{
                  variables: {
                    colorPrimary: '#1D2D3D',
                    colorBackground: '#fafafb',
                    colorText: '#1D1F20',
                    colorInputBackground: '#F2F2F3',
                    colorInputText: '#1D1F20',
                    fontFamily: "'Inter Tight', system-ui, sans-serif",
                    borderRadius: '10px',
                  },
                  elements: {
                    rootBox: {
                      width: '100%',
                    },
                    card: {
                      border: '1px solid rgba(29, 45, 61, 0.12)',
                      boxShadow: '0 16px 36px -18px rgba(29, 45, 61, 0.25)',
                      backgroundColor: '#fafafb',
                      padding: '2rem 1.75rem',
                    },
                    headerTitle: {
                      fontFamily: "'Bacasime Antique', Georgia, serif",
                      fontSize: '1.6rem',
                      fontWeight: '400',
                      color: '#1D2D3D',
                    },
                    headerSubtitle: {
                      color: '#5D5D60',
                      fontSize: '0.9rem',
                    },
                    formButtonPrimary: {
                      backgroundColor: '#1D2D3D',
                      color: '#F2F2F3',
                      borderRadius: '999px',
                      fontWeight: '600',
                      fontSize: '0.95rem',
                      padding: '0.75rem 1.5rem',
                      transition: 'all 0.25s ease',
                      '&:hover': {
                        backgroundColor: '#5980A6',
                      },
                    },
                    footerAction: {
                      display: 'none',
                    },
                  },
                }}
              />
            </div>
          )}

          <div class="login-footer-info">
            <p class="mono text-muted">
              Looking for client services? <a href="/login">Go to Client Portal →</a>
            </p>
          </div>
        </div>
      </main>
    </div>

    <style>
      .admin-login-body {
        margin: 0;
        min-height: 100vh;
        background: var(--paper);
        color: var(--text);
        font-family: var(--font-body);
      }
      .admin-login-layout {
        display: grid;
        grid-template-columns: 1.1fr 1.3fr;
        min-height: 100vh;
      }
      .admin-login-brand {
        background: var(--ink-deep);
        padding: clamp(2.5rem, 5vw, 4rem);
        position: relative;
        overflow: hidden;
      }
      .brand-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        justify-content: space-between;
        gap: 3rem;
      }
      .brand-logo {
        display: inline-flex;
        width: fit-content;
      }
      .brand-hero {
        display: grid;
        gap: 1.5rem;
        max-width: 480px;
      }
      .brand-title {
        font-size: clamp(2.2rem, 2rem + 2vw, 3.8rem);
        line-height: 1.05;
        color: var(--paper);
      }
      .brand-desc {
        color: rgba(242, 242, 243, 0.75);
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
      }
      .admin-features-list {
        display: grid;
        gap: 0.85rem;
        margin-top: 1rem;
      }
      .feat-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.65rem 1rem;
        border-radius: var(--radius-s);
        font-size: 0.88rem;
        color: rgba(242, 242, 243, 0.85);
      }
      .feat-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        flex-shrink: 0;
      }
      .brand-footer {
        display: flex;
        justify-content: space-between;
        color: rgba(242, 242, 243, 0.4);
        font-size: 0.75rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding-top: 1.5rem;
      }
      .brand-footer a {
        color: var(--tint);
      }

      .admin-login-main {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(2rem, 4vw, 4rem);
        background: var(--paper);
      }
      .login-card-wrap {
        width: 100%;
        max-width: 440px;
        display: grid;
        gap: 1.5rem;
      }
      .login-card-header {
        display: grid;
        gap: 0.5rem;
      }
      .admin-badge-pill {
        display: inline-flex;
        align-items: center;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        background: rgba(29, 45, 61, 0.08);
        color: var(--ink);
        width: fit-content;
      }
      .login-title {
        font-size: 2.2rem;
        margin: 0;
        color: var(--ink);
      }
      .login-subtitle {
        color: var(--text-muted);
        font-size: 0.92rem;
        line-height: 1.5;
        margin: 0;
      }
      .login-subtitle code {
        font-family: var(--font-mono);
        background: var(--paper-raised);
        padding: 0.15rem 0.35rem;
        border-radius: 3px;
        color: var(--ink);
        border: 1px solid var(--line);
      }

      .alert-box {
        display: flex;
        gap: 0.75rem;
        padding: 1rem 1.15rem;
        border-radius: var(--radius-s);
        font-size: 0.88rem;
        line-height: 1.5;
      }
      .alert-error {
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #991b1b;
      }
      .alert-icon {
        font-weight: bold;
        color: #ef4444;
      }
      .alert-body p {
        margin: 0.25rem 0 0 0;
        font-size: 0.85rem;
      }
      .alert-body code {
        font-family: var(--font-mono);
        background: rgba(239, 68, 68, 0.12);
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
      }
      .alert-switch-wrap {
        margin-top: 0.75rem;
      }
      .btn-switch-account {
        background: #991b1b;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        font-size: 0.78rem;
        cursor: pointer;
        transition: opacity 0.2s ease;
      }
      .btn-switch-account:hover {
        opacity: 0.9;
      }

      .clerk-admin-container {
        width: 100%;
      }

      .login-footer-info {
        text-align: center;
        font-size: 0.82rem;
        padding-top: 0.5rem;
      }
      .login-footer-info a {
        color: var(--accent);
        font-weight: 600;
      }

      @media (max-width: 960px) {
        .admin-login-layout { grid-template-columns: 1fr; }
        .admin-login-brand { display: none; }
      }
    </style>
  </body>
</html>
