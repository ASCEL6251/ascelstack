---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../../lib/admin-auth';
import { db, quotations, users, businesses, quotationHistory, serviceRequests, services } from '../../../db';
import { eq, desc, sql } from 'drizzle-orm';

// Strict Server-Side Session Check
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}

const quoteId = Astro.params.id;
if (!quoteId) {
  return Astro.redirect('/admin/quotations');
}

// 1. Fetch quotation
const [quotation] = await db
  .select()
  .from(quotations)
  .where(sql`${quotations.id}::text = ${quoteId} OR ${quotations.quotationNumber} = ${quoteId}`)
  .limit(1);

if (!quotation) {
  return Astro.redirect('/admin/quotations');
}

// 2. Fetch associated customer
const [customer] = await db
  .select()
  .from(users)
  .where(eq(users.id, quotation.userId))
  .limit(1);

// 3. Fetch associated business
let business = null;
if (quotation.businessId) {
  [business] = await db
    .select()
    .from(businesses)
    .where(eq(businesses.id, quotation.businessId))
    .limit(1);
}

// 4. Fetch quotation history
const history = await db
  .select()
  .from(quotationHistory)
  .where(eq(quotationHistory.quotationId, quotation.id))
  .orderBy(desc(quotationHistory.createdAt));

// 5. Fetch linked services
const linkedRequests = await db
  .select({
    id: serviceRequests.id,
    serviceId: serviceRequests.serviceId,
    requirements: serviceRequests.requirements,
    status: serviceRequests.status,
    requestedAt: serviceRequests.requestedAt,
    service: {
      id: services.id,
      code: services.code,
      name: services.name,
      slug: services.slug,
      description: services.description,
      layer: services.layer,
      discipline: services.discipline,
    },
  })
  .from(serviceRequests)
  .innerJoin(services, eq(serviceRequests.serviceId, services.id))
  .where(eq(serviceRequests.quotationId, quotation.id));

const QUOTATION_STATUS_OPTIONS = [
  'New Inquiry',
  'Under Review',
  'Processing',
  'Estimation in Progress',
  'Quotation Prepared',
  'Quotation Sent',
  'Awaiting Customer Approval',
  'Approved',
  'Rejected',
  'On Hold',
  'Completed',
  'Cancelled',
];

const PAYMENT_STATUS_OPTIONS = [
  'Not Required',
  'Payment Pending',
  'Payment Processing',
  'Partially Paid',
  'Payment Completed',
  'Payment Failed',
  'Payment Refunded',
];
---

<AdminLayout
  title={`${quotation.quotationNumber} · ${quotation.projectTitle}`}
  activeNav="quotations"
  breadcrumbs={[
    { label: 'Quotations', href: '/admin/quotations' },
    { label: quotation.quotationNumber },
  ]}
  session={session}
>
  <div class="quotation-detail-view">
    <!-- Header Back Navigation & Actions -->
    <div class="detail-header-bar">
      <a href="/admin/quotations" class="back-link">
        <span aria-hidden="true">←</span> Back to Quotations
      </a>

      <div class="header-badges">
        <span class={`status-tag status-${quotation.quotationStatus.toLowerCase().replace(/\s+/g, '-')}`} id="badge-quote-status">
          {quotation.quotationStatus}
        </span>
        <span class={`payment-pill payment-${quotation.paymentStatus.toLowerCase().replace(/\s+/g, '-')}`} id="badge-payment-status">
          {quotation.paymentStatus}
        </span>
        <span class="mono text-xs badge-pill" id="badge-progress">
          {quotation.projectProgress}% Complete
        </span>
      </div>
    </div>

    <!-- Main Overview Card -->
    <div class="quote-header-card">
      <div class="quote-meta-row">
        <div>
          <span class="mono eyebrow">QUOTATION REFERENCE</span>
          <h1 class="display h2 quote-title" id="display-project-title">{quotation.projectTitle}</h1>
          <div class="quote-refs-line">
            <span class="mono quote-ref-badge">{quotation.quotationNumber}</span>
            <span class="mono text-muted text-xs">
              Submitted: {new Date(quotation.createdAt).toLocaleDateString('en-IN', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
              })}
            </span>
            <span class="mono text-muted text-xs">·</span>
            <span class="mono text-muted text-xs" id="display-updated-at">
              Last Updated: {new Date(quotation.updatedAt).toLocaleDateString('en-IN', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
              })}
            </span>
          </div>
        </div>

        <div class="quote-price-header-block">
          <span class="mono quote-amount-label">FINAL QUOTATION AMOUNT</span>
          <div class="display quote-amount-display" id="display-final-amount">
            {quotation.currency} {parseFloat(String(quotation.finalQuotationAmount || quotation.initialEstimatedCost)).toLocaleString()}
          </div>
          <span class="mono text-muted text-xs" id="display-initial-amount">
            Initial Estimate: {quotation.currency} {parseFloat(String(quotation.initialEstimatedCost)).toLocaleString()}
          </span>
        </div>
      </div>

      <!-- Live Project Progress Bar -->
      <div class="quote-progress-section">
        <div class="progress-info-row">
          <span class="mono progress-label">PROJECT PROGRESS</span>
          <span class="mono progress-val" id="display-progress-pct">{quotation.projectProgress}%</span>
        </div>
        <div class="live-progress-bar">
          <div class="live-progress-fill" id="live-progress-fill" style={`width: ${quotation.projectProgress}%;`}></div>
        </div>
      </div>
    </div>

    <!-- Workspace Grid: Left Column (Status & Pricing Editor) & Right Column (Customer & Audit) -->
    <div class="quote-workspace-grid">
      <!-- LEFT COLUMN: STATUS & ESTIMATION EDITORS -->
      <div class="quote-left-pane">
        <!-- 1. EDITABLE STATUSES CARD -->
        <div class="card-panel">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Status Control</span>
              <h3 class="display h3">Lifecycle & Progress Status</h3>
              <p class="panel-subtitle">Independent fields for quotation stage, payment verification, and delivery completion</p>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="btn-save-statuses">
              <span>Save Statuses</span>
              <span class="arrow">→</span>
            </button>
          </div>

          <div class="status-fields-grid">
            <!-- A. Quotation Status -->
            <label class="field">
              <span class="mono field-label">Quotation Status (12 Stages)</span>
              <select class="admin-select" id="input-quotation-status">
                {QUOTATION_STATUS_OPTIONS.map((status) => (
                  <option value={status} selected={quotation.quotationStatus === status}>
                    {status}
                  </option>
                ))}
              </select>
              <span class="field-hint">Changes customer view lifecycle state.</span>
            </label>

            <!-- B. Payment Status -->
            <label class="field">
              <span class="mono field-label">Payment Status (Verified Flow)</span>
              <select class="admin-select" id="input-payment-status">
                {PAYMENT_STATUS_OPTIONS.map((pay) => (
                  <option value={pay} selected={quotation.paymentStatus === pay}>
                    {pay}
                  </option>
                ))}
              </select>
              <span class="field-hint">Verified through transaction confirmation.</span>
            </label>

            <!-- Payment Reference Input -->
            <label class="field">
              <span class="mono field-label">Payment Reference / Txn ID</span>
              <input
                type="text"
                class="admin-input"
                id="input-payment-ref"
                value={quotation.paymentReference || ''}
                placeholder="e.g. TXN_RAZOR_84920491 or UTR-9348102"
              />
              <span class="field-hint">Optional payment reference or receipt code.</span>
            </label>

            <!-- C. Project Progress (0% - 100%) -->
            <div class="field">
              <div class="progress-input-header">
                <span class="mono field-label">Project Progress (0% to 100%)</span>
                <span class="mono text-xs font-semibold" id="slider-val-display">{quotation.projectProgress}%</span>
              </div>
              <div class="progress-slider-wrap">
                <input
                  type="range"
                  min="0"
                  max="100"
                  value={quotation.projectProgress}
                  class="admin-slider"
                  id="input-progress-slider"
                />
                <input
                  type="number"
                  min="0"
                  max="100"
                  value={quotation.projectProgress}
                  class="admin-number-input mono"
                  id="input-progress-number"
                />
              </div>
              <span class="field-hint">Visible to customer on their dashboard.</span>
            </div>
          </div>
        </div>

        <!-- 2. PROJECT ESTIMATION & PRICING MANAGEMENT -->
        <div class="card-panel">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Financial Engine</span>
              <h3 class="display h3">Project Estimation & Pricing</h3>
              <p class="panel-subtitle">Configure base estimate, final agreed quote, additional services, discounts, and breakdowns</p>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="btn-save-pricing">
              <span>Save Pricing</span>
              <span class="arrow">→</span>
            </button>
          </div>

          <div class="pricing-fields-grid">
            <div class="form-row">
              <label class="field">
                <span class="mono field-label">Currency</span>
                <select class="admin-select" id="input-currency">
                  <option value="INR" selected={quotation.currency === 'INR'}>₹ INR (Indian Rupee)</option>
                  <option value="USD" selected={quotation.currency === 'USD'}>$ USD (US Dollar)</option>
                </select>
              </label>

              <label class="field">
                <span class="mono field-label">Initial Estimated Cost</span>
                <input
                  type="number"
                  step="0.01"
                  class="admin-input mono"
                  id="input-initial-cost"
                  value={quotation.initialEstimatedCost || '0'}
                />
              </label>
            </div>

            <div class="form-row-3">
              <label class="field">
                <span class="mono field-label">Final Quotation Amount</span>
                <input
                  type="number"
                  step="0.01"
                  class="admin-input mono font-semibold"
                  id="input-final-amount"
                  value={quotation.finalQuotationAmount || quotation.initialEstimatedCost || '0'}
                />
              </label>

              <label class="field">
                <span class="mono field-label">Additional Service Charges</span>
                <input
                  type="number"
                  step="0.01"
                  class="admin-input mono"
                  id="input-additional-charges"
                  value={quotation.additionalCharges || '0'}
                />
              </label>

              <label class="field">
                <span class="mono field-label">Discounts</span>
                <input
                  type="number"
                  step="0.01"
                  class="admin-input mono"
                  id="input-discount-amount"
                  value={quotation.discountAmount || '0'}
                />
              </label>
            </div>

            <!-- Notes separation: Internal Administrative Notes vs Customer-Visible Notes -->
            <div class="notes-split-grid">
              <!-- Internal Notes (Strictly Hidden) -->
              <label class="field">
                <div class="notes-header">
                  <span class="mono field-label text-warn">INTERNAL ESTIMATION NOTES</span>
                  <span class="mono badge-hidden">STRICTLY ADMIN ONLY</span>
                </div>
                <textarea
                  class="admin-textarea"
                  rows="4"
                  id="input-internal-notes"
                  placeholder="Private estimation notes, supplier costs, margins, engineering guild allocations... (Never shown to client)"
                >{quotation.internalNotes || ''}</textarea>
              </label>

              <!-- Customer-Visible Notes -->
              <label class="field">
                <div class="notes-header">
                  <span class="mono field-label text-accent">CUSTOMER-VISIBLE UPDATES</span>
                  <span class="mono badge-visible">VISIBLE TO CUSTOMER</span>
                </div>
                <textarea
                  class="admin-textarea"
                  rows="4"
                  id="input-customer-notes"
                  placeholder="Message visible on customer's portal: scope deliverables, quotation validity date, milestone notes..."
                >{quotation.customerNotes || ''}</textarea>
              </label>
            </div>
          </div>
        </div>

        <!-- 3. ORIGINAL PROJECT REQUIREMENTS & LINKED SERVICES -->
        <div class="card-panel">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Customer Submission</span>
              <h3 class="display h3">Project Requirements & Scope</h3>
            </div>
          </div>

          <div class="requirements-box">
            {quotation.projectDescription && (
              <div class="req-section">
                <span class="mono text-xs text-muted">Project Description:</span>
                <p class="req-text">{quotation.projectDescription}</p>
              </div>
            )}

            {quotation.requirements && (
              <div class="req-section">
                <span class="mono text-xs text-muted">Customer Requirements:</span>
                <div class="req-quote-box mono">
                  {quotation.requirements}
                </div>
              </div>
            )}

            {linkedRequests.length > 0 && (
              <div class="req-section">
                <span class="mono text-xs text-muted">Linked Catalog Services ({linkedRequests.length}):</span>
                <div class="linked-services-list">
                  {linkedRequests.map((r) => (
                    <div class="linked-service-item">
                      <div class="lsi-top">
                        <span class="mono lsi-code">{r.service.code}</span>
                        <span class={`layer-tag layer-${r.service.layer}`}>{r.service.layer}</span>
                        <span class="text-xs text-muted">{r.service.discipline}</span>
                      </div>
                      <strong class="lsi-name">{r.service.name}</strong>
                      <p class="lsi-desc">{r.service.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: CUSTOMER DETAILS & AUDIT TRAIL -->
      <div class="quote-right-pane">
        <!-- Customer Details Card -->
        <div class="card-panel">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Customer Information</span>
              <h3 class="display h3">Client Account</h3>
            </div>
            {customer && (
              <a href={`/admin/users/${customer.id}`} class="text-link mono">
                Profile →
              </a>
            )}
          </div>

          {customer ? (
            <div class="customer-info-box">
              <div class="cust-profile-row">
                {customer.avatarUrl ? (
                  <img src={customer.avatarUrl} alt={customer.fullName || 'Customer'} class="cust-avatar-img" />
                ) : (
                  <div class="cust-avatar-placeholder mono">
                    {(customer.fullName || customer.email)[0].toUpperCase()}
                  </div>
                )}
                <div>
                  <h4 class="cust-full-name">{customer.fullName || 'Ascelstack Customer'}</h4>
                  <span class="mono cust-email-text">{customer.email}</span>
                </div>
              </div>

              <div class="cust-meta-list mono text-xs">
                <div>
                  <span class="text-muted">Account ID:</span>
                  <span class="cust-id-val">{customer.id}</span>
                </div>
                <div>
                  <span class="text-muted">Clerk ID:</span>
                  <span class="cust-id-val">{customer.clerkUserId}</span>
                </div>
                <div>
                  <span class="text-muted">Member Since:</span>
                  <span>{new Date(customer.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>
                {business && (
                  <div>
                    <span class="text-muted">Business:</span>
                    <strong>{business.businessName} ({business.industry || 'General'})</strong>
                  </div>
                )}
              </div>
            </div>
          ) : (
            <p class="empty-subtext">No associated customer profile found.</p>
          )}
        </div>

        <!-- Historical Change Log Card -->
        <div class="card-panel">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Audit Trail</span>
              <h3 class="display h3">Quotation History ({history.length})</h3>
              <p class="panel-subtitle">Recorded administrator edits & status updates</p>
            </div>
          </div>

          <div class="history-timeline" id="history-container">
            {history.length === 0 ? (
              <p class="empty-subtext">No modifications recorded yet. Any status or pricing changes will be logged here with administrator identity and timestamps.</p>
            ) : (
              history.map((h) => (
                <div class="history-item">
                  <div class="history-bullet"></div>
                  <div class="history-content">
                    <div class="history-meta">
                      <span class="mono field-tag">{h.fieldChanged}</span>
                      <span class="mono history-admin">{h.adminEmail}</span>
                    </div>
                    <p class="history-desc">{h.description}</p>
                    <span class="mono history-time">
                      {new Date(h.createdAt).toLocaleDateString('en-IN', {
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                      })}
                    </span>
                  </div>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .quotation-detail-view {
      display: grid;
      gap: 1.5rem;
    }
    .detail-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .header-badges {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .quote-header-card {
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-l);
      padding: clamp(1.5rem, 3vw, 2.25rem);
      box-shadow: 0 10px 30px -15px rgba(20, 33, 48, 0.1);
      display: grid;
      gap: 1.5rem;
    }
    .quote-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .quote-title {
      font-size: clamp(1.6rem, 2.5vw, 2.5rem);
      margin: 0.25rem 0 0.5rem;
      color: var(--ink);
    }
    .quote-refs-line {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }
    .quote-ref-badge {
      background: var(--ink);
      color: var(--tint);
      font-size: 0.75rem;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
    }
    .quote-price-header-block {
      display: grid;
      gap: 0.25rem;
      text-align: right;
    }
    .quote-amount-label {
      font-size: 0.68rem;
      color: var(--text-muted);
    }
    .quote-amount-display {
      font-size: clamp(2rem, 3vw, 2.8rem);
      color: var(--ink);
      line-height: 1;
    }
    .quote-progress-section {
      display: grid;
      gap: 0.4rem;
      border-top: 1px solid var(--line);
      padding-top: 1.25rem;
    }
    .progress-info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .progress-label {
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .progress-val {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--ink);
    }
    .live-progress-bar {
      height: 10px;
      background: var(--paper-sunk);
      border-radius: 999px;
      overflow: hidden;
    }
    .live-progress-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 999px;
      transition: width 0.4s ease;
    }
    .quote-workspace-grid {
      display: grid;
      grid-template-columns: 1.55fr 1fr;
      gap: 1.5rem;
      align-items: start;
    }
    .quote-left-pane,
    .quote-right-pane {
      display: grid;
      gap: 1.5rem;
    }
    .status-fields-grid {
      display: grid;
      gap: 1.25rem;
    }
    .field-label {
      font-size: 0.75rem;
      color: var(--text);
      display: block;
      margin-bottom: 0.35rem;
    }
    .field-hint {
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
      display: block;
    }
    .admin-select,
    .admin-input,
    .admin-textarea {
      width: 100%;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      padding: 0.65rem 0.85rem;
      font-size: 0.9rem;
      color: var(--ink);
      outline: 0;
      transition: border-color 0.2s;
    }
    .admin-select:focus,
    .admin-input:focus,
    .admin-textarea:focus {
      border-color: var(--accent);
    }
    .progress-input-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .progress-slider-wrap {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 0.35rem;
    }
    .admin-slider {
      flex: 1;
      accent-color: var(--accent);
      cursor: pointer;
    }
    .admin-number-input {
      width: 70px;
      padding: 0.4rem 0.6rem;
      text-align: center;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      background: var(--paper);
      font-size: 0.85rem;
    }
    .pricing-fields-grid {
      display: grid;
      gap: 1.25rem;
    }
    .notes-split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-top: 0.5rem;
    }
    .notes-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.35rem;
    }
    .badge-hidden {
      font-size: 0.62rem;
      background: #fef3c7;
      color: #92400e;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }
    .badge-visible {
      font-size: 0.62rem;
      background: #dbeafe;
      color: #1e40af;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
    }
    .requirements-box {
      display: grid;
      gap: 1rem;
    }
    .req-section {
      display: grid;
      gap: 0.35rem;
    }
    .req-text {
      color: var(--text);
      font-size: 0.92rem;
      line-height: 1.5;
    }
    .req-quote-box {
      background: var(--paper-raised);
      border-left: 3px solid var(--accent);
      padding: 0.75rem 1rem;
      border-radius: 0 var(--radius-s) var(--radius-s) 0;
      font-size: 0.82rem;
      line-height: 1.5;
    }
    .linked-services-list {
      display: grid;
      gap: 0.75rem;
    }
    .linked-service-item {
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      padding: 0.75rem 1rem;
      display: grid;
      gap: 0.3rem;
    }
    .lsi-top {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .lsi-code {
      font-size: 0.72rem;
      color: var(--text-muted);
    }
    .lsi-name {
      font-size: 0.95rem;
      color: var(--ink);
    }
    .lsi-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin: 0;
    }
    .customer-info-box {
      display: grid;
      gap: 1rem;
    }
    .cust-profile-row {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .cust-avatar-img,
    .cust-avatar-placeholder {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--line);
      flex-shrink: 0;
    }
    .cust-avatar-placeholder {
      background: var(--ink);
      color: var(--paper);
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 1.1rem;
    }
    .cust-full-name {
      font-size: 1.05rem;
      color: var(--ink);
      margin: 0;
    }
    .cust-email-text {
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .cust-meta-list {
      display: grid;
      gap: 0.4rem;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      padding: 0.75rem 1rem;
    }
    .cust-meta-list > div {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .cust-id-val {
      font-size: 0.68rem;
      color: var(--ink);
      word-break: break-all;
    }
    .history-timeline {
      display: grid;
      gap: 1rem;
    }
    .history-item {
      display: flex;
      gap: 0.75rem;
    }
    .history-bullet {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      margin-top: 6px;
      flex-shrink: 0;
    }
    .history-content {
      display: grid;
      gap: 0.2rem;
      flex: 1;
      min-width: 0;
    }
    .history-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 0.5rem;
    }
    .field-tag {
      font-size: 0.65rem;
      background: var(--paper-sunk);
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      color: var(--ink);
    }
    .history-admin {
      font-size: 0.65rem;
      color: var(--text-muted);
    }
    .history-desc {
      font-size: 0.82rem;
      color: var(--text);
      margin: 0;
    }
    .history-time {
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    @media (max-width: 1024px) {
      .quote-workspace-grid { grid-template-columns: 1fr; }
      .notes-split-grid { grid-template-columns: 1fr; }
      .quote-price-header-block { text-align: left; }
    }
    @media (max-width: 640px) {
      .quote-header-card {
        padding: 1.25rem;
      }
      .quote-title-line {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      .pricing-inputs-grid {
        grid-template-columns: 1fr;
      }
      .form-actions-row {
        flex-direction: column;
      }
      .form-actions-row .btn {
        width: 100%;
        justify-content: center;
      }
      .slider-control-row {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>

  <script is:inline define:vars={{ quoteId: quotation.id }}>
    const btnSaveStatuses = document.getElementById('btn-save-statuses');
    const btnSavePricing = document.getElementById('btn-save-pricing');

    const selectQuotationStatus = document.getElementById('input-quotation-status');
    const selectPaymentStatus = document.getElementById('input-payment-status');
    const inputPaymentRef = document.getElementById('input-payment-ref');
    const progressSlider = document.getElementById('input-progress-slider');
    const progressNumber = document.getElementById('input-progress-number');
    const sliderValDisplay = document.getElementById('slider-val-display');

    const inputCurrency = document.getElementById('input-currency');
    const inputInitialCost = document.getElementById('input-initial-cost');
    const inputFinalAmount = document.getElementById('input-final-amount');
    const inputAddCharges = document.getElementById('input-additional-charges');
    const inputDiscount = document.getElementById('input-discount-amount');
    const inputInternalNotes = document.getElementById('input-internal-notes');
    const inputCustomerNotes = document.getElementById('input-customer-notes');

    // Sync progress slider & number input
    function updateProgressUI(val) {
      const clamped = Math.max(0, Math.min(100, parseInt(val, 10) || 0));
      if (progressSlider) progressSlider.value = clamped;
      if (progressNumber) progressNumber.value = clamped;
      if (sliderValDisplay) sliderValDisplay.textContent = `${clamped}%`;
      const liveFill = document.getElementById('live-progress-fill');
      const displayPct = document.getElementById('display-progress-pct');
      const badgeProgress = document.getElementById('badge-progress');
      if (liveFill) liveFill.style.width = `${clamped}%`;
      if (displayPct) displayPct.textContent = `${clamped}%`;
      if (badgeProgress) badgeProgress.textContent = `${clamped}% Complete`;
    }

    progressSlider?.addEventListener('input', (e) => updateProgressUI(e.target.value));
    progressNumber?.addEventListener('input', (e) => updateProgressUI(e.target.value));

    // Save Statuses & Progress
    btnSaveStatuses?.addEventListener('click', async () => {
      try {
        btnSaveStatuses.disabled = true;
        btnSaveStatuses.innerHTML = '<span>Saving...</span>';

        const qStatus = selectQuotationStatus?.value;
        const pStatus = selectPaymentStatus?.value;
        const pRef = inputPaymentRef?.value.trim();
        const progress = parseInt(progressNumber?.value || '0', 10);

        const res = await fetch(`/api/admin/quotations/${quoteId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            quotationStatus: qStatus,
            paymentStatus: pStatus,
            paymentReference: pRef,
            paymentVerified: pStatus === 'Payment Completed' ? true : undefined,
            projectProgress: progress,
          }),
        });

        const data = await res.json();
        btnSaveStatuses.disabled = false;
        btnSaveStatuses.innerHTML = '<span>Save Statuses</span><span class="arrow">→</span>';

        if (res.ok) {
          window.showAdminToast?.('Statuses and project progress saved successfully!', 'success');
          // Broadcast real-time change to all open admin tabs and customer portal
          try {
            const bc = new BroadcastChannel('asc_admin_sync');
            bc.postMessage({ type: 'QUOTATION_UPDATED', quotationId: quoteId, quotationStatus: qStatus, paymentStatus: pStatus, timestamp: Date.now() });
            bc.close();
          } catch (e) {}
          try {
            const custBc = new BroadcastChannel('asc_customer_sync');
            custBc.postMessage({ type: 'QUOTATION_UPDATED', quotationId: quoteId, quotationStatus: qStatus, paymentStatus: pStatus, timestamp: Date.now() });
            custBc.close();
          } catch (e) {}
          try {
            localStorage.setItem('asc_admin_sync_tick', String(Date.now()));
            localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('asc:db-sync', { detail: { type: 'QUOTATION_UPDATED', quotationId: quoteId } }));

          // Update top badges
          const badgeQ = document.getElementById('badge-quote-status');
          const badgeP = document.getElementById('badge-payment-status');
          if (badgeQ) {
            badgeQ.textContent = qStatus;
            badgeQ.className = `status-tag status-${qStatus.toLowerCase().replace(/\s+/g, '-')}`;
          }
          if (badgeP) {
            badgeP.textContent = pStatus;
            badgeP.className = `payment-pill payment-${pStatus.toLowerCase().replace(/\s+/g, '-')}`;
          }
        } else {
          window.showAdminToast?.(data.error || 'Failed to update statuses', 'error');
        }
      } catch (err) {
        btnSaveStatuses.disabled = false;
        btnSaveStatuses.innerHTML = '<span>Save Statuses</span><span class="arrow">→</span>';
        window.showAdminToast?.('Connection error while saving', 'error');
      }
    });

    // Save Pricing & Notes
    btnSavePricing?.addEventListener('click', async () => {
      try {
        btnSavePricing.disabled = true;
        btnSavePricing.innerHTML = '<span>Saving...</span>';

        const currency = inputCurrency?.value || 'INR';
        const initialCost = parseFloat(inputInitialCost?.value || '0');
        const finalAmount = parseFloat(inputFinalAmount?.value || '0');
        const addCharges = parseFloat(inputAddCharges?.value || '0');
        const discount = parseFloat(inputDiscount?.value || '0');
        const internalNotes = inputInternalNotes?.value;
        const customerNotes = inputCustomerNotes?.value;

        const res = await fetch(`/api/admin/quotations/${quoteId}/pricing`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            currency,
            initialEstimatedCost: initialCost,
            finalQuotationAmount: finalAmount,
            additionalCharges: addCharges,
            discountAmount: discount,
            internalNotes,
            customerNotes,
          }),
        });

        const data = await res.json();
        btnSavePricing.disabled = false;
        btnSavePricing.innerHTML = '<span>Save Pricing</span><span class="arrow">→</span>';

        if (res.ok) {
          window.showAdminToast?.('Pricing and estimation notes saved successfully!', 'success');
          try {
            const bc = new BroadcastChannel('asc_admin_sync');
            bc.postMessage({ type: 'QUOTATION_PRICING_UPDATED', quotationId: quoteId, timestamp: Date.now() });
            bc.close();
          } catch (e) {}
          try {
            const custBc = new BroadcastChannel('asc_customer_sync');
            custBc.postMessage({ type: 'QUOTATION_PRICING_UPDATED', quotationId: quoteId, timestamp: Date.now() });
            custBc.close();
          } catch (e) {}
          try {
            localStorage.setItem('asc_admin_sync_tick', String(Date.now()));
            localStorage.setItem('asc_customer_sync_tick', String(Date.now()));
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('asc:db-sync', { detail: { type: 'QUOTATION_PRICING_UPDATED', quotationId: quoteId } }));

          const displayFinal = document.getElementById('display-final-amount');
          const displayInitial = document.getElementById('display-initial-amount');
          if (displayFinal) displayFinal.textContent = `${currency} ${finalAmount.toLocaleString()}`;
          if (displayInitial) displayInitial.textContent = `Initial Estimate: ${currency} ${initialCost.toLocaleString()}`;
        } else {
          window.showAdminToast?.(data.error || 'Failed to update pricing', 'error');
        }
      } catch (err) {
        btnSavePricing.disabled = false;
        btnSavePricing.innerHTML = '<span>Save Pricing</span><span class="arrow">→</span>';
        window.showAdminToast?.('Connection error while saving pricing', 'error');
      }
    });
  </script>
</AdminLayout>
