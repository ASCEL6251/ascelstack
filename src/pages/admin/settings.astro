---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAdminSession, getAuthorizedAdminEmails, getEnvVariable } from '../../lib/admin-auth';

const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}
const allowedEmails = getAuthorizedAdminEmails(Astro);
const hasGoogleClientId = Boolean(getEnvVariable('GOOGLE_CLIENT_ID', Astro));
const hasDbUrl = Boolean(getEnvVariable('DATABASE_URL', Astro));
---

<AdminLayout title="Admin Settings" activeNav="settings" breadcrumbs={[{ label: 'Settings' }]}>
  <div class="settings-grid">
    <!-- Card 1: Cloudflare ADMIN_EMAILS Access Control -->
    <div class="card-panel">
      <div class="panel-header">
        <div>
          <span class="eyebrow">Cloudflare Access Control</span>
          <h2 class="display h3">Administrator Allowlist</h2>
          <p class="panel-subtitle">Access is governed exclusively through the server-side <code>ADMIN_EMAILS</code> environment variable</p>
        </div>
        <span class="badge-status-active">
          <span class="status-dot"></span> {allowedEmails.length} Authorized
        </span>
      </div>

      <div class="settings-section">
        <p class="settings-desc">
          Only Google accounts matching the comma-separated emails below are granted administrator access. When you add, edit, or remove an email in your Cloudflare dashboard, changes take effect immediately on privileged requests.
        </p>

        <div class="allowlist-box">
          <span class="mono text-xs text-muted">Active Authorized Emails:</span>
          <div class="allowlist-tags">
            {allowedEmails.map((email) => (
              <span class="mono email-pill">
                <span class="dot-online"></span>
                <span>{email}</span>
                {session?.email === email && <span class="tag-current">(Current Session)</span>}
              </span>
            ))}
          </div>
        </div>

        <div class="cloudflare-doc-callout">
          <div class="doc-callout-header">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />
            </svg>
            <strong>How to Update Authorized Administrators in Cloudflare:</strong>
          </div>
          <ol class="doc-steps">
            <li>Log in to your <strong>Cloudflare Dashboard</strong>.</li>
            <li>Navigate to <strong>Workers & Pages</strong> → Select <strong>ascelstack</strong>.</li>
            <li>Go to <strong>Settings</strong> → <strong>Variables and Secrets</strong>.</li>
            <li>Edit the <strong><code>ADMIN_EMAILS</code></strong> variable with comma-separated emails:
              <br /><code class="code-sample">ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com</code>
            </li>
            <li>Save & Deploy. <em>Removed emails lose administrator privileges immediately on their next request.</em></li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Card 2: Security & System Diagnostics -->
    <div class="card-panel">
      <div class="panel-header">
        <div>
          <span class="eyebrow">Security & Runtime</span>
          <h2 class="display h3">System Diagnostics</h2>
        </div>
      </div>

      <div class="diagnostics-list">
        <div class="diag-item">
          <div>
            <strong>Database Connection</strong>
            <span class="diag-sub">Neon Serverless PostgreSQL Pooler</span>
          </div>
          <span class="diag-badge text-success">
            {hasDbUrl ? '✓ Connected' : '✕ Missing URL'}
          </span>
        </div>

        <div class="diag-item">
          <div>
            <strong>Google OAuth Provider</strong>
            <span class="diag-sub">Google Identity Services / Token Verification</span>
          </div>
          <span class="diag-badge text-accent">
            {hasGoogleClientId ? '✓ Configured' : 'ℹ Dev Mode Active'}
          </span>
        </div>

        <div class="diag-item">
          <div>
            <strong>Active Admin Session</strong>
            <span class="diag-sub">Signed HTTP-only cookie with HMAC-SHA256</span>
          </div>
          <span class="diag-badge text-success">✓ Verified & Valid</span>
        </div>

        <div class="diag-item">
          <div>
            <strong>Instant Access Revocation</strong>
            <span class="diag-sub">Re-validates allowlist on every privileged request</span>
          </div>
          <span class="diag-badge text-success">✓ Enforced Server-Side</span>
        </div>

        <div class="diag-item">
          <div>
            <strong>Customer Auth Isolation</strong>
            <span class="diag-sub">Admin session is strictly isolated from Clerk customer sessions</span>
          </div>
          <span class="diag-badge text-success">✓ Isolated</span>
        </div>
      </div>
    </div>
  </div>

  <style>
    .settings-grid {
      display: grid;
      gap: 1.5rem;
    }
    .settings-section {
      display: grid;
      gap: 1.25rem;
    }
    .settings-desc {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.5;
      margin: 0;
    }
    .allowlist-box {
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      padding: 1rem;
      display: grid;
      gap: 0.65rem;
    }
    .allowlist-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .email-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--paper);
      border: 1px solid var(--line);
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      color: var(--ink);
    }
    .dot-online {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #10b981;
    }
    .tag-current {
      font-size: 0.68rem;
      color: var(--accent);
      font-weight: 600;
    }
    .cloudflare-doc-callout {
      background: rgba(89, 128, 166, 0.08);
      border-left: 3px solid var(--accent);
      padding: 1.25rem;
      border-radius: 0 var(--radius-s) var(--radius-s) 0;
      display: grid;
      gap: 0.75rem;
    }
    .doc-callout-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--ink);
    }
    .doc-steps {
      margin: 0;
      padding-left: 1.25rem;
      font-size: 0.88rem;
      line-height: 1.6;
      color: var(--text);
    }
    .code-sample {
      font-family: var(--font-mono);
      background: var(--paper-raised);
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.8rem;
      display: inline-block;
      margin-top: 0.25rem;
    }
    .diagnostics-list {
      display: grid;
      gap: 0.75rem;
    }
    .diag-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1rem;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
    }
    .diag-sub {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
    }
    .diag-badge {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
    }
  </style>
</AdminLayout>
