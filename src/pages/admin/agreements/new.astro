          </button>
          <button type="button" class="btn btn-sm btn-primary" id="btn-preview-create">
            Create Agreement
          </button>
        </div>
      </div>

      <div class="agreement-paper-container">
        <article class="agreement-paper" id="rendered-paper">
          <!-- Live Document Header -->
          <header class="doc-header">
            <div class="doc-brand">
              <div class="doc-brand-logo">
                <svg width="48" height="48" viewBox="0 0 100 100" aria-hidden="true">
                  <path d="M50 6 L66 38 L34 38 Z" fill="#94BCE3"></path>
                  <path d="M32 42 L68 42 L70 46 L80 66 L60 66 L50 46 L40 66 L20 66 L30 46 Z" fill="#5980A6"></path>
                  <path d="M18 70 L38 70 L26 94 L6 94 Z M82 70 L62 70 L74 94 L94 94 Z" fill="#1D2D3D"></path>
                </svg>
              </div>
              <div class="doc-brand-info">
                <h2 id="prev-brand-name">{companyInfo.legalName}</h2>
                <p id="prev-brand-address">{companyInfo.address}</p>
                <p style="font-size: 0.75rem; color: #64748b; margin-top: 2px;">
                  <span>Email: {companyInfo.email}</span> · <span>Phone: {companyInfo.phone}</span>
                  <span id="prev-gstin-line" style="display: none;"> · <strong id="prev-gstin-val"></strong></span>
