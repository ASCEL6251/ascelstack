---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../../lib/admin-auth';
import { db, users, businesses, companySettings, agreementTemplates, quotations } from '../../../db';
import { STANDARD_25_CLAUSES, PRESET_TEMPLATES, DEFAULT_COMPANY_INFO } from '../../../lib/agreement-clauses';
import { desc, asc } from 'drizzle-orm';

// Strict Server-Side Session Check
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}

// 1. Safe Company Settings with guaranteed fallbacks
let companyInfo = { ...DEFAULT_COMPANY_INFO };
try {
  const [settings] = await db.select().from(companySettings).limit(1);
  if (settings) {
    companyInfo = {
      legalName: settings.companyLegalName || DEFAULT_COMPANY_INFO.legalName,
      brandName: settings.companyBrandName || DEFAULT_COMPANY_INFO.brandName,
      address: settings.registeredAddress || DEFAULT_COMPANY_INFO.address,
      email: settings.legalEmail || DEFAULT_COMPANY_INFO.email,
      supportEmail: settings.supportEmail || DEFAULT_COMPANY_INFO.supportEmail,
      phone: settings.contactPhone || DEFAULT_COMPANY_INFO.phone,
      gstin: settings.gstin || '',
      gstinEnabled: Boolean(settings.gstinEnabled),
      logoUrl: settings.logoUrl || DEFAULT_COMPANY_INFO.logoUrl,
      signatoryName: settings.signatoryName || DEFAULT_COMPANY_INFO.signatoryName,
      signatoryTitle: settings.signatoryTitle || DEFAULT_COMPANY_INFO.signatoryTitle,
      defaultCurrency: settings.defaultCurrency || 'INR',
    };
  }
} catch (err) {
  console.warn('[Agreements/New] Error fetching company settings, using defaults:', err);
}

// 2. Safe registered clients for quick selection
let registeredUsers: Array<{ id: string; fullName: string | null; email: string }> = [];
try {
  registeredUsers = await db
    .select({
      id: users.id,
      fullName: users.fullName,
      email: users.email,
    })
    .from(users)
    .orderBy(asc(users.fullName));
} catch (err) {
  console.warn('[Agreements/New] Error fetching registered users:', err);
  registeredUsers = [];
}

// 3. Safe quotations if admin wants to base agreement on a quotation
let approvedQuotations: Array<{
  id: string;
  quotationNumber: string;
  projectTitle: string;
  finalQuotationAmount: string | null;
  currency: string;
  userId: string;
  businessId: string | null;
}> = [];
try {
  approvedQuotations = await db
    .select({
      id: quotations.id,
      quotationNumber: quotations.quotationNumber,
      projectTitle: quotations.projectTitle,
      finalQuotationAmount: quotations.finalQuotationAmount,
      currency: quotations.currency,
      userId: quotations.userId,
      businessId: quotations.businessId,
    })
    .from(quotations)
    .orderBy(desc(quotations.createdAt))
    .limit(30);
} catch (err) {
  console.warn('[Agreements/New] Error fetching approved quotations:', err);
  approvedQuotations = [];
}

// 4. Safe saved templates from database
let templatesList = PRESET_TEMPLATES;
try {
  const dbTemplates = await db.select().from(agreementTemplates).orderBy(asc(agreementTemplates.name));
  if (dbTemplates && dbTemplates.length > 0) {
    templatesList = dbTemplates as any;
  }
} catch (err) {
  console.warn('[Agreements/New] Error fetching templates:', err);
  templatesList = PRESET_TEMPLATES;
}
---

<AdminLayout
  title="Create Client Agreement"
  activeNav="agreements"
  breadcrumbs={[
    { label: 'Agreements', href: '/admin/agreements' },
    { label: 'New Agreement' },
  ]}
  session={session}
>
  <style>
    /* Scoped styling to guarantee pixel-perfect match with the main UI */
    .form-row {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 1.25rem !important;
      margin-bottom: 1.25rem !important;
      align-items: start !important;
    }
    .form-row-3 {
      display: grid !important;
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 1.25rem !important;
      margin-bottom: 1.25rem !important;
      align-items: start !important;
    }
    @media (max-width: 768px) {
      .form-row, .form-row-3 {
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
      }
    }
    .field {
      display: flex !important;
      flex-direction: column !important;
      gap: 0.45rem !important;
      margin-bottom: 1.25rem !important;
      min-width: 0 !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .field > .mono, .field span.mono {
      font-family: var(--font-mono, monospace) !important;
      font-size: 0.72rem !important;
      font-weight: 600 !important;
      color: var(--text-muted, #5d5d60) !important;
      text-transform: uppercase !important;
      letter-spacing: 0.06em !important;
      display: block !important;
      margin-bottom: 0.15rem !important;
    }
    .field input, .field select, .field textarea, .field-select, .deliverable-row input, .milestone-row input {
      width: 100% !important;
      padding: 0.75rem 1rem !important;
      background: #ffffff !important;
      color: var(--ink, #1d2d3d) !important;
      border: 1px solid var(--line, rgba(29, 45, 61, 0.18)) !important;
      border-radius: var(--radius-s, 6px) !important;
      font-family: var(--font-body, inherit) !important;
      font-size: 0.92rem !important;
      line-height: 1.5 !important;
      box-sizing: border-box !important;
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease !important;
    }
    .field textarea {
      resize: vertical !important;
      min-height: 80px !important;
    }
    .field input:focus, .field select:focus, .field textarea:focus, .field-select:focus,
    .deliverable-row input:focus, .milestone-row input:focus {
      outline: none !important;
      border-color: var(--accent, #5980a6) !important;
      box-shadow: 0 0 0 3px rgba(89, 128, 166, 0.2) !important;
      background: #ffffff !important;
    }
    .field input.input-disabled, .field input:read-only, .field textarea:read-only {
      background: var(--paper-sunk, #e8e8ea) !important;
      color: var(--text-muted, #5d5d60) !important;
      border-color: rgba(29, 45, 61, 0.12) !important;
      cursor: not-allowed !important;
    }
    .field input.is-invalid, .field select.is-invalid, .field textarea.is-invalid {
      border-color: #ef4444 !important;
      box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.2) !important;
    }
    .tab-pill {
      display: inline-flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      padding: 0.6rem 1.15rem !important;
      border-radius: var(--radius-s, 6px) !important;
      background: var(--paper-raised, #fafafb) !important;
      border: 1px solid var(--line, rgba(29, 45, 61, 0.14)) !important;
      color: var(--text-muted, #5d5d60) !important;
      font-size: 0.86rem !important;
      font-weight: 500 !important;
      cursor: pointer !important;
      transition: all 0.2s ease !important;
    }
    .tab-pill:hover {
      border-color: var(--accent, #5980a6) !important;
      color: var(--ink, #1d2d3d) !important;
    }
    .tab-pill.is-on {
      background: var(--ink, #1d2d3d) !important;
      color: #ffffff !important;
      border-color: var(--ink, #1d2d3d) !important;
      font-weight: 600 !important;
      box-shadow: 0 2px 8px rgba(29, 45, 61, 0.12) !important;
    }
    .stepper-nav {
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      overflow-x: auto !important;
      padding: 0.5rem 0 1.25rem !important;
      margin-bottom: 1.5rem !important;
      border-bottom: 1px solid var(--line, rgba(29, 45, 61, 0.14)) !important;
    }
    .step-item {
      display: flex !important;
      align-items: center !important;
      gap: 0.6rem !important;
      padding: 0.65rem 1.15rem !important;
      border-radius: var(--radius-s, 6px) !important;
      background: #ffffff !important;
      border: 1px solid var(--line, rgba(29, 45, 61, 0.14)) !important;
      color: var(--text-muted, #5d5d60) !important;
      cursor: pointer !important;
      font-size: 0.84rem !important;
      font-weight: 600 !important;
      white-space: nowrap !important;
      transition: all 0.2s ease !important;
    }
    .step-item:hover {
      border-color: var(--accent, #5980a6) !important;
      color: var(--ink, #1d2d3d) !important;
    }
    .step-item.is-active {
      background: var(--ink, #1d2d3d) !important;
      color: #ffffff !important;
      border-color: var(--ink, #1d2d3d) !important;
      box-shadow: 0 4px 12px rgba(29, 45, 61, 0.15) !important;
    }
    .step-item .step-num {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 22px !important;
      height: 22px !important;
      border-radius: 50% !important;
      background: var(--paper-sunk, #e8e8ea) !important;
      color: var(--ink, #1d2d3d) !important;
      font-family: var(--font-mono, monospace) !important;
      font-size: 0.72rem !important;
      font-weight: 700 !important;
    }
    .step-item.is-active .step-num {
      background: var(--accent, #5980a6) !important;
      color: #ffffff !important;
    }
    .admin-alert-banner {
      display: flex !important;
      align-items: flex-start !important;
      gap: 0.75rem !important;
      padding: 1rem 1.25rem !important;
      border-radius: var(--radius-s, 6px) !important;
      font-size: 0.88rem !important;
      line-height: 1.5 !important;
      margin-bottom: 1.5rem !important;
    }
    .admin-alert-error {
      background: #fef2f2 !important;
      border: 1px solid #fecaca !important;
      color: #991b1b !important;
    }
  </style>

  <div class="dash-view is-active" id="agreement-builder-view">
    <!-- Header banner -->
    <div class="dash-welcome-card" style="margin-bottom: 1.5rem;">
      <div class="welcome-copy">
        <p class="eyebrow">Document Generator · Indian Law Standard</p>
        <h1 class="display welcome-title">Professional Service <em>Agreement Generator</em></h1>
        <p class="welcome-desc">
          Configure corporate client information, scope of work, sprint milestones, pricing terms, and 25 customizable legal clauses. Preview in real-time with official corporate branding and execute via secure client link.
        </p>
      </div>

      <div class="welcome-actions">
        <button type="button" class="btn btn-ghost" id="btn-toggle-preview">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
          <span id="preview-toggle-text">Toggle Document Preview</span>
        </button>
        <a href="/admin/agreements" class="btn btn-ghost">
          Cancel
        </a>
      </div>
    </div>

    <!-- Mode Selector: Wizard Form vs Live Document Preview -->
    <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
      <button type="button" class="tab-pill is-on" id="tab-btn-form" data-pane="form">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
        <span>Agreement Editor</span>
      </button>

      <button type="button" class="tab-pill" id="tab-btn-preview" data-pane="preview">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
        </svg>
        <span>Live Document Preview</span>
      </button>
    </div>

    <!-- Form Container -->
    <div id="pane-form">
      <form id="agreement-form" class="business-form" novalidate>
        <!-- STEPPER TABS -->
        <div class="stepper-nav">
          <button type="button" class="step-item is-active" data-step="1">
            <span class="step-num">1</span>
            <span>Client & Entity</span>
          </button>
          <button type="button" class="step-item" data-step="2">
            <span class="step-num">2</span>
            <span>Project & SOW</span>
          </button>
          <button type="button" class="step-item" data-step="3">
            <span class="step-num">3</span>
            <span>Commercials & Milestones</span>
          </button>
          <button type="button" class="step-item" data-step="4">
            <span class="step-num">4</span>
            <span>Legal Clauses (25 Sections)</span>
          </button>
          <button type="button" class="step-item" data-step="5">
            <span class="step-num">5</span>
            <span>Branding & Execution</span>
          </button>
        </div>

        <!-- ============================================================== -->
        <!-- STEP 1: CLIENT & ENTITY -->
        <!-- ============================================================== -->
        <div class="card-panel step-pane is-active" data-step-content="1">
          <div class="panel-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
            <div>
              <span class="eyebrow">Step 01</span>
              <h2 class="display h3">Client & Contracting Entity</h2>
              <p class="panel-subtitle">Select an existing registered client or enter new company information</p>
            </div>

            <!-- Optional: Link Existing Client & Quick Fill -->
            <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
              <select id="select-registered-client" class="field-select" style="min-width: 220px;">
                <option value="">-- Quick Load Client Profile --</option>
                {(registeredUsers || []).map((u) => (
                  <option value={u.id} data-name={u.fullName || ''} data-email={u.email}>
                    {u.fullName || u.email} ({u.email})
                  </option>
                ))}
              </select>
              <button type="button" class="btn btn-sm btn-ghost" id="btn-fill-demo-client" title="Autofill sample corporate client details for fast testing" style="white-space: nowrap;">
                ⚡ Autofill Sample Client
              </button>
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Client Signatory Full Legal Name *</span>
              <input type="text" id="clientName" name="clientName" required placeholder="e.g. Rahul Sharma" />
            </div>
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Client Official Email Address *</span>
              <input type="email" id="clientEmail" name="clientEmail" required placeholder="rahul@company.com" />
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Client Company / Legal Entity Name</span>
              <input type="text" id="clientCompany" name="clientCompany" placeholder="e.g. Apex Retail Technologies Pvt Ltd" />
            </div>
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Official Phone Number</span>
              <input type="text" id="clientPhone" name="clientPhone" placeholder="+91 98765 43210" />
            </div>
          </div>

          <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%; margin-bottom: 1.25rem;">
            <span class="mono">Principal Place of Business / Registered Address</span>
            <textarea id="clientAddress" name="clientAddress" rows="2" placeholder="Suite 401, Tech Park, Indiranagar"></textarea>
          </div>

          <div class="form-row-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">City</span>
              <input type="text" id="clientCity" name="clientCity" placeholder="Bengaluru" />
            </div>
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">State</span>
              <input type="text" id="clientState" name="clientState" placeholder="Karnataka" />
            </div>
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Country</span>
              <input type="text" id="clientCountry" name="clientCountry" value="India" />
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Client GSTIN / Tax Identification (Optional)</span>
              <input type="text" id="clientGstin" name="clientGstin" placeholder="29ABCDE1234F1Z5" />
            </div>
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Link Existing Quotation (Optional)</span>
              <select id="quotationId" name="quotationId">
                <option value="">-- No linked quotation --</option>
                {(approvedQuotations || []).map((q) => (
                  <option value={q.id} data-amount={q.finalQuotationAmount || '0'} data-title={q.projectTitle || ''}>
                    {q.quotationNumber} - {q.projectTitle} ({q.currency || 'INR'} {Number(q.finalQuotationAmount || 0).toLocaleString()})
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-footer" style="display: flex; justify-content: flex-end;">
            <button type="button" class="btn btn-primary" data-next-step="2">
              <span>Next: Project & Scope</span>
              <span class="arrow">→</span>
            </button>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- STEP 2: PROJECT & SCOPE OF WORK -->
        <!-- ============================================================== -->
        <div class="card-panel step-pane" data-step-content="2" style="display: none;">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Step 02</span>
              <h2 class="display h3">Project Name & Statement of Work</h2>
              <p class="panel-subtitle">Define the technical architecture, scope boundaries, and core deliverables</p>
            </div>
          </div>

          <div class="field">
            <span class="mono">Project Name / Reference Title *</span>
            <input type="text" id="projectName" name="projectName" required value="Enterprise Cloud Architecture & AI Automation Pipeline" placeholder="e.g. Next-Generation Cloud Application & AI Workflow Engine" />
          </div>

          <div class="field">
            <span class="mono">Project Overview & Business Objectives</span>
            <textarea id="projectDescription" name="projectDescription" rows="3" placeholder="Comprehensive digital platform build engineered to automate multi-channel customer workflows, streamline compliance reporting, and provide unified customer visibility across 3 operating layers..."></textarea>
          </div>

          <div class="field">
            <span class="mono">Detailed Scope of Work (SOW)</span>
            <textarea id="scopeOfWork" name="scopeOfWork" rows="5" placeholder="1. Frontend UI Architecture with responsive React/Astro design system&#10;2. Cloudflare serverless edge worker backend and RESTful APIs&#10;3. Neon PostgreSQL database modeling, schema indexes, and automated migrations&#10;4. Autonomous AI agent integration for automated customer inquiry routing&#10;5. End-to-end user acceptance testing, performance optimization, and production deployment"></textarea>
          </div>

          <!-- Dynamic Deliverables -->
          <div class="field">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span class="mono">Key Deliverables Catalogue</span>
              <button type="button" class="btn btn-sm btn-ghost" id="btn-add-deliverable">
                + Add Deliverable
              </button>
            </div>
            <div id="deliverables-container" style="display: grid; gap: 0.5rem;">
              <div class="deliverable-row" style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="text" class="deliv-title" placeholder="Deliverable name (e.g. Production Web Application Source Code)" style="flex: 1;" value="Production Web & Mobile Application Source Code" />
                <button type="button" class="btn-remove-deliv btn-sm btn-ghost" style="color: #ef4444;">✕</button>
              </div>
              <div class="deliverable-row" style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="text" class="deliv-title" placeholder="Deliverable name" style="flex: 1;" value="Modular API Endpoints & Neon PostgreSQL Database Schema" />
                <button type="button" class="btn-remove-deliv btn-sm btn-ghost" style="color: #ef4444;">✕</button>
              </div>
              <div class="deliverable-row" style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="text" class="deliv-title" placeholder="Deliverable name" style="flex: 1;" value="Deployment Scripts, Architectural Documentation & Admin Secrets Handover" />
                <button type="button" class="btn-remove-deliv btn-sm btn-ghost" style="color: #ef4444;">✕</button>
              </div>
            </div>
          </div>

          <div class="form-footer" style="display: flex; justify-content: space-between;">
            <button type="button" class="btn btn-ghost" data-prev-step="1">
              ← Back
            </button>
            <button type="button" class="btn btn-primary" data-next-step="3">
              <span>Next: Commercials & Milestones</span>
              <span class="arrow">→</span>
            </button>
          </div>
        </div>

        <!-- ============================================================== -->
        <!-- STEP 3: COMMERCIALS & MILESTONES -->
        <!-- ============================================================== -->
        <div class="card-panel step-pane" data-step-content="3" style="display: none;">
          <div class="panel-header">
            <div>
              <span class="eyebrow">Step 03</span>
              <h2 class="display h3">Commercials, Pricing & Timeline</h2>
              <p class="panel-subtitle">Configure contract valuation, advance mobilization, and milestone release schedules</p>
            </div>
          </div>

          <div class="form-row-3" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Contract Currency</span>
              <select id="currency" name="currency">
                <option value="INR" selected>₹ INR (Indian Rupee)</option>
                <option value="USD">$ USD (US Dollar)</option>
              </select>
            </div>

            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Total Contract Value *</span>
              <input type="number" id="totalAmount" name="totalAmount" required min="0" step="0.01" value="150000" />
            </div>

            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Advance Payment %</span>
              <input type="number" id="advancePercentage" name="advancePercentage" min="0" max="100" value="50" />
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
            <div class="field" style="display: flex; flex-direction: column; gap: 0.45rem; width: 100%;">
              <span class="mono">Advance Amount (Auto-Calculated)</span>
              <input type="number" id="advanceAmount" name="advanceAmount" readonly class="input-disabled" value="75000" />
            </div>

