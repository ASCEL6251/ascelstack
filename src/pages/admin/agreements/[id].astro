---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminSession } from '../../../lib/admin-auth';
import { db, agreements, agreementSignatures, agreementAuditLogs, users, businesses } from '../../../db';
import { eq, desc } from 'drizzle-orm';

// Strict Server-Side Session Check
const session = await getAdminSession(Astro);
if (!session) {
  return Astro.redirect('/admin/login');
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/admin/agreements');
}

const [agreement] = await db
  .select()
  .from(agreements)
  .where(eq(agreements.id, id))
  .limit(1);

if (!agreement) {
  return Astro.redirect('/admin/agreements');
}

// Fetch signatures
const signatures = await db
  .select()
  .from(agreementSignatures)
  .where(eq(agreementSignatures.agreementId, id))
  .orderBy(desc(agreementSignatures.signedAt));

const providerSig = signatures.find((s) => s.signerRole === 'provider');
const clientSig = signatures.find((s) => s.signerRole === 'client');

// Fetch audit logs
const auditLogs = await db
  .select()
  .from(agreementAuditLogs)
  .where(eq(agreementAuditLogs.agreementId, id))
  .orderBy(desc(agreementAuditLogs.createdAt));

function formatCurrency(amount: string | number, curr = 'INR') {
  const num = typeof amount === 'string' ? parseFloat(amount) : amount;
  if (isNaN(num)) return '₹0';
  if (curr === 'USD') return `$${num.toLocaleString('en-US')}`;
  return `₹${num.toLocaleString('en-IN')}`;
}

const clauses = (agreement.clauses as any[]) || [];
const deliverables = (agreement.deliverables as any[]) || [];
const milestones = (agreement.milestones as any[]) || [];

const clientSigningUrl = `${Astro.url.origin}/agreements/${agreement.secureToken}`;
const printPdfUrl = `${Astro.url.origin}/agreements/${agreement.secureToken}/print`;

const statusDisplay: Record<string, string> = {
  draft: 'Draft',
  pending_review: 'Pending Review',
  sent: 'Sent to Client',
  viewed: 'Viewed by Client',
  pending_signature: 'Pending Signature',
  partially_signed: 'Partially Signed',
  signed: 'Signed & Immutable',
  rejected: 'Rejected',
  expired: 'Expired',
  cancelled: 'Cancelled',
};
---

<AdminLayout
  title={`${agreement.agreementNumber} · Agreement Details`}
  activeNav="agreements"
  breadcrumbs={[
    { label: 'Agreements', href: '/admin/agreements' },
    { label: agreement.agreementNumber },
  ]}
  session={session}
>
  <div class="dash-view is-active">
    <!-- Top Action Banner -->
    <div class="dash-welcome-card" style="margin-bottom: 2rem;">
      <div class="welcome-copy">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
          <span class="mono" style="font-size: 1.15rem; font-weight: 700; color: var(--accent);">
            {agreement.agreementNumber}
          </span>
          <span class={`status-tag status-${agreement.status}`}>
            {statusDisplay[agreement.status] || agreement.status}
          </span>
          <span class="mono text-muted text-xs">Version {agreement.version}</span>
          {agreement.isImmutable && (
            <span class="mono" style="background: rgba(4, 120, 87, 0.1); color: #047857; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700;">
              LOCKED (IMMUTABLE)
            </span>
          )}
        </div>

        <h1 class="display welcome-title">{agreement.projectName}</h1>
        <p class="welcome-desc">
          Contracted to <strong>{agreement.clientName}</strong> ({agreement.clientCompany || 'Client Organization'}). Commercial Valuation: <strong class="mono">{formatCurrency(agreement.totalAmount, agreement.currency)}</strong>.
        </p>
      </div>

      <div class="welcome-actions">
        <!-- Copy Unique Agreement Code -->
        <button
          type="button"
          class="btn btn-ghost"
          id="btn-copy-agreement-code"
          data-code={agreement.agreementNumber}
          title="Copy Unique Agreement Code for Client (User can enter this in their portal)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span>Copy Code: <strong style="color: var(--accent);">{agreement.agreementNumber}</strong></span>
        </button>

        <!-- Secure link button -->
        <button
          type="button"
          class="btn btn-ghost"
          id="btn-copy-signing-link"
          data-url={clientSigningUrl}
          title="Copy Secure Client Signing Link"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span>Copy Client Link</span>
        </button>

        <!-- PDF Print / Download Button -->
        <a href={`${printPdfUrl}?download=1`} target="_blank" rel="noreferrer" class="btn btn-ghost" title="Print document or download as official PDF">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download PDF / Print</span>
        </a>

        {!providerSig && agreement.status !== 'cancelled' && (
          <button type="button" class="btn btn-primary" id="btn-open-sign-modal">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            <span>Sign on Behalf of Ascelstack</span>
          </button>
        )}

        {!agreement.isImmutable && agreement.status !== 'signed' && (
          <a href={`/admin/agreements/${agreement.id}/edit`} class="btn btn-ghost">
            <span>Edit Agreement</span>
          </a>
        )}
      </div>
    </div>

    <!-- 2 Column Workspace Grid -->
    <div class="planner-workspace-grid">
      <!-- Left Column: Document Viewer & Clauses -->
      <div class="planner-left-pane">
        <!-- Status Switcher Card -->
        <div class="card-panel" style="margin-bottom: 1.5rem;">
          <div class="panel-header" style="margin-bottom: 0.75rem;">
            <div>
              <span class="eyebrow">Status Control</span>
              <h3 class="display h3">Contract Lifecycle State</h3>
            </div>
            <span class={`status-tag status-${agreement.status}`}>
              {statusDisplay[agreement.status] || agreement.status}
            </span>
          </div>

          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
            <select id="quick-status-select" class="field-select" style="min-width: 220px;" disabled={agreement.status === 'signed'}>
              <option value="draft" selected={agreement.status === 'draft'}>Draft (Internal Only)</option>
              <option value="pending_review" selected={agreement.status === 'pending_review'}>Pending Review</option>
              <option value="sent" selected={agreement.status === 'sent'}>Sent to Client</option>
              <option value="viewed" selected={agreement.status === 'viewed'}>Viewed by Client</option>
              <option value="pending_signature" selected={agreement.status === 'pending_signature'}>Pending Signature</option>
              <option value="partially_signed" selected={agreement.status === 'partially_signed'}>Partially Signed</option>
              <option value="signed" selected={agreement.status === 'signed'} disabled>Signed & Immutable</option>
              <option value="rejected" selected={agreement.status === 'rejected'}>Rejected</option>
              <option value="expired" selected={agreement.status === 'expired'}>Expired</option>
              <option value="cancelled" selected={agreement.status === 'cancelled'}>Cancelled</option>
            </select>

            <button
              type="button"
              class="btn btn-sm btn-primary"
              id="btn-update-status"
              data-id={agreement.id}
              disabled={agreement.status === 'signed'}
            >
              Update Status
            </button>
          </div>
          {agreement.isImmutable && (
            <p class="mono text-muted text-xs" style="margin-top: 0.5rem; color: #047857;">
              ✓ Agreement has been electronically signed by both parties and is permanently locked against modification.
            </p>
          )}
        </div>

        <!-- Rendered Document View -->
        <div class="card-panel" style="background: #f8fafc; padding: 2rem 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;">
            <div>
              <span class="mono text-muted text-xs">AGREEMENT DOCUMENT</span>
              <h3 class="display" style="font-size: 1.35rem; margin: 2px 0 0; color: var(--ink);">
                PROFESSIONAL SERVICE AGREEMENT
              </h3>
            </div>
            <a href={printPdfUrl} target="_blank" class="btn btn-sm btn-ghost">
              Open Fullscreen Document ↗
            </a>
          </div>

          <!-- Document Header Preview -->
          <div class="doc-header" style="border-bottom: 2px solid var(--ink); padding-bottom: 1.25rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 1rem;">
              <svg width="42" height="42" viewBox="0 0 100 100" aria-hidden="true">
                <path d="M50 6 L66 38 L34 38 Z" fill="#94BCE3"></path>
                <path d="M32 42 L68 42 L70 46 L80 66 L60 66 L50 46 L40 66 L20 66 L30 46 Z" fill="#5980A6"></path>
                <path d="M18 70 L38 70 L26 94 L6 94 Z M82 70 L62 70 L74 94 L94 94 Z" fill="#1D2D3D"></path>
              </svg>
              <div>
                <strong style="font-family: Georgia, serif; font-size: 1.25rem; color: var(--ink); display: block;">
                  {agreement.providerName}
                </strong>
                <p style="font-size: 0.78rem; color: #555; margin: 2px 0 0;">{agreement.providerAddress}</p>
                <p style="font-size: 0.75rem; color: #64748b; margin: 2px 0 0;">
                  <span>Email: {agreement.providerEmail}</span> · <span>Phone: {agreement.providerPhone}</span>
                  {agreement.providerGstinEnabled && agreement.providerGstin && (
                    <span> · <strong>GSTIN: {agreement.providerGstin}</strong></span>
                  )}
                </p>
              </div>
            </div>

            <div style="text-align: right;">
              <span class="mono" style="font-size: 0.95rem; font-weight: 700; color: var(--accent); display: block;">
                {agreement.agreementNumber}
              </span>
              <span class="mono text-muted text-xs" style="display: block;">
                Created: {new Date(agreement.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>
              <span class="mono text-muted text-xs">Version {agreement.version}</span>
            </div>
          </div>

          <!-- Contracting Parties Box -->
          <div class="doc-parties-grid" style="margin-bottom: 1.5rem;">
            <div class="doc-party-col">
              <h4>SERVICE PROVIDER</h4>
              <strong>{agreement.providerName}</strong>
              <p>{agreement.providerAddress}</p>
              <p style="font-size: 0.78rem; margin-top: 4px;">Signatory: {agreement.providerSignatoryName} ({agreement.providerSignatoryTitle})</p>
            </div>
            <div class="doc-party-col">
              <h4>CLIENT</h4>
              <strong>{agreement.clientName}</strong>
              {agreement.clientCompany && <p>{agreement.clientCompany}</p>}
              <p>{agreement.clientAddress || 'Address on record'}</p>
              <p style="font-size: 0.78rem; margin-top: 4px;">Contact: {agreement.clientEmail} · {agreement.clientPhone || 'N/A'}</p>
            </div>
          </div>

          <!-- All 25 Clauses Accordion -->
          <div style="margin-top: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <h4 class="display h3" style="font-size: 1.15rem;">Contract Clauses ({clauses.length} Sections)</h4>
              <button type="button" class="btn btn-sm btn-ghost" id="btn-toggle-all-view-clauses">
                Toggle All Clauses
              </button>
            </div>

            <div class="clause-list-container" style="gap: 0.5rem;">
              {clauses.map((c, i) => (
                <div class="clause-card" style="background: #ffffff;">
                  <div class="clause-card-header" data-accordion-header={i} style="padding: 0.75rem 1rem;">
                    <div class="clause-card-title" style="font-size: 0.88rem;">
                      <span class="clause-num-tag mono">Sec {String(c.sectionNumber || i + 1).padStart(2, '0')}</span>
                      <span>{c.title}</span>
                    </div>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                  <div class="clause-card-body" id={`accordion-body-${i}`} style="display: none; padding: 1rem; font-size: 0.88rem; line-height: 1.6; color: #334155;">
                    <p style="white-space: pre-line; margin: 0;">{c.content}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Signatures, Commercials & Audit Trail -->
      <div class="planner-right-pane">
        <!-- Signatures Verification Card -->
        <div class="card-panel" style="margin-bottom: 1.5rem;">
          <div class="panel-header" style="margin-bottom: 1rem;">
            <div>
              <span class="eyebrow">Signatures</span>
              <h3 class="display h3" style="font-size: 1.25rem;">Execution Status</h3>
            </div>
          </div>

          <!-- Service Provider Signature -->
          <div class="sig-box" style="margin-bottom: 1rem; min-height: auto;">
            <span class="sig-box-title">SERVICE PROVIDER SIGNATURE</span>
            {providerSig ? (
              <div style="margin: 0.5rem 0;">
                <div class="sig-display-area" style="min-height: 50px;">
                  {providerSig.signatureType === 'drawn' ? (
                    <img src={providerSig.signatureData} alt="Provider Signature" class="sig-drawn-img" />
                  ) : (
                    <span class="sig-typed-font">{providerSig.signatureData}</span>
                  )}
                </div>
                <strong style="display: block; font-size: 0.85rem;">{providerSig.signerName}</strong>
                <span class="sig-meta-line">{providerSig.signerTitle} · {providerSig.signerEmail}</span>
                <span class="sig-meta-line mono">
                  Signed: {new Date(providerSig.signedAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}
                </span>
                {providerSig.ipAddress && (
                  <span class="sig-meta-line mono" style="font-size: 0.65rem;">
                    IP: {providerSig.ipAddress} · Verified IT Act Sec 10A
                  </span>
                )}
              </div>
            ) : (
              <div style="padding: 1rem 0; text-align: center;">
                <p class="text-muted text-xs" style="margin-bottom: 0.75rem;">
                  Awaiting Service Provider authorized countersignature.
                </p>
                <button type="button" class="btn btn-sm btn-primary" id="btn-trigger-provider-sign">
                  Affix Provider Signature
                </button>
              </div>
            )}
          </div>

          <!-- Client Signature -->
          <div class="sig-box" style="min-height: auto;">
            <span class="sig-box-title">CLIENT ELECTRONIC SIGNATURE</span>
            {clientSig ? (
              <div style="margin: 0.5rem 0;">
                <div class="sig-display-area" style="min-height: 50px;">
                  {clientSig.signatureType === 'drawn' ? (
                    <img src={clientSig.signatureData} alt="Client Signature" class="sig-drawn-img" />
                  ) : (
                    <span class="sig-typed-font">{clientSig.signatureData}</span>
                  )}
                </div>
                <strong style="display: block; font-size: 0.85rem;">{clientSig.signerName}</strong>
                <span class="sig-meta-line">{clientSig.signerTitle || 'Client Representative'} · {clientSig.signerEmail}</span>
                <span class="sig-meta-line mono">
                  Signed: {new Date(clientSig.signedAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}
                </span>
                {clientSig.ipAddress && (
                  <span class="sig-meta-line mono" style="font-size: 0.65rem;">
                    IP: {clientSig.ipAddress} · Consent Checkbox Recorded
                  </span>
                )}
              </div>
            ) : (
              <div style="padding: 1rem 0; text-align: center;">
                <p class="text-muted text-xs" style="margin-bottom: 0.75rem;">
                  Client has not yet affixed an electronic signature.
                </p>
                <button
                  type="button"
                  class="btn btn-sm btn-ghost"
                  id="btn-copy-client-link-side"
                  data-url={clientSigningUrl}
                >
                  Copy Secure Client Signing Link
                </button>
              </div>
            )}
          </div>
        </div>

        <!-- Commercials Summary Card -->
        <div class="card-panel" style="margin-bottom: 1.5rem;">
          <div class="panel-header" style="margin-bottom: 0.75rem;">
            <div>
              <span class="eyebrow">Financials</span>
              <h3 class="display h3" style="font-size: 1.25rem;">Payment Terms</h3>
            </div>
          </div>

          <div style="display: grid; gap: 0.75rem; font-size: 0.88rem;">
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--line);">
              <span class="text-muted">Total Contract Value:</span>
              <strong class="mono" style="color: var(--ink); font-size: 1rem;">
                {formatCurrency(agreement.totalAmount, agreement.currency)}
              </strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--line);">
              <span class="text-muted">Advance Deposit ({agreement.advancePercentage}%):</span>
              <strong class="mono text-warn">
                {formatCurrency(agreement.advanceAmount, agreement.currency)}
              </strong>
            </div>

            <div style="display: flex; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--line);">
              <span class="text-muted">Remaining Balance:</span>
              <strong class="mono">
                {formatCurrency(Number(agreement.totalAmount) - Number(agreement.advanceAmount), agreement.currency)}
              </strong>
            </div>

            {agreement.timeline && (
              <div style="padding-top: 0.25rem;">
                <span class="text-muted text-xs mono" style="display: block;">DELIVERY TIMELINE:</span>
                <span>{agreement.timeline}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Chronological Audit Trail -->
        <div class="card-panel">
          <div class="panel-header" style="margin-bottom: 0.75rem;">
            <div>
              <span class="eyebrow">Audit Trail</span>
              <h3 class="display h3" style="font-size: 1.25rem;">Activity History</h3>
            </div>
            <span class="mono text-muted text-xs">{auditLogs.length} events</span>
          </div>

          <div class="activity-feed" style="max-height: 380px; overflow-y: auto;">
            {auditLogs.map((log) => (
              <div class="activity-item">
                <div class="activity-bullet"></div>
                <div class="activity-body">
                  <p class="activity-desc" style="font-size: 0.85rem;">{log.description}</p>
                  <span class="mono activity-time" style="font-size: 0.72rem;">
                    {new Date(log.createdAt).toLocaleDateString('en-IN', {
                      month: 'short',
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit',
                    })}
                    {log.performedBy && ` · ${log.performedBy}`}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MODAL: PROVIDER SIGNATURE MODAL -->
  <!-- ============================================================== -->
  <div class="modal-backdrop" id="provider-sign-modal" style="display: none; position: fixed; inset: 0; background: rgba(10, 18, 28, 0.7); z-index: 100; align-items: center; justify-content: center; padding: 1.5rem;">
    <div class="card-panel" style="max-width: 520px; width: 100%; background: #ffffff; padding: 2rem; border-radius: var(--radius); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem;">
        <div>
          <span class="eyebrow">Service Provider Signatory</span>
          <h3 class="display h3" style="margin-top: 2px;">Sign Agreement</h3>
        </div>
        <button type="button" class="btn btn-sm btn-ghost" id="btn-close-sign-modal" style="font-size: 1.25rem; line-height: 1;">✕</button>
      </div>

      <form id="provider-sign-form">
        <div class="form-row">
          <label class="field">
            <span class="mono">Signatory Name *</span>
            <input type="text" id="signSignerName" value={agreement.providerSignatoryName} required />
          </label>
          <label class="field">
            <span class="mono">Designation / Title *</span>
            <input type="text" id="signSignerTitle" value={agreement.providerSignatoryTitle} required />
          </label>
        </div>

        <!-- Signature Mode: Type vs Draw -->
        <div class="field">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span class="mono">Signature Format</span>
            <div style="display: flex; gap: 0.25rem;">
              <button type="button" class="tab-pill is-on btn-sm" id="btn-mode-typed">Type Name</button>
              <button type="button" class="tab-pill btn-sm" id="btn-mode-drawn">Draw with Mouse/Pen</button>
            </div>
          </div>

          <!-- Type Signature Box -->
          <div id="sign-box-typed">
            <input type="text" id="typedSignature" value={agreement.providerSignatoryName} style="font-family: 'Brush Script MT', cursive; font-size: 1.85rem; padding: 0.75rem; text-align: center;" />
            <span class="text-muted text-xs mono" style="display: block; text-align: center; margin-top: 4px;">Cursive digital script execution</span>
          </div>

          <!-- Draw Signature Box -->
          <div id="sign-box-drawn" style="display: none;">
            <div class="sig-canvas-wrap">
              <canvas id="sign-canvas" width="460" height="150" class="sig-canvas"></canvas>
              <span class="sig-canvas-hint" id="canvas-hint">Sign here using mouse or touch</span>
            </div>
            <div style="text-align: right; margin-top: 4px;">
              <button type="button" class="text-link mono text-xs" id="btn-clear-canvas">Clear Signature</button>
            </div>
          </div>
        </div>

        <div class="field" style="margin-top: 1rem;">
          <label style="display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.82rem; cursor: pointer; color: #475569;">
            <input type="checkbox" id="providerConsent" required checked style="width: 16px; height: 16px; margin-top: 2px;" />
            <span>I confirm that I am an authorized corporate signatory of {agreement.providerName} and legally execute this Professional Service Agreement under Section 10A of the Information Technology Act, 2000.</span>
          </label>
        </div>

        <div class="form-footer" style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
          <button type="button" class="btn btn-ghost" id="btn-cancel-sign-modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="btn-confirm-sign">
            <span>Execute & Sign</span>
            <span class="arrow">✓</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Toast Hub -->
  <div class="toast-hub" id="toast-hub" aria-live="polite"></div>
</AdminLayout>

<script is:inline define:vars={{ agreementId: agreement.id }}>
  function showToast(message, type = 'success') {
    const hub = document.getElementById('toast-hub');
    if (!hub) return;
    const toast = document.createElement('div');
    toast.className = `toast-item toast-${type}`;
    toast.innerHTML = `<span>${message}</span>`;
    hub.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('fade-out');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // Copy Agreement Code Handlers
  document.querySelectorAll('#btn-copy-agreement-code, [data-action="copy-agreement-code"]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        showToast(`Agreement Code "${code}" copied! Send this code to client to enter in their portal.`);
      } catch {
        prompt('Copy client agreement code:', code);
      }
    });
  });

  // Copy Link Handlers
  document.querySelectorAll('#btn-copy-signing-link, #btn-copy-client-link-side').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        showToast('Secure signing link copied to clipboard!');
      } catch {
        prompt('Copy client signing link:', url);
      }
    });
  });

  // Accordion Toggle for Clauses
  document.querySelectorAll('[data-accordion-header]').forEach((hdr) => {
    hdr.addEventListener('click', () => {
      const idx = hdr.getAttribute('data-accordion-header');
      const body = document.getElementById(`accordion-body-${idx}`);
      if (body) {
        body.style.display = body.style.display === 'none' ? 'block' : 'none';
      }
    });
  });

  let allOpen = false;
  document.getElementById('btn-toggle-all-view-clauses')?.addEventListener('click', () => {
    allOpen = !allOpen;
    document.querySelectorAll('[id^="accordion-body-"]').forEach((b) => {
      b.style.display = allOpen ? 'block' : 'none';
    });
  });

  // Update Status Handler
  document.getElementById('btn-update-status')?.addEventListener('click', async () => {
    const statusSelect = document.getElementById('quick-status-select');
    const newStatus = statusSelect?.value;
    if (!newStatus) return;

    try {
      const res = await fetch(`/api/admin/agreements/${agreementId}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to update status');

      showToast(`Status updated to "${newStatus}"!`);
      setTimeout(() => window.location.reload(), 800);
    } catch (err) {
      alert(`Error updating status: ${err.message}`);
    }
  });

  // Provider Sign Modal Management
  const modal = document.getElementById('provider-sign-modal');
  const openModal = () => {
    if (modal) modal.style.display = 'flex';
  };
  const closeModal = () => {
    if (modal) modal.style.display = 'none';
  };

  document.getElementById('btn-open-sign-modal')?.addEventListener('click', openModal);
  document.getElementById('btn-trigger-provider-sign')?.addEventListener('click', openModal);
  document.getElementById('btn-close-sign-modal')?.addEventListener('click', closeModal);
  document.getElementById('btn-cancel-sign-modal')?.addEventListener('click', closeModal);

  // Type vs Draw Mode
  let sigMode = 'typed';
  const btnTyped = document.getElementById('btn-mode-typed');
  const btnDrawn = document.getElementById('btn-mode-drawn');
  const boxTyped = document.getElementById('sign-box-typed');
  const boxDrawn = document.getElementById('sign-box-drawn');
  const canvas = document.getElementById('sign-canvas');
  const hint = document.getElementById('canvas-hint');

  btnTyped?.addEventListener('click', () => {
    sigMode = 'typed';
    btnTyped.classList.add('is-on');
    btnDrawn?.classList.remove('is-on');
    boxTyped.style.display = 'block';
    boxDrawn.style.display = 'none';
  });

  btnDrawn?.addEventListener('click', () => {
    sigMode = 'drawn';
    btnDrawn.classList.add('is-on');
    btnTyped?.classList.remove('is-on');
    boxDrawn.style.display = 'block';
    boxTyped.style.display = 'none';
  });

  // Canvas Drawing Logic
  let isDrawing = false;
  let hasDrawn = false;
  const ctx = canvas?.getContext('2d');

  function startDraw(e) {
    isDrawing = true;
    hasDrawn = true;
    if (hint) hint.style.display = 'none';
    const pos = getPos(e);
    ctx?.beginPath();
    ctx?.moveTo(pos.x, pos.y);
  }

  function draw(e) {
    if (!isDrawing || !ctx) return;
    const pos = getPos(e);
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.strokeStyle = '#0f172a';
    ctx.lineTo(pos.x, pos.y);
    ctx.stroke();
  }

  function stopDraw() {
    isDrawing = false;
  }

  function getPos(e) {
    const rect = canvas.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    return {
      x: clientX - rect.left,
      y: clientY - rect.top,
    };
  }

  if (canvas) {
    canvas.addEventListener('mousedown', startDraw);
    canvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', stopDraw);

    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      startDraw(e);
    });
    canvas.addEventListener('touchmove', (e) => {
      e.preventDefault();
      draw(e);
    });
    canvas.addEventListener('touchend', stopDraw);
  }

  document.getElementById('btn-clear-canvas')?.addEventListener('click', () => {
    if (ctx && canvas) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasDrawn = false;
      if (hint) hint.style.display = 'block';
    }
  });

  // Provider Sign Form Submission
  document.getElementById('provider-sign-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const signerName = document.getElementById('signSignerName')?.value.trim();
    const signerTitle = document.getElementById('signSignerTitle')?.value.trim();
    let signatureData = '';

    if (sigMode === 'typed') {
      signatureData = document.getElementById('typedSignature')?.value.trim();
      if (!signatureData) {
        alert('Please enter your signature name');
        return;
      }
    } else {
      if (!hasDrawn || !canvas) {
        alert('Please draw your signature on the pad');
        return;
      }
      signatureData = canvas.toDataURL('image/png');
    }

    const confirmBtn = document.getElementById('btn-confirm-sign');
    if (confirmBtn) confirmBtn.disabled = true;

    try {
      const res = await fetch(`/api/admin/agreements/${agreementId}/sign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          signerName,
          signerTitle,
          signatureType: sigMode,
          signatureData,
        }),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to sign agreement');

      showToast('Agreement successfully signed on behalf of Ascelstack!');
      closeModal();
      setTimeout(() => window.location.reload(), 800);
    } catch (err) {
      alert(`Signature Error: ${err.message}`);
      if (confirmBtn) confirmBtn.disabled = false;
    }
  });
</script>
