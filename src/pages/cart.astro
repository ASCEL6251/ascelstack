---
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getAuthenticatedUser } from '../lib/auth';

const authData = await getAuthenticatedUser(Astro);
const serverUser = authData
  ? {
      id: authData.user.id,
      email: authData.user.email,
      name: authData.user.fullName || authData.user.email,
      company: authData.business?.businessName,
      createdAt: authData.user.createdAt ? new Date(authData.user.createdAt).getTime() : Date.now(),
    }
  : null;
---

<Base title="Your estimate" description="Build a project estimate from Ascelstack services and packages.">
  <section class="est">
    <div class="wrap">
      <header class="est-head">
        <div>
          <p class="eyebrow">Your estimate</p>
          <h1 class="display h2">What your project <em>should cost.</em></h1>
        </div>
      </header>

      <div class="est-grid">
        <div class="est-lines" data-lines aria-live="polite"></div>

        <aside class="est-sum" data-summary>
          <div class="sum-card">
            <h2 class="mono sum-title">Summary</h2>
            <div data-totals></div>
            <div data-onquote></div>
            <ul class="sum-fine">
              <li>All prices exclude 18% GST, shown separately.</li>
              <li>Govt fees, stamp duty, ad spend, licences and API usage are billed at actuals.</li>
              <li data-starting-note hidden>"From" items are starting prices; final cost depends on scope.</li>
            </ul>
            <div class="sum-act" data-actions></div>
          </div>
          <p class="proto-note live-note">
            <strong>LIVE SYNC</strong>
            <span>Submitting your estimate automatically creates service requests in your Ascelstack Client Portal.</span>
          </p>
        </aside>
      </div>
    </div>
  </section>
  <script id="server-auth-data" type="application/json" set:html={JSON.stringify(serverUser)}></script>
</Base>

<style>
  .est { padding: calc(var(--nav-h) + clamp(2rem, 5vw, 4rem)) 0 clamp(4rem, 8vw, 7rem); }
  .est-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem 2rem;
    flex-wrap: wrap;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .est-head > div:first-child { display: grid; gap: 1rem; }
  .est-head h1 { font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem); }

  .est-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 2rem; align-items: start; }
  .est-sum { position: sticky; top: calc(var(--nav-h) + 1rem); display: grid; gap: 1rem; }

  .est-lines { display: grid; gap: 0.75rem; }
  .est-lines :global(.line) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.9rem 1.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .est-lines :global(.line-main) { display: grid; gap: 0.35rem; min-width: 0; }
  .est-lines :global(.line-meta) { color: var(--text-muted); }
  .est-lines :global(.line-name) { font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
  .est-lines :global(.line-unit) { font-size: 0.875rem; color: var(--text-muted); }
  .est-lines :global(.line-market) { font-size: 0.78rem; color: var(--text-muted); opacity: 0.85; }
  .est-lines :global(.line-note) { font-size: 0.78rem; color: var(--accent); }
  .est-lines :global(.line-total) { text-align: right; display: grid; gap: 0.2rem; align-content: start; }
  .est-lines :global(.line-total strong) {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.25rem;
    white-space: nowrap;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  .est-lines :global(.line-total .mono) { color: var(--text-muted); }
  .est-lines :global(.line-ctrl) {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--line);
  }
  .est-lines :global(.line-ctrl select) {
    padding: 0.4rem 0.65rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    max-width: 100%;
  }
  .est-lines :global(.qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--paper);
    overflow: hidden;
  }
  .est-lines :global(.qty button) {
    width: 28px;
    height: 28px;
    border: 0;
    background: none;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .est-lines :global(.qty button:hover) { background: var(--paper-sunk); }
  .est-lines :global(.qty input) {
    width: 44px;
    height: 28px;
    border: 0;
    border-inline: 1px solid var(--line);
    text-align: center;
    font-size: 0.85rem;
    background: none;
    -moz-appearance: textfield;
  }
  .est-lines :global(.qty input::-webkit-outer-spin-button),
  .est-lines :global(.qty input::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }
  .est-lines :global(.qty-label) { font-size: 0.78rem; color: var(--text-muted); }
  .est-lines :global(.line-remove) {
    margin-left: auto;
    background: none;
    border: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
  }
  .est-lines :global(.line-remove:hover) { color: #9a3b2e; }

  .est-lines :global(.empty) {
    display: grid;
    gap: 1rem;
    padding: clamp(2rem, 5vw, 4rem);
    background: var(--paper-raised);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    text-align: center;
    place-items: center;
    max-width: 480px;
    margin: 2rem auto;
  }
  .est-lines :global(.empty p) { color: var(--text-muted); max-width: 38ch; }

  .sum-card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
  }
  .sum-title { color: var(--text-on-ink-muted); text-transform: uppercase; }
  .sum-card :global(.grp) { display: grid; gap: 0.35rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line-on-ink); }
  .sum-card :global(.grp-row) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-on-ink-muted);
  }
  .sum-card :global(.grp-row span:last-child) {
    font-family: var(--font-body);
    font-weight: 700;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  .sum-card :global(.grp-head) { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tint); }
  .sum-card :global(.grp-total) {
    font-family: var(--font-body);
    color: var(--paper);
    font-size: 1.05rem;
    font-weight: 800;
  }
  .sum-card :global(.grp-total span:last-child) {
    font-family: var(--font-body);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  .sum-card :global(.grp-total small) { font-size: 0.6em; font-weight: 600; color: var(--text-on-ink-muted); }
  .sum-card :global(.oq) { display: grid; gap: 0.35rem; font-size: 0.85rem; color: var(--text-on-ink-muted); }
  .sum-card :global(.oq strong) { color: var(--paper); font-size: 0.8rem; }
  .sum-fine { display: grid; gap: 0.3rem; font-size: 0.75rem; color: var(--text-on-ink-muted); list-style: disc; padding-left: 1rem; }
  .sum-act { display: grid; gap: 0.6rem; }
  .sum-act :global(.btn) { justify-content: center; --bg: var(--paper); --fg: var(--ink); }
  .sum-act :global(.btn:hover) { --bg: var(--tint); }
  .sum-act :global(.btn[disabled]) { opacity: 0.5; pointer-events: none; }
  .sum-act :global(.ghost) {
    padding: 0.7rem;
    border: 1px solid var(--line-on-ink);
    border-radius: 999px;
    background: none;
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
  }
  .sum-act :global(.ghost:hover) {
    background: rgba(242, 242, 243, 0.08);
    border-color: var(--tint);
  }
  .sum-act :global(textarea) {
    width: 100%;
    min-height: 70px;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--line-on-ink);
    border-radius: var(--radius-s);
    background: var(--ink-raised);
    color: var(--paper);
    font-size: 0.875rem;
    resize: vertical;
  }
  .sum-act :global(.who) { font-size: 0.8rem; color: var(--text-on-ink-muted); }

  .sum-act :global(.user-badge-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    background: rgba(242, 242, 243, 0.08);
    border: 1px solid var(--line-on-ink);
    border-radius: var(--radius-s);
    margin-top: 0.25rem;
  }
  .sum-act :global(.user-status) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .sum-act :global(.user-dot) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #16a34a;
    flex: none;
    box-shadow: 0 0 0 2px rgba(22, 163, 74, 0.3);
  }
  .sum-act :global(.user-email) {
    font-size: 0.78rem;
    color: var(--text-on-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sum-act :global(.switch-link) {
    font-size: 0.74rem;
    color: var(--tint);
    text-decoration: underline;
    text-underline-offset: 2px;
    flex: none;
  }
  .sum-act :global(.switch-link:hover) {
    color: var(--paper);
  }

  @media (max-width: 960px) {
    .est-grid { grid-template-columns: 1fr; }
    .est-sum { position: static; }
  }
  @media (max-width: 520px) {
    .est-lines :global(.line) { grid-template-columns: 1fr; padding: 1rem; }
    .est-lines :global(.line-total) { text-align: left; }
    .sum-card { padding: 1.25rem 1rem; }
  }

  @media print {
    :global(.nav), :global(.footer), :global(footer), :global(.toast), .sum-act, .proto-note, .est-lines :global(.line-ctrl) { display: none !important; }
    .est-grid { grid-template-columns: 1fr; }
    .sum-card { background: none; color: var(--ink); border: 1px solid var(--line); }
  }
</style>

<script>
  import { onCart, getCart, setQty, removeItem, setPackage, clearCart } from '../lib/cart';
  import { buildEstimate } from '../lib/estimate';
  import { RECURRENCE_LABEL, RECURRENCE_SUFFIX } from '../lib/pricing';
  import { convertPriceText, formatMoney, getCurrency, onCurrency } from '../lib/currency';
  import { getUser, onAuth, setCachedUser } from '../lib/mock-auth';
  import { submitEstimate } from '../lib/api';
  import '../scripts/realtime-pricing';

  const linesEl = document.querySelector<HTMLElement>('[data-lines]')!;
  const totalsEl = document.querySelector<HTMLElement>('[data-totals]')!;
  const onQuoteEl = document.querySelector<HTMLElement>('[data-onquote]')!;
  const actionsEl = document.querySelector<HTMLElement>('[data-actions]')!;
  const startingNote = document.querySelector<HTMLElement>('[data-starting-note]')!;

  // Seed server-authenticated user immediately from SSR payload
  try {
    const rawData = document.getElementById('server-auth-data')?.textContent;
    if (rawData) {
      const parsed = JSON.parse(rawData);
      if (parsed && parsed.email) {
        setCachedUser(parsed);
      }
    }
  } catch (e) {}

  // Also query sync endpoint to handle fresh client sessions
  fetch('/api/customer/sync')
    .then((r) => r.ok ? r.json() : null)
    .then((data) => {
      if (data?.user) {
        setCachedUser({
          id: data.user.id,
          name: data.user.fullName || data.user.email,
          email: data.user.email,
          company: data.business?.businessName,
          createdAt: data.user.createdAt ? new Date(data.user.createdAt).getTime() : Date.now(),
        });
      }
    })
    .catch(() => {});

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  let note = '';
  let busy = false;

  let shownCurrency = '';
  function render() {
    shownCurrency = getCurrency();
    const cart = getCart();
    const est = buildEstimate(cart);

    if (!est.lines.length) {
      linesEl.innerHTML = `<div class="empty">
        <h2 class="display h3">Your estimate is empty.</h2>
        <p>Browse our services and tap <strong>Add to estimate</strong> or <strong>Choose package</strong>. Totals update here as you go.</p>
        <a class="btn" href="/services">Browse services <span class="arrow">→</span></a>
      </div>`;
    } else {
      linesEl.innerHTML = est.lines
        .map((l) => {
          const q = l.quote;
          const p = l.pricing;
          const suffix = RECURRENCE_SUFFIX[q.recurrence];
          const unitPrice = q.price === null ? esc(convertPriceText(q.text || 'On quote')) : `${q.isStarting ? 'From ' : ''}${formatMoney(q.price)}${suffix}${q.per ? ` per ${esc(q.per)}` : ''}`;
          const pkgSelect = p.packages
            ? `<select data-pkg aria-label="Package">${p.packages
                .map((k) => `<option value="${esc(k.key)}"${k.key === l.pkg ? ' selected' : ''}>${esc(k.name)} — ${k.price === null ? 'On quote' : formatMoney(k.price)}</option>`)
                .join('')}</select>`
            : '';
          const pkg = p.packages?.find((k) => k.key === l.pkg);
          const detail = p.type === 'package' ? '' : (p['small']?.detail || '');
          return `<article class="line" data-id="${l.id}" data-pkg-key="${esc(l.pkg ?? '')}">
            <div class="line-main">
              <span class="mono line-meta">${l.id} · ${esc(l.category)}</span>
              <h3 class="line-name">${esc(l.name)}</h3>
              <span class="line-unit">${esc(q.label)} · ${unitPrice}</span>
              ${pkg ? `<span class="line-unit">${esc(convertPriceText(pkg.includes))} · ${esc(pkg.delivery)}</span>` : detail ? `<span class="line-unit">${esc(convertPriceText(detail))}</span>` : ''}
              ${p.market ? `<span class="line-market">India market rate: ${esc(convertPriceText(p.market))}</span>` : ''}
              ${p.notes ? `<span class="line-note">${esc(convertPriceText(p.notes))}</span>` : ''}
            </div>
            <div class="line-total">
              <strong>${l.total === null ? 'On quote' : formatMoney(l.total) + suffix}</strong>
              <span class="mono">${RECURRENCE_LABEL[q.recurrence]}${l.qty > 1 && q.price !== null ? ` · ${l.qty} × ${formatMoney(q.price)}` : ''}</span>
            </div>
            <div class="line-ctrl">
              ${pkgSelect}
              <span class="qty">
                <button type="button" data-dec aria-label="Decrease">−</button>
                <input type="number" min="1" max="999" value="${l.qty}" data-qty aria-label="Quantity" />
                <button type="button" data-inc aria-label="Increase">+</button>
              </span>
              <span class="qty-label">${q.per ? esc(q.per) + (l.qty > 1 ? 's' : '') : 'qty'}</span>
              <button type="button" class="line-remove" data-remove>Remove</button>
            </div>
          </article>`;
        })
        .join('');
    }

    totalsEl.innerHTML = est.groups.length
      ? est.groups
          .map(
            (g) => `<div class="grp">
              <span class="grp-head">${RECURRENCE_LABEL[g.recurrence]}</span>
              <div class="grp-row"><span>Subtotal</span><span>${formatMoney(g.subtotal)}</span></div>
              <div class="grp-row"><span>GST 18%</span><span>${formatMoney(g.gst)}</span></div>
              <div class="grp-row grp-total"><span>Total${RECURRENCE_SUFFIX[g.recurrence] ? ` ${RECURRENCE_SUFFIX[g.recurrence]}` : ''}</span><span>${est.hasStarting ? '<small>from </small>' : ''}${formatMoney(g.total)}</span></div>
            </div>`,
          )
          .join('')
      : `<p class="grp-row">Add services to see totals.</p>`;

    onQuoteEl.innerHTML = est.onQuote.length
      ? `<div class="oq"><strong>+ ${est.onQuote.length} item${est.onQuote.length > 1 ? 's' : ''} priced on quote</strong>${est.onQuote
          .map((l) => `<span>${esc(l.name)} — ${esc(convertPriceText(l.quote.text || 'custom quote'))}</span>`)
          .join('')}</div>`
      : '';
    startingNote.hidden = !est.hasStarting;
    renderActions(est.lines.length > 0);
  }

  function renderActions(hasItems: boolean) {
    const user = getUser();
    if (!hasItems) {
      actionsEl.innerHTML = `<a class="btn" href="/services">Browse services <span class="arrow">→</span></a>`;
      return;
    }
    if (!user) {
      actionsEl.innerHTML = `<a class="btn" href="/login?redirect=/cart">Sign in to submit <span class="arrow">→</span></a>
        <a class="ghost" href="/sign-up?redirect=/cart">Create an account</a>
        <button type="button" class="ghost" data-print>Print / save as PDF</button>`;
      return;
    }
    actionsEl.innerHTML = `<label class="who" for="est-note">Anything we should know? <em>(optional)</em></label>
      <textarea id="est-note" data-note placeholder="Timeline, budget, requirements, links…">${esc(note)}</textarea>
      <button type="button" class="btn" data-submit ${busy ? 'disabled' : ''}>${busy ? 'Submitting to Portal…' : 'Submit estimate'} <span class="arrow">→</span></button>
      <button type="button" class="ghost" data-print>Print / save as PDF</button>
      <div class="user-badge-bar">
        <div class="user-status">
          <span class="user-dot"></span>
          <span class="user-email">Signed in as <strong>${esc(user.email)}</strong></span>
        </div>
        <a href="/login?redirect=/cart" class="switch-link">Switch</a>
      </div>`;
  }

  // ---- events (delegated, survive re-render)
  linesEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const line = t.closest<HTMLElement>('.line');
    if (!line) return;
    const id = line.dataset.id!;
    const pkg = line.dataset.pkgKey || undefined;
    const qty = Number(line.querySelector<HTMLInputElement>('[data-qty]')!.value);
    if (t.closest('[data-inc]')) setQty(id, pkg, qty + 1);
    else if (t.closest('[data-dec]')) qty <= 1 ? removeItem(id, pkg) : setQty(id, pkg, qty - 1);
    else if (t.closest('[data-remove]')) removeItem(id, pkg);
  });
  linesEl.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement;
    const line = t.closest<HTMLElement>('.line');
    if (!line) return;
    const id = line.dataset.id!;
    const pkg = line.dataset.pkgKey || undefined;
    if (t.matches('[data-qty]')) setQty(id, pkg, Number(t.value));
    if (t.matches('[data-pkg]')) setPackage(id, pkg, t.value);
  });

  actionsEl.addEventListener('input', (e) => {
    if ((e.target as HTMLElement).matches('[data-note]')) note = (e.target as HTMLTextAreaElement).value;
  });
  actionsEl.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-print]')) return window.print();
    if (!t.closest('[data-submit]') || busy) return;
    const user = getUser();
    if (!user) {
      location.href = '/login?redirect=/cart';
      return;
    }
    busy = true;
    renderActions(true);
    try {
      await submitEstimate(user, getCart(), note);
      clearCart();
      location.href = '/dashboard#my-services';
    } catch (err: any) {
      alert(err.message || 'Failed to submit estimate');
      busy = false;
      renderActions(true);
    }
  });

  onCart(render);
  // Totals are summed in the base currency, then converted once for display.
  onCurrency((c) => {
    if (c !== shownCurrency) render();
  });
  onAuth(() => renderActions(getCart().items.length > 0));
  window.addEventListener('ascel:pricing-update', () => render());
</script>
