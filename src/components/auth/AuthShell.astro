---
// Shared frame for /sign-in and /sign-up. Placeholder until Clerk's
// <SignIn /> / <SignUp /> components replace the form in the slot.
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="auth">
  <div class="wrap auth-grid">
    <div class="auth-side">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="display h2" set:html={title} />
      <p class="lead">{lead}</p>
      <ul class="auth-points">
        <li><span class="mono">01</span> Pick services and packages into one estimate</li>
        <li><span class="mono">02</span> See live totals against 2026 India market rates</li>
        <li><span class="mono">03</span> Submit it — our team confirms scope and final quote</li>
      </ul>
    </div>
    <div class="auth-card">
      <slot />
      <p class="proto-note">
        <strong>PROTOTYPE</strong>
        <span>Mock sign-in. Accounts are saved only in this browser and no password is stored. Clerk will replace this.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .auth { padding: calc(var(--nav-h) + clamp(2.5rem, 6vw, 5rem)) 0 clamp(4rem, 8vw, 7rem); }
  .auth-grid { display: grid; grid-template-columns: 1fr minmax(0, 460px); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .auth-side { display: grid; gap: 1.25rem; padding-top: 1rem; }
  .auth-side :global(em) { font-style: italic; color: var(--accent); }
  .auth-points { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .auth-points li { display: flex; gap: 0.9rem; align-items: baseline; color: var(--text-muted); }
  .auth-points .mono { color: var(--accent); }
  .auth-card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    box-shadow: 0 30px 60px -40px rgba(29, 45, 61, 0.45);
  }
  .auth-card :global(form) { display: grid; gap: 1rem; }
  .auth-card :global(.auth-alt) { font-size: 0.9rem; color: var(--text-muted); }
  .auth-card :global(.auth-alt a) { color: var(--accent); font-weight: 600; }
  .auth-card :global(.btn) { justify-content: center; }
  @media (max-width: 860px) {
    .auth-grid { grid-template-columns: 1fr; }
    .auth-points { display: none; }
  }
</style>
