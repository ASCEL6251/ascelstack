---
import { ICONS, KIND_INFO } from '../../data/workflows';
const kinds = ['trigger', 'agent', 'tool', 'if', 'action', 'report'] as const;
---

<section class="an section" aria-labelledby="an-title">
  <div class="wrap">
    <header class="an-head">
      <p class="eyebrow" data-reveal>Anatomy of a workflow</p>
      <h2 id="an-title" class="display h2" data-reveal>Six parts. <em>Every flow</em> is built from them.</h2>
      <p class="lead" data-reveal>
        Each node is readable on its own, so you can open any step and see exactly what it did and why.
      </p>
    </header>

    <ol class="an-grid">
      {
        kinds.map((k, i) => (
          <li class:list={['an-card', `an-card--${k}`]} data-reveal data-reveal-delay={(i % 3) * 0.06}>
            <span class="an-tile" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26">
                <path d={ICONS[KIND_INFO[k].icon]} />
              </svg>
            </span>
            <span class="mono an-n">0{i + 1}</span>
            <h3 class="display h3">{KIND_INFO[k].name}</h3>
            <p>{KIND_INFO[k].text}</p>
          </li>
        ))
      }
    </ol>

    <div class="an-legend" data-reveal>
      <span class="mono">Node marker</span>
      <span class="an-strata"><i class="on b"></i><i></i><i></i></span> Build layer
      <span class="an-strata"><i></i><i class="on g"></i><i></i></span> Grow layer
      <span class="an-strata"><i></i><i></i><i class="on r"></i></span> Run layer
    </div>
  </div>
</section>

<style>
  .an-head { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 6vw, 4rem); max-width: 50rem; }
  .an-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    overflow: hidden;
  }
  .an-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper-raised);
    transition: background 0.4s;
  }
  .an-card:hover { background: #fff; }
  .an-tile {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 0.5rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid var(--line);
    background-image: radial-gradient(var(--line) 1px, transparent 1.4px);
    background-size: 8px 8px;
  }
  .an-card--trigger .an-tile { border-radius: 28px 14px 14px 28px; border-color: var(--accent); }
  .an-card--agent .an-tile { width: 96px; border-color: var(--accent); }
  .an-card--tool .an-tile { border-radius: 50%; border-style: dashed; }
  .an-card--if .an-tile { border-style: dashed; }
  .an-tile path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .an-card--trigger .an-tile path,
  .an-card--agent .an-tile path { stroke: var(--accent); }
  .an-n { position: absolute; top: 1.5rem; right: 1.5rem; color: var(--text-muted); }
  .an-card p { color: var(--text-muted); font-size: 0.95rem; }

  .an-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.25rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .an-legend .mono { text-transform: uppercase; color: var(--accent); margin-right: 0.5rem; }
  .an-strata { display: inline-grid; gap: 2px; justify-items: center; margin-right: -0.6rem; vertical-align: middle; }
  .an-strata i { display: block; height: 2px; border-radius: 1px; background: var(--mist); }
  .an-strata i:nth-child(1) { width: 6px; }
  .an-strata i:nth-child(2) { width: 10px; }
  .an-strata i:nth-child(3) { width: 14px; }
  .an-strata i.on.b { background: var(--tint); }
  .an-strata i.on.g { background: var(--accent); }
  .an-strata i.on.r { background: var(--ink); }

  @media (max-width: 900px) {
    .an-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .an-grid { grid-template-columns: 1fr; }
  }
</style>
