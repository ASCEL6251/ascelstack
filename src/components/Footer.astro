---
import Logo from './Logo.astro';
import { coreCategories, counts } from '../data/catalog';
const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo tone="light" size={40} />
        <p class="footer-tag">
          One stack for the whole business. {counts.core} services live today, more on the way.
        </p>
        <a href="mailto:support@ascelstack.com" class="footer-mail">support@ascelstack.com</a>
      </div>

      <div class="footer-cols">
        <div>
          <p class="mono footer-h">Services</p>
          <ul>
            {coreCategories.map((c) => <li><a href={`/services/${c.slug}`}>{c.short}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="mono footer-h">Company</p>
          <ul>
            <li><a href="/about">About us</a></li>
            <li><a href="/automation">Automation studio</a></li>
            <li><a href="/#process">Process</a></li>
            <li><a href="/#industries">Industries</a></li>
            <li><a href="/contact">Contact us</a></li>
          </ul>
        </div>
        <div>
          <p class="mono footer-h">Legal & Trust</p>
          <ul>
            <li><a href="/privacy">Privacy policy</a></li>
            <li><a href="/terms">Terms & conditions</a></li>
            <li><a href="/contact">Support & security</a></li>
          </ul>
        </div>
      </div>
    </div>

    <p class="footer-giant display" aria-hidden="true" data-giant>
      {'Ascelstack'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
    </p>

    <div class="footer-bottom mono">
      <span>© {year} Ascelstack Technologies</span>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy</a>
        <span>·</span>
        <a href="/terms">Terms</a>
        <span>·</span>
        <a href="/contact">Contact</a>
      </div>
      <span>Build · Grow · Run</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 3rem;
  }
  .footer-tag {
    margin-top: 1.5rem;
    max-width: 32ch;
    color: var(--text-on-ink-muted);
  }
  .footer-mail {
    display: inline-block;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-bottom: 1px solid var(--line-on-ink);
    transition: border-color 0.3s, color 0.3s;
  }
  .footer-mail:hover { color: var(--tint); border-color: var(--tint); }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .footer-h {
    color: var(--tint);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
  .footer-cols li { margin-bottom: 0.55rem; }
  .footer-cols a {
    color: var(--text-on-ink-muted);
    transition: color 0.2s;
  }
  .footer-cols a:hover { color: var(--paper); }

  .footer-giant {
    font-size: clamp(4rem, 19vw, 19rem);
    line-height: 0.8;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-bottom: 0.06em;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-align: center;
    overflow: hidden;
  }
  /* Each letter: outlined, with a light band that sweeps across once. */
  .footer-giant span {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1px rgba(148, 188, 227, 0.28);
    background: linear-gradient(
        100deg,
        transparent 0 40%,
        rgba(148, 188, 227, 0.55) 50%,
        transparent 60% 100%
      )
      no-repeat;
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* Before it plays (JS only): letters wait below the line. */
  :global(html.js) .footer-giant:not(.is-in) span {
    transform: translateY(105%);
    opacity: 0;
  }
  .footer-giant.is-in span {
    animation:
      giant-rise 1.1s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 0.06s) both,
      giant-sheen 1.6s ease-in-out calc(0.7s + var(--i) * 0.07s) both;
  }
  @keyframes giant-rise {
    from { transform: translateY(105%) rotate(4deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  @keyframes giant-sheen {
    from { background-position: 100% 0; }
    to { background-position: 0% 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-giant span,
    .footer-giant.is-in span { animation: none; transform: none; opacity: 1; }
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line-on-ink);
    color: var(--text-on-ink-muted);
  }
  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .footer-legal-links a {
    color: var(--text-on-ink-muted);
    transition: color 0.2s;
  }
  .footer-legal-links a:hover {
    color: var(--tint);
  }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .footer-cols { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Play the wordmark once when it scrolls into view, then leave it in place.
  const giant = document.querySelector<HTMLElement>('[data-giant]');
  if (giant) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        giant.classList.add('is-in');
        io.disconnect();
      },
      { threshold: 0.35 },
    );
    io.observe(giant);
  }
</script>
