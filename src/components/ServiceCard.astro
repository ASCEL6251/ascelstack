---
import type { Service, Layer } from '../data/catalog';
import { getPricing, cardPrice } from '../lib/pricing';
import { DEFAULT_CURRENCY, convertPriceText } from '../lib/currency';

interface Props {
  service: Service;
  layer: Layer;
  shared?: boolean;
}
const { service: s, layer, shared = false } = Astro.props;
const search = `${s.name} ${s.description} ${s.category} ${s.subcategory} ${s.id}`.toLowerCase();
const p = getPricing(s.id);
// Printed in the default currency; the navbar currency script re-renders tagged prices.
const price = p ? cardPrice(p, DEFAULT_CURRENCY) : null;
const market = p?.market ? `Market: ${p.market}` : '';
const open = p ? p.status === 'open' : s.priority === 'core';
const typeLabel = p ? { package: '5 packages', fixed: 'Fixed price', starting: 'Starting price' }[p.type] : '';
---

<article
  class:list={['card', `card--${layer}`, { 'card--future': !open }]}
  data-card
  data-service-code={s.id}
  data-search={search}
>
  <div class="card-top">
    <span class="mono card-id">{s.id}</span>
    <span class="card-badge card-badge--soon" data-badge-soon hidden={open}>Coming soon</span>
    {shared && <span class="card-badge card-badge--soft">Shared</span>}
  </div>
  <h3 class="card-name">{s.name}</h3>
  <p class="card-desc">{s.description}</p>
  <div class="card-price" data-card-price>
    <span class="mono card-price-type" data-price-type>{typeLabel}</span>
    <span class="card-price-row">
      <span class="card-price-from" data-price-from hidden={!price?.prefix}>{price?.prefix || ''}</span>
      <strong class="card-price-amt" data-price-amt data-money={price?.base ?? undefined}>{price?.amount || 'On quote'}</strong>
      <span class="card-price-unit" data-price-unit>{price?.unit || ''}</span>
    </span>
    <span class="card-market" data-price-market data-money-text={market} title="India market rate, 2026">{convertPriceText(market, DEFAULT_CURRENCY)}</span>
  </div>
  <div class="card-actions" data-card-actions>
    {
      open && p ? (
        <button type="button" class="card-add" data-add={s.id}>
          <span class="card-add-label" data-add-label>{p.type === 'package' ? 'Choose package' : 'Add to estimate'}</span>
          <span class="card-add-plus" aria-hidden="true">+</span>
        </button>
      ) : (
        <a class="card-cta" href={`/contact?service=${s.id}`}>
          Register interest <span class="arrow">→</span>
        </a>
      )
    }
    <a class="card-link" href={`/contact?service=${s.id}`} data-card-enquire hidden={!open}>Enquire</a>
  </div>
  <span class="card-strata" aria-hidden="true"><i></i><i></i><i></i></span>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 200px;
    padding: 1.4rem 1.4rem 1.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.5s var(--ease-out), border-color 0.4s, box-shadow 0.5s var(--ease-out);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--layer) 70%, transparent);
    box-shadow: 0 24px 50px -32px rgba(29, 45, 61, 0.5);
  }
  .card--build { --layer: var(--tint); --layer-idx: 1; }
  .card--grow { --layer: var(--accent); --layer-idx: 2; }
  .card--run { --layer: var(--ink); --layer-idx: 3; }

  .card-top { display: flex; align-items: center; gap: 0.5rem; }
  .card-id { color: var(--text-muted); }
  .card-badge {
    margin-left: auto;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .card-badge--soft { background: var(--paper-sunk); color: var(--ink); }
  .card-badge + .card-badge { margin-left: 0; }

  .card-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.4rem);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin-top: 0.4rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .card-desc { font-size: 0.92rem; line-height: 1.5; color: var(--text-muted); }
  .card-price { display: grid; gap: 0.15rem; margin-top: 0.35rem; padding-top: 0.85rem; border-top: 1px dashed var(--line); }
  .card-price-type { color: var(--text-muted); text-transform: uppercase; font-size: 0.65rem; }
  .card-price-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.35rem; }
  .card-price-from { font-size: 0.8rem; color: var(--text-muted); }
  .card-price-amt {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums lining-nums;
    font-feature-settings: 'tnum' 1, 'lnum' 1;
  }
  .card-price-unit { font-size: 0.8rem; color: var(--text-muted); }
  .card-market { font-size: 0.75rem; color: var(--text-muted); opacity: 0.85; line-height: 1.4; }

  .card-actions {
    margin-top: auto;
    padding-top: 1rem;
    padding-right: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .card :global(.card-add) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    padding: 0 5px 0 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s var(--ease-out);
    touch-action: manipulation;
  }
  .card :global(.card-add:hover) { background: var(--accent); }
  .card :global(.card-add-plus) {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.4s var(--ease-out);
  }
  .card :global(.card-add:hover) :global(.card-add-plus) { transform: rotate(90deg); }
  .card :global(.card-add.is-added) { background: var(--accent); }
  .card :global(.card-add.is-added) :global(.card-add-plus) { transform: none; }
  .card :global(.card-link) {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.35rem 0.5rem;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    border-radius: 4px;
    transition: color 0.2s;
  }
  .card :global(.card-link:hover) { color: var(--accent); }

  .card :global(.card-cta) {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    width: fit-content;
    padding: 0.35rem 0;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
  }
  .card :global(.card-cta .arrow) { display: inline-block; transition: transform 0.4s var(--ease-out); }
  .card:hover :global(.card-cta .arrow) { transform: translateX(4px); }

  /* Three-stratum indicator; the card's own layer is filled. */
  .card-strata {
    position: absolute;
    right: 1.25rem;
    bottom: 1.35rem;
    display: grid;
    gap: 3px;
    justify-items: center;
    pointer-events: none;
  }
  .card-strata i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: var(--paper-sunk);
  }
  .card-strata i:nth-child(1) { width: 10px; }
  .card-strata i:nth-child(2) { width: 18px; }
  .card-strata i:nth-child(3) { width: 26px; }
  .card--build .card-strata i:nth-child(1),
  .card--grow .card-strata i:nth-child(2),
  .card--run .card-strata i:nth-child(3) { background: var(--layer); }

  .card--future { background: transparent; border-style: dashed; }

  @keyframes liveCardFlash {
    0% {
      transform: translateY(-4px) scale(1.02);
      border-color: #4ade80;
      box-shadow: 0 0 25px rgba(74, 222, 128, 0.45);
    }
    100% {
      transform: none;
      box-shadow: none;
    }
  }

  .card.is-live-updated {
    animation: liveCardFlash 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 480px) {
    .card {
      padding: 1.15rem 1.15rem 1rem;
      gap: 0.5rem;
    }
    .card-actions {
      padding-right: 2.25rem;
      gap: 0.6rem;
    }
    .card :global(.card-add) {
      font-size: 0.82rem;
      min-height: 38px;
      padding-left: 0.85rem;
    }
    .card :global(.card-add-plus) {
      width: 26px;
      height: 26px;
    }
  }
</style>
