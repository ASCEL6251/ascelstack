---
import Logo from '../Logo.astro';
import { futureCategories, counts } from '../../data/catalog';
const loop = [...futureCategories, ...futureCategories];
---

<section class="next" aria-labelledby="next-title">
  <div class="wrap next-head">
    <p class="eyebrow">Coming next</p>
    <h2 id="next-title" class="mono next-sub">{counts.future} more services in {futureCategories.length} new disciplines</h2>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        loop.map((c) => (
          <span class="marquee-item">
            <span class="display">{c.short}</span>
            <span class="mono">{c.services.length}</span>
          </span>
        ))
      }
    </div>
  </div>
  <ul class="sr-only">
    {futureCategories.map((c) => <li>{c.name}: {c.services.length} services</li>)}
  </ul>
</section>

<section class="cta on-ink" aria-labelledby="cta-title" data-cta>
  <div class="wrap cta-inner">
    <div class="cta-mark" data-cta-mark aria-hidden="true">
      <Logo tone="light" wordmark={false} size={120} />
    </div>
    <h2 id="cta-title" class="display cta-title">Let's stack<br /><em>your business.</em></h2>
    <p class="lead">Tell us what's slowing you down. We'll come back within one working day with a plan.<span class="temp"></span></p>
    <div class="cta-actions">
      <a href="/contact" class="btn">Start a project <span class="arrow">→</span></a>
      <a href="/services" class="btn btn-ghost">Browse all services</a>
    </div>
  </div>
</section>

<style>
  .next {
    padding-block: clamp(4rem, 8vw, 6rem);
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .next-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .next-sub { color: var(--text-muted); font-weight: 400; text-transform: uppercase; }
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-item {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-inline: 2.5rem;
    border-right: 1px solid var(--line);
  }
  .marquee-item .display {
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    line-height: 1.1;
    color: var(--ink);
  }
  .marquee-item .mono { color: var(--accent); margin-top: 0.75rem; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6rem, 14vw, 12rem);
    background:
      radial-gradient(50% 60% at 50% 0%, rgba(89, 128, 166, 0.45), transparent 70%),
      var(--ink);
  }
  .cta-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 2rem;
  }
  .cta-title { font-size: clamp(3rem, 1.5rem + 7vw, 8rem); line-height: 0.95; }
  .cta .lead { margin-inline: auto; max-width: 44ch; }
  .cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .cta-mark :global(path) { transform-box: fill-box; }

  @media (max-width: 540px) {
    .cta-actions { flex-direction: column; width: 100%; max-width: 320px; }
    .cta-actions .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../../scripts/motion';

  if (!reducedMotion) {
    // The mark restacks itself as the CTA scrolls in (and unstacks on the way back up).
    const mark = document.querySelector('[data-cta-mark]');
    if (mark) {
      const tl = gsap.timeline({
        scrollTrigger: { trigger: '[data-cta]', start: 'top 85%', end: 'top 25%', scrub: 0.6 },
      });
      tl.from(mark.querySelector('.logo-l1'), { y: -60, autoAlpha: 0 }, 0)
        .from(mark.querySelector('.logo-l2'), { x: -50, autoAlpha: 0 }, 0.1)
        .from(mark.querySelector('.logo-l3'), { y: 60, autoAlpha: 0 }, 0.2)
        .from('.cta-title', { y: 60, autoAlpha: 0 }, 0.2)
        .from('.cta .lead, .cta-actions', { y: 30, autoAlpha: 0, stagger: 0.1 }, 0.35);
    }
  }
</script>
