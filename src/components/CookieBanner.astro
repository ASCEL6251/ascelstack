    border-color: rgba(148, 188, 227, 0.28);
  }

  .asc-btn-ghost:hover {
    background: rgba(148, 188, 227, 0.12);
    border-color: #94bce3;
    color: #ffffff;
  }

  .asc-icon {
    flex-shrink: 0;
  }

  /* ------------------------------------------------------------- View 2: Customize */
  #asc-cookie-view-customize {
    display: grid;
    gap: 1.5rem;
  }

  .asc-customize-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .asc-customize-title {
    margin-top: 0.35rem;
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
  }

  .asc-customize-sub {
    margin-top: 0.45rem;
    max-width: 800px;
  }

  .asc-close-btn {
    background: rgba(35, 55, 75, 0.4);
    border: 1px solid rgba(148, 188, 227, 0.2);
    color: #9fb0c1;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
