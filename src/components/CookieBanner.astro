  .asc-toggle-input:checked + .asc-toggle-label {
    background: #5980a6;
    border-color: #94bce3;
  }

  .asc-toggle-input:checked + .asc-toggle-label .asc-toggle-slider {
    transform: translateX(20px);
    background: #ffffff;
  }

  .asc-toggle-label.is-locked {
    cursor: not-allowed;
    background: #23374b;
    border-color: rgba(148, 188, 227, 0.3);
  }

  .asc-toggle-input:disabled + .asc-toggle-label .asc-toggle-slider {
    background: #94bce3;
  }

  .asc-toggle-input:focus-visible + .asc-toggle-label {
    outline: 2px solid #94bce3;
    outline-offset: 3px;
  }

  /* Customize Actions */
  .asc-customize-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid rgba(148, 188, 227, 0.16);
  }

  .asc-customize-legal {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.82rem;
    color: #9fb0c1;
    flex-wrap: wrap;
  }

  .asc-dot {
    opacity: 0.5;
  }

  .asc-customize-btns {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Responsive Rules */
  @media (max-width: 960px) {
    #asc-cookie-view-notice {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .asc-cookie-actions {
      justify-content: flex-start;
      width: 100%;
    }

    .asc-cookie-actions .asc-btn {
      flex: 1 1 auto;
      min-width: 140px;
    }
  }

  @media (max-width: 640px) {
    .asc-cookie-wrapper {
      padding: 1.15rem 1rem;
      max-height: 90vh;
    }

    .asc-cookie-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }

    .asc-cookie-actions .asc-btn {
      width: 100%;
    }

    .asc-customize-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .asc-customize-btns {
      flex-direction: column;
      align-items: stretch;
    }

    .asc-customize-btns .asc-btn {
      width: 100%;
    }
  }
</style>

<script>
  // ============================================================================
  // Ascelstack Cookie & Storage Consent Management
  // Supports Localhost & Production environments with robust persistence
  // ============================================================================

  interface CookieConsent {
    necessary: true;
    analytics: boolean;
    personalization: boolean;
    timestamp: string;
    version: number;
  }

  const STORAGE_KEY = 'ascelstack_cookie_consent_v1';
  const COOKIE_NAME = 'ascelstack_consent';
  const CURRENT_VERSION = 1;

  // Retrieve existing consent from localStorage or document.cookie
  function readConsent(): CookieConsent | null {
    try {
      // 1. Try LocalStorage
      const rawLocal = localStorage.getItem(STORAGE_KEY);
      if (rawLocal) {
        const parsed = JSON.parse(rawLocal);
        if (parsed && parsed.version === CURRENT_VERSION && parsed.necessary === true) {
          return parsed as CookieConsent;
        }
      }
    } catch {
      // LocalStorage might be disabled or restricted
    }

    try {
      // 2. Try Cookie fallback (useful for SSR/Edge if needed)
      const match = document.cookie.match(new RegExp('(^|; )' + COOKIE_NAME + '=([^;]+)'));
      if (match && match[2]) {
        const decoded = decodeURIComponent(match[2]);
        const parsed = JSON.parse(decoded);
        if (parsed && parsed.version === CURRENT_VERSION && parsed.necessary === true) {
          return parsed as CookieConsent;
        }
      }
    } catch {
      // Cookie parsing error
    }

    return null;
  }

  // Persist consent to both localStorage and document.cookie
  function persistConsent(analytics: boolean, personalization: boolean): CookieConsent {
    const consent: CookieConsent = {
      necessary: true,
      analytics: Boolean(analytics),
      personalization: Boolean(personalization),
      timestamp: new Date().toISOString(),
      version: CURRENT_VERSION,
    };

    const serialized = JSON.stringify(consent);

    // 1. Write LocalStorage (Works on localhost & all ports)
    try {
      localStorage.setItem(STORAGE_KEY, serialized);
    } catch {
      // Ignore storage quota errors
    }

    // 2. Write document.cookie with 1 year lifetime
    try {
      const maxAge = 365 * 24 * 60 * 60; // 1 year
      const isHttps = window.location.protocol === 'https:';
      const secureFlag = isHttps ? '; Secure' : '';
      // On localhost, omitting Secure allows it to store properly
      document.cookie = `${COOKIE_NAME}=${encodeURIComponent(serialized)}; Max-Age=${maxAge}; Path=/; SameSite=Lax${secureFlag}`;
    } catch {
      // Ignore cookie errors
    }

    // 3. Dispatch system-wide event for analytics or feature toggles
    window.dispatchEvent(
      new CustomEvent('ascelstack:consent-updated', {
        detail: consent,
      })
    );

    return consent;
  }

  function initCookieBanner() {
    const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');
    const backdrop = document.querySelector<HTMLElement>('[data-cookie-backdrop]');
    const viewNotice = document.querySelector<HTMLElement>('[data-view-notice]');
    const viewCustomize = document.querySelector<HTMLElement>('[data-view-customize]');

    const btnAcceptAllList = document.querySelectorAll<HTMLButtonElement>('[data-cookie-accept-all]');
    const btnRejectNonEssential = document.querySelector<HTMLButtonElement>('[data-cookie-reject-nonessential]');
    const btnOpenCustomize = document.querySelector<HTMLButtonElement>('[data-cookie-open-customize]');
    const btnCloseCustomize = document.querySelector<HTMLButtonElement>('[data-cookie-close-customize]');
    const btnBackToNotice = document.querySelector<HTMLButtonElement>('[data-cookie-back-to-notice]');
    const btnSavePreferences = document.querySelector<HTMLButtonElement>('[data-cookie-save-preferences]');

    const inputAnalytics = document.querySelector<HTMLInputElement>('[data-pref-analytics]');
    const inputPersonalization = document.querySelector<HTMLInputElement>('[data-pref-personalization]');

    if (!banner || !backdrop || !viewNotice || !viewCustomize) return;

    let currentConsent = readConsent();

    function showBanner(openCustomizeDirectly = false) {
      banner.hidden = false;
      banner.style.display = 'block';

      if (openCustomizeDirectly) {
        viewNotice.hidden = true;
        viewCustomize.hidden = false;

        // Pre-fill checkboxes with current or default choices
        const consent = readConsent();
        if (inputAnalytics) inputAnalytics.checked = consent ? consent.analytics : false;
        if (inputPersonalization) inputPersonalization.checked = consent ? consent.personalization : false;
      } else {
        viewNotice.hidden = false;
        viewCustomize.hidden = true;
      }

      // Smooth frame-based animation
      requestAnimationFrame(() => {
        backdrop.classList.add('is-visible');
        banner.classList.add('is-visible');
      });
    }

    function hideBanner() {
      banner.classList.remove('is-visible');
      backdrop.classList.remove('is-visible');

      setTimeout(() => {
        banner.hidden = true;
        banner.style.display = 'none';
        viewNotice.hidden = false;
        viewCustomize.hidden = true;
      }, 400);
    }

    function switchToCustomize() {
      const consent = readConsent();
      if (inputAnalytics) inputAnalytics.checked = consent ? consent.analytics : false;
      if (inputPersonalization) inputPersonalization.checked = consent ? consent.personalization : false;

      viewNotice.hidden = true;
      viewCustomize.hidden = false;
    }

    function switchToNotice() {
      viewCustomize.hidden = true;
      viewNotice.hidden = false;
    }

    // Accept All action
    btnAcceptAllList.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentConsent = persistConsent(true, true);
        hideBanner();
      });
    });

    // Reject Non-Essential (Essential Only)
    if (btnRejectNonEssential) {
      btnRejectNonEssential.addEventListener('click', () => {
        currentConsent = persistConsent(false, false);
        hideBanner();
      });
    }

    // Open Customize view
    if (btnOpenCustomize) {
      btnOpenCustomize.addEventListener('click', () => {
        switchToCustomize();
      });
    }

    // Close Customize view (if already consented, hide banner; otherwise return to notice)
    if (btnCloseCustomize) {
      btnCloseCustomize.addEventListener('click', () => {
        if (readConsent()) {
          hideBanner();
        } else {
          switchToNotice();
        }
      });
    }

    // Back button in Customize view
    if (btnBackToNotice) {
      btnBackToNotice.addEventListener('click', () => {
        switchToNotice();
      });
    }

    // Save custom preferences
    if (btnSavePreferences) {
      btnSavePreferences.addEventListener('click', () => {
        const analytics = inputAnalytics ? inputAnalytics.checked : false;
        const personalization = inputPersonalization ? inputPersonalization.checked : false;
        currentConsent = persistConsent(analytics, personalization);
        hideBanner();
      });
    }

    // Global listener for footer button or anywhere else on the site
    document.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement)?.closest('[data-open-cookie-preferences]');
      if (target) {
        event.preventDefault();
        showBanner(true); // Open directly into customization view
      }
    });

    // Global custom event API
    window.addEventListener('ascelstack:open-cookie-preferences', () => {
      showBanner(true);
    });

    // Close on Escape key if customization modal is open
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !banner.hidden) {
        if (readConsent()) {
          hideBanner();
        }
      }
    });

    // Initial check: if no consent found, show the banner after a short delay for smooth page entrance
    if (!currentConsent) {
      setTimeout(() => {
        showBanner(false);
      }, 400);
    }
  }

  // Initialize when DOM is interactive
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
  } else {
    initCookieBanner();
  }
</script>
