  /* Toggle Switch */
  .asc-toggle-wrapper {
    position: relative;
    flex-shrink: 0;
    width: 48px;
    height: 28px;
  }

  .asc-toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .asc-toggle-label {
    display: block;
    width: 48px;
    height: 28px;
    background: #23374b;
    border: 1px solid rgba(148, 188, 227, 0.3);
    border-radius: 999px;
    cursor: pointer;
    position: relative;
    transition: background 0.25s, border-color 0.25s;
  }

  .asc-toggle-slider {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 20px;
    height: 20px;
    background: #c7c7c9;
    border-radius: 50%;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
