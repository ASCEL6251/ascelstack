---
// src/components/CookieBanner.astro
// Ascelstack Technologies — Privacy & Cookie Consent Banner
// Compliant with Indian Digital Data Protection (DPDP) Guidelines & Global Best Practices
---

<!-- Scrim backdrop that dims the main screen when the banner or preference panel is active -->
<div
  id="asc-cookie-backdrop"
  class="asc-cookie-backdrop"
  data-cookie-backdrop
  aria-hidden="true"
></div>

<!-- Edge-to-edge banner covering the full width from one side to another side -->
<aside
  id="asc-cookie-banner"
  class="asc-cookie-banner"
  role="dialog"
  aria-modal="true"
  aria-labelledby="asc-cookie-title"
  aria-describedby="asc-cookie-desc"
  data-cookie-banner
  hidden
>
  <div class="asc-cookie-wrapper">
    <!-- Top accent highlight line -->
    <div class="asc-cookie-beam" aria-hidden="true"></div>

    <!-- VIEW 1: Initial Consent Notice (Fast, bold, transparent) -->
    <div id="asc-cookie-view-notice" class="asc-cookie-view" data-view-notice>
      <div class="asc-cookie-content">
        <div class="asc-cookie-badge-row">
          <span class="asc-cookie-badge">Privacy & Cookie Notice</span>
          <span class="asc-cookie-indicator" aria-hidden="true"></span>
        </div>

        <h2 id="asc-cookie-title" class="asc-cookie-heading">
          We Respect Your Privacy &amp; Data Choices
        </h2>

        <p id="asc-cookie-desc" class="asc-cookie-text">
          Ascelstack uses essential cookies and local browser storage to keep your account session secure,
          remember your active service cart, and process estimate requests. With your approval, we also use
          analytical and personalization tools to measure performance and improve your workflow experience.
          We never sell your data. Review our
          <a href="/terms" class="asc-cookie-link">Terms &amp; Conditions</a>
          and
          <a href="/privacy#cookies" class="asc-cookie-link">Privacy Policy</a>
          or customize your preferences at any time.
        </p>
      </div>

      <div class="asc-cookie-actions">
        <button
          type="button"
          class="asc-btn asc-btn-primary"
          data-cookie-accept-all
        >
          Accept All
        </button>

        <button
          type="button"
          class="asc-btn asc-btn-secondary"
          data-cookie-reject-nonessential
        >
          Essential Only
        </button>

        <button
          type="button"
          class="asc-btn asc-btn-ghost"
          data-cookie-open-customize
        >
          <svg
            class="asc-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="3"></circle>
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
            ></path>
          </svg>
          <span>Personalize Choices</span>
        </button>
      </div>
    </div>

    <!-- VIEW 2: Granular Preference Center (Accessible anytime via footer) -->
    <div id="asc-cookie-view-customize" class="asc-cookie-view" data-view-customize hidden>
      <div class="asc-customize-header">
        <div>
          <span class="asc-cookie-badge">Privacy Settings</span>
          <h2 class="asc-cookie-heading asc-customize-title">
            Personalize Your Cookie &amp; Storage Preferences
          </h2>
          <p class="asc-cookie-text asc-customize-sub">
            Configure your privacy settings below. Strictly necessary cookies are permanently enabled as
            they are required to keep your account session secure, protect transactions, and store your
            service cart.
          </p>
        </div>
        <button
          type="button"
          class="asc-close-btn"
          data-cookie-close-customize
          aria-label="Close preferences panel"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Categories Grid -->
      <div class="asc-pref-grid">
        <!-- 1. Strictly Necessary -->
        <div class="asc-pref-card asc-pref-locked">
          <div class="asc-pref-header">
            <div class="asc-pref-info">
              <div class="asc-pref-title-row">
                <h3 class="asc-pref-title">Strictly Necessary Cookies</h3>
                <span class="asc-status-badge asc-status-active">Always Active</span>
              </div>
              <p class="asc-pref-desc">
                Vital for authenticating client portal sessions, preventing CSRF forgery, preserving your
                cart estimates, and securing database communications. These cannot be disabled.
              </p>
            </div>
            <div class="asc-toggle-wrapper">
              <input
                type="checkbox"
                id="asc-pref-necessary"
                checked
                disabled
                class="asc-toggle-input"
                aria-label="Strictly Necessary Cookies (Always Active)"
              />
              <label for="asc-pref-necessary" class="asc-toggle-label is-locked" aria-hidden="true">
                <span class="asc-toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- 2. Performance & Analytics -->
        <div class="asc-pref-card">
          <div class="asc-pref-header">
            <div class="asc-pref-info">
              <div class="asc-pref-title-row">
                <h3 class="asc-pref-title">Performance &amp; Analytics</h3>
                <span class="asc-status-badge asc-status-optional">Optional</span>
              </div>
              <p class="asc-pref-desc">
                Allows us to analyze site speed, measure request latencies, and identify high-value workflows.
                All metrics are collected in an aggregated, privacy-safe format with zero cross-site ad tracking.
              </p>
            </div>
            <div class="asc-toggle-wrapper">
              <input
                type="checkbox"
                id="asc-pref-analytics"
                class="asc-toggle-input"
                data-pref-analytics
                aria-label="Toggle Performance & Analytics cookies"
              />
              <label for="asc-pref-analytics" class="asc-toggle-label">
                <span class="asc-toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- 3. Personalization & Workflows -->
        <div class="asc-pref-card">
          <div class="asc-pref-header">
            <div class="asc-pref-info">
              <div class="asc-pref-title-row">
                <h3 class="asc-pref-title">Personalization &amp; Workflows</h3>
                <span class="asc-status-badge asc-status-optional">Optional</span>
              </div>
              <p class="asc-pref-desc">
                Remembers your selected industry filters, quotation scope selections, and UI display settings
                so your tailored dashboard and builder configuration persist seamlessly across visits.
              </p>
            </div>
            <div class="asc-toggle-wrapper">
              <input
                type="checkbox"
                id="asc-pref-personalization"
                class="asc-toggle-input"
                data-pref-personalization
                aria-label="Toggle Personalization & Workflows cookies"
              />
              <label for="asc-pref-personalization" class="asc-toggle-label">
                <span class="asc-toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Customize Action Bar -->
      <div class="asc-customize-actions">
        <div class="asc-customize-legal">
          <span>Manage at any time via the footer</span>
          <span class="asc-dot">·</span>
          <a href="/privacy#cookies" class="asc-cookie-link">Cookie Policy</a>
          <span class="asc-dot">·</span>
          <a href="/terms" class="asc-cookie-link">Terms</a>
        </div>

        <div class="asc-customize-btns">
          <button
            type="button"
            class="asc-btn asc-btn-secondary"
            data-cookie-back-to-notice
          >
            Back
          </button>
          <button
            type="button"
            class="asc-btn asc-btn-ghost"
            data-cookie-save-preferences
          >
            Save My Preferences
          </button>
          <button
            type="button"
            class="asc-btn asc-btn-primary"
            data-cookie-accept-all
          >
            Accept All
          </button>
        </div>
      </div>
    </div>
  </div>
</aside>

<style>
  /* ==========================================================================
     Ascelstack Cookie Banner & Preference Center
     Follows brand tokens: Ink #1D2D3D, Tint #94BCE3, Accent #5980A6, Paper #F2F2F3
     ========================================================================== */

  /* Backdrop: covers main screen to draw crisp, professional focus */
  .asc-cookie-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9998;
    background: rgba(14, 22, 32, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .asc-cookie-backdrop.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* Full-bleed bottom banner covering the entire screen edge-to-edge */
  .asc-cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 9999;
    background: #142130;
    color: #f2f2f3;
    border-top: 1px solid rgba(148, 188, 227, 0.22);
    box-shadow: 0 -12px 48px -10px rgba(10, 18, 28, 0.85);
    transform: translateY(105%);
    opacity: 0;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.35s ease;
    will-change: transform, opacity;
  }

  .asc-cookie-banner.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  /* Subtle accent glow beam across the top edge */
  .asc-cookie-beam {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(89, 128, 166, 0.4) 15%,
      rgba(148, 188, 227, 0.85) 50%,
      rgba(89, 128, 166, 0.4) 85%,
      transparent 100%
    );
  }

  .asc-cookie-wrapper {
    position: relative;
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1rem, 3vw, 2.5rem);
    max-height: 85vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* ------------------------------------------------------------- View 1: Notice */
  .asc-cookie-view[hidden] {
    display: none !important;
  }

  #asc-cookie-view-notice {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .asc-cookie-content {
    display: grid;
    gap: 0.65rem;
    max-width: 820px;
  }

  .asc-cookie-badge-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .asc-cookie-badge {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94bce3;
    background: rgba(148, 188, 227, 0.12);
    border: 1px solid rgba(148, 188, 227, 0.28);
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    display: inline-block;
  }

  .asc-cookie-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #94bce3;
    box-shadow: 0 0 8px #94bce3;
  }

  .asc-cookie-heading {
    font-family: var(--font-body, 'Inter Tight', sans-serif);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0;
  }

  .asc-cookie-text {
    font-family: var(--font-body, 'Inter Tight', sans-serif);
    font-size: clamp(0.88rem, 0.82rem + 0.2vw, 0.96rem);
    line-height: 1.55;
    color: #c7c7c9;
    margin: 0;
  }

  .asc-cookie-link {
    color: #94bce3;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .asc-cookie-link:hover {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }

  /* Actions */
  .asc-cookie-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .asc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-body, 'Inter Tight', sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    cursor: pointer;
    border: 1px solid transparent;
    transition:
      background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.25s,
      border-color 0.25s,
      transform 0.2s;
    white-space: nowrap;
  }

  .asc-btn:hover {
    transform: translateY(-1px);
  }

  .asc-btn:active {
    transform: translateY(0);
  }

  /* Primary Button: High contrast white/paper */
  .asc-btn-primary {
    background: #f2f2f3;
    color: #142130;
    border-color: #f2f2f3;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  }

  .asc-btn-primary:hover {
    background: #94bce3;
    border-color: #94bce3;
    color: #142130;
  }

  /* Secondary Button: Outlined ink tone */
  .asc-btn-secondary {
    background: rgba(35, 55, 75, 0.6);
    color: #f2f2f3;
    border-color: rgba(148, 188, 227, 0.25);
  }

  .asc-btn-secondary:hover {
    background: rgba(35, 55, 75, 0.95);
    border-color: #94bce3;
    color: #ffffff;
  }

  /* Ghost Button: Transparent with clean accent */
  .asc-btn-ghost {
