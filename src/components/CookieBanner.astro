  .asc-pref-card:hover {
    border-color: rgba(148, 188, 227, 0.35);
    background: rgba(29, 45, 61, 0.95);
  }

  .asc-pref-card.asc-pref-locked {
    background: rgba(20, 31, 44, 0.95);
    border-color: rgba(148, 188, 227, 0.12);
  }

  .asc-pref-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .asc-pref-info {
    display: grid;
    gap: 0.4rem;
  }

  .asc-pref-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .asc-pref-title {
    font-family: var(--font-body, 'Inter Tight', sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .asc-status-badge {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem;
    font-weight: 600;
