---
import Logo from './Logo.astro';
import { coreCategories, LAYERS } from '../data/catalog';
import { industries } from '../data/industries';

interface Props {
  /** Kept for API compatibility; the pill carries its own background on every page. */
  tone?: 'light' | 'dark';
}

// Order is fixed: Logo · Services · Automation · Industries · Process · CTA
const links = [
  { href: '/services', label: 'Services' },
  { href: '/automation', label: 'Automation' },
  { href: '/#industries', label: 'Industries' },
  { href: '/#process', label: 'Process' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => !href.startsWith('/#') && path.startsWith(href);

// Phone menu: Services and Industries open as accordions, the rest are plain links.
type Sub = { href: string; title: string; sub: string; mark: string; layer?: string };
const layerIndex = { build: 0, grow: 1, run: 2 } as const;
const menu: { label: string; href: string; sub?: Sub[]; all?: string }[] = [
  {
    label: 'Services',
    href: '/services',
    all: 'All services',
    sub: coreCategories.map((c) => ({
      href: `/services/${c.slug}`,
      title: c.short,
      sub: LAYERS[c.layer].title,
      mark: String(layerIndex[c.layer]),
      layer: c.layer,
    })),
  },
  { label: 'Automation', href: '/automation' },
  {
    label: 'Industries',
    href: '/#industries',
    all: 'See how it fits',
    sub: industries.map((ind, i) => ({
      href: `/services/${ind.slug}`,
      title: ind.title,
      sub: ind.tag,
      mark: String(i + 1).padStart(2, '0'),
    })),
  },
  { label: 'Process', href: '/#process' },
];
---

<header class="nav" data-nav>
  <div class="nav-bar">
    <div class="nav-pill" data-pill>
      <a href="/" class="nav-logo" aria-label="Ascelstack home">
        <Logo tone="dark" size={28} />
      </a>

      <nav class="nav-links" aria-label="Primary" data-links>
        <span class="nav-glide" aria-hidden="true" data-glide></span>
        {
          links.map((l) => (
            <a href={l.href} class:list={['nav-link', { 'is-active': isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
              <span>{l.label}</span>
            </a>
          ))
        }
      </nav>

      <a href="/contact" class="nav-cta">
        <span class="nav-cta-text">Start a project</span>
        <span class="nav-cta-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 11 11 3M5 3h6v6" /></svg>
        </span>
      </a>

      <a href="/dashboard" class="nav-portal" aria-label="Client Portal" title="Client Portal">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span class="nav-portal-label">Portal</span>
      </a>

      <button
        class="nav-dots"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-drawer"
        data-nav-toggle
      >
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<div class="mnav" id="nav-drawer" data-drawer>
  <div class="mnav-panel on-ink" role="dialog" aria-modal="true" aria-label="Site menu" data-lenis-prevent>
    <nav class="mnav-list" aria-label="Mobile">
      {
        menu.map((m, i) =>
          m.sub ? (
            <div class="mnav-item mnav-acc" style={`--i:${i}`} data-acc>
              <button
                type="button"
                class:list={['mnav-row', { 'is-active': isActive(m.href) }]}
                aria-expanded="false"
                aria-controls={`mnav-sub-${i}`}
                data-acc-toggle
              >
                <span class="mnav-label">{m.label}</span>
                <span class="mnav-chev" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
                </span>
              </button>
              <div class="mnav-sub" id={`mnav-sub-${i}`} data-acc-body>
                <div class="mnav-sub-inner">
                  <ul class="mnav-sub-list">
                    {m.sub.map((s) => (
                      <li>
                        <a href={s.href} class:list={['mnav-sublink', { 'is-active': path === s.href }]}>
                          <span class="mnav-tile" aria-hidden="true">
                            {s.layer ? (
                              <span class="mnav-layers" data-layer={s.mark}><i /><i /><i /></span>
                            ) : (
                              <span class="mono">{s.mark}</span>
                            )}
                          </span>
                          <span class="mnav-subtext">
                            <span class="mnav-subtitle">{s.title}</span>
                            <span class="mnav-subdesc">{s.sub}</span>
                          </span>
                          <svg class="mnav-subarrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" /></svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a href={m.href} class="mnav-all">
                    {m.all} <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a href={m.href} class:list={['mnav-item', 'mnav-row', { 'is-active': isActive(m.href) }]} style={`--i:${i}`}>
              <span class="mnav-label">{m.label}</span>
            </a>
          ),
        )
      }
    </nav>
    <div class="mnav-foot" style={`--i:${menu.length}`}>
      <a href="/contact" class="mnav-cta">
        Start a project <span aria-hidden="true">→</span>
      </a>
      <a href="/dashboard" class="mnav-portal-link">
        Client Portal <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  /* ---------------------------------------------------------------- Pill bar */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    height: var(--nav-h);
    pointer-events: none;
    transition: transform 0.6s var(--ease-out);
  }
  .nav.is-hidden { transform: translateY(-120%); }

  .nav-bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: var(--gutter);
  }

  .nav-pill {
    pointer-events: auto;
    width: 100%;
    max-width: 1080px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 6px 6px 6px 18px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper-raised) 78%, transparent);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border: 1px solid rgba(29, 45, 61, 0.1);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 10px 30px -18px rgba(29, 45, 61, 0.35);
    transition: box-shadow 0.4s var(--ease-out), background 0.4s, max-width 0.6s var(--ease-out);
  }
  .nav.is-scrolled .nav-pill {
    background: color-mix(in srgb, var(--paper-raised) 90%, transparent);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.7) inset,
      0 18px 40px -20px rgba(29, 45, 61, 0.45);
  }

  /* Bold lockup: Georgia bold, as in the brand deck */
  .nav-logo { margin-right: auto; display: flex; align-items: center; }
  .nav-logo :global(.logo-word) {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 700;
    font-size: 1.28rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* ------------------------------------------------------------- Links */
  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(29, 45, 61, 0.05);
  }
  .nav-link {
    position: relative;
    z-index: 1;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--ink);
    transition: color 0.35s var(--ease-out);
  }
  .nav-link span { display: inline-block; transition: transform 0.4s var(--ease-out); }
  .nav-link.is-lit { color: var(--paper); }
  /* Focus is shown by the sliding highlight instead of an outline ring. */
  .nav-link:focus-visible { outline: none; }
  .nav-link.is-lit span { transform: translateY(-1px); }

  /* Sliding highlight that follows the cursor between links */
  .nav-glide {
    position: absolute;
    z-index: 0;
    top: 4px;
    left: 0;
    height: calc(100% - 8px);
    width: 0;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: 0 6px 16px -8px rgba(29, 45, 61, 0.6);
    opacity: 0;
    transition:
      transform 0.5s cubic-bezier(0.34, 1.4, 0.5, 1),
      width 0.5s cubic-bezier(0.34, 1.4, 0.5, 1),
      opacity 0.3s,
      background 0.3s;
  }
  .nav-glide.is-on { opacity: 1; }
  .nav-glide.is-resting { background: var(--accent); }

  /* ------------------------------------------------------------- CTA */
  .nav-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 44px;
    padding: 0 6px 0 1.2rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 700;
    overflow: hidden;
    isolation: isolate;
  }
  .nav-cta::before {
    /* fill wipe on hover */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    border-radius: inherit;
    transform: translateX(-101%);
    transition: transform 0.55s var(--ease-out);
  }
  .nav-cta:hover::before { transform: none; }
  .nav-cta-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }
  .nav-cta-icon svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; transition: transform 0.45s var(--ease-out); }
  .nav-cta:hover .nav-cta-icon svg { transform: rotate(45deg); }

  /* ------------------------------------------------------------- Client Portal */
  .nav-portal {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(29, 45, 61, 0.15);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.25s var(--ease-out);
  }
  .nav-portal:hover {
    border-color: var(--ink);
    background: var(--paper-sunk);
  }
  .nav-portal svg {
    color: var(--accent);
    transition: transform 0.3s ease;
  }
  .nav-portal:hover svg {
    transform: scale(1.1);
  }

  /* ------------------------------------------------------------- Menu toggle (phone) */
  .nav-dots {
    display: none;
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }
  .nav-dots i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 2px;
    margin: -1px 0 0 -9px;
    border-radius: 2px;
    background: var(--paper);
    transition: transform 0.5s var(--ease-out), width 0.4s var(--ease-out), opacity 0.3s;
  }
  .nav-dots i:nth-child(1) { transform: translateY(-6px); }
  .nav-dots i:nth-child(2) { width: 12px; }
  .nav-dots i:nth-child(3) { transform: translateY(6px); }
  .nav-dots:hover i:nth-child(2) { width: 18px; }
  /* Open: top and bottom lines cross into an X, the middle one collapses */
  .nav.is-open .nav-dots i:nth-child(1) { transform: rotate(-45deg); }
  .nav.is-open .nav-dots i:nth-child(2) { width: 0; opacity: 0; }
  .nav.is-open .nav-dots i:nth-child(3) { transform: rotate(45deg); }

  /* ------------------------------------------------------------- Tablet */
  @media (max-width: 1024px) {
    .nav-pill { padding-left: 14px; gap: 0.35rem; }
    .nav-link { padding: 0.5rem 0.75rem; font-size: 0.85rem; }
    .nav-cta { padding-left: 1rem; }
  }
  @media (max-width: 860px) {
    .nav-cta-text { display: none; }
    .nav-cta { padding: 0 6px; }
  }

  /* ------------------------------------------------------------- Phone */
  @media (max-width: 680px) {
    .nav-links { display: none; }
    .nav-dots { display: block; }
    .nav-pill { height: 54px; padding: 5px 5px 5px 16px; gap: 6px; }
    /* "Start a project" lives inside the menu on phones. */
    .nav-cta { display: none; }
    .nav-portal { display: none; }
  }

  /* ------------------------------------------------------------- Full-screen menu (phone only) */
  .nav.is-open { z-index: 80; transform: none; }
  .nav.is-open .nav-pill {
    background: var(--paper-raised);
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.5);
  }

  .mnav {
    position: fixed;
    inset: 0;
    z-index: 70;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 0.6s;
  }
  .mnav.is-open {
    visibility: visible;
    pointer-events: auto;
    transition: none;
  }

  /* Panel drops down from the top edge to fill the screen */
  .mnav-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: calc(var(--nav-h) + 1.25rem) var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
    background: var(--ink);
    color: var(--paper);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }
  .mnav.is-open .mnav-panel { clip-path: inset(0 0 0 0); }

  .mnav-list { display: flex; flex-direction: column; }

  /* Items rise into place one after another */
  .mnav-item,
  .mnav-foot {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .mnav.is-open .mnav-item,
  .mnav.is-open .mnav-foot {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s var(--ease-out) calc(0.25s + var(--i) * 0.06s),
      transform 0.6s var(--ease-out) calc(0.25s + var(--i) * 0.06s);
  }

  .mnav-row {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.05rem 0;
    border: 0;
    border-bottom: 1px solid var(--line-on-ink);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .mnav-acc .mnav-row { border-bottom: 0; }
  .mnav-acc { border-bottom: 1px solid var(--line-on-ink); }
  .mnav-label {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .mnav-row.is-active .mnav-label,
  .mnav-row:hover .mnav-label,
  .mnav-acc.is-open > .mnav-row .mnav-label { color: var(--tint); }

  .mnav-chev {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-left: auto;
    border-radius: 50%;
    border: 1px solid var(--line-on-ink);
    transition: transform 0.45s var(--ease-out), background 0.3s, border-color 0.3s;
  }
  .mnav-chev svg { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .mnav-acc.is-open .mnav-chev {
    transform: rotate(180deg);
    background: var(--tint);
    border-color: var(--tint);
    color: var(--ink);
  }

  /* Accordion body: grid row animates from 0fr to 1fr */
  .mnav-sub {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }
  .mnav-acc.is-open .mnav-sub { grid-template-rows: 1fr; }
  .mnav-sub-inner {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition: opacity 0.3s, clip-path 0.5s var(--ease-out);
  }
  .mnav-acc.is-open .mnav-sub-inner {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transition: opacity 0.4s 0.05s, clip-path 0.5s var(--ease-out);
  }
  .mnav-sub-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0.25rem;
    display: grid;
    gap: 2px;
  }

  .mnav-sublink {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.55rem 0.5rem 0.55rem 0.25rem;
    border-radius: 12px;
    transition: background 0.25s;
  }
  .mnav-sublink:hover,
  .mnav-sublink:focus-visible,
  .mnav-sublink.is-active { background: rgba(242, 242, 243, 0.06); }

  .mnav-tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--ink-raised);
    border: 1px solid var(--line-on-ink);
    color: var(--tint);
    transition: background 0.25s, color 0.25s;
  }
  .mnav-tile .mono { font-size: 0.7rem; }
  .mnav-sublink:hover .mnav-tile,
  .mnav-sublink.is-active .mnav-tile { background: var(--ink-deep); }

  /* Three stacked bars; the one for this service's layer is lit */
  .mnav-layers { display: grid; gap: 3px; width: 18px; }
  .mnav-layers i { display: block; height: 3px; border-radius: 2px; background: rgba(242, 242, 243, 0.18); }
  .mnav-layers[data-layer='0'] i:nth-child(1) { background: var(--tint); }
  .mnav-layers[data-layer='1'] i:nth-child(2) { background: var(--accent); }
  .mnav-layers[data-layer='2'] i:nth-child(3) { background: var(--paper); }

  .mnav-subtext { display: grid; gap: 1px; min-width: 0; }
  .mnav-subtitle { font-weight: 700; font-size: 0.95rem; transition: color 0.25s; }
  .mnav-subdesc { font-size: 0.78rem; color: var(--text-on-ink-muted); }
  .mnav-sublink:hover .mnav-subtitle,
  .mnav-sublink.is-active .mnav-subtitle { color: var(--tint); }

  .mnav-subarrow {
    flex: none;
    margin-left: auto;
    fill: none;
    stroke: var(--tint);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.3s, transform 0.3s var(--ease-out);
  }
  .mnav-sublink:hover .mnav-subarrow,
  .mnav-sublink:focus-visible .mnav-subarrow { opacity: 1; transform: none; }

  .mnav-all {
    display: inline-flex;
    gap: 0.4rem;
    margin: 0.5rem 0 1.1rem 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--tint);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s var(--ease-out);
  }
  .mnav-all:hover { background-size: 100% 1px; }

  .mnav-foot { margin-top: auto; padding-top: 2rem; }
  .mnav-cta {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.25s;
  }
  .mnav-cta:hover { background: var(--tint); }
  .mnav-portal-link {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem;
    margin-top: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-on-ink);
    color: var(--text-on-ink);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.25s;
  }
  .mnav-portal-link:hover {
    border-color: var(--tint);
    color: var(--tint);
  }

  @media (prefers-reduced-motion: reduce) {
    .mnav, .mnav-panel, .mnav-item, .mnav-foot, .mnav-sub, .mnav-sub-inner, .nav-glide { transition: none !important; }
  }
</style>

<script>
  import { getLenis } from '../scripts/motion';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const linksBox = nav.querySelector<HTMLElement>('[data-links]')!;
  const glide = nav.querySelector<HTMLElement>('[data-glide]')!;
  const links = [...linksBox.querySelectorAll<HTMLAnchorElement>('.nav-link')];
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;

  /* ---------- Scroll state: shadow when scrolled, hide on scroll down */
  let last = 0;
  const onScroll = () => {
    const y = window.scrollY;
    nav.classList.toggle('is-scrolled', y > 24);
    nav.classList.toggle('is-hidden', y > 420 && y > last + 2 && !nav.classList.contains('is-open'));
    if (y < last - 2) nav.classList.remove('is-hidden');
    last = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  /* ---------- Sliding hover highlight */
  const active = links.find((l) => l.classList.contains('is-active')) ?? null;
  const moveTo = (el: HTMLElement | null, resting = false) => {
    links.forEach((l) => l.classList.toggle('is-lit', l === el));
    if (!el) {
      glide.classList.remove('is-on');
      return;
    }
    glide.style.width = `${el.offsetWidth}px`;
    glide.style.transform = `translateX(${el.offsetLeft}px)`;
    glide.classList.add('is-on');
    glide.classList.toggle('is-resting', resting);
  };
  const rest = () => moveTo(active, true);

  links.forEach((l) => {
    l.addEventListener('mouseenter', () => moveTo(l));
    l.addEventListener('focus', () => moveTo(l));
  });
  linksBox.addEventListener('mouseleave', rest);
  linksBox.addEventListener('focusout', (e) => {
    if (!linksBox.contains(e.relatedTarget as Node)) rest();
  });
  // Place without animating on first paint, then enable transitions.
  glide.style.transition = 'none';
  rest();
  requestAnimationFrame(() => requestAnimationFrame(() => (glide.style.transition = '')));
  window.addEventListener('resize', rest);
  document.fonts?.ready.then(rest);

  /* ---------- Phone full-screen menu */
  const accs = [...drawer.querySelectorAll<HTMLElement>('[data-acc]')];
  const setAcc = (acc: HTMLElement, open: boolean) => {
    acc.classList.toggle('is-open', open);
    acc.querySelector('[data-acc-toggle]')!.setAttribute('aria-expanded', String(open));
    acc.querySelector('[data-acc-body]')!.toggleAttribute('inert', !open);
  };
  accs.forEach((acc) => {
    setAcc(acc, false);
    acc.querySelector('[data-acc-toggle]')!.addEventListener('click', () => {
      const open = !acc.classList.contains('is-open');
      // One section open at a time, as on the reference pattern
      accs.forEach((o) => o !== acc && setAcc(o, false));
      setAcc(acc, open);
    });
  });

  const setOpen = (open: boolean) => {
    nav.classList.toggle('is-open', open);
    drawer.classList.toggle('is-open', open);
    drawer.toggleAttribute('inert', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    const lenis = getLenis();
    if (open) {
      lenis?.stop();
      setTimeout(() => drawer.querySelector<HTMLElement>('.mnav-row')?.focus({ preventScroll: true }), 450);
    } else {
      lenis?.start();
      // Collapse sections once the panel has closed
      setTimeout(() => !drawer.classList.contains('is-open') && accs.forEach((a) => setAcc(a, false)), 600);
    }
  };
  drawer.setAttribute('inert', '');

  toggle.addEventListener('click', () => setOpen(!drawer.classList.contains('is-open')));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 681px)').addEventListener('change', (m) => m.matches && setOpen(false));
</script>
