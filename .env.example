# Ascelstack Environment Variables Example
# Duplicate this file to .env and fill in the values

# Clerk Authentication (Customer Portal)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Neon PostgreSQL Database Connection String
# (pooled connection recommended for serverless)
DATABASE_URL=postgresql://neondb_owner:password@ep-something-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# Administrator Access Allowlist (Cloudflare Environment Variable)
# Comma-separated list of authorized Google account email addresses
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com,admin3@gmail.com

# Admin Session Secret (Optional - defaults to derived HMAC key from CLERK_SECRET_KEY)
ADMIN_SESSION_SECRET=your-random-32-char-secret-key-here

# Google OAuth Credentials for Admin Panel
# Required for Google Identity Services / Sign in with Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional for server-side code exchange
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
